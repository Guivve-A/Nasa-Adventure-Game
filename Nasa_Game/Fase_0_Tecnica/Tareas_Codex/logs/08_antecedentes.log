func _ready() -> void:
	var mapa := {
		"mover_izquierda": [KEY_A, KEY_LEFT],
		"mover_derecha": [KEY_D, KEY_RIGHT],
		"mover_arriba": [KEY_W, KEY_UP],
		"mover_abajo": [KEY_S, KEY_DOWN],
		"interactuar": [KEY_E, KEY_SPACE, KEY_ENTER],
		"cancelar": [KEY_ESCAPE],
	}
	for accion: String in mapa:
		if not InputMap.has_action(accion):
			InputMap.add_action(accion)
		for tecla in mapa[accion]:
			var evento := InputEventKey.new()
			evento.physical_keycode = tecla
			InputMap.action_add_event(accion, evento)


func tiene_argumento(nombre: String) -> bool:
	return argumentos.has(nombre)
