func _update_preview() -> void:
	_preview.apply_config(avatar_config)
	_portrait.texture = _preview.get_portrait_texture()

func confirm_avatar() -> void:
	var chosen := _name_edit.text.strip_edges()
	avatar_config.name = chosen if not chosen.is_empty() else "Alex"
	book_open = false
	if is_instance_valid(world): world.reset_player(); world.set_book_open(false)
	_save()
	start_intro()

func start_intro() -> void:
	_clear()
	screen = "intro"
	_intro_time = 0.0
	var sky := ColorRect.new()
	sky.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	_intro_material = ShaderMaterial.new()
	_intro_material.shader = preload("res://assets/ui/orbit.gdshader")
	sky.material = _intro_material
	_layer.add_child(sky)
	_label("PR�"LOGO",Vector2(66,54),Vector2(450,32),17,GOLD)
	_intro_label = _label("Toda gran pregunta\ncomienza mirando hacia arriba.",Vector2(66,445),Vector2(650,120),37,PAPER,true)
	_button("Saltar intro  ��  Espacio",Vector2(935,632),Vector2(280,45),enter_room,"SkipIntro")

func _process(delta: float) -> void:
	if screen == "intro":
		_intro_time += delta
		_intro_material.set_shader_parameter("progress",0.0 if settings.reduced_motion else clampf(_intro_time/10.5,0.0,1.0))
		if _intro_time > 5.0: _intro_label.text = "Guayaquil, Ecuador.\nUna ventana al universo."
		if _intro_time > 10.5: enter_room()

