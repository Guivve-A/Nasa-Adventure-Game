extends Control
## Front-end and prologue state flow. Existing mission systems remain intact.
const Avatar = preload("res://scripts/avatar.gd")
const Bedroom = preload("res://scenes/bedroom.tscn")
const DISPLAY_FONT = preload("res://assets/fonts/Cinzel.ttf")
const BODY_FONT = preload("res://assets/fonts/Atkinson-Regular.ttf")
const GOLD := Color("d6b477")
const PAPER := Color("eee8d9")
const MUTED := Color("9eaab4")
const INK := Color("101926")
const DEFAULT_AVATAR := {"name":"Alex", "hair":0, "skin":1, "eyes":0, "hair_color":0, "outfit":0, "accessory":0}
var screen := "title"
var avatar_config: Dictionary = DEFAULT_AVATAR.duplicate()
var settings := {"sound":true,"reduced_motion":false,"fullscreen":false}
var save_data: Dictionary = {}
var book_open := false
var _layer: Control
var _world_container: SubViewportContainer
var _world_view: SubViewport
var world: Node3D
var _portrait: TextureRect
var _preview: Node3D
var _name_edit: LineEdit
var _hint: Label
var _objective: Label
var _intro_material: ShaderMaterial
var _intro_label: Label
var _intro_time := 0.0
var _return_screen := "title"
var _mission_container: SubViewportContainer
var _mission: CanvasLayer
var _sound: AudioStreamPlayer
var _save_path := "user://journey_v1.json"
var _status_message := ""

func _ready() -> void:
	if OS.get_cmdline_user_args().has("--test-profile"): _save_path = "user://test_journey_v1.json"
	_setup_inputs()
	theme = _theme()
	_load_save()
	_sound = AudioStreamPlayer.new()
	_sound.volume_db = -18.0
	add_child(_sound)
	_layer = Control.new()
	_layer.name = "ScreenLayer"
	_layer.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	_layer.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(_layer)
	_preview = Avatar.new()
	$Title/Start.pressed.connect(show_customizer)
	$Title/Continue.pressed.connect(continue_journey)
	$Title/Options.pressed.connect(func(): show_options("title"))
	$Title/Credits.pressed.connect(show_credits)
	for b in [$Title/Start,$Title/Continue,$Title/Options,$Title/Credits]:
		b.mouse_entered.connect(func(): b.grab_focus())
	$Title/Start.add_theme_stylebox_override("normal",_style(Color("ccb17a"),GOLD,10))
	$Title/Start.add_theme_color_override("font_color",INK)
	$Title/Start.add_theme_color_override("font_focus_color",INK)
	$Title/Start.add_theme_color_override("font_pressed_color",INK)
	$Title/Start.add_theme_stylebox_override("hover",_style(Color("eee0bb"),PAPER,10))
	$Title/Start.add_theme_color_override("font_hover_color",INK)
	_apply_settings()
	show_title()
	print("GRAVEDAD_READY screen=title")

func _exit_tree() -> void:
	if is_instance_valid(_preview): _preview.free()

func _setup_inputs() -> void:
	var actions := {"move_left":[KEY_A,KEY_LEFT], "move_right":[KEY_D,KEY_RIGHT], "move_up":[KEY_W,KEY_UP], "move_down":[KEY_S,KEY_DOWN], "interact":[KEY_E], "run":[KEY_SHIFT]}
	for action: String in actions:
		if not InputMap.has_action(action): InputMap.add_action(action)
		for key in actions[action]:
			var event := InputEventKey.new()
			event.physical_keycode = key
			InputMap.action_add_event(action,event)

func _theme() -> Theme:
	var result := Theme.new()
	result.default_font = BODY_FONT
	result.default_font_size = 21
	for type: String in ["Label","Button","OptionButton","LineEdit","CheckButton","RichTextLabel"]:
		result.set_color("font_color",type,PAPER)
	for type: String in ["Button","OptionButton"]:
		result.set_stylebox("normal",type,_style(Color(0.07,0.11,0.17,0.86),Color(0.65,0.56,0.39,0.65),8))
		result.set_stylebox("hover",type,_style(Color("293547"),GOLD,8))
		result.set_stylebox("pressed",type,_style(Color("394250"),PAPER,8))
		result.set_stylebox("focus",type,_style(Color(0,0,0,0),Color("a0e0e0"),8,2))
		result.set_stylebox("disabled",type,_style(Color(0.06,0.09,0.13,0.65),Color("41434a"),8))
		result.set_color("font_disabled_color",type,Color("74777b"))
		result.set_color("font_hover_color",type,PAPER)
	result.set_stylebox("normal","LineEdit",_style(Color("1b2636"),GOLD,10))
	result.set_stylebox("focus","LineEdit",_style(Color("202e40"),Color("a0e0e0"),10,2))
	result.set_stylebox("panel","PopupMenu",_style(INK,GOLD,10))
	result.set_font_size("font_size","PopupMenu",21)
	return result

func _style(bg: Color, border: Color, padding: int = 12, width: int = 1) -> StyleBoxFlat:
	var s := StyleBoxFlat.new()
	s.bg_color = bg
	s.border_color = border
	s.set_border_width_all(width)
	s.set_content_margin_all(padding)
	s.corner_radius_top_left = 2
	s.corner_radius_top_right = 2
	s.corner_radius_bottom_left = 2
	s.corner_radius_bottom_right = 2
	return s

func _clear() -> void:
	for child in _layer.get_children():
		_layer.remove_child(child)
		child.queue_free()
	$Title.visible = false
	if is_instance_valid(world): world.set_playing(false)

func _label(text: String, pos: Vector2, dimensions: Vector2, font_size: int = 22, color: Color = PAPER, display: bool = false) -> Label:
	var l := Label.new()
	l.text = text
	l.position = pos
	l.size = dimensions
	l.add_theme_font_size_override("font_size",font_size)
	l.add_theme_color_override("font_color",color)
	if display: l.add_theme_font_override("font",DISPLAY_FONT)
	l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	l.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_layer.add_child(l)
	return l

func _button(text: String, pos: Vector2, dimensions: Vector2, callback: Callable, id: String = "") -> Button:
	var b := Button.new()
	b.text = text
	b.position = pos
	b.size = dimensions
	if not id.is_empty(): b.name = id
	b.pressed.connect(func(): _chime(); callback.call())
	_layer.add_child(b)
	return b

func _panel(pos: Vector2, dimensions: Vector2, opacity: float = 0.95) -> Panel:
	var p := Panel.new()
	p.position = pos
	p.size = dimensions
	p.add_theme_stylebox_override("panel",_style(Color(0.045,0.075,0.12,opacity),Color(0.6,0.5,0.34,0.5)))
	_layer.add_child(p)
	return p

func _shade(alpha: float = 0.75) -> void:
	var shade := ColorRect.new()
	shade.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	shade.color = Color(0.015,0.025,0.045,alpha)
	_layer.add_child(shade)

func _art_background() -> void:
	var art := TextureRect.new()
	art.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	art.texture = preload("res://assets/ui/atardecer.png")
	art.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	art.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_COVERED
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_layer.add_child(art)

func show_title() -> void:
	_clear()
	screen = "title"
	$Title.visible = true
	if is_instance_valid(_world_container): _world_container.hide()
	$Title/Continue.disabled = save_data.is_empty()
	$Title/Start.grab_focus.call_deferred()
	if not _status_message.is_empty():
		_label(_status_message,Vector2(74,590),Vector2(520,52),17,MUTED)

