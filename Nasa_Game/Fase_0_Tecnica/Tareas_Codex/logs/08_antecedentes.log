extends SceneTree
func _initialize() -> void:
	_run.call_deferred()
func _run() -> void:
	var main = load("res://scenes/main.tscn").instantiate()
	root.add_child(main)
	await process_frame
	var view := "title"
	for arg in OS.get_cmdline_user_args():
		if arg.begins_with("--view="): view=arg.trim_prefix("--view=")
	match view:
		"customizer": main.show_customizer()
		"room": main.enter_room()
