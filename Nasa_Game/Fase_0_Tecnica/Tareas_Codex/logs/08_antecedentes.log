extends Node3D
## Original layered pixel avatar. The feet anchor and 1.65 m height are invariant.
const SKIN = [Color("f2c7a1"), Color("d9a47d"), Color("b97b59"), Color("895336"), Color("593929")]
const HAIR = [Color("35282c"), Color("754432"), Color("cf9954"), Color("bd6a50"), Color("d5d2c6")]
const EYES = [Color("66402c"), Color("388c8c"), Color("5369a1"), Color("65904f")]
const CLOTHES = [Color("e7dbc0"), Color("517e86"), Color("b46750"), Color("737594"), Color("799266")]
var config: Dictionary = {"name":"Alex", "hair":0, "skin":1, "eyes":0, "hair_color":0, "outfit":0, "accessory":0}
var _sprite: Sprite3D
var _moving := false
var _facing := Vector2.DOWN
var _time := 0.0
var _last_frame := -1
var _texture: ImageTexture

func _ready() -> void:
	_sprite = Sprite3D.new()
	_sprite.name = "PixelLayers"
	_sprite.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	_sprite.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
	_sprite.alpha_cut = SpriteBase3D.ALPHA_CUT_DISCARD
	_sprite.pixel_size = 1.65 / 56.0
	_sprite.position.y = 0.825
	_sprite.shaded = false
	add_child(_sprite)
	_refresh(0)

func apply_config(value: Dictionary) -> void:
	for key in config:
		if value.has(key): config[key] = value[key]
	if is_instance_valid(_sprite): _refresh(0)

func set_moving(value: bool) -> void:
	_moving = value

func set_facing(direction: Vector2) -> void:
	if not direction.is_zero_approx(): _facing = direction

func get_portrait_texture() -> Texture2D:
	return ImageTexture.create_from_image(_paint(0, Vector2.DOWN))

func _process(delta: float) -> void:
	var camera := get_viewport().get_camera_3d()
	if camera != null: _sprite.position = camera.global_basis.y * 0.825
	_time += delta
	var frame := int(_time * 9.0) % 4 if _moving else 0
	var pose := frame + (8 if _facing.y < -0.35 else 0) + (16 if _facing.x < -0.3 else 0)
	if pose != _last_frame:
		_refresh(frame)
		_last_frame = pose

func _refresh(frame: int) -> void:
	var img := _paint(frame, _facing)
	if _texture == null: _texture = ImageTexture.create_from_image(img)
	else: _texture.update(img)
	_sprite.texture = _texture
	_sprite.flip_h = _facing.x < -0.3

func _paint(frame: int, facing: Vector2) -> Image:
	var img := Image.create(40, 56, false, Image.FORMAT_RGBA8)
	var skin: Color = SKIN[clampi(int(config.skin),0,4)]
	var hair: Color = HAIR[clampi(int(config.hair_color),0,4)]
	var iris: Color = EYES[clampi(int(config.eyes),0,3)]
	var shirt: Color = CLOTHES[clampi(int(config.outfit),0,4)]
	var outline := Color("242733")
	var back := facing.y < -0.35
	var step_a := 2 if frame == 1 else (0 if frame == 0 or frame == 2 else -1)
	var step_b := 2 if frame == 3 else (0 if frame == 0 or frame == 2 else -1)
	# Hair back and neck.
	_oval(img, 8, 3, 25, 26, outline)
	_oval(img, 9, 4, 23, 25, hair.darkened(0.15))
	if int(config.hair) == 1: _box(img,9,15,23,16,hair.darkened(0.17))
	_box(img,17,25,7,6,skin.darkened(0.17))
	# Trouser legs and independent soles.
	_box(img,13,39,14,8,outline)
	_box(img,13,43,6,10+step_a,Color("435249"))
	_box(img,22,43,6,10+step_b,Color("344139"))
	_box(img,14,44,2,7+step_a,Color("687361"))
	_box(img,23,44,2,7+step_b,Color("566451"))
	_box(img,11,51+step_a,9,3,outline)
	_box(img,21,51+step_b,9,3,outline)
	_box(img,11,52+step_a,8,2,Color("d9d4ba"))
	_box(img,21,52+step_b,8,2,Color("c3c1ae"))
	# Torso and sleeves; shoulder silhouette wider than waist.
	_box(img,11,29,19,12,outline)
	_box(img,13,28,15,14,shirt.darkened(0.25))
	_box(img,15,28,11,13,shirt)
	_box(img,16,30,2,10,shirt.lightened(0.13))
	_box(img,9,30,5,10,shirt.darkened(0.2))
	_box(img,27,30,5,10,shirt.darkened(0.3))
	_box(img,9,39,4,4,skin)
	_box(img,28,39,4,4,skin.darkened(0.12))
	_box(img,14,41,14,2,Color("7c624d"))
	if not back:
		_box(img,19,28,4,3,skin)
		_box(img,20,31,1,9,shirt.darkened(0.5))
		_box(img,24,32,3,4,shirt.darkened(0.2))
	# Face and ears.
	_oval(img,10,8,21,19,skin.darkened(0.18))
	_oval(img,11,8,18,17,skin)
	_box(img,9,16,3,5,skin)
	_box(img,29,16,3,5,skin.darkened(0.1))
	if not back:
		_box(img,14,16,4,4,outline); _box(img,24,16,4,4,outline)
		_box(img,15,17,2,2,iris); _box(img,25,17,2,2,iris)
		_box(img,14,16,1,1,Color("f8efd9")); _box(img,24,16,1,1,Color("f8efd9"))
		_box(img,14,14,4,1,hair); _box(img,24,14,4,1,hair)
		_box(img,19,21,4,1,skin.darkened(0.4)); _box(img,20,22,2,1,skin.lightened(0.2))
		_box(img,12,20,3,2,skin.lerp(Color("c97d73"),0.32))
	# Three genuinely different hair silhouettes.
	var style := int(config.hair)
	_oval(img,9,4,23,10,hair)
	if style == 0:
		_box(img,12,3,8,5,hair); _box(img,18,2,7,5,hair)
		_box(img,10,10,5,7,hair); _box(img,15,10,6,3,hair)
		_box(img,26,10,5,5,hair.darkened(0.1))
	elif style == 1:
		_box(img,9,10,4,17,hair); _box(img,28,10,4,17,hair.darkened(0.15))
		_box(img,12,10,15,3,hair); _box(img,13,12,6,2,hair)
	else:
		for pos in [Vector2i(9,5),Vector2i(14,2),Vector2i(21,2),Vector2i(27,5),Vector2i(8,10),Vector2i(27,11)]:
			_oval(img,pos.x,pos.y,7,7,hair.darkened(0.1))
			_box(img,pos.x+2,pos.y+1,3,2,hair.lightened(0.12))
	_box(img,14,6,9,2,hair.lightened(0.2))
	if back: _oval(img,10,7,21,19,hair.darkened(0.06))
	if int(config.accessory) == 1 and not back:
		for x in [12,23]:
			_box(img,x,15,7,1,outline); _box(img,x,20,7,1,outline)
			_box(img,x,16,1,4,outline); _box(img,x+6,16,1,4,outline)
		_box(img,19,17,4,1,outline)
	elif int(config.accessory) == 2:
		_box(img,28,10,1,5,Color("f3ce74")); _box(img,26,12,5,1,Color("f3ce74"))
	return img

func _box(img: Image, x: int, y: int, w: int, h: int, color: Color) -> void:
	img.fill_rect(Rect2i(x,y,w,h).intersection(Rect2i(0,0,40,56)),color)

func _oval(img: Image, x: int, y: int, w: int, h: int, color: Color) -> void:
	for py in range(y,y+h):
		for px in range(x,x+w):
			var dx := (float(px-x)+0.5)/w*2.0-1.0
			var dy := (float(py-y)+0.5)/h*2.0-1.0
			if dx*dx+dy*dy <= 1.0 and px>=0 and px<40 and py>=0 and py<56: img.set_pixel(px,py,color)
