func _apply_settings() -> void:
	var mat := $Title/Atmosphere.material as ShaderMaterial
	mat.set_shader_parameter("motion",0.0 if settings.reduced_motion else 1.0)
	if DisplayServer.get_name() != "headless":
		DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_FULLSCREEN if settings.fullscreen else DisplayServer.WINDOW_MODE_WINDOWED)

func _save_settings() -> void:
	var cfg := ConfigFile.new()
	for key in settings: cfg.set_value("display",key,settings[key])
	cfg.save("user://preferences.cfg")

func _load_save() -> void:
	var preferences := ConfigFile.new()
	if preferences.load("user://preferences.cfg") == OK:
		for key in settings: settings[key] = bool(preferences.get_value("display",key,settings[key]))
	if not FileAccess.file_exists(_save_path): return
	var file := FileAccess.open(_save_path,FileAccess.READ)
	if file == null: return
	var data = JSON.parse_string(file.get_as_text())
	if not data is Dictionary or data.get("version",0) != 1 or not data.get("avatar") is Dictionary:
		_status_message = "No se pudo leer la partida anterior. Puedes comenzar un viaje."
		return
	var clean: Dictionary = DEFAULT_AVATAR.duplicate()
	for key: String in ["hair","skin","eyes","hair_color","outfit","accessory"]:
		var limit: int = {"hair":2,"skin":4,"eyes":3,"hair_color":4,"outfit":4,"accessory":2}[key]
		var value = data.avatar.get(key,clean[key])
		if value is float or value is int: clean[key] = clampi(int(value),0,limit)
	clean.name = str(data.avatar.get("name","Alex")).left(22)
	save_data = {"version":1,"avatar":clean,"book_open":bool(data.get("book_open",false))}
	avatar_config = clean.duplicate()

func _save() -> void:
	save_data = {"version":1,"avatar":avatar_config.duplicate(),"book_open":book_open}
	var file := FileAccess.open(_save_path+".tmp",FileAccess.WRITE)
	if file == null:
		_status_message = "La partida no pudo guardarse en este equipo."
		return
	file.store_string(JSON.stringify(save_data,"\t"))
	file.close()
	if FileAccess.file_exists(_save_path):
		DirAccess.copy_absolute(_save_path,_save_path+".bak")
	var error := DirAccess.rename_absolute(_save_path+".tmp",_save_path)
	if error != OK: _status_message = "La partida no pudo guardarse en este equipo."

func _chime(frequency: float = 440.0) -> void:
	if not is_instance_valid(_sound) or not settings.sound: return
	var wave := AudioStreamWAV.new()
	wave.format = AudioStreamWAV.FORMAT_16_BITS
	wave.mix_rate = 22050
	var data := PackedByteArray()
	data.resize(4410*2)
	for i in range(4410):
		var envelope := sin(PI*float(i)/4410.0)*exp(-float(i)/1200.0)
		var value := int(sin(TAU*frequency*i/22050.0)*envelope*8500)
		data.encode_s16(i*2,value)
	wave.data = data
	_sound.stream = wave
	_sound.play()

func _unhandled_input(event: InputEvent) -> void:
	if screen == "mission": return
	if event is InputEventKey and event.pressed and not event.echo:
		if screen == "intro" and event.physical_keycode in [KEY_SPACE,KEY_ESCAPE,KEY_ENTER]:
			enter_room()
			get_viewport().set_input_as_handled()
		elif event.physical_keycode == KEY_ESCAPE:
			match screen:
				"room": show_pause()
				"pause", "book", "complete": enter_room()
				"customizer", "credits": show_title()
				"options": _return_from_options()
			get_viewport().set_input_as_handled()
