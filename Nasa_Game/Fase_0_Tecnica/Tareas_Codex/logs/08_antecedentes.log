class_name ConsolaMision
extends CanvasLayer
## Consola de dise�o de misi�n (reto Space Mission Design Game).
## Cada columna indica el rol que la tomar�a en modo equipo (hasta cuatro personas).

signal cerrada

const FONDO := Color("0F1228")
const CIAN := Color("00E5FF")
const ROJO := Color("FF6B5A")
const VERDE := Color("7CF29A")
const TENUE := Color("8A93B8")
const TEXTO := Color("E8ECFF")
const RUTA_FUENTE := "res://arte/fuentes/DotGothic16-Regular.ttf"

var _diseno := DisenoMision.new()
var _resultado := {}
var _sel := {}
var _checks: Array[CheckBox] = []
var _recursos := {}
var _objetivo := Label.new()
var _dv := Label.new()
var _vista_diseno := HBoxContainer.new()
var _vista_sim := HBoxContainer.new()
var _sim := SimulacionOrbital.new()
var _registro := RichTextLabel.new()


func _ready() -> void:
	layer = 10
	var raiz := PanelContainer.new()
	raiz.set_anchors_preset(Control.PRESET_FULL_RECT)
	raiz.theme = _crear_tema()
	add_child(raiz)
	var margen := MarginContainer.new()
	for lado: String in ["left", "right", "top", "bottom"]:
		margen.add_theme_constant_override("margin_" + lado, 5)
	raiz.add_child(margen)
	var pila := VBoxContainer.new()
	margen.add_child(pila)
	var cabecera := HBoxContainer.new()
	cabecera.add_child(_etiqueta("CONSOLA DE MISI�N", CIAN))
	var hueco := Control.new()
	hueco.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	cabecera.add_child(hueco)
	cabecera.add_child(_etiqueta("[Esc] volver", TENUE))
	pila.add_child(cabecera)
	_construir_diseno(pila)
	_construir_simulacion(pila)
	_al_cambiar("escenario")
	(_sel["escenario"] as OptionButton).grab_focus.call_deferred()


func _construir_diseno(pila: VBoxContainer) -> void:
	_vista_diseno.size_flags_vertical = Control.SIZE_EXPAND_FILL
	_vista_diseno.add_theme_constant_override("separation", 8)
	pila.add_child(_vista_diseno)
	var plan := _columna("PLANIFICACI�N � rol 1")
	_selector(plan, "escenario", "Escenario", Catalogo.ESCENARIOS)
	_objetivo.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	_objetivo.add_theme_color_override("font_color", TENUE)
	plan.add_child(_objetivo)
	_selector(plan, "orbita", "�rbita", [])
	_selector(plan, "lanzador", "Lanzador", Catalogo.LANZADORES)
	var nave := _columna("NAVE Y CIENCIA � roles 2 y 3")
	_selector(nave, "bus", "Bus", Catalogo.BUSES)
	_selector(nave, "energia", "Energ�a", Catalogo.ENERGIA)
	_selector(nave, "comunicaciones", "Comunicaciones", Catalogo.COMUNICACIONES)
	nave.add_child(_etiqueta("Instrumentos", TENUE))
	for instrumento: Componente in Catalogo.INSTRUMENTOS:
		var casilla := CheckBox.new()
		casilla.text = instrumento.nombre
		casilla.clip_text = true
		casilla.tooltip_text = instrumento.leccion
		casilla.toggled.connect(func(_activa: bool) -> void: _recalcular())
		nave.add_child(casilla)
		_checks.append(casilla)
	var recursos := _columna("RECURSOS � rol 4")
	for par: Array in [["masa", "MASA"], ["energia", "ENERG�A"], ["datos", "DATOS"], ["presupuesto", "COSTO"], ["vida", "VIDA"]]:
		_recurso(recursos, par[0], par[1])
	_dv.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	_dv.add_theme_color_override("font_color", TENUE)
	recursos.add_child(_dv)
	var boton := Button.new()
	boton.text = "SIMULAR MISI�N"
	boton.pressed.connect(_simular)
	recursos.add_child(boton)


func _construir_simulacion(pila: VBoxContainer) -> void:
	_vista_sim.size_flags_vertical = Control.SIZE_EXPAND_FILL
	_vista_sim.visible = false
	pila.add_child(_vista_sim)
	_sim.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_sim.size_flags_stretch_ratio = 1.2
	_vista_sim.add_child(_sim)
	_registro.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_registro.bbcode_enabled = true
	_registro.scroll_following = true
	_vista_sim.add_child(_registro)
	_sim.linea.connect(func(texto: String) -> void: _registro.append_text(texto + "\n"))
	_sim.terminada.connect(_al_terminar)


func _columna(titulo: String) -> VBoxContainer:
	var columna := VBoxContainer.new()
	columna.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	columna.add_theme_constant_override("separation", 1)
	columna.add_child(_etiqueta(titulo, CIAN))
	_vista_diseno.add_child(columna)
	return columna


func _selector(padre: Control, clave: String, titulo: String, elementos: Array) -> void:
	padre.add_child(_etiqueta(titulo, TENUE))
	var opciones := OptionButton.new()
	opciones.clip_text = true
	for elemento: Resource in elementos:
		opciones.add_item(elemento.get("nombre"))
		var leccion = elemento.get("leccion")
		if leccion:
			opciones.set_item_tooltip(opciones.item_count - 1, leccion)
	opciones.item_selected.connect(func(_indice: int) -> void: _al_cambiar(clave))
	padre.add_child(opciones)
	_sel[clave] = opciones


func _recurso(padre: Control, clave: String, titulo: String) -> void:
	var etiqueta := _etiqueta(titulo, TEXTO)
	etiqueta.clip_text = true
	var barra := ProgressBar.new()
	barra.show_percentage = false
	barra.custom_minimum_size = Vector2(0.0, 3.0)
	padre.add_child(etiqueta)
	padre.add_child(barra)
	_recursos[clave] = [barra, etiqueta, titulo]


func _etiqueta(texto: String, color: Color) -> Label:
	var etiqueta := Label.new()
	etiqueta.text = texto
	etiqueta.add_theme_color_override("font_color", color)
	return etiqueta


func _al_cambiar(clave: String) -> void:
	if clave == "escenario":
		var escenario: Escenario = Catalogo.ESCENARIOS[_indice("escenario")]
		_objetivo.text = escenario.objetivo
		var orbitas: OptionButton = _sel["orbita"]
		orbitas.clear()
		for orbita: Dictionary in escenario.orbitas:
			orbitas.add_item(orbita["nombre"])
			orbitas.set_item_tooltip(orbitas.item_count - 1, orbita.get("nota", ""))
		orbitas.select(0)
	_recalcular()


func _indice(clave: String) -> int:
	return (_sel[clave] as OptionButton).selected


func _leer_seleccion() -> void:
	_diseno.escenario = Catalogo.ESCENARIOS[_indice("escenario")]
	_diseno.orbita = maxi(_indice("orbita"), 0)
	_diseno.lanzador = Catalogo.LANZADORES[_indice("lanzador")]
	_diseno.bus = Catalogo.BUSES[_indice("bus")]
	_diseno.energia = Catalogo.ENERGIA[_indice("energia")]
	_diseno.comunicaciones = Catalogo.COMUNICACIONES[_indice("comunicaciones")]
	_diseno.instrumentos.clear()
	for i in _checks.size():
		if _checks[i].button_pressed:
			_diseno.instrumentos.append(Catalogo.INSTRUMENTOS[i])


func _recalcular() -> void:
	if _sel.size() < 6:
		return
	_leer_seleccion()
	_resultado = EvaluadorMision.evaluar(_diseno, Catalogo.CUERPOS)
	var r := _resultado
	_barra("masa", r["masa_total"], r["capacidad"], r["masa_total"] <= r["capacidad"], "%.0f / %.0f kg" % [r["masa_total"], r["capacidad"]])
	_barra("energia", r["consumo_w"], r["generacion_w"], r["consumo_w"] <= r["generacion_w"], "%.0f / %.0f W" % [r["consumo_w"], r["generacion_w"]])
	_barra("datos", r["datos_gb"], r["bajada_gb"], r["datos_gb"] <= r["bajada_gb"], "%.1f / %.1f GB/d�a" % [r["datos_gb"], r["bajada_gb"]])
	_barra("presupuesto", r["costo"], r["presupuesto"], r["costo"] <= r["presupuesto"], "%.0f / %.0f M USD" % [r["costo"], r["presupuesto"]])
	_barra("vida", r["vida"], r["vida_minima"], r["vida"] >= r["vida_minima"], "%.1f / %.1f a�os" % [r["vida"], r["vida_minima"]])
	_dv.text = "?v inserci�n %.2f km/s � propelente %.0f kg" % [r["dv_insercion"], r["propelente"]]


func _barra(clave: String, valor: float, maximo: float, ok: bool, detalle: String) -> void:
	var barra: ProgressBar = _recursos[clave][0]
	var etiqueta: Label = _recursos[clave][1]
	barra.max_value = maxf(maximo, 0.001)
	barra.value = minf(valor, barra.max_value)
	var relleno := StyleBoxFlat.new()
	relleno.bg_color = VERDE if ok else ROJO
	barra.add_theme_stylebox_override("fill", relleno)
	etiqueta.text = "%s  %s" % [_recursos[clave][2], detalle]
	etiqueta.add_theme_color_override("font_color", TEXTO if ok else ROJO)


func _simular() -> void:
	_recalcular()
	_vista_diseno.visible = false
	_vista_sim.visible = true
	_registro.clear()
	_registro.append_text("[color=#00E5FF]%s � %s[/color]\n" % [_diseno.escenario.nombre, _resultado["orbita"]])
	_sim.iniciar(_resultado)


func _al_terminar() -> void:
	var exito: bool = _resultado["exito"]
	var color := (VERDE if exito else ROJO).to_html(false)
	_registro.append_text("\n[color=#%s]%s � PUNTAJE %d[/color]\n" % [color, "MISI�N CUMPLIDA" if exito else "OBJETIVO NO CUMPLIDO", _resultado["puntaje"]])
	for leccion: String in _resultado["lecciones"]:
		_registro.append_text(" %s\n" % leccion)
	_registro.append_text("[color=#8A93B8][Esc] volver al dise�o[/color]")


func _unhandled_input(evento: InputEvent) -> void:
	if not evento.is_action_pressed("cancelar"):
		return
	get_viewport().set_input_as_handled()
	if _vista_sim.visible:
		_sim.detener()
		_vista_sim.visible = false
		_vista_diseno.visible = true
	else:
		cerrada.emit()
		queue_free()


## Dise�o de ejemplo para la demo y el video: misi�n lunar que cumple su objetivo.
func demo() -> void:
	(_sel["escenario"] as OptionButton).select(1)
	_al_cambiar("escenario")
	for par: Array in [["orbita", 1], ["lanzador", 1], ["bus", 1], ["energia", 1], ["comunicaciones", 1]]:
		(_sel[par[0]] as OptionButton).select(par[1])
	_checks[0].set_pressed_no_signal(true)
	_checks[2].set_pressed_no_signal(true)
	_simular()


func _crear_tema() -> Theme:
	var tema := Theme.new()
	tema.default_font_size = 7
	if ResourceLoader.exists(RUTA_FUENTE):
		tema.default_font = load(RUTA_FUENTE)
	var panel := StyleBoxFlat.new()
	panel.bg_color = Color(FONDO, 0.97)
	tema.set_stylebox("panel", "PanelContainer", panel)
	tema.set_color("font_color", "Label", TEXTO)
	var normal := _caja(Color("1A2046"), Color(CIAN, 0.35))
	var activo := _caja(Color("26306A"), CIAN)
	var foco := _caja(Color(0, 0, 0, 0), CIAN)
	for tipo: String in ["Button", "OptionButton"]:
		tema.set_stylebox("normal", tipo, normal)
		tema.set_stylebox("hover", tipo, activo)
		tema.set_stylebox("pressed", tipo, activo)
		tema.set_stylebox("focus", tipo, foco)
		tema.set_color("font_color", tipo, TEXTO)
	return tema


func _caja(fondo: Color, borde: Color) -> StyleBoxFlat:
	var caja := StyleBoxFlat.new()
	caja.bg_color = fondo
	caja.border_color = borde
	caja.set_border_width_all(1)
	caja.set_content_margin_all(2)
	return caja
