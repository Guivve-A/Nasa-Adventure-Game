extends CharacterBody3D
## Walks relative to the fixed room camera. Visual anchor is at floor level.

const AvatarScript = preload("res://scripts/avatar.gd")
const WALK_SPEED := 2.05
const RUN_SPEED := 3.45
const GRAVITY := 15.0

var playing := false
var _avatar: Node3D
var _right := Vector3.RIGHT
var _down := Vector3.BACK


func _ready() -> void:
	_avatar = AvatarScript.new()
	_avatar.name = "Avatar"
	add_child(_avatar)


func set_camera_basis(camera_basis: Basis) -> void:
	_right = Vector3(camera_basis.x.x, 0.0, camera_basis.x.z).normalized()
	_down = Vector3(camera_basis.z.x, 0.0, camera_basis.z.z).normalized()


func set_playing(value: bool) -> void:
	playing = value
	if not playing:
		velocity = Vector3.ZERO
		_avatar.set_moving(false)


func apply_avatar(config: Dictionary) -> void:
	_avatar.apply_config(config)


func reset_to(spawn_point: Vector3) -> void:
	global_position = spawn_point
	velocity = Vector3.ZERO
	_avatar.set_facing(Vector2(0.8, -0.5))
	_avatar.set_moving(false)


func _physics_process(delta: float) -> void:
	var axis := Vector2.ZERO
	if playing:
		axis = Input.get_vector(&"move_left", &"move_right", &"move_up", &"move_down")
	var speed := RUN_SPEED if playing and Input.is_action_pressed(&"run") else WALK_SPEED
	var direction := _right * axis.x + _down * axis.y
	velocity.x = direction.x * speed
	velocity.z = direction.z * speed
	velocity.y -= GRAVITY * delta
	move_and_slide()
	if not axis.is_zero_approx():
		_avatar.set_facing(axis)
	var planar_velocity := Vector2(get_real_velocity().x, get_real_velocity().z)
	_avatar.set_moving(playing and not axis.is_zero_approx() and planar_velocity.length_squared() > 0.025)
