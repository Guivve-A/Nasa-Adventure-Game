	theme.set_type_variation("PrimaryButton","Button")
	theme.set_stylebox("normal","PrimaryButton",source._style(Color("ccb17a"),Color("d6b477"),10))
	theme.set_stylebox("hover","PrimaryButton",source._style(Color("eee0bb"),Color("eee8d9"),10))
	for state in ["font_color","font_hover_color","font_focus_color","font_pressed_color"]:
		theme.set_color(state,"PrimaryButton",Color("101926"))
	var err := ResourceSaver.save(theme,"res://assets/ui/gravedad_theme.tres")
