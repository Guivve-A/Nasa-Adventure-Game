func _apply_settings() -> void:
	var mat := $Title/Atmosphere.material as ShaderMaterial
	mat.set_shader_parameter("motion",0.0 if settings.reduced_motion else 1.0)
	if DisplayServer.get_name() != "headless":
		DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_FULLSCREEN if settings.fullscreen else DisplayServer.WINDOW_MODE_WINDOWED)

func _save_settings() -> void:
	var cfg := ConfigFile.new()
	for key in settings: cfg.set_value("display",key,settings[key])
	cfg.save("user://preferences.cfg")

func _load_save() -> void:
	var preferences := ConfigFile.new()
	if preferences.load("user://preferences.cfg") == OK:
		for key in settings: settings[key] = bool(preferences.get_value("display",key,settings[key]))
	if not FileAccess.file_exists(_save_path): return
	var file := FileAccess.open(_save_path,FileAccess.READ)
	if file == null: return
	var data = JSON.parse_string(file.get_as_text())
	if not data is Dictionary or data.get("version",0) != 1 or not data.get("avatar") is Dictionary:
		_status_message = "No se pudo leer la partida anterior. Puedes comenzar un viaje."
		return
	var clean: Dictionary = DEFAULT_AVATAR.duplicate()
	for key: String in ["hair","skin","eyes","hair_color","outfit","accessory"]:
		var limit: int = {"hair":2,"skin":4,"eyes":3,"hair_color":4,"outfit":4,"accessory":2}[key]
		var value = data.avatar.get(key,clean[key])
		if value is float or value is int: clean[key] = clampi(int(value),0,limit)
	clean.name = str(data.avatar.get("name","Alex")).left(22)
	save_data = {"version":1,"avatar":clean,"book_open":bool(data.get("book_open",false))}
	avatar_config = clean.duplicate()

func _save() -> void:
	save_data = {"version":1,"avatar":avatar_config.duplicate(),"book_open":book_open}
	var file := FileAccess.open(_save_path+".tmp",FileAccess.WRITE)
	if file == null:
		_status_message = "La partida no pudo guardarse en este equipo."
		return
	file.store_string(JSON.stringify(save_data,"\t"))
	file.close()
	if FileAccess.file_exists(_save_path):
		DirAccess.copy_absolute(_save_path,_save_path+".bak")
	var error := DirAccess.rename_absolute(_save_path+".tmp",_save_path)
	if error != OK: _status_message = "La partida no pudo guardarse en este equipo."

func _chime(frequency: float = 440.0) -> void:
	if not is_instance_valid(_sound) or not settings.sound: return
	var wave := AudioStreamWAV.new()
	wave.format = AudioStreamWAV.FORMAT_16_BITS
	wave.mix_rate = 22050
	var data := PackedByteArray()
	data.resize(4410*2)
	for i in range(4410):
		var envelope := sin(PI*float(i)/4410.0)*exp(-float(i)/1200.0)
		var value := int(sin(TAU*frequency*i/22050.0)*envelope*8500)
		data.encode_s16(i*2,value)
	wave.data = data
	_sound.stream = wave
	_sound.play()

func _unhandled_input(event: InputEvent) -> void:
	if screen == "mission": return
	if event is InputEventKey and event.pressed and not event.echo:
		if screen == "intro" and event.physical_keycode in [KEY_SPACE,KEY_ESCAPE,KEY_ENTER]:
			enter_room()
			get_viewport().set_input_as_handled()
		elif event.physical_keycode == KEY_ESCAPE:
			match screen:
				"room": show_pause()
				"pause", "book", "complete": enter_room()
				"customizer", "credits": show_title()
				"options": _return_from_options()
			get_viewport().set_input_as_handled()
extends SceneTree
## End-to-end test: real GUI/input dispatch, physics, save reload and mission UI.
## Run with -- --test-profile; never touches the player's save.
var app
var checks := 0
var failures: Array[String] = []

func _initialize() -> void:
	_run.call_deferred()

func check(value: bool, description: String) -> void:
	checks += 1
	if not value: failures.append(description); push_error("FAIL: "+description)
	else: print("PASS: ",description)

func frames(count: int = 2) -> void:
	for i in range(count): await physics_frame

func key(code: int, ctrl: bool = false, unicode_value: int = 0) -> void:
	var event := InputEventKey.new()
	event.keycode = code
	event.physical_keycode = code
	event.unicode = unicode_value
	event.ctrl_pressed = ctrl
	event.pressed = true
	Input.parse_input_event(event)
	await process_frame
	event = event.duplicate()
	event.pressed = false
	Input.parse_input_event(event)
	await frames()

func click(control: Control) -> void:
	var p := control.get_global_rect().get_center()
	var motion := InputEventMouseMotion.new()
	motion.position=p
	motion.global_position=p
	root.push_input(motion,true)
	await process_frame
	var event := InputEventMouseButton.new()
	event.button_index = MOUSE_BUTTON_LEFT
	event.position=p
	event.global_position=p
	event.pressed=true
	root.push_input(event,true)
	await process_frame
	event = event.duplicate()
	event.pressed=false
	root.push_input(event,true)
	await frames(3)

func shot(label: String) -> void:
	if DisplayServer.get_name() == "headless": return
	await RenderingServer.frame_post_draw
	root.get_texture().get_image().save_png("res://evidence/"+label+".png")

func walk_to(goal: Vector3) -> bool:
	var actions := ["move_left","move_right","move_up","move_down"]
	for i in range(380):
		if app.screen != "room": break
		var difference: Vector3 = goal-app.world.player.position
		difference.y=0.0
		if difference.length()<0.16:
			for action in actions: Input.action_release(action)
			await frames(3)
			return true
		var right: Vector3 = app.world.player._right
		var down: Vector3 = app.world.player._down
		var horizontal := difference.dot(right)
		var vertical := difference.dot(down)
		for action in actions: Input.action_release(action)
		if absf(horizontal)>0.06: Input.action_press("move_right" if horizontal>0 else "move_left")
		if absf(vertical)>0.06: Input.action_press("move_down" if vertical>0 else "move_up")
		await physics_frame
	for action in actions: Input.action_release(action)
	return false

func _run() -> void:
	if not OS.get_cmdline_user_args().has("--test-profile"):
		push_error("Run with -- --test-profile to isolate saves")
		quit(2)
		return
	app = load("res://scenes/main.tscn").instantiate()
	root.gui_embed_subwindows = true
	root.notify_mouse_entered()
	create_timer(55.0).timeout.connect(func(): push_error("test timeout"); quit(2))
	root.add_child(app)
	await frames(4)
	check(app.screen=="title","title opens")
	await shot("title")
	app.avatar_config = app.DEFAULT_AVATAR.duplicate()
	await click(app.get_node("Title/Start"))
	check(app.screen=="customizer","mouse Start opens avatar editor")
	if app.screen != "customizer":
		print("DEBUG viewport=",root.get_visible_rect()," hovered=",root.gui_get_hovered_control()," button=",app.get_node("Title/Start").get_global_rect())
		quit(1)
		return
	var name: LineEdit = app._name_edit
	await click(name)
	await key(KEY_A,true)
	for character in "Sol �vila": await key(0,false,character.unicode_at(0))
	check(name.text=="Sol �vila","name accepts Spanish text through keyboard")
	var before: PackedByteArray = app._portrait.texture.get_image().get_data()
	var hair: OptionButton = app._layer.get_node("Choice_hair")
	hair.grab_focus()
	await key(KEY_SPACE)
	await key(KEY_DOWN)
	await key(KEY_ENTER)
	check(int(app.avatar_config.hair)!=0,"keyboard changes hair option")
	check(before!=app._portrait.texture.get_image().get_data(),"hair choice changes rendered avatar")
	for pair in [["skin",4],["eyes",2],["hair_color",3],["outfit",1],["accessory",1]]:
		var select: OptionButton = app._layer.get_node("Choice_"+str(pair[0]))
		var previous: PackedByteArray = app._portrait.texture.get_image().get_data()
		select.select(pair[1])
		select.item_selected.emit(pair[1])
		check(previous!=app._portrait.texture.get_image().get_data(),str(pair[0])+" changes visible pixels")
	await shot("customizer")
	await click(app._layer.get_node("ConfirmAvatar"))
	check(app.screen=="intro","confirm starts opening sequence")
	check(app.avatar_config.name=="Sol �vila","chosen identity reaches intro")
	await frames(40)
	await shot("intro")
	await key(KEY_SPACE)
	check(app.screen=="room","Space skips intro into playable room")
	await frames(20)
	check(app.world.player.is_on_floor(),"player grounded on 3D floor")
	var initial: Vector3 = app.world.get_player_position()
	Input.action_press("move_right")
	await frames(35)
	Input.action_release("move_right")
	check(initial.distance_to(app.world.get_player_position())>0.5,"movement input displaces player")
	await key(KEY_ESCAPE)
	check(app.screen=="pause","Escape pauses room")
	var paused: Vector3 = app.world.get_player_position()
	Input.action_press("move_left")
	await frames(15)
	Input.action_release("move_left")
	check(paused.distance_to(app.world.get_player_position())<0.02,"pause blocks movement")
	await click(app._layer.get_node("Resume"))
	check(app.screen=="room","Continue resumes room")
	check(await walk_to(Vector3(1.65,0,0.0)),"walk through clear floor to desk approach")
	check(await walk_to(Vector3(1.65,0,-0.65)),"walk within book interaction range")
	check(app._hint.text.contains("libro"),"interaction prompt appears near book")
	await shot("room")
	await key(KEY_E)
	check(app.screen=="book","E opens book through proximity check")
	check(app.book_open and app.world.hologram.visible,"book reveals separate hologram")
	await shot("book")
	await click(app._layer.get_node("Mission"))
	check(app.screen=="mission","book connects to existing mission designer")
	await frames(12)
	var controls_fit := true
	for instrument: CheckBox in app._mission._checks:
		controls_fit = controls_fit and Rect2(0,0,512,267).encloses(instrument.get_global_rect())
	check(controls_fit,"all mission instruments fit inside the viewport")
	await shot("mission")
	await click(app._layer.get_node("BackMission"))
	check(app.screen=="room" and not root.get_node("Juego").consola_activa,"mission returns to room")
	await frames(3)
	check(app._hint.text.contains("libro"),"book prompt restores after returning from a panel")
	check(await walk_to(Vector3(-1.4,0,0.6)),"return path clear")
	check(await walk_to(Vector3(-2.6,0,1.3)),"door is reachable")
	await key(KEY_E)
	check(app.screen=="complete","door completes prologue after opening book")
	await shot("complete")
	app.show_title()
	await frames()
	check(not app.get_node("Title/Continue").disabled,"Continue enabled after progress")
	app.queue_free()
	await frames(3)
	app = load("res://scenes/main.tscn").instantiate()
	root.add_child(app)
	await frames(4)
	await click(app.get_node("Title/Continue"))
	check(app.avatar_config.name=="Sol �vila" and int(app.avatar_config.skin)==4,"identity survives fresh scene load")
	check(app.book_open and app.world.hologram.visible,"book progress survives reload")
	# Closed furniture collision must stop motion rather than let the avatar pass.
	app.world.player.reset_to(Vector3(1.65,0.05,-0.9))
	await frames(5)
	var reached := await walk_to(Vector3(1.65,0,-2.2))
	check(not reached and app.world.player.position.z > -1.55,"desk footprint blocks player")
	# The unskipped intro also hands over control automatically.
	app.start_intro()
	app._intro_time=10.49
	await frames(5)
	check(app.screen=="room","intro completes automatically")
	var report := {"checks":checks,"failures":failures,"rendering":DisplayServer.get_name(),"engine":Engine.get_version_info().string}
	var file := FileAccess.open("res://evidence/prologue-results.json",FileAccess.WRITE)
	file.store_string(JSON.stringify(report,"\t")); file.close()
	print("PROLOGUE_RESULTS ",JSON.stringify(report))
	app.queue_free()
	await frames(3)
	quit(0 if failures.is_empty() else 1)
shader_type canvas_item;
uniform float motion = 1.0;
float hash(vec2 p) { return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453); }
void fragment() {
 float dark = 0.025;
 dark += (1.0-smoothstep(0.18,0.33,UV.y)) * mix(0.69,0.08,smoothstep(0.25,0.72,UV.x));
 dark += smoothstep(0.68,1.0,UV.y)*0.76;
 vec2 p = UV*vec2(100.0,58.0)+vec2(TIME*0.18,-TIME*0.24)*motion;
 float mote=(1.0-smoothstep(0.015,0.06,length(fract(p)-vec2(0.5))))*step(0.987,hash(floor(p)))*0.22;
 COLOR=vec4(vec3(0.025,0.036,0.07)+vec3(0.85,0.55,0.20)*mote,clamp(dark,0.0,0.96));
}
shader_type canvas_item;
uniform float progress = 0.0;
float hash(vec2 p) { return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453); }
void fragment() {
 vec2 uv=UV; vec2 q=(uv-vec2(0.65,0.49))*vec2(1.7778,1.0);
 float radius=0.29+pow(progress,4.0)*2.2;
 float d=length(q); vec3 col=mix(vec3(0.008,0.014,0.035),vec3(0.035,0.07,0.12),uv.y);
 vec2 star=floor(uv*vec2(420.0,236.0));
 float h=hash(star); col+=vec3(0.7,0.8,1.0)*step(0.997,h)*pow(h,60.0)*0.8;
 float glow=exp(-abs(d-radius)*65.0)*0.38;
 col+=vec3(0.15,0.45,0.8)*glow;
 if(d<radius) {
  vec2 xy=q/radius; float z=sqrt(max(0.0,1.0-dot(xy,xy))); vec3 n=vec3(xy,z);
  float longitude=atan(n.x,n.z)+0.5+progress*0.4; float latitude=asin(n.y);
  float continent=sin(longitude*5.0+sin(latitude*7.0))*sin(latitude*6.0+cos(longitude*4.0))+0.28*sin(longitude*17.0+latitude*11.0);
  vec3 sea=vec3(0.035,0.22,0.38); vec3 land=vec3(0.19,0.34,0.26);
  vec3 ground=mix(sea,land,smoothstep(0.10,0.27,continent));
  float cloud=sin(longitude*23.0+sin(latitude*17.0))*sin(latitude*28.0+longitude*3.0);
  ground=mix(ground,vec3(0.78,0.85,0.83),smoothstep(0.48,0.82,cloud)*0.8);
  float light=max(0.06,dot(n,normalize(vec3(-0.9,-0.45,0.85))));
  col=ground*light+pow(1.0-z,3.0)*vec3(0.08,0.24,0.38);
 }
 vec2 rock=vec2(-0.15+progress*3.1,0.17+progress*0.6); vec2 r=(uv-rock)*vec2(1.7778,1.0);
 if(progress<0.45) {
  float tail=exp(-length(r+vec2(0.05,0.015))*48.0)*0.5;
  col+=vec3(0.42,0.65,0.72)*tail;
  if(length(r)<0.012)col=vec3(0.43,0.37,0.31)*(0.5+r.y*25.0);
 }
 col*=1.0-smoothstep(0.89,1.0,progress);
 COLOR=vec4(col,1.0);
}

