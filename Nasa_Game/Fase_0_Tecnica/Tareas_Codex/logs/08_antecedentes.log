func _cerca(nombre: String, valor: float, esperado: float, tolerancia: float) -> void:
	var ok := absf(valor - esperado) <= tolerancia
	if not ok:
		_fallos += 1
	print("%s %s: %.3f (esperado %.3f � %.3f)" % ["OK   " if ok else "FALLA", nombre, valor, esperado, tolerancia])


func _mision(nombre: String, sel: Array, instrumentos: Array, falla_esperada: String) -> void:
	var d := DisenoMision.new()
	d.escenario = Catalogo.ESCENARIOS[sel[0]]
	d.orbita = sel[1]
	d.lanzador = Catalogo.LANZADORES[sel[2]]
	d.bus = Catalogo.BUSES[sel[3]]
	d.energia = Catalogo.ENERGIA[sel[4]]
	d.comunicaciones = Catalogo.COMUNICACIONES[sel[5]]
	for i: int in instrumentos:
		d.instrumentos.append(Catalogo.INSTRUMENTOS[i])
	var r := EvaluadorMision.evaluar(d, Catalogo.CUERPOS)
	var ok: bool = r["falla"] == falla_esperada
	if not ok:
		_fallos += 1
	print("%s %s  falla �%s� � masa %.0f/%.0f kg � %.0f/%.0f W � datos %.1f/%.1f � costo %.0f/%.0f � ciencia %.0f � puntaje %d" % [
		"OK   " if ok else "FALLA", nombre, r["falla"], r["masa_total"], r["capacidad"], r["consumo_w"], r["generacion_w"],
		r["datos_gb"], r["bajada_gb"], r["costo"], r["presupuesto"], r["ciencia"], r["puntaje"]])

