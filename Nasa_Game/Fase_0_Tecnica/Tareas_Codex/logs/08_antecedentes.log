class_name MecanicaOrbital
## Mec�nica orbital de c�nicas empalmadas. Unidades: km, s y km/s.
## F�rmulas: vis-viva, transferencia de Hohmann, efecto Oberth y ecuaci�n de Tsiolkovsky.

const G0_KM_S2 := 9.80665e-3
const ALTITUD_ESPERA_KM := 200.0


static func velocidad_circular(mu: float, r: float) -> float:
	return sqrt(mu / r)


static func vis_viva(mu: float, r: float, a: float) -> float:
	return sqrt(mu * (2.0 / r - 1.0 / a))


## ?v de las dos maniobras de una Hohmann entre �rbitas circulares de radios r1 y r2.
## Con el � del Sol y los semiejes de dos planetas devuelve v8 de salida (x) y de llegada (y).
static func hohmann(mu: float, r1: float, r2: float) -> Vector2:
	var a := (r1 + r2) * 0.5
	return Vector2(
		absf(vis_viva(mu, r1, a) - velocidad_circular(mu, r1)),
		absf(velocidad_circular(mu, r2) - vis_viva(mu, r2, a)))


static func tiempo_hohmann_s(mu: float, r1: float, r2: float) -> float:
	var a := (r1 + r2) * 0.5
	return PI * sqrt(a * a * a / mu)


## ?v para salir de una �rbita circular de radio r con exceso hiperb�lico v8 (efecto Oberth).
static func dv_desde_orbita(mu: float, r: float, v_inf: float) -> float:
	return sqrt(v_inf * v_inf + 2.0 * mu / r) - velocidad_circular(mu, r)


## ?v para frenar desde v8 y quedar en una �rbita de periapsis rp y apoapsis ra (radios).
static func dv_captura(mu: float, v_inf: float, rp: float, ra: float) -> float:
	return sqrt(v_inf * v_inf + 2.0 * mu / rp) - vis_viva(mu, rp, (rp + ra) * 0.5)


## Ecuaci�n de Tsiolkovsky: propelente (kg) para dar ?v (km/s) a una masa seca con un Isp (s).
static func masa_propelente(masa_seca: float, dv: float, isp: float) -> float:
	return masa_seca * (exp(dv / (isp * G0_KM_S2)) - 1.0)


## ?v de inyecci�n desde la �rbita de espera: TLI hacia la Luna o TMI hacia Marte.
static func dv_salida(destino: String, cuerpos: Dictionary) -> float:
	var tierra: CuerpoCeleste = cuerpos["tierra"]
	var r_espera := tierra.radio_km + ALTITUD_ESPERA_KM
	if destino == "luna":
		var luna: CuerpoCeleste = cuerpos["luna"]
		return hohmann(tierra.gm_km3_s2, r_espera, luna.semieje_km).x
	if destino == "marte":
		return dv_desde_orbita(tierra.gm_km3_s2, r_espera, _v_inf_marte(cuerpos).x)
	return 0.0


## ?v que aporta la nave para insertarse en la �rbita elegida (altitudes en la �rbita).
static func dv_insercion(destino: String, orbita: Dictionary, cuerpos: Dictionary) -> float:
	var alt_p: float = orbita.get("periapsis_km", 0.0)
	var alt_a: float = orbita.get("apoapsis_km", alt_p)
	if destino == "luna":
		var tierra: CuerpoCeleste = cuerpos["tierra"]
		var luna: CuerpoCeleste = cuerpos["luna"]
		var a := (tierra.radio_km + ALTITUD_ESPERA_KM + luna.semieje_km) * 0.5
		var v_inf := velocidad_circular(tierra.gm_km3_s2, luna.semieje_km) - vis_viva(tierra.gm_km3_s2, luna.semieje_km, a)
		return dv_captura(luna.gm_km3_s2, v_inf, luna.radio_km + alt_p, luna.radio_km + alt_a)
	if destino == "marte":
		var marte: CuerpoCeleste = cuerpos["marte"]
		return dv_captura(marte.gm_km3_s2, _v_inf_marte(cuerpos).y, marte.radio_km + alt_p, marte.radio_km + alt_a)
	return 0.0


static func dias_transferencia(destino: String, cuerpos: Dictionary) -> float:
	var tierra: CuerpoCeleste = cuerpos["tierra"]
	if destino == "luna":
		var luna: CuerpoCeleste = cuerpos["luna"]
		return tiempo_hohmann_s(tierra.gm_km3_s2, tierra.radio_km + ALTITUD_ESPERA_KM, luna.semieje_km) / 86400.0
	if destino == "marte":
		var sol: CuerpoCeleste = cuerpos["sol"]
		var marte: CuerpoCeleste = cuerpos["marte"]
		return tiempo_hohmann_s(sol.gm_km3_s2, tierra.semieje_km, marte.semieje_km) / 86400.0
	return 0.0


static func _v_inf_marte(cuerpos: Dictionary) -> Vector2:
	var sol: CuerpoCeleste = cuerpos["sol"]
	var tierra: CuerpoCeleste = cuerpos["tierra"]
	var marte: CuerpoCeleste = cuerpos["marte"]
	return hohmann(sol.gm_km3_s2, tierra.semieje_km, marte.semieje_km)
