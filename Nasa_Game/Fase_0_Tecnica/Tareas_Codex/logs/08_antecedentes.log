class_name VehiculoLanzamiento
extends Resource
## Lanzador gen�rico con capacidades plausibles por destino. No representa un veh�culo real.

@export var id := ""
@export var nombre := ""
@export var capacidad_leo_kg := 0.0
## Masa que deja en trayectoria hacia la Luna (TLI).
@export var capacidad_luna_kg := 0.0
## Masa que deja en trayectoria hacia Marte (TMI).
@export var capacidad_marte_kg := 0.0
@export var costo_musd := 0.0
@export_multiline var leccion := ""


func capacidad(destino: String) -> float:
	match destino:
		"luna":
			return capacidad_luna_kg
		"marte":
			return capacidad_marte_kg
	return capacidad_leo_kg
