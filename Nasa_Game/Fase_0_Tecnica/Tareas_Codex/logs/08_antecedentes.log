extends Node2D
## Habitaci�n Atardecer: primera integraci�n del kit de Astra/Codex.
## Recorrido: entrar, llegar al escritorio, abrir el libro y pasar a la consola de misi�n.
## Argumentos de captura: �-- --captura-habitacion� abre el libro con el avatar al lado;
## �-- --captura-consola� abre la consola; �-- --demo� simula la misi�n lunar.

@onready var _libro: LibroHolografico = $Mundo/Escritorio/Libro
@onready var _jugador: Jugador = $Mundo/Jugador

var _consola: ConsolaMision


func _ready() -> void:
	_libro.consola_solicitada.connect(_abrir_consola)
	if Juego.tiene_argumento("--captura-habitacion"):
		_jugador.position = Vector2(262, 124)
		_libro.abrir()
	if Juego.tiene_argumento("--captura-consola") or Juego.tiene_argumento("--demo"):
		_libro.abrir()
		_abrir_consola()
		if Juego.tiene_argumento("--demo"):
			_consola.demo()


func _abrir_consola() -> void:
	if _consola != null:
		return
	_consola = ConsolaMision.new()
	_consola.cerrada.connect(_al_cerrar_consola)
	add_child(_consola)
	_jugador.bloqueado = true
	Juego.consola_activa = true


func _al_cerrar_consola() -> void:
	_consola = null
	_jugador.bloqueado = false
	Juego.consola_activa = false
