extends SceneTree
## Bakes the code-authored room geometry to an editable Godot scene.
func _initialize() -> void:
	_run.call_deferred()
func _run() -> void:
	var room = load("res://scenes/bedroom.tscn").instantiate()
	root.add_child(room)
	await process_frame
	var architecture: Node3D = room.get_node("Architecture")
	# Rebuild from the authoritative dimensions/material generator when re-baking.
	for child in architecture.get_children(): child.free()
	room._create_architecture()
	_set_owners(architecture,architecture)
	var packed := PackedScene.new()
	var error := packed.pack(architecture)
	if error == OK: error = ResourceSaver.save(packed,"res://scenes/architecture.scn")
	print("ARCHITECTURE_SAVED ",error," nodes=",architecture.get_child_count())
	room.queue_free()
	await process_frame
	quit(error)
func _set_owners(node: Node, owner_root: Node) -> void:
	for child in node.get_children():
		child.owner=owner_root
		_set_owners(child,owner_root)
extends SceneTree
