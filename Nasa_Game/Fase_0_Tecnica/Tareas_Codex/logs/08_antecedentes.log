@tool
class_name PiezaKit
extends Node2D
## Pieza del kit de Astra/Codex colocada en el mundo.
## Origen = pie del sprite (borde frontal de la huella en el suelo), para ordenar por Y.
## La escala sale de la altura relativa al avatar (avatar = 1,0). Ver Escala.

@export var textura: Texture2D:
	set(valor):
		textura = valor
		_actualizar()
@export_range(0.05, 3.0, 0.01) var altura_relativa := 1.0:
	set(valor):
		altura_relativa = valor
		_actualizar()
## Ancho � fondo de la huella en px l�gicos. Cero = sin colisi�n.
@export var huella := Vector2.ZERO:
	set(valor):
		huella = valor
		_actualizar()
@export var voltear := false:
	set(valor):
		voltear = valor
		_actualizar()

var _sprite: Sprite2D
var _cuerpo: StaticBody2D


func _ready() -> void:
	_actualizar()


func _actualizar() -> void:
	if not is_inside_tree():
		return
	if _sprite == null:
		_sprite = Sprite2D.new()
		_sprite.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
		add_child(_sprite)
		move_child(_sprite, 0)
	_sprite.texture = textura
	_sprite.flip_h = voltear
	if textura:
		var s := altura_relativa * Escala.ALTURA_AVATAR_PX / textura.get_height()
		_sprite.scale = Vector2(s, s)
		_sprite.offset = Vector2(0.0, -textura.get_height() * 0.5)
	if not Engine.is_editor_hint() and huella != Vector2.ZERO and _cuerpo == null:
		_cuerpo = StaticBody2D.new()
		var forma := CollisionShape2D.new()
		var rect := RectangleShape2D.new()
		rect.size = huella
		forma.shape = rect
		forma.position = Vector2(0.0, -huella.y * 0.5)
		_cuerpo.add_child(forma)
		add_child(_cuerpo)
	queue_redraw()


func _draw() -> void:
	if Engine.is_editor_hint() and huella != Vector2.ZERO:
		draw_rect(Rect2(-huella.x * 0.5, -huella.y, huella.x, huella.y), Color(0.0, 0.9, 1.0, 0.7), false, 1.0)
