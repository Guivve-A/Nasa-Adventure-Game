class_name EvaluadorMision
## Eval�a un dise�o de misi�n: masa, energ�a, datos, presupuesto, vida �til, puntaje y lecciones.
## La f�sica usa MecanicaOrbital con constantes de NASA. Componentes y lanzadores usan valores
## de juego plausibles (ver datos/).

const MARGEN_PROPELENTE := 1.10
const NOMBRES := {"leo": "�rbita baja", "luna": "la Luna", "marte": "Marte"}


static func evaluar(d: DisenoMision, cuerpos: Dictionary) -> Dictionary:
	var e: Escenario = d.escenario
	var orbita: Dictionary = e.orbitas[clampi(d.orbita, 0, e.orbitas.size() - 1)]
	var tierra: CuerpoCeleste = cuerpos["tierra"]
	var lecciones: Array[String] = []

	# 1. Masa seca, consumo, datos, ciencia y costo.
	var masa_seca := 0.0
	var costo := d.lanzador.costo_musd + e.costo_operacion_musd_anio * e.vida_minima_anios
	for c: Componente in [d.bus, d.energia, d.comunicaciones]:
		masa_seca += c.masa_kg
		costo += c.costo_musd
	var consumo_base := d.bus.potencia_w + d.comunicaciones.potencia_w
	var consumo_inst := 0.0
	var datos := 0.0
	var ciencia_bruta := 0.0
	for i: Componente in d.instrumentos:
		masa_seca += i.masa_kg
		costo += i.costo_musd
		consumo_inst += i.potencia_w
		datos += i.datos_gb_dia
		ciencia_bruta += i.valor_cientifico * float(e.bonus_instrumentos.get(i.id, 1.0))

	# 2. Inserci�n orbital: ?v y propelente con la ecuaci�n de Tsiolkovsky.
	var dv := MecanicaOrbital.dv_insercion(e.destino, orbita, cuerpos)
	var propelente := 0.0
	if dv > 0.0:
		propelente = MecanicaOrbital.masa_propelente(masa_seca, dv, d.bus.isp_s) * MARGEN_PROPELENTE
	var masa_total := masa_seca + propelente
	var capacidad := d.lanzador.capacidad(e.destino)

	# 3. Energ�a: la luz solar disminuye con el cuadrado de la distancia al Sol.
	var factor_solar := 1.0
	if e.destino == "marte":
		var marte: CuerpoCeleste = cuerpos["marte"]
		factor_solar = pow(tierra.semieje_km / marte.semieje_km, 2.0)
	var generacion := d.energia.potencia_w * factor_solar
	var ciclo := 1.0
	if consumo_inst > 0.0:
		ciclo = clampf((generacion - consumo_base) / consumo_inst, 0.0, 1.0)

	# 4. Datos: lo que no cabe en el enlace de bajada se pierde.
	var bajada: float = d.comunicaciones.bajada_gb_dia.get(e.destino, 0.0)
	var fraccion_datos := 1.0
	if datos > 0.0:
		fraccion_datos = clampf(bajada / datos, 0.0, 1.0)

	# 5. Vida �til: la del bus, limitada por la �rbita (arrastre o estabilidad).
	var vida := minf(d.bus.vida_diseno_anios, float(orbita.get("vida_max_anios", 99.0)))
	var ciencia := ciencia_bruta * float(orbita.get("ciencia", 1.0)) * ciclo * fraccion_datos

	# La primera falla cr�tica decide en qu� fase se detiene la misi�n.
	var falla := ""
	if costo > e.presupuesto_musd:
		falla = "diseno"
		lecciones.append("El costo (%.0f M USD) supera el presupuesto (%.0f M USD). Operar tambi�n cuesta: %.0f M USD por a�o." % [costo, e.presupuesto_musd, e.costo_operacion_musd_anio])
	elif masa_total > capacidad:
		falla = "lanzamiento"
		lecciones.append("La nave pesa %.0f kg con propelente y el %s solo lleva %.0f kg hacia %s. Quita masa o elige un lanzador mayor." % [masa_total, d.lanzador.nombre.to_lower(), capacidad, NOMBRES[e.destino]])
	elif e.destino != "leo" and not d.bus.espacio_profundo:
		falla = "crucero"
		lecciones.append("El %s no tiene blindaje contra la radiaci�n fuera de la magnetosfera ni navegaci�n de espacio profundo." % d.bus.nombre.to_lower())
	elif generacion < consumo_base:
		falla = "operacion"
		lecciones.append("Los paneles dan %.0f W y el bus con su antena necesita %.0f W: la nave se apaga." % [generacion, consumo_base])
	elif d.instrumentos.is_empty():
		falla = "operacion"
		lecciones.append("Sin instrumentos no hay ciencia: la nave llega, pero no cumple el objetivo.")
	elif vida < e.vida_minima_anios:
		falla = "operacion"
		lecciones.append("La misi�n dura %.1f a�os y el objetivo pide %.1f. %s" % [vida, e.vida_minima_anios, orbita.get("nota", "")])
	elif ciencia < e.ciencia_minima:
		falla = "operacion"
		lecciones.append("El valor cient�fico (%.0f) no alcanza el m�nimo del objetivo (%.0f)." % [ciencia, e.ciencia_minima])

	# Explicaciones que ense�an por qu� cada recurso qued� as�.
	if factor_solar < 1.0:
		lecciones.append("En Marte llega %.0f %% de la luz solar que en la Tierra: los paneles dan %.0f W en vez de %.0f W." % [factor_solar * 100.0, generacion, d.energia.potencia_w])
	if ciclo < 1.0 and generacion >= consumo_base:
		lecciones.append("Falta energ�a: los instrumentos funcionan solo %.0f %% del tiempo." % (ciclo * 100.0))
	if fraccion_datos < 1.0:
		lecciones.append("Los instrumentos generan %.1f GB/d�a y la antena baja %.1f GB/d�a: se pierde %.0f %% de los datos." % [datos, bajada, (1.0 - fraccion_datos) * 100.0])
	if dv > 0.0:
		lecciones.append("Insertarse en la �rbita pide %.2f km/s. Con Isp de %.0f s son %.0f kg de propelente, con 10 %% de margen." % [dv, d.bus.isp_s, propelente])

	var exito := falla == ""
	var puntaje := 0
	if exito:
		puntaje = roundi(ciencia * 10.0 + (e.presupuesto_musd - costo) * 2.0 + (1.0 - masa_total / capacidad) * 100.0)
	elif falla == "operacion":
		puntaje = roundi(ciencia * 2.0)

	var r := {
		"destino": e.destino, "orbita": orbita.get("nombre", ""), "exito": exito, "falla": falla,
		"masa_seca": masa_seca, "propelente": propelente, "masa_total": masa_total, "capacidad": capacidad,
		"dv_insercion": dv, "generacion_w": generacion, "consumo_w": consumo_base + consumo_inst,
		"datos_gb": datos, "bajada_gb": bajada, "costo": costo, "presupuesto": e.presupuesto_musd,
		"vida": vida, "vida_minima": e.vida_minima_anios, "ciencia": ciencia,
		"ciencia_minima": e.ciencia_minima, "puntaje": puntaje, "lecciones": lecciones,
	}
	_agregar_fases(r, d, cuerpos)
	return r


## Telemetr�a por fase: [progreso de 0 a 1, texto]. Se detiene en la fase de la falla.
static func _agregar_fases(r: Dictionary, d: DisenoMision, cuerpos: Dictionary) -> void:
	var tierra: CuerpoCeleste = cuerpos["tierra"]
	var destino: String = r["destino"]
	var falla: String = r["falla"]
	var fases: Array = []
	var limite := 1.0
	if falla == "diseno":
		fases.append([0.0, "REVISI�N DE DISE�O � costo %.0f > presupuesto %.0f M USD � MISI�N CANCELADA" % [r["costo"], r["presupuesto"]]])
		limite = 0.0
	else:
		fases.append([0.0, "T+0 LANZAMIENTO � %s � %.0f / %.0f kg" % [d.lanzador.nombre, r["masa_total"], r["capacidad"]]])
		if falla == "lanzamiento":
			fases.append([0.08, "FALLA � el lanzador no alcanza la �rbita con esa masa"])
			limite = 0.1
		else:
			var v := MecanicaOrbital.velocidad_circular(tierra.gm_km3_s2, tierra.radio_km + MecanicaOrbital.ALTITUD_ESPERA_KM)
			fases.append([0.15, "�RBITA DE ESPERA %.0f km � v = %.2f km/s" % [MecanicaOrbital.ALTITUD_ESPERA_KM, v]])
			if destino == "leo":
				fases.append([0.3, "�RBITA FINAL � %s � vida estimada %.1f a�os" % [r["orbita"], r["vida"]]])
			else:
				fases.append([0.3, "INYECCI�N � ?v %.2f km/s con la etapa superior" % MecanicaOrbital.dv_salida(destino, cuerpos)])
				fases.append([0.45, "CRUCERO � %.0f d�as hasta %s" % [MecanicaOrbital.dias_transferencia(destino, cuerpos), NOMBRES[destino]]])
				if falla == "crucero":
					fases.append([0.55, "FALLA � reinicios por radiaci�n en la electr�nica"])
					limite = 0.58
				else:
					fases.append([0.75, "INSERCI�N � %s � ?v %.2f km/s � %.0f kg de propelente" % [r["orbita"], r["dv_insercion"], r["propelente"]]])
			if limite == 1.0:
				fases.append([0.88, "OPERACI�N � %.0f / %.0f W � datos %.1f / %.1f GB/d�a" % [r["consumo_w"], r["generacion_w"], r["datos_gb"], r["bajada_gb"]]])
				fases.append([1.0, "MISI�N CUMPLIDA" if r["exito"] else "OBJETIVO NO CUMPLIDO"])
	r["fases"] = fases
	r["limite_progreso"] = limite
