class_name Jugador
extends CharacterBody2D
## Avatar provisional: la muestra de escala del kit, sin capas ni animaci�n todav�a.

const TEXTURA := preload("res://arte/kit-habitacion/avatar-muestra.png")

## P�xeles l�gicos por segundo.
@export var velocidad := 70.0

var bloqueado := false
var _sprite := Sprite2D.new()


func _ready() -> void:
	motion_mode = CharacterBody2D.MOTION_MODE_FLOATING
	_sprite.texture = TEXTURA
	_sprite.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
	var s := Escala.ALTURA_AVATAR_PX / TEXTURA.get_height()
	_sprite.scale = Vector2(s, s)
	_sprite.offset = Vector2(0.0, -TEXTURA.get_height() * 0.5)
	add_child(_sprite)
	var forma := CollisionShape2D.new()
	var rect := RectangleShape2D.new()
	rect.size = Vector2(10.0, 4.0)
	forma.shape = rect
	forma.position = Vector2(0.0, -2.0)
	add_child(forma)


func _physics_process(_delta: float) -> void:
	var direccion := Vector2.ZERO
	if not bloqueado:
		direccion = Input.get_vector("mover_izquierda", "mover_derecha", "mover_arriba", "mover_abajo")
	velocity = direccion * velocidad
	if not is_zero_approx(direccion.x):
		_sprite.flip_h = direccion.x < 0.0
	move_and_slide()


## Sombra de contacto bajo los pies.
func _draw() -> void:
	draw_set_transform(Vector2.ZERO, 0.0, Vector2(1.0, 0.35))
	draw_circle(Vector2.ZERO, 7.0, Color(0.05, 0.02, 0.08, 0.35))
FILE: 1_Mecanicas_y_Codigo/godot/escenas/interactivos/libro_holografico.gd
class_name LibroHolografico
extends Node2D
## Libro del escritorio: cerrado  abierto con holograma  abre la consola de misi�n.
## Se se�ala por forma (flecha) y por color, y se activa desde el suelo frente al escritorio.

signal consola_solicitada

const CERRADO := preload("res://arte/kit-habitacion/libro-cerrado.png")
const ABIERTO := preload("res://arte/kit-habitacion/libro-abierto.png")
const HOLOGRAMA := preload("res://arte/kit-habitacion/holograma.png")
const CIAN := Color("00E5FF")

## Anchos relativos a la altura del avatar. Abierto ~ ancho de hombros (ficha de Astra).
@export var ancho_cerrado := 0.25
@export var ancho_abierto := 0.33
@export var altura_holograma := 0.55
## Zona del suelo, relativa al libro, desde donde se puede usar.
@export var zona := Rect2(-16.0, 22.0, 32.0, 14.0)

var abierto := false
var _cerca := false
var _libro := Sprite2D.new()
var _holo := Sprite2D.new()
var _luz := PointLight2D.new()
var _marca := Node2D.new()
var _t := 0.0


func _ready() -> void:
	_libro.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
	add_child(_libro)
	_poner_textura(CERRADO, ancho_cerrado)
	_holo.texture = HOLOGRAMA
	_holo.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
	var suma := CanvasItemMaterial.new()
	suma.blend_mode = CanvasItemMaterial.BLEND_MODE_ADD
	_holo.material = suma
	var s := altura_holograma * Escala.ALTURA_AVATAR_PX / HOLOGRAMA.get_height()
	_holo.scale = Vector2(s, s)
	_holo.offset = Vector2(0.0, -HOLOGRAMA.get_height() * 0.5)
	_holo.position = Vector2(0.0, -3.0)
	_holo.modulate.a = 0.0
	add_child(_holo)
	_luz.texture = _textura_radial()
	_luz.color = CIAN
	_luz.energy = 0.0
	_luz.texture_scale = 1.6
	_luz.position = Vector2(0.0, -8.0)
	add_child(_luz)
	_crear_marca()
	_crear_zona()


func _process(delta: float) -> void:
	_t += delta
	_marca.position.y = -14.0 + sin(_t * 4.0)
	if abierto:
		_holo.position.y = -3.0 + sin(_t * 1.6) * 0.8
		_luz.energy = 0.8 + sin(_t * 3.0) * 0.1


func _unhandled_input(evento: InputEvent) -> void:
	if not _cerca or Juego.consola_activa or not evento.is_action_pressed("interactuar"):
		return
	get_viewport().set_input_as_handled()
	if abierto:
		consola_solicitada.emit()
	else:
		abrir()


func abrir() -> void:
	if abierto:
		return
	abierto = true
	_poner_textura(ABIERTO, ancho_abierto)
	create_tween().tween_property(_holo, "modulate:a", 1.0, 0.6)


func _poner_textura(textura: Texture2D, ancho_relativo: float) -> void:
	_libro.texture = textura
	var s := ancho_relativo * Escala.ALTURA_AVATAR_PX / textura.get_width()
	_libro.scale = Vector2(s, s)
	_libro.offset = Vector2(0.0, -textura.get_height() * 0.5)


func _textura_radial() -> GradientTexture2D:
	var degradado := Gradient.new()
	degradado.set_color(0, Color(1, 1, 1, 1))
	degradado.set_color(1, Color(1, 1, 1, 0))
	var textura := GradientTexture2D.new()
	textura.gradient = degradado
	textura.fill = GradientTexture2D.FILL_RADIAL
	textura.fill_from = Vector2(0.5, 0.5)
	textura.fill_to = Vector2(1.0, 0.5)
	textura.width = 64
	textura.height = 64
	return textura


func _crear_marca() -> void:
	var flecha := Polygon2D.new()
	flecha.polygon = PackedVector2Array([Vector2(-3, -4), Vector2(3, -4), Vector2(0, 0)])
	flecha.color = CIAN
	_marca.add_child(flecha)
	var tecla := Label.new()
	tecla.text = "E"
	tecla.add_theme_font_size_override("font_size", 6)
	tecla.add_theme_color_override("font_color", CIAN)
	tecla.position = Vector2(4, -9)
	_marca.add_child(tecla)
	_marca.visible = false
	add_child(_marca)


func _crear_zona() -> void:
	var area := Area2D.new()
	var forma := CollisionShape2D.new()
	var rect := RectangleShape2D.new()
	rect.size = zona.size
	forma.shape = rect
	forma.position = zona.get_center()
	area.add_child(forma)
	area.body_entered.connect(_al_entrar)
	area.body_exited.connect(_al_salir)
	add_child(area)


func _al_entrar(cuerpo: Node2D) -> void:
	if cuerpo is Jugador:
		_cerca = true
		_marca.visible = true


func _al_salir(cuerpo: Node2D) -> void:
	if cuerpo is Jugador:
		_cerca = false
		_marca.visible = false
