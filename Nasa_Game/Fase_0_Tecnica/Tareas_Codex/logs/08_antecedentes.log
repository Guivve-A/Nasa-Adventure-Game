import { Client } from './godot-mcp/node_modules/@modelcontextprotocol/sdk/dist/client/index.js';
import { StdioClientTransport } from './godot-mcp/node_modules/@modelcontextprotocol/sdk/dist/client/stdio.js';
import { CallToolResultSchema, ListToolsResultSchema } from './godot-mcp/node_modules/@modelcontextprotocol/sdk/dist/types.js';
import fs from 'node:fs';
import path from 'node:path';
import readline from 'node:readline';
const base = path.resolve(import.meta.dirname, '..');
const projectPath = path.join(base, '1_Mecanicas_y_Codigo/godot');
const transport = new StdioClientTransport({ command: process.execPath, args: [path.join(base,'.tools/godot-mcp/build/index.js')], env: {...process.env, GODOT_PATH:'C:/Users/guill/Downloads/Godot_v4.7.2-stable_win64.exe/Godot_v4.7.2-stable_win64.exe'} });
const client = new Client({ name:'gravedad-integration', version:'1.0.0' }, { capabilities:{} });
await client.connect(transport);
const action=process.argv[2]||'info';
const results=[];
async function call(name,args={}) { const result=await client.request({method:'tools/call',params:{name,arguments:args}},CallToolResultSchema); results.push({name,args,result}); console.log(JSON.stringify({name,result})); return result; }
try {
 if(action==='info') { await call('get_godot_version'); await call('get_project_info',{projectPath}); }
 if(action==='open') { await call('get_godot_version'); await call('launch_editor',{projectPath}); }
 if(action==='serve') {
  await call('get_godot_version'); await call('launch_editor',{projectPath});
  const lines=readline.createInterface({input:process.stdin});
  for await (const line of lines) { if(!line.trim()) continue; const req=JSON.parse(line); if(req.name==='exit') break; await call(req.name,req.arguments??{}); fs.writeFileSync(path.join(projectPath,'evidence','mcp-session.json'),JSON.stringify(results,null,2)); }
 }
 if(action==='create') { await call('create_scene',{projectPath,scenePath:'scenes/main.tscn',rootNodeType:'Control'}); }
 if(action==='run') { await call('run_project',{projectPath}); await new Promise(r=>setTimeout(r,5000)); await call('get_debug_output'); }
 fs.mkdirSync(path.join(projectPath,'evidence'),{recursive:true});
 fs.writeFileSync(path.join(projectPath,'evidence','mcp-'+action+'.json'),JSON.stringify(results,null,2));
} finally { await client.close(); }
process.exit(0);
