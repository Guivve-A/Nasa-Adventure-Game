		"intro": main.start_intro()
		"mission": main.enter_room(); main.open_mission()
	await create_timer(1.5).timeout
	await RenderingServer.frame_post_draw
	var img := root.get_texture().get_image()
	var path := "res://evidence/"+view+".png"
	img.save_png(path)
	print("CAPTURE_OK ",path," ",img.get_size())
	main.queue_free()
	await process_frame
	await process_frame
	quit()
