# Sincroniza el arte de Astra/Codex (2_Arte_e_Interfaz) con el proyecto de Godot.
# Solo copia: nunca escribe en la carpeta de Arte. Ejecutar despues de cada entrega de Arte:
#   powershell -ExecutionPolicy Bypass -File 1_Mecanicas_y_Codigo\godot\herramientas\sincronizar_arte.ps1
$ErrorActionPreference = 'Stop'
$godot = Split-Path -Parent $PSScriptRoot
$boveda = Split-Path -Parent (Split-Path -Parent $godot)
$arte = Join-Path $boveda '2_Arte_e_Interfaz'
$copias = @(
    @{ Origen = 'kit-habitacion\piezas'; Destino = 'arte\kit-habitacion'; Filtro = '*.png' },
    @{ Origen = 'fuentes'; Destino = 'arte\fuentes'; Filtro = '*.ttf' },
    @{ Origen = 'iconos-mision'; Destino = 'arte\iconos-mision'; Filtro = '*.png' },
    @{ Origen = 'espacio'; Destino = 'arte\espacio'; Filtro = '*.png' }
)
foreach ($c in $copias) {
    $origen = Join-Path $arte $c.Origen
    if (-not (Test-Path $origen)) { Write-Host "Omitido (no existe): $($c.Origen)"; continue }
    $destino = Join-Path $godot $c.Destino
    New-Item -ItemType Directory -Force -Path $destino | Out-Null
    $archivos = @(Get-ChildItem -Path $origen -Filter $c.Filtro -File)
    foreach ($a in $archivos) { Copy-Item -LiteralPath $a.FullName -Destination $destino -Force }
    Write-Host ("{0} archivo(s): {1} -> {2}" -f $archivos.Count, $c.Origen, $c.Destino)
}
