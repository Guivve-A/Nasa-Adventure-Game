class_name SimulacionOrbital
extends Control
## Esquema animado de la misi�n (no a escala) que emite la telemetr�a fase por fase.

signal linea(texto: String)
signal terminada

const CIAN := Color("00E5FF")
const DURACION_S := 7.0

var _r := {}
var _fases: Array = []
var _p := 0.0
var _limite := 1.0
var _siguiente := 0
var _estrellas := PackedVector2Array()


func _ready() -> void:
	set_process(false)
	var azar := RandomNumberGenerator.new()
	azar.seed = 2026
	for i in 60:
		_estrellas.append(Vector2(azar.randf(), azar.randf()))


func iniciar(resultado: Dictionary) -> void:
	_r = resultado
	_fases = resultado["fases"]
	_limite = resultado["limite_progreso"]
	_p = 0.0
	_siguiente = 0
	set_process(true)


func detener() -> void:
	set_process(false)


func _process(delta: float) -> void:
	_p = minf(_p + delta / DURACION_S, _limite)
	while _siguiente < _fases.size() and _p >= float(_fases[_siguiente][0]):
		linea.emit(String(_fases[_siguiente][1]))
		_siguiente += 1
	queue_redraw()
	if _p >= _limite:
		set_process(false)
		terminada.emit()


func _draw() -> void:
	for estrella in _estrellas:
		draw_rect(Rect2(estrella * size, Vector2.ONE), Color(1, 1, 1, 0.35))
	if _r.is_empty():
		return
	var falla: bool = not _r["exito"] and _p >= _limite
	var color_nave := Color("FF6B5A") if falla else Color.WHITE
	var centro := size * 0.5
	if _r["destino"] == "leo":
		var radio := minf(size.x, size.y) * 0.3
		draw_circle(centro, radio * 0.55, Color("2E6FD8"))
		draw_arc(centro, radio, 0.0, TAU, 64, Color(CIAN, 0.4), 1.0)
		var nave := centro + Vector2(0.0, -radio * lerpf(0.55, 1.0, _p / 0.2))
		if _p >= 0.2:
			var angulo := -PI * 0.5 + (_p - 0.2) * TAU * 3.0
			nave = centro + Vector2(cos(angulo), sin(angulo)) * radio
		draw_circle(nave, 2.0, color_nave)
		return
	var tierra := Vector2(size.x * 0.18, centro.y)
	var meta := Vector2(size.x * 0.82, centro.y)
	var rt := minf(size.x, size.y) * 0.08
	var rm := rt * (0.45 if _r["destino"] == "luna" else 0.6)
	draw_circle(tierra, rt, Color("2E6FD8"))
	draw_circle(meta, rm, Color("BFC3C9") if _r["destino"] == "luna" else Color("C1440E"))
	var arco := PackedVector2Array()
	for k in 33:
		arco.append(_punto_transferencia(tierra, meta, rt, rm, k / 32.0))
	draw_polyline(arco, Color(CIAN, 0.35), 1.0)
	draw_circle(_posicion_nave(tierra, meta, rt, rm), 2.0, color_nave)


## Punto del arco de transferencia, de la cima de la �rbita de espera a la cima de la de destino.
func _punto_transferencia(tierra: Vector2, meta: Vector2, rt: float, rm: float, t: float) -> Vector2:
	var y_base := lerpf(tierra.y - rt * 1.6, meta.y - rm * 1.8, t)
	return Vector2(lerpf(tierra.x, meta.x, t), y_base - size.y * 0.25 * sin(PI * t))


func _posicion_nave(tierra: Vector2, meta: Vector2, rt: float, rm: float) -> Vector2:
	if _p < 0.15:
		return tierra + Vector2(0.0, -lerpf(rt, rt * 1.6, _p / 0.15))
	if _p < 0.3:
		var angulo := -PI * 0.5 + (_p - 0.15) / 0.15 * TAU
		return tierra + Vector2(cos(angulo), sin(angulo)) * rt * 1.6
	if _p < 0.75:
		return _punto_transferencia(tierra, meta, rt, rm, (_p - 0.3) / 0.45)
	var giro := -PI * 0.5 + (_p - 0.75) * TAU * 4.0
	return meta + Vector2(cos(giro), sin(giro)) * rm * 1.8
func _ensure_world() -> void:
	if is_instance_valid(world): return
	_world_container = SubViewportContainer.new()
	_world_container.name = "WorldView"
	_world_container.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	_world_container.stretch = true
	_world_container.stretch_shrink = 2
	_world_container.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	_world_container.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(_world_container)
	move_child(_world_container,1)
	_world_view = SubViewport.new()
	_world_view.own_world_3d = true
	_world_view.render_target_update_mode = SubViewport.UPDATE_ALWAYS
	_world_container.add_child(_world_view)
	world = Bedroom.instantiate()
	_world_view.add_child(world)
	world.book_requested.connect(open_book)
	world.door_requested.connect(finish_prologue)
	world.hint_changed.connect(func(value: String): if is_instance_valid(_hint): _hint.text = value)

func enter_room() -> void:
	_clear()
	_ensure_world()
	screen = "room"
	_world_container.show()
	world.apply_avatar(avatar_config)
	world.set_book_open(book_open)
	world.set_playing(true)
	_panel(Vector2(28,24),Vector2(380,90),0.81).mouse_filter = Control.MOUSE_FILTER_IGNORE
	_label("GUAYAQUIL  /  TU HABITACI�N",Vector2(45,34),Vector2(350,27),16,GOLD)
	_objective = _label("Busca el libro sobre el escritorio." if not book_open else "Explora las misiones o sal por la puerta.",Vector2(45,65),Vector2(350,40),20)
	_hint = _label("",Vector2(400,591),Vector2(500,45),25,PAPER)
	_hint.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_label("WASD / Flechas � Moverte     May�s � Correr     E � Interactuar",Vector2(45,665),Vector2(950,28),18,MUTED)
	_button("Pausa  �  Esc",Vector2(1075,27),Vector2(175,41),show_pause,"Pause")
	_save()
	print("GRAVEDAD_ROOM avatar=",avatar_config.name)

func continue_journey() -> void:
	if save_data.is_empty(): return
	avatar_config = save_data.avatar.duplicate()
	book_open = bool(save_data.get("book_open",false))
	enter_room()

func open_book() -> void:
	if screen != "room": return
	_clear()
	screen = "book"
	book_open = true
	world.set_book_open(true)
	_save()
	_chime(660.0)
	_shade(0.26)
	_panel(Vector2(110,402),Vector2(1060,278),0.97)
	_label("CUADERNO DE VUELO  /  PRIMERA PREGUNTA",Vector2(143,425),Vector2(970,30),17,GOLD)
	_label("�Hasta d�nde puede llegar una se�al?",Vector2(143,468),Vector2(970,52),31,PAPER,true)
	_label("�El cielo parece lejano. Pero cada misi�n empieza aqu�: observar, elegir y volver a probar�.\nEl libro proyecta un peque�o sistema orbital sobre tu escritorio.",Vector2(143,526),Vector2(970,71),22)
	_button("Dise�ar una misi�n",Vector2(143,614),Vector2(320,44),open_mission,"Mission")
	_button("Seguir explorando",Vector2(815,614),Vector2(320,44),enter_room,"ReturnRoom")

codex
Para el nuevo objetivo visual, conviene conservar la narrativa, la interacción con el libro y el núcleo de misiones. El kit, en cambio, tiene luz y perspectiva dibujadas: sirve para probar composición, pero no demuestra iluminación 3D sobre sprites. También confirmé que `Nasa_Game/` no está en esta bóveda; el contraste con el plan actual se limitará al brief que compartiste.
