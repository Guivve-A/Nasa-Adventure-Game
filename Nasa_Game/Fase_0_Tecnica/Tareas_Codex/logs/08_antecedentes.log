extends Node3D
signal book_requested
signal door_requested
signal hint_changed(text: String)
const PLAYER_SCENE = preload("res://scenes/player.tscn")
var player: CharacterBody3D
var camera: Camera3D
var book: Node3D
var hologram: Node3D
var playing := false
var _open := false
var _last_hint := ""
var _elapsed := 0.0
var _cyan: OmniLight3D
var book_anchor := Vector3(1.65,0.0,-1.65)
var spawn_point := Vector3(-1.8,0.08,1.1)
var door_anchor := Vector3(-3.0,0.0,1.3)

func _ready() -> void:
	camera = $Camera3D
	camera.look_at(Vector3(0.0,0.85,-0.2))
	_create_architecture()
	for child in $Furniture.get_children():
		if child.has_method("face_camera"): child.face_camera(camera.global_basis)
	book = $Furniture/Desk/Book
	book.face_camera(camera.global_basis)
	hologram = $Furniture/Desk/Hologram
	hologram.face_camera(camera.global_basis)
	hologram.visible = false
	player = PLAYER_SCENE.instantiate()
	player.name = "Player"
	add_child(player)
	player.set_camera_basis(camera.global_basis)
	reset_player()
	_cyan = OmniLight3D.new()
	_cyan.position = Vector3(1.65,1.35,-1.8)
	_cyan.light_color = Color("6edfeb")
	_cyan.omni_range = 2.5
	_cyan.light_energy = 0.0
	add_child(_cyan)

func set_playing(value: bool) -> void:
	playing = value
	if value: _last_hint = "__refresh__"
	if is_instance_valid(player): player.set_playing(value)

func apply_avatar(config: Dictionary) -> void:
	player.apply_avatar(config)

func reset_player() -> void:
	player.reset_to(spawn_point)

func get_player_position() -> Vector3:
	return player.global_position

func set_book_open(value: bool) -> void:
	_open = value
	book.set_open(value)
	hologram.visible = value
	_cyan.light_energy = 1.0 if value else 0.0

func _process(delta: float) -> void:
	_elapsed += delta
	if is_instance_valid(hologram) and _open:
		hologram.position.y = 1.03 + sin(_elapsed*1.8)*0.035
	if not playing or not is_instance_valid(player): return
	var p := Vector2(player.position.x,player.position.z)
	var near_book := p.distance_to(Vector2(book_anchor.x,book_anchor.z)) < 1.35
	var near_door := p.distance_to(Vector2(door_anchor.x,door_anchor.z)) < 0.85
	var hint := "E � Leer el libro" if near_book else ("E � Salir de la habitaci�n" if near_door and _open else "")
	if hint != _last_hint:
		_last_hint = hint
		hint_changed.emit(hint)
	if Input.is_action_just_pressed("interact"):
		if near_book: book_requested.emit()
		elif near_door and _open: door_requested.emit()

func _material(base: Color, planks: bool = false) -> StandardMaterial3D:
	var img := Image.create(128,128,false,Image.FORMAT_RGB8)
	var rng := RandomNumberGenerator.new()
	rng.seed = 931
	for y in range(128):
		for x in range(128):
			var n := rng.randf_range(-0.065,0.065)
			var c := base.lightened(n) if n>0 else base.darkened(-n)
			if planks:
				if y % 16 <= 1 or (x + floori(float(y)/16.0)*29) % 64 == 0: c = base.darkened(0.45)
				elif y%4 == 0 and rng.randf()>0.4: c = base.darkened(0.09)
			img.set_pixel(x,y,c)
	var mat := StandardMaterial3D.new()
	mat.albedo_texture = ImageTexture.create_from_image(img)
	mat.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
	mat.roughness = 0.95
	mat.uv1_scale = Vector3(3,3,3) if planks else Vector3(2,2,2)
	return mat

func _box(label: String, pos: Vector3, dimensions: Vector3, mat: Material, solid: bool = false) -> MeshInstance3D:
	var mesh := MeshInstance3D.new()
	mesh.name = label
	var box := BoxMesh.new()
	box.size = dimensions
	mesh.mesh = box
	mesh.material_override = mat
	mesh.position = pos
	$Architecture.add_child(mesh)
	if solid:
		var body := StaticBody3D.new()
		var collider := CollisionShape3D.new()
		var shape := BoxShape3D.new()
		shape.size = dimensions
		collider.shape = shape
		body.add_child(collider)
		mesh.add_child(body)
	return mesh

func _flat(color: Color, unlit: bool = false) -> StandardMaterial3D:
	var mat := StandardMaterial3D.new()
	mat.albedo_color = color
	mat.roughness = 1.0
	if unlit: mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	if color.a < 1.0: mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	return mat

