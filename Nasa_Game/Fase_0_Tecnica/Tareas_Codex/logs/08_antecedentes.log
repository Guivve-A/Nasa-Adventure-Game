@tool
extends Node3D
## Sprite at a measured floor or tabletop anchor, with an optional solid footprint.

@export var art: Texture2D
@export var open_art: Texture2D
@export var display_width := 1.0
@export var display_offset := Vector2.ZERO
@export var footprint := Vector2.ZERO
@export var collider_height := 0.65
@export var receives_tint := true
@export var emissive := false

var _picture: Sprite3D


func _ready() -> void:
	_picture = Sprite3D.new()
	_picture.name = "Picture"
	_picture.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	_picture.shaded = false
	_picture.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
	_picture.alpha_cut = SpriteBase3D.ALPHA_CUT_DISABLED if emissive else SpriteBase3D.ALPHA_CUT_DISCARD
	_picture.alpha_scissor_threshold = 0.32
	_picture.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	if receives_tint:
		_picture.modulate = Color(0.93, 0.88, 0.85)
	add_child(_picture)
	_update_picture(art)
	if footprint.x > 0.0 and footprint.y > 0.0:
		_add_collision()


func face_camera(camera_basis: Basis) -> void:
	_picture.billboard = BaseMaterial3D.BILLBOARD_DISABLED
	_picture.basis = camera_basis
	_update_picture(_picture.texture)


func set_open(value: bool) -> void:
	_update_picture(open_art if value and open_art != null else art)


func _update_picture(texture: Texture2D) -> void:
	if texture == null:
		return
	_picture.texture = texture
	_picture.pixel_size = display_width / texture.get_width()
	var half_height := texture.get_height() * _picture.pixel_size * 0.5
	_picture.position = _picture.basis.x * display_offset.x
	_picture.position += _picture.basis.y * (half_height + display_offset.y)


func _add_collision() -> void:
	var body := StaticBody3D.new()
	body.name = "Footprint"
	var collider := CollisionShape3D.new()
	var shape := BoxShape3D.new()
	shape.size = Vector3(footprint.x, collider_height, footprint.y)
	collider.shape = shape
	collider.position.y = collider_height * 0.5
	body.add_child(collider)
	add_child(body)

