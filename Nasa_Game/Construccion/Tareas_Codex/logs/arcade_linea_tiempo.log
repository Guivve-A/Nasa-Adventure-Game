extends Node

# Sonido del juego (autoload "Audio"). PROVISIONAL: la Fase 4 (diseno acustico y musica) no esta validada.
#
#   Audio.sonar("ok")                 efecto suelto. Busca primero el archivo importado res://audio/<nombre>_<zona>.ogg
#                                     (variante de la zona actual, p. ej. paso_luna), luego res://audio/<nombre>.ogg
#                                     y, si no hay archivo, el pitido sintetizado de RECETAS.
#   Audio.paso()                      un paso: intervalo minimo y tono algo distinto cada vez. sonar("paso", ...)
#                                     tambien pasa por aqui (asi lo llama hoy nucleo/jugador.gd).
#   Audio.ambiente("luna", -18.0)     fondo en bucle res://audio/ambiente_<nombre>.ogg con fundidos; "" lo para.
#                                     Al cambiar de zona arranca solo el ambiente de esa zona, si su archivo existe.
#
# Los archivos salen del lote A1 de Higgsfield (Nasa_Game/Fase_4_Audio/Lote_A1/registro.md), convertidos con
# Nasa_Game/Fase_4_Audio/Lote_A1/convertir.py. Se cargan con load() sobre el recurso importado, nunca con
# load_from_file sobre res:// (falla en el juego exportado).

const TASA := 22050
const CARPETA := "res://audio/"
const RECETAS := {
	# nombre: [frecuencia inicial, frecuencia final, duracion, forma, volumen]
	"ok": [660.0, 990.0, 0.16, "seno", 0.5],
	"error": [220.0, 165.0, 0.22, "triangulo", 0.45],
	"pulsar": [520.0, 620.0, 0.06, "seno", 0.35],
	"pagina": [900.0, 300.0, 0.09, "ruido", 0.25],
	"paso": [140.0, 90.0, 0.05, "ruido", 0.30],
	"salto": [300.0, 520.0, 0.14, "seno", 0.35],
	"recoger": [780.0, 1320.0, 0.18, "seno", 0.45],
	"umbral": [392.0, 784.0, 0.35, "seno", 0.40],
	"logro": [523.0, 1046.0, 0.50, "arpegio", 0.45],
	"tic": [1200.0, 1200.0, 0.03, "seno", 0.25],
	"radio": [1800.0, 1400.0, 0.12, "ruido", 0.18],
}
const PASO_INTERVALO_MS := 210      # dos pasos nunca suenan mas cerca que esto
const PASO_AJUSTE_DB := -10.0       # los archivos de paso ya vienen normalizados (RMS de unos -21 dB)
const PASO_TONO := 0.07             # variacion de tono de un paso a otro (+-7 %)
const AMBIENTE_ENTRADA := 1.6       # s de fundido al entrar
const AMBIENTE_SALIDA := 1.1        # s de fundido al salir
const AMBIENTE_ATENUADO_DB := -9.0  # el ambiente baja mientras hay un minijuego abierto

var volumen_db := -8.0
var _muestras := {}                 # nombre -> AudioStreamWAV sintetizado
var _archivos := {}                 # ruta -> AudioStream importado o null si no existe
var _voces: Array[AudioStreamPlayer] = []
var _siguiente := 0
var _ultimo_paso_ms := -100000
var _azar := RandomNumberGenerator.new()
var _fondo: Array[AudioStreamPlayer] = []   # dos reproductores para el fundido cruzado
var _fondo_activo := 0
var _fondo_nombre := ""
var _fondo_base_db := -18.0
var _fondo_tween: Tween = null
var _atenuado := 0.0


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_azar.seed = 7
	for i in 6:
		var voz := AudioStreamPlayer.new()
		add_child(voz)
		_voces.append(voz)
	for i in 2:
		var f := AudioStreamPlayer.new()
		f.volume_db = -80.0
		add_child(f)
		_fondo.append(f)
	# Zonas es un autoload que se crea despues de este: se conecta en el cuadro siguiente
	_conectar_zonas.call_deferred()


func _conectar_zonas() -> void:
	var zonas: Node = get_node_or_null("/root/Zonas")
	if zonas != null and not zonas.zona_cambiada.is_connected(_al_cambiar_zona):
		zonas.zona_cambiada.connect(_al_cambiar_zona)


func _process(delta: float) -> void:
	# sin zona (menu principal) no hay ambiente; con un minijuego abierto, el ambiente se aparta
	var zonas: Node = get_node_or_null("/root/Zonas")
	if _fondo_nombre != "" and zonas != null and zonas.get("actual") == null and not bool(zonas.get("ocupado")):
		ambiente("")
	var interfaz: Node = get_node_or_null("/root/Interfaz")
	var meta := 0.0
	if interfaz != null and interfaz.get("anfitrion") != null and interfaz.anfitrion.visible:
		meta = AMBIENTE_ATENUADO_DB
	if absf(meta - _atenuado) > 0.01:
		_atenuado = move_toward(_atenuado, meta, delta * 12.0)
		if _fondo_nombre != "" and (_fondo_tween == null or not _fondo_tween.is_running()):
			_fondo[_fondo_activo].volume_db = _fondo_base_db + _atenuado


# ------------------------------------------------------------------ efectos

func sonar(nombre: String, ajuste_db: float = 0.0, tono: float = 1.0) -> void:
	if Juego.args.has("sin_sonido"):
		return
	if nombre == "paso":
		paso()
		return
	var stream: AudioStream = _archivo_para(nombre)
	if stream == null:
		if not RECETAS.has(nombre):
			return
		if not _muestras.has(nombre):
			_muestras[nombre] = _crear(RECETAS[nombre])
		stream = _muestras[nombre]
	var voz := _voces[_siguiente]
	_siguiente = (_siguiente + 1) % _voces.size()
	voz.stream = stream
	voz.volume_db = volumen_db + ajuste_db
	voz.pitch_scale = tono
	voz.play()


func paso(ajuste_db: float = 0.0) -> void:
	# un paso de la protagonista: lo llama quien anima la caminata (hoy, nucleo/jugador.gd via sonar("paso"))
	var ahora := Time.get_ticks_msec()
	if ahora - _ultimo_paso_ms < PASO_INTERVALO_MS:
		return
	_ultimo_paso_ms = ahora
	if _archivo_para("paso") == null:
		# sin archivo: el golpecito sintetizado de siempre, muy bajo
		_sonar_receta("paso", -26.0 + ajuste_db, _azar.randf_range(1.0 - PASO_TONO, 1.0 + PASO_TONO))
		return
	var stream: AudioStream = _archivo_para("paso")
	var voz := _voces[_siguiente]
	_siguiente = (_siguiente + 1) % _voces.size()
	voz.stream = stream
	voz.volume_db = volumen_db + PASO_AJUSTE_DB + ajuste_db + _azar.randf_range(-1.5, 1.0)
	voz.pitch_scale = _azar.randf_range(1.0 - PASO_TONO, 1.0 + PASO_TONO)
	voz.play()


func _sonar_receta(nombre: String, ajuste_db: float, tono: float) -> void:
	if not RECETAS.has(nombre):
		return
	if not _muestras.has(nombre):
		_muestras[nombre] = _crear(RECETAS[nombre])
	var voz := _voces[_siguiente]
	_siguiente = (_siguiente + 1) % _voces.size()
	voz.stream = _muestras[nombre]
	voz.volume_db = volumen_db + ajuste_db
	voz.pitch_scale = tono
	voz.play()


func tiene_archivo(nombre: String) -> bool:
	return _archivo_para(nombre) != null


func _archivo_para(nombre: String) -> AudioStream:
	# variante de la zona actual (paso_luna) y, si no hay, el archivo general (paso)
	var zonas: Node = get_node_or_null("/root/Zonas")
	var zona := String(zonas.get("id_actual")) if zonas != null else ""
	if zona != "":
		var propio := _cargar(CARPETA + nombre + "_" + zona + ".ogg")
		if propio != null:
			return propio
	return _cargar(CARPETA + nombre + ".ogg")


func _cargar(ruta: String) -> AudioStream:
	if not _archivos.has(ruta):
		var r: AudioStream = null
		if ResourceLoader.exists(ruta):
			r = load(ruta) as AudioStream
		_archivos[ruta] = r
	return _archivos[ruta]


# ------------------------------------------------------------------ ambiente

func ambiente(nombre: String, volumen_ambiente_db: float = -18.0) -> void:
	# fondo en bucle con fundido; "" lo apaga. Si ya suena el mismo, solo ajusta el volumen.
	if Juego.args.has("sin_sonido"):
		nombre = ""
	var stream: AudioStream = null
	if nombre != "":
		stream = _cargar(CARPETA + "ambiente_" + nombre + ".ogg")
		if stream == null:
extends Node

# Pruebas automaticas del juego (sin ventana). Se corren con:
#   python -I herramientas/juego_ejecutar.py -- --prueba=<nombre> --ritmo=8
# Nombres: nucleo | zonas | zona:<id> | minijuegos | minijuego:<id> | recorrido | manos | recorrido_manos
# (manos y recorrido_manos juegan con teclas simuladas, como una persona: usar --ritmo=2)
# Cada comprobacion imprime PRUEBA_OK o PRUEBA_FALLO; el envoltorio sale con 1 si hay algun fallo.

var fallos := 0
var hechas := 0


func comprobar(condicion: bool, nombre: String, detalle: String = "") -> bool:
	hechas += 1
	if condicion:
		print("PRUEBA_OK ", nombre)
	else:
		fallos += 1
		print("PRUEBA_FALLO ", nombre, (": " + detalle) if detalle != "" else "")
	return condicion


func correr(cual: String) -> void:
	var nombre := cual.get_slice(":", 0)
	var dato := cual.get_slice(":", 1) if cual.contains(":") else ""
	match nombre:
		"nucleo":
			await _nucleo()
		"zonas":
			await _zonas()
		"zona":
			await _zona(dato)
			await _enlaces([dato])
		"minijuegos":
			for m in Juego.catalogo_minijuegos():
				if String(m.get("zona", "")) == "":
					await _minijuego(m["id"])
		"minijuego":
			await _minijuego(dato)
		"recorrido":
			await _recorrido()
		"manos":
			await _manos()
		"recorrido_manos":
			await _recorrido_manos()
		"guion":
			# prueba propia de un carril: un guion con  func correr(pruebas: Node) -> void  que usa
			# pruebas.comprobar(condicion, nombre, detalle). Ejemplo: --prueba=guion:res://base/prueba_base.gd
			var ruta := cual.substr(cual.find(":") + 1)
			var guion: Variant = load(ruta) if ResourceLoader.exists(ruta) else null
			if comprobar(guion != null, "guion_de_prueba_existe", ruta):
				var nodo: Node = guion.new()
				add_child(nodo)
				await nodo.correr(self)
				nodo.queue_free()
		_:
			comprobar(false, "prueba_desconocida", cual)
	print("PRUEBAS hechas=%d fallos=%d" % [hechas, fallos])


func _esperar(segundos: float) -> void:
	await get_tree().create_timer(segundos).timeout


# ------------------------------------------------------------------ nucleo

func _nucleo() -> void:
	comprobar(not Zonas.catalogo(true).is_empty(), "catalogo_de_zonas")
	comprobar(not Juego.catalogo_minijuegos().is_empty(), "catalogo_de_minijuegos")
	comprobar(not Juego.fichas.is_empty(), "fichas_del_cuaderno", "datos/datos_espaciales.json vacio o ilegible")
	comprobar(not Juego.misiones.is_empty(), "misiones", "datos/misiones.json vacio o ilegible")
	_minimapa_datos()
	_sonido()
	Juego.nueva_partida()
	var llego: bool = await Zonas.ir_a("plantilla", "inicio")
	comprobar(llego and Zonas.actual != null, "ir_a_plantilla")
	if Zonas.actual == null:
		return
	await _esperar(0.6)
	var j: CharacterBody3D = Zonas.jugador
	comprobar(j != null and j.is_on_floor(), "protagonista_en_el_suelo", "y=%.2f" % (j.global_position.y if j != null else -99.0))
	comprobar(j.modelo != null, "modelo_de_la_protagonista_cargado")
	comprobar(Zonas.companero.modelo != null, "modelo_de_orbita_cargado")
	var ok: bool = await j.caminar_hasta(Vector3(2.0, 0.0, 1.0))
	comprobar(ok and j.global_position.distance_to(Vector3(2.0, j.global_position.y, 1.0)) < 0.5, "piloto_camina_hasta_un_punto", str(j.global_position))
	await Interfaz.decir(["Prueba de diálogo.", {"quien": "Órbita", "texto": "Miau."}])
	comprobar(not Interfaz.dialogo.visible, "dialogo_se_cierra")
	var elegido: int = await Interfaz.elegir("¿Seguimos?", ["Sí", "No"])
	comprobar(elegido == 0, "pregunta_con_opciones")
	var cartel: Node3D = Zonas.actual.get_node_or_null("Cartel")
	comprobar(cartel != null, "interactuable_existe")
	if cartel != null:
		await cartel.usar(j)
		comprobar(bool(Juego.bandera("plantilla_minijuego")), "minijuego_desde_la_zona", "la zona no puso la bandera tras el minijuego")
	Juego.poner_bandera("plantilla_paso_1")
	Juego.poner_bandera("plantilla_paso_2")
	comprobar(Juego.estado["misiones_hechas"].has("m_plantilla") or Juego.misiones.filter(func(m): return m.get("id") == "m_plantilla").is_empty(), "mision_se_completa")
	# cruza el umbral del fondo y vuelve a entrar por la otra entrada
	ok = await j.caminar_hasta(Vector3(0.0, 0.0, -4.2))
	await _esperar(1.2)
	comprobar(Zonas.id_actual == "plantilla" and j.global_position.z > 2.0, "umbral_cambia_de_entrada", "z=%.2f" % j.global_position.z)
	Zonas.cerrar()
	await _esperar(0.2)
	comprobar(Zonas.actual == null, "zona_cerrada")


# ------------------------------------------------------------------ zonas

var _entradas_por_zona := {}
var _destinos := []        # [zona origen, nombre del umbral, zona destino, entrada destino]

