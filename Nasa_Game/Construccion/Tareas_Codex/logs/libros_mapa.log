69: func _accion(nombre: String, teclas: Array, botones: Array = [], ejes: Array = []) -> void:
70: 	if InputMap.has_action(nombre):
71: 		return
72: 	InputMap.add_action(nombre, 0.35)
73: 	for t in teclas:
74: 		var tecla := InputEventKey.new()
75: 		tecla.physical_keycode = t
76: 		InputMap.action_add_event(nombre, tecla)
77: 	for b in botones:
78: 		var boton := InputEventJoypadButton.new()
79: 		boton.button_index = b
80: 		InputMap.action_add_event(nombre, boton)
81: 	for par in ejes:
82: 		var eje := InputEventJoypadMotion.new()
83: 		eje.axis = par[0]
84: 		eje.axis_value = par[1]
85: 		InputMap.action_add_event(nombre, eje)
