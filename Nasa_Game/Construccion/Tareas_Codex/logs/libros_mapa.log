250: func explicacion() -> Array:
251: 	match causa:
252: 		"rasgado":
253: 			return ["A %d km la nave todavía iba muy rápido: el paracaídas se abrió" % int(alt_paracaidas),
254: 				"con tanta fuerza que la tela se rasgó. Ábrelo más abajo, cuando ya frenó un poco.",
255: 				"Perseverance lo abrió a unos 11 km de altura."]
256: 		"poco_freno":
257: 			return ["A %d km quedaba muy poco aire por delante: el paracaídas no alcanzó" % int(alt_paracaidas),
258: 				"a frenar la nave y los cohetes no pudieron con tanta velocidad.",
259: 				"Ábrelo más arriba: Perseverance lo abrió a unos 11 km."]
260: 		"cohetes_tarde":
261: 			return ["Los cohetes se encendieron a %s km: demasiado cerca del suelo." % numero(alt_cohetes, 1),
262: 				"No hubo tiempo de frenar la caída. Enciéndelos más arriba;",
263: 				"Perseverance se soltó del paracaídas a unos 2,1 km."]
264: 		"cohetes_pronto":
265: 			return ["Los cohetes se encendieron a %s km: muy pronto." % numero(alt_cohetes, 1),
266: 				"Gastaron el combustible antes de llegar y la nave cayó los últimos metros.",
267: 				"Llegarías, pero con un golpe fuerte. Prueba entre 1 y 3 km."]
268: 		"rocas":
269: 			return ["Sin navegación por terreno, la nave no vio las rocas del valle",
