390: func _escena(tr: float, p: Array) -> void:
391: 	var c := _lienzo
392: 	var h: float = p[0]
393: 	var v: float = p[1]
394: 	_cielo(h)
395: 	# las montanas suben a medida que la nave baja
396: 	var desp := [0.0, 0.0, 0.0]
397: 	for i in 3:
398: 		var tope := [8.0, 4.0, 2.0][i] as float
399: 		var dy := clampf(h / tope, 0.0, 1.0) * 320.0
400: 		if dy < 319.0:
401: 			var tex: Texture2D = _montes[i]
402: 			var xo := -fposmod(tr * (6.0 + i * 8.0), 640.0)
403: 			for n in 2:
404: 				c.draw_texture(tex, Vector2(xo + n * 640.0, dy))
405: 			desp[i] = dy
406: 	var dy_suelo := clampf(h / 0.5, 0.0, 1.0) * 120.0
407: 	if dy_suelo < 119.0:
408: 		for n in 2:
409: 			c.draw_texture(_suelo, Vector2(n * 640.0 - fposmod(tr * 30.0, 640.0), 304.0 + dy_suelo))
410: 	# rocas sueltas si no hay navegacion por terreno
411: 	var rocas := causa == "rocas"
412: 	if rocas and dy_suelo < 119.0:
413: 		for k in 4:
414: 			var rx := 270.0 + k * 30.0
415: 			var ry := 304.0 + dy_suelo
416: 			c.draw_colored_polygon(PackedVector2Array([Vector2(rx - 9, ry + 2), Vector2(rx - 5, ry - 7 - k % 2 * 3), Vector2(rx + 6, ry - 6), Vector2(rx + 10, ry + 2)]), Color("6e2e2e"))
417: 			c.draw_line(Vector2(rx - 5, ry - 7 - k % 2 * 3), Vector2(rx + 6, ry - 6), Color("d47a45"), 1.0)
418: 	# estelas de velocidad
419: 	var rapidez := clampf(v / 2500.0, 0.0, 1.0)
420: 	for i in 30:
421: 		var sx := float((i * 97) % 640)
422: 		var sy := fposmod(float((i * 53) % 360) - tr * (80.0 + 600.0 * rapidez), 360.0)
423: 		c.draw_line(Vector2(sx, sy), Vector2(sx, sy + 4.0 + 16.0 * rapidez), Color(1, 0.95, 0.85, 0.25 + 0.3 * rapidez), 1.0)
424: 	# la nave
425: 	var w := 28.0
426: 	var alto := 80.0
427: 	var base_y := 200.0
428: 	var suelo_y := 304.0 + dy_suelo
429: 	var px := 320.0
430: 	if navegacion and h < 1.6 and causa != "cohetes_tarde":
431: 		px = 320.0 + clampf((1.6 - h) / 1.4, 0.0, 1.0) * 70.0          # se desvia hacia un lugar plano
432: 	var pie_y := lerpf(304.0, base_y, clampf(h / 0.5, 0.0, 1.0))
433: 	var tiembla := Vector2(sin(tr * 47.0), cos(tr * 39.0)) * 1.5 * rapidez
434: 	var ang := 0.0
435: 	if rocas and h <= 0.0:
436: 		ang = 0.22
437: 	var nave := Rect2(px - w * 0.5, pie_y - alto, w, alto)
438: 	var en_entrada := tr < T_ENTRADA
439: 	var tp := tr - T_ENTRADA
440: 	var tc := tr - T_ENTRADA - T_PARACAIDAS
441: 	# plasma de la entrada: la nave baja de cola con el escudo termico adelante
442: 	if en_entrada:
443: 		var fuerza := sin(clampf(tr / T_ENTRADA, 0.0, 1.0) * PI) * 0.9 + 0.1
444: 		for i in 22:
445: 			var lado := -1.0 if i % 2 == 0 else 1.0
446: 			var lx := px + lado * (8.0 + (i * 7 % 13))
447: 			var largo := (20.0 + (i * 13 % 40)) * fuerza + sin(_anim * 30.0 + i) * 5.0
448: 			c.draw_line(Vector2(lx, pie_y + 2), Vector2(lx + lado * 4.0, pie_y - largo), (Color("ffe08a") if i % 3 == 0 else NARANJA) * Color(1, 1, 1, 0.8 * fuerza), 2.0)
449: 		c.draw_circle(Vector2(px, pie_y + 4), 18.0 * fuerza + 6.0, Color(1, 0.6, 0.3, 0.35 * fuerza))
450: 	# escudo termico: plato bajo la nave hasta poco despues de abrir el paracaidas
451: 	var escudo_y := pie_y + 4.0
452: 	if tp > 0.8:
453: 		escudo_y += (tp - 0.8) * (tp - 0.8) * 160.0
454: 	if escudo_y < 380.0 and causa != "rasgado":
455: 		c.draw_colored_polygon(PackedVector2Array([Vector2(px - 20, escudo_y - 2), Vector2(px + 20, escudo_y - 2), Vector2(px + 12, escudo_y + 5), Vector2(px - 12, escudo_y + 5)]), Color("7d5210"))
456: 		c.draw_line(Vector2(px - 20, escudo_y - 2), Vector2(px + 20, escudo_y - 2), Color("d39528"), 2.0)
457: 	elif causa == "rasgado" or tp <= 0.8:
458: 		c.draw_colored_polygon(PackedVector2Array([Vector2(px - 20, pie_y + 2), Vector2(px + 20, pie_y + 2), Vector2(px + 12, pie_y + 9), Vector2(px - 12, pie_y + 9)]), Color("7d5210"))
459: 	# paracaidas
460: 	if tp >= 0.0 and tc < 0.3:
461: 		var abre := clampf(tp / 0.5, 0.0, 1.0)
462: 		var cima := Vector2(px, nave.position.y - 70.0)
463: 		if tc >= 0.0:
464: 			cima += Vector2(tc * 60.0, -tc * 400.0)          # se suelta y se va hacia arriba
465: 		var ancho := 52.0 * abre
466: 		if causa == "rasgado":
467: 			var vuela := maxf(0.0, tp - 0.6)
468: 			for k in 4:
469: 				var trozo := cima + Vector2((k - 1.5) * 18.0 + (k - 1.5) * vuela * 50.0, -vuela * 90.0 - k * 6.0 * vuela)
470: 				c.draw_arc(trozo, 9.0, PI, TAU, 6, Color("f6f1e4") if k % 2 == 0 else ROSA, 3.0)
471: 			if vuela < 0.2:
472: 				c.draw_arc(cima, ancho, PI, TAU, 20, ROSA, 6.0)
473: 		else:
474: 			c.draw_arc(cima, ancho, PI, TAU, 24, Color("f6f1e4"), 7.0)
475: 			for k in 6:
476: 				var a := PI + PI * k / 5.0
477: 				c.draw_arc(cima, ancho, a, a + PI / 10.0, 4, ROSA, 7.0)
478: 			for k in 5:
479: 				var bx := cima.x - ancho + k * ancho * 0.5
480: 				c.draw_line(Vector2(bx, cima.y), Vector2(px - 4 + k * 2, nave.position.y), Color(0.9, 0.9, 0.85, 0.7), 1.0)
481: 	# cohetes encendidos
482: 	var llama := tc >= 0.0 and h > 0.0
483: 	if causa == "cohetes_pronto" and h < 0.05:
484: 		llama = false
485: 	if causa == "poco_freno" or causa == "rasgado":
486: 		llama = false
487: 	if llama:
488: 		for i in 10:
489: 			var largo := randf_range(8.0, 22.0)
490: 			c.draw_rect(Rect2(px - 9 + i * 2, pie_y, 2, largo), Color("ffe08a") if i % 3 == 0 else NARANJA)
491: 	# cuerpo de la nave (el cohete que despego de la Luna)
492: 	if ang == 0.0:
493: 		c.draw_texture_rect(_cohete, Rect2(nave.position + tiembla, nave.size), false)
494: 	else:
495: 		c.draw_set_transform(Vector2(px, pie_y), ang, Vector2.ONE)
496: 		c.draw_texture_rect(_cohete, Rect2(Vector2(-w * 0.5, -alto), nave.size), false)
497: 		c.draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)
498: 	# polvo al tocar el suelo
499: 	if h <= 0.0 and resultado != "perdida":
500: 		var tt := tr - (T_ENTRADA + T_PARACAIDAS + T_COHETES)
501: 		for i in 16:
502: 			var a := PI + PI * i / 15.0
503: 			var r := 6.0 + tt * 60.0
504: 			c.draw_rect(Rect2(Vector2(px, suelo_y - 2) + Vector2(cos(a) * r * 1.4, sin(a) * r * 0.35), Vector2(3, 2)), Color("d47a45", clampf(1.0 - tt, 0.0, 1.0)))
505: 	# la simulacion se corta: senal perdida
506: 	if resultado == "perdida" and t >= _t_fin() - 0.25:
507: 		c.draw_rect(Rect2(0, 0, 640, 360), Color(0.06, 0.06, 0.08, 0.92))
508: 		for i in 2200:
509: 			var q := Vector2(randf() * 640.0, randf() * 360.0)
510: 			c.draw_rect(Rect2(q, Vector2(2, 1)), Color(1, 1, 1, randf() * 0.5))
511: 		_txt(Vector2(0, 230), "SEÑAL PERDIDA", ROSA, 16, 640, HORIZONTAL_ALIGNMENT_CENTER)
512: 
513: 
514: func _telemetria(p: Array) -> void:
515: 	var c := _lienzo
516: 	var r := Rect2(470, 70, 160, 92)
517: 	_caja(r, CIAN)
518: 	_txt(r.position + Vector2(8, 13), "Simulador de descenso", CIAN, 8)
519: 	_txt(r.position + Vector2(8, 29), "Altitud", SUAVE, 7)
520: 	_txt(r.position + Vector2(70, 29), (numero(p[0], 1) + " km") if p[0] >= 1.0 else ("%d m" % int(p[0] * 1000.0)), BLANCO, 8)
521: 	_txt(r.position + Vector2(8, 42), "Velocidad", SUAVE, 7)
522: 	_txt(r.position + Vector2(70, 42), numero(p[1]) + " km/h", BLANCO, 8)
523: 	var s := int(p[2])
524: 	_txt(r.position + Vector2(8, 55), "Tiempo", SUAVE, 7)
525: 	_txt(r.position + Vector2(70, 55), "%d:%02d de 7:00" % [s / 60, s % 60], BLANCO, 8)
526: 	_txt(r.position + Vector2(8, 68), "Fase", SUAVE, 7)
527: 	_txt(r.position + Vector2(70, 68), p[3], AMBAR, 8)
528: 	# lo que sabe la Tierra en ese momento: nada todavia
529: 	var rt := Rect2(10, 70, 170, 50)
530: 	_caja(rt, BORDE)
531: 	_txt(rt.position + Vector2(8, 13), "Centro de control (Tierra)", SUAVE, 7)
532: 	var espera := int(ceil(11.0 - float(s) / 60.0))
533: 	_txt(rt.position + Vector2(8, 28), "Esperando señal…", BLANCO, 8)
534: 	_txt(rt.position + Vector2(8, 41), "llegará en unos %d min" % maxi(espera, 4), SUAVE, 7)
535: 	if fmod(_anim, 1.0) < 0.5:
536: 		c.draw_circle(rt.position + Vector2(160, 10), 2.5, NARANJA)
537: 
