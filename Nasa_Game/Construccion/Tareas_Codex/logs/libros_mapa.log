320: 	# Marte visto desde arriba: una curva naranja que crece al bajar
321: 	if h > 8.0:
322: 		var r := lerpf(900.0, 3000.0, clampf((125.0 - h) / 117.0, 0.0, 1.0))
323: 		var centro := Vector2(320, 360 + r - lerpf(40.0, 150.0, clampf((125.0 - h) / 117.0, 0.0, 1.0)))
324: 		c.draw_circle(centro, r + 6.0, Color(0.95, 0.6, 0.35, 0.25))
325: 		c.draw_circle(centro, r, Color("c2683a"))
326: 		c.draw_circle(centro + Vector2(0, 30), r, Color("a8502e"))
