386: func _flecha(p: Vector2, d: int, col: Color) -> void:
387: 	_lienzo.draw_colored_polygon(PackedVector2Array([p + Vector2(d * 4, 0), p + Vector2(-d * 3, -4), p + Vector2(-d * 3, 4)]), col)
