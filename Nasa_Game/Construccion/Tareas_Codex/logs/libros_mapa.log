254: func _mover(delta: float, dir: float, correr: bool) -> void:
255: 	var v := CAMINAR
256: 	if montado:
257: 		v = VEL_ROVER if barras["energia"] > 0.0 else 30.0
258: 	elif correr:
259: 		v = CORRER
260: 	if not montado:
261: 		if barras["alimentos"] <= 0.0:
262: 			v *= 0.6
263: 		if _total(mochila) >= 3:
264: 			v *= 0.85
265: 	vel.x = dir * v
266: 	var pos: Vector2 = jugador.position
267: 	var nx := clampf(pos.x + vel.x * delta, 10.0, ancho - 10.0)
268: 	var ny := suelo_en(nx)
269: 	if en_suelo:
270: 		if ny < pos.y - 8.5:
271: 			nx = pos.x                      # escalon de mas de media casilla: hay que saltar
272: 		elif ny <= pos.y + 8.5:
273: 			pos.y = ny                      # escalon bajo: lo sube o lo baja solo
274: 		else:
275: 			en_suelo = false                # se acabo el suelo: cae
276: 	elif ny < pos.y - 0.5:
277: 		nx = pos.x                          # choca de lado contra el escalon
278: 	pos.x = nx
279: 	if not en_suelo:
280: 		vel.y += GRAVEDAD * delta
281: 		pos.y += vel.y * delta
282: 		if pos.y >= suelo_en(pos.x):
283: 			pos.y = suelo_en(pos.x)
284: 			vel.y = 0.0
285: 			en_suelo = true
286: 			impulso_listo = true
287: 	jugador.position = pos
288: 	if montado:
289: 		var nodo: Sprite2D = rover["nodo"]
290: 		rover["x"] = pos.x
291: 		nodo.position = Vector2(pos.x - 32.0, pos.y - 36.0)
292: 		if dir != 0.0:
293: 			nodo.flip_h = dir < 0.0
294: 		return
295: 	jugador.mirar(dir)
296: 	var anim := "quieto"
297: 	if not en_suelo:
298: 		anim = "saltar"
299: 	elif dir != 0.0:
300: 		anim = "caminar"
301: 	if jugador.animation != anim:
302: 		jugador.play(anim)
