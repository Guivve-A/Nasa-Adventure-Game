845: func _texto_accion(o: Dictionary) -> String:
846: 	match o["tipo"]:
847: 		"npc":
848: 			return "E: hablar con " + String(dialogos.get(o["id"], {}).get("nombre", ""))
849: 		"cajas":
850: 			return "E: recoger caja (%d)" % o["unidades"]
851: 		"veta":
852: 			return "Mantén E: extraer %s (%d)" % [o["recurso"], o["unidades"]]
853: 		"refugio":
854: 			return "E: entrar a " + REFUGIOS[o["id"]]
855: 		"rover":
856: 			return "E: subir al rover"
857: 		"constructora":
858: 			return "E: entregar recursos" if fase < 4 else "Cohete armado"
859: 		"deposito":
860: 			return "E: cargar hielo (%d %%)" % int(combustible) if fase >= 4 else "Depósito de combustible"
861: 		"panel":
862: 			return "Panel orientado al Sol" if o["orientado"] else "Mantén E: orientar el panel"
863: 		"cohete":
864: 			return "E: ¡DESPEGAR!" if listo_para_despegar() else "Cohete: fase %d/4" % fase
865: 	return ""

