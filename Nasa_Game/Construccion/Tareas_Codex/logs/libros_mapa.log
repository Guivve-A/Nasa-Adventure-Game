===== juego/minijuegos/plantilla/plantilla.gd =====
extends "res://nucleo/minijuego.gd"

# Minijuego de plantilla: «Sintoniza la señal». El ejemplo minimo de un minijuego completo.
# Se mueve un dial con izquierda y derecha (o con el raton) hasta que la onda propia coincide con la de
# referencia y se mantiene asi 1,5 s. Copia este archivo para empezar un minijuego nuevo.

const TOLERANCIA := 0.06      # diferencia de frecuencia aceptada
const SOSTENER_S := 1.5
const LIMITE_S := 30.0

var objetivo := 1.0           # frecuencia de la senal de referencia
var dial := 0.4               # frecuencia elegida por el jugador
var sostenido := 0.0
var _auto := 0                # 0 = juega la persona; 1 = solo y acierta; -1 = solo y falla
var _barra: ProgressBar
var _lectura: Label


func _preparar() -> void:
	objetivo = [1.3, 1.7, 2.3][dificultad - 1]
	dial = 0.5
	_lectura = texto("", 20, Estilo.TINTA, 600)
	_lectura.position = Vector2(24, 16)
	_lectura.custom_minimum_size = Vector2(700, 0)
	add_child(_lectura)
	_barra = ProgressBar.new()
	_barra.position = Vector2(24, size.y - 44)
	_barra.size = Vector2(size.x - 48, 22)
	_barra.max_value = SOSTENER_S
	_barra.show_percentage = false
	add_child(_barra)


func _empezar() -> void:
	sostenido = 0.0


func _paso(delta: float) -> void:
	# entrada: teclado o mando; el piloto de pruebas mueve el dial solo
	var mando := eje_x()
	if _auto == 1:
		mando = clampf((objetivo - dial) * 6.0, -1.0, 1.0)
	elif _auto == -1:
		mando = -1.0
	dial = clampf(dial + mando * delta * 0.8, 0.2, 3.0)
	var error := absf(dial - objetivo)
	if error < TOLERANCIA:
		sostenido += delta
	else:
		sostenido = maxf(sostenido - delta * 2.0, 0.0)
	_barra.value = sostenido
	_lectura.text = "Tu señal: %.2f Hz   ·   Referencia: %.2f Hz   ·   Tiempo: %d s" % [dial, objetivo, int(LIMITE_S - tiempo)]
	queue_redraw()
	if sostenido >= SOSTENER_S:
		sonar("ok")
		terminar(true, maxf(100.0 - tiempo * 2.0, 10.0), "Las dos ondas quedaron en fase a %.2f Hz." % objetivo)
	elif tiempo >= LIMITE_S:
		var causa := "Tu señal quedó por debajo: gira el dial a la derecha." if dial < objetivo else "Tu señal quedó por encima: gira el dial a la izquierda."
		terminar(false, 0.0, "Se acabó el tiempo. " + causa)
	elif _auto == -1 and tiempo > 3.0:
		terminar(false, 0.0, "Tu señal quedó por debajo de la referencia: gira el dial a la derecha.")


func _gui_input(evento: InputEvent) -> void:
	# raton: arrastrar mueve el dial
	if activo and evento is InputEventMouseMotion and (evento.button_mask & MOUSE_BUTTON_MASK_LEFT) != 0:
		dial = clampf(dial + evento.relative.x * 0.004, 0.2, 3.0)


func _draw() -> void:
	var medio := size.y * 0.5
	var ancho := size.x - 48.0
	draw_rect(Rect2(24, 70, ancho, size.y - 140), Color("1c282e"), true)
	for capa in 2:
		var frecuencia := objetivo if capa == 0 else dial
		var color := Color(Estilo.CREMA, 0.55) if capa == 0 else Estilo.CIAN
		var puntos := PackedVector2Array()
		for i in 160:
			var x := float(i) / 159.0
			puntos.append(Vector2(24.0 + x * ancho, medio + sin(x * TAU * 3.0 * frecuencia + tiempo * 2.0) * 110.0))
		draw_polyline(puntos, color, 3.0 if capa == 1 else 5.0, true)


func jugar_solo(acierta: bool) -> void:
	_auto = 1 if acierta else -1


===== juego/minijuegos/seguidor/prueba_manos.gd =====
extends Node

# Lee posicion y deslizamiento; solo actua mediante teclas fisicas.
var pulsadas: Dictionary = {}
var final: Dictionary = {}
var devuelto: bool = false


func correr(pruebas: Node) -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	Juego.modo_prueba = false
	Juego.sin_guardar = true
	Juego.minijuegos_solos = false
	await _partida(pruebas, false)
	await _partida(pruebas, true)
	Juego.modo_prueba = true


func _lanzar(parametros: Dictionary) -> void:
	final = await Interfaz.abrir_minijuego("seguidor", parametros)
	devuelto = true


func _partida(pruebas: Node, ayuda: bool) -> void:
	final = {}
	devuelto = false
	var parametros: Dictionary = {"dificultad": 1}
	if ayuda:
		parametros["modo"] = "prealimentacion"
	_lanzar(parametros)
	var limite := 5.0
	while not Interfaz.anfitrion.visible and limite > 0.0:
		await _real(0.1)
		limite -= 0.1
	await _real(0.15)
	var m: Control = Interfaz.anfitrion.get("_minijuego")
	var nombre := "seguidor.manos.cielo" if ayuda else "seguidor.manos.normal"
	pruebas.comprobar(m != null and Interfaz.anfitrion.visible, nombre + ".abierto", str(parametros))
	if m == null:
		return
	pruebas.comprobar(int(m.get("_auto")) == 0 and int(m.get("_solo")) == 0, nombre + ".sin_piloto", "Entrada fisica")
	pruebas.comprobar(m.size == Vector2(1280, 720), nombre + ".pantalla_completa", str(m.size))
	await _toque(KEY_ENTER)
	limite = 110.0
	while is_instance_valid(m) and bool(m.get("activo")) and limite > 0.0:
		if int(m.get("fase")) == 2:
			if ayuda and not bool(m.get("cielo")):
				await _toque(KEY_E)
			var error: float = float(m.get("luna_x")) - float(m.get("visor_x"))
			var velocidad: float = float(m.get("visor_v"))
			var deriva: float = float(m.get("vel_cielo"))
			# Impulsos de una decima; anticipa el frenado mirando el deslizamiento.
			var sobra := velocidad - deriva
			var orden := 6.0 * error - 3.5 * sobra
			_tecla(KEY_D, orden > 8.0)
			_tecla(KEY_A, orden < -8.0)
			var base: float = deriva if bool(m.get("cielo")) else 0.0
			_tecla(KEY_SPACE, absf(sobra) > 20.0 and (velocidad - base) * sobra > 0.0 and absf(error) < 0.45 * absf(sobra) + 4.0)
		await _real(0.1)
		limite -= 0.1
	for codigo in pulsadas.keys():
		_tecla(int(codigo), false)
	await _real(0.3)
	var resultado: Dictionary = Interfaz.anfitrion.get("_resultado")
	pruebas.comprobar(bool(resultado.get("superado", false)), nombre + ".superado", str(resultado))
	print("MANOS ", nombre, " ", resultado)
	await _toque(KEY_ENTER)
	await _real(0.3)
	pruebas.comprobar(devuelto and bool(final.get("superado", false)), nombre + ".resultado_devuelto", str(final))
	pruebas.comprobar(not Interfaz.anfitrion.visible, nombre + ".anfitrion_cerrado", str(Interfaz.anfitrion.visible))
	pruebas.comprobar(not get_tree().paused, nombre + ".arbol_sin_pausa", str(get_tree().paused))
	if ayuda:
		var cuaderno: Array = Juego.estado.get("cuaderno", [])
		pruebas.comprobar(cuaderno.has("prealimentacion"), nombre + ".ficha_anotada", str(cuaderno))


func _tecla(codigo: int, abajo: bool) -> void:
	if bool(pulsadas.get(codigo, false)) == abajo:
		return
	pulsadas[codigo] = abajo
	var evento := InputEventKey.new()
	evento.physical_keycode = codigo
	evento.keycode = codigo
	evento.pressed = abajo
	Input.parse_input_event(evento)


func _toque(codigo: int) -> void:
	_tecla(codigo, true)
	await get_tree().process_frame
	await get_tree().physics_frame
	await get_tree().process_frame
	_tecla(codigo, false)
	await get_tree().process_frame


func _real(segundos: float) -> void:
	await get_tree().create_timer(segundos, true, false, true).timeout


