564: func _llegada() -> void:
565: 	var c := _lienzo
566: 	var k := clampf(_t_llegada / 4.0, 0.0, 1.0)
567: 	c.draw_rect(Rect2(0, 0, 640, 360), Color(0.02, 0.02, 0.04, 1.0))
568: 	var a := clampf(_t_llegada * 1.5, 0.0, 1.0) * clampf((4.0 - _t_llegada) * 1.5, 0.0, 1.0)
569: 	_txt(Vector2(0, 160), "El programa viaja a la nave… y la nave baja sola.", Color(BLANCO, a), 9, 640, HORIZONTAL_ALIGNMENT_CENTER)
570: 	_txt(Vector2(0, 180), "Once minutos después, la Tierra recibe la señal:", Color(SUAVE, a), 8, 640, HORIZONTAL_ALIGNMENT_CENTER)
571: 	_txt(Vector2(0, 202), "¡Estamos en Marte!", Color(AMBAR, a * clampf((k - 0.35) * 4.0, 0.0, 1.0)), 16, 640, HORIZONTAL_ALIGNMENT_CENTER)

