252: func _minijuego(id: String) -> void:
253: 	var meta := Juego.info_minijuego(id)
254: 	if not comprobar(not meta.is_empty(), "%s.minijuego_json" % id):
255: 		return
256: 	for clave in ["titulo", "resumen", "controles"]:
257: 		comprobar(String(meta.get(clave, "")) != "", "%s.json.%s" % [id, clave])
258: 	comprobar((meta.get("instrucciones", []) as Array).size() >= 2, "%s.json.instrucciones" % id, "faltan al menos 2 pasos")
259: 	comprobar((meta.get("pistas", []) as Array).size() >= 3, "%s.json.pistas" % id, "faltan las 3 pistas de Orbita")
260: 	var ficha: String = meta.get("ficha", "")
261: 	comprobar(ficha == "" or not Juego.ficha(ficha).is_empty(), "%s.json.ficha" % id, "la ficha '%s' no esta en datos_espaciales.json" % ficha)
262: 	for dificultad in [1, 3]:
263: 		var r: Dictionary = await _jugar_con_limite(id, {"dificultad": dificultad}, 60.0)
264: 		comprobar(not r.get("colgado", false), "%s.d%d.termina_solo" % [id, dificultad], "no termino en 60 s de juego")
265: 		comprobar(bool(r.get("superado", false)), "%s.d%d.se_puede_superar" % [id, dificultad], str(r.get("detalle", "")))
266: 	var mal: Dictionary = await _jugar_con_limite(id, {"dificultad": 1, "fallar": true}, 60.0)
267: 	comprobar(not mal.get("colgado", false) and not bool(mal.get("superado", true)), "%s.se_puede_fallar" % id, "jugar_solo(false) debe terminar sin superar")
268: 	comprobar(String(mal.get("detalle", "")).length() > 12, "%s.el_fallo_explica_la_causa" % id, "detalle vacio o muy corto: '%s'" % str(mal.get("detalle", "")))
269: 
270: 
271: # ------------------------------------------------------------------ recorrido completo
272: 
273: func _recorrido() -> void:
274: 	# historia de punta a punta con el piloto automatico: cada zona aporta su ruta_de_prueba()
275: 	Juego.nueva_partida()
276: 	var orden: Array = Juego.leer_json("res://datos/misiones.json").get("recorrido_de_prueba", [])
277: 	if not comprobar(not orden.is_empty(), "recorrido.definido", "falta 'recorrido_de_prueba' en datos/misiones.json"):
278: 		return
279: 	for tramo in orden:
280: 		var id: String = tramo["zona"]
281: 		await _esperar(0.3)
282: 		while Zonas.ocupado:
283: 			await get_tree().process_frame
284: 		if Zonas.id_actual != id:
285: 			var llego: bool = await Zonas.ir_a(id, tramo.get("entrada", "inicio"))
286: 			if not comprobar(llego, "recorrido.%s.carga" % id):
287: 				return
288: 		await _esperar(0.5)
289: 		var ruta: Array = Zonas.actual.ruta_de_prueba()
290: 		await _seguir_ruta(id, ruta)
291: 		await _esperar(0.3)
292: 		while Zonas.ocupado:
293: 			await get_tree().process_frame
294: 		for b in tramo.get("banderas", []):
295: 			comprobar(bool(Juego.bandera(b)), "recorrido.%s.bandera_%s" % [id, b])
296: 	# las secundarias (los libros de la biblioteca) no cuentan para cerrar la historia
297: 	var queda := Juego.mision_activa()
298: 	comprobar(queda.is_empty() or bool(queda.get("secundaria", false)), "recorrido.todas_las_misiones_principales_hechas", "queda activa: %s" % str(queda.get("id", "")))
