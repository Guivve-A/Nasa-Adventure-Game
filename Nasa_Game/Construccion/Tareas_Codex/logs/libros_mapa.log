228: var _resultado_mj := {}
229: var _listo_mj := false
230: 
231: 
232: func _lanzar(id: String, parametros: Dictionary) -> void:
233: 	_resultado_mj = await Interfaz.abrir_minijuego(id, parametros)
234: 	_listo_mj = true
235: 
236: 
237: func _jugar_con_limite(id: String, parametros: Dictionary, limite_s: float) -> Dictionary:
238: 	_listo_mj = false
239: 	_resultado_mj = {}
240: 	_lanzar(id, parametros)
241: 	var restante := limite_s
242: 	while not _listo_mj and restante > 0.0:
243: 		await get_tree().process_frame
244: 		restante -= get_process_delta_time()
245: 	if not _listo_mj:
246: 		Interfaz.anfitrion._abandonar()
247: 		await _esperar(0.3)
248: 		return {"superado": false, "colgado": true}
249: 	return _resultado_mj
