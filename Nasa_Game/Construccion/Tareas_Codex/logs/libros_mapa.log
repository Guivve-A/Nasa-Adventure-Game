77: # ---------- programa ----------
78: func programar(paracaidas: float, cohetes: float, trn: bool) -> void:
79: 	alt_paracaidas = clampf(snappedf(paracaidas, 1.0), PAR_MIN, PAR_MAX)
80: 	alt_cohetes = clampf(snappedf(cohetes, 0.1), COH_MIN, COH_MAX)
81: 	navegacion = trn
82: 
83: 
84: func ajustar(d: int) -> void:
85: 	match fila:
86: 		0:
87: 			alt_paracaidas = clampf(alt_paracaidas + d, PAR_MIN, PAR_MAX)
88: 		1:
89: 			alt_cohetes = clampf(snappedf(alt_cohetes + d * 0.1, 0.1), COH_MIN, COH_MAX)
90: 		2:
91: 			navegacion = not navegacion
92: 
93: 
94: func probar() -> void:
95: 	intentos += 1
96: 	_evaluar()
97: 	estado = "descenso"
98: 	t = 0.0
99: 
100: 
101: func _evaluar() -> void:
102: 	resultado = "suave"
103: 	causa = ""
104: 	if alt_paracaidas > 13.0:
105: 		resultado = "perdida"
106: 		causa = "rasgado"
107: 	elif alt_paracaidas < 7.0:
108: 		resultado = "perdida"
109: 		causa = "poco_freno"
110: 	elif alt_cohetes < 1.0:
111: 		resultado = "perdida"
112: 		causa = "cohetes_tarde"
113: 	elif alt_cohetes > 3.0:
114: 		resultado = "duro"
115: 		causa = "cohetes_pronto"
116: 	elif not navegacion:
117: 		resultado = "duro"
118: 		causa = "rocas"
