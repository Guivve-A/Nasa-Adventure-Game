===== Misión Artemis\codigo\fondo_parallax.gd =====
1: extends Node2D
2: 
3: # Fondo con parallax por capas. Sirve para la Luna y para Marte: solo cambia la carpeta.
4: # Cada capa es un PNG de 640 x 360 que se repite en horizontal, con estos nombres:
5: #   capa_0_espacio, capa_0b_sol_tierra, capa_1_montanas_lejanas, capa_2_montanas_medias, capa_3_colinas_cercanas
6: # Si falta un PNG, esa capa se dibuja como una silueta lisa (reserva), para poder jugar antes de tener el arte.
7: 
8: const CAPAS := [["capa_0_espacio", 0.02], ["capa_0b_sol_tierra", 0.06], ["capa_1_montanas_lejanas", 0.18], ["capa_2_montanas_medias", 0.35], ["capa_3_colinas_cercanas", 0.6]]
9: const ANCHO := 640.0
10: const ALTO := 360.0
11: 
12: 
13: # carpeta: donde estan los PNG. reserva: un color por capa. Devuelve cuantas capas tenian su PNG.
14: func armar(carpeta: String, reserva: Array = [], corrimiento_astros := 0.0) -> int:
15: 	var cargadas := 0
16: 	for i in CAPAS.size():
17: 		var p := Parallax2D.new()
18: 		p.scroll_scale = Vector2(CAPAS[i][1], 0.0)
19: 		p.repeat_size = Vector2(ANCHO, 0.0)
20: 		p.repeat_times = 3
21: 		if i == 1:
22: 			p.scroll_offset = Vector2(corrimiento_astros, 0.0)
23: 		add_child(p)
24: 		var ruta: String = carpeta + "/" + CAPAS[i][0] + ".png"
25: 		if ResourceLoader.exists(ruta):
26: 			var s := Sprite2D.new()
27: 			s.texture = load(ruta)
28: 			s.centered = false
29: 			p.add_child(s)
30: 			cargadas += 1
31: 		elif i < reserva.size():
32: 			p.add_child(_silueta(i, reserva[i]))
33: 	return cargadas
34: 
35: 
36: func _silueta(i: int, color: Color) -> Node2D:
37: 	var pol := Polygon2D.new()
38: 	pol.color = color
39: 	var pts := PackedVector2Array()
40: 	if i == 0:
41: 		pts = PackedVector2Array([Vector2(0, 0), Vector2(ANCHO, 0), Vector2(ANCHO, ALTO), Vector2(0, ALTO)])
42: 	elif i == 1:
43: 		# un sol pequeno: desde Marte el Sol se ve mas chico que desde la Tierra
44: 		for k in 16:
45: 			pts.append(Vector2(110, 120) + Vector2.from_angle(TAU * k / 16.0) * 7.0)
46: 	else:
47: 		var base := [0.0, 0.0, 190.0, 232.0, 268.0][i] as float
48: 		var amp := [0.0, 0.0, 34.0, 24.0, 14.0][i] as float
49: 		for x in range(0, int(ANCHO) + 1, 8):
50: 			var a := TAU * x / ANCHO
51: 			pts.append(Vector2(x, base - amp * (sin(a * (i - 1)) + 0.5 * sin(a * 3.0 * i + i))))
52: 		pts.append(Vector2(ANCHO, ALTO))
53: 		pts.append(Vector2(0, ALTO))
54: 	pol.polygon = pts
55: 	return pol

