===== Misión Artemis\codigo\principal.gd =====
1: extends Node
2: 
3: # Mision Artemis: Mas alla de las paginas. Encadena los capitulos: Luna -> Viaje -> Marte -> Fin.
4: # Argumentos (tras "--"):
5: #   --capitulo=luna|viaje|marte   empieza en ese capitulo
6: #   --prueba                      juega solo de principio a fin, comprueba cada paso y sale (0 si todo paso)
7: #   --capturas=<carpeta>          con --prueba, guarda capturas de cada momento
8: 
9: const Luna := preload("nivel_luna.gd")
10: const Viaje := preload("viaje.gd")
11: const Marte := preload("nivel_marte.gd")
12: const Hud := preload("hud.gd")
13: 
14: var actual: Node
15: var capitulo := ""
16: var args := {}
17: var resumen := {"tiempo": 0.0, "rescates": 0}
18: var _ok := 0
19: var _mal := 0
20: 
21: 
22: func _ready() -> void:
23: 	for s in OS.get_cmdline_user_args():
24: 		var limpio := s.trim_prefix("--")
25: 		var i := limpio.find("=")
26: 		if i >= 0:
27: 			args[limpio.substr(0, i)] = limpio.substr(i + 1)
28: 		else:
29: 			args[limpio] = "1"
30: 	abrir(String(args.get("capitulo", "luna")))
31: 	if args.has("prueba"):
32: 		_prueba()
33: 
34: 
35: func abrir(c: String) -> void:
36: 	if actual != null:
37: 		actual.queue_free()
38: 	capitulo = c
39: 	match c:
40: 		"viaje":
41: 			actual = Viaje.new()
42: 			actual.llegada.connect(func(): abrir.call_deferred("marte"))
43: 		"marte":
44: 			actual = Marte.new()
45: 			actual.terminado.connect(func(): abrir.call_deferred("fin"))
46: 		"fin":
47: 			actual = Node2D.new()
48: 			var hud = Hud.new()
49: 			hud.capitulo = "Fin"
50: 			var minutos := int(resumen["tiempo"]) / 60
51: 			hud.panel = {"titulo": "Misión cumplida", "lineas": [
52: 				"Construiste el cohete, cruzaste el espacio y levantaste la base marciana.",
53: 				"La protagonista cierra el libro… y mira al cielo.",
54: 				"",
55: 				"Tiempo en la Luna: %d min %d s   ·   Rescates: %d" % [minutos, int(resumen["tiempo"]) % 60, resumen["rescates"]],
56: 				"",
57: 				"R: volver a empezar"]}
58: 			actual.add_child(hud)
59: 		_:
60: 			capitulo = "luna"
61: 			actual = Luna.new()
62: 			actual.despegue.connect(func(r): resumen = r; abrir.call_deferred("viaje"))
63: 	add_child(actual)
64: 
65: 
66: func _unhandled_input(evento: InputEvent) -> void:
67: 	var tecla := evento as InputEventKey
68: 	if tecla == null or not tecla.pressed or tecla.echo:
69: 		return
70: 	if tecla.keycode == KEY_R and capitulo == "fin":
71: 		abrir("luna")
72: 	elif tecla.keycode == KEY_F11:
73: 		var w := get_window()
74: 		w.mode = Window.MODE_WINDOWED if w.mode == Window.MODE_FULLSCREEN else Window.MODE_FULLSCREEN
75: 
76: 
77: # ---------- prueba automatica ----------
78: func _ver(nombre: String, cond: bool) -> void:
79: 	if cond:
80: 		_ok += 1
81: 	else:
82: 		_mal += 1
83: 	print(("  ok    " if cond else "  FALLA ") + nombre)
84: 
85: 
86: func _esperar(s: float) -> void:
87: 	await get_tree().create_timer(s).timeout
88: 
89: 
90: func _captura(nombre: String) -> void:
91: 	if not args.has("capturas"):
92: 		return
93: 	await RenderingServer.frame_post_draw
94: 	get_viewport().get_texture().get_image().save_png(String(args["capturas"]).path_join(nombre + ".png"))
95: 
96: 
97: func _lleno(l) -> void:
98: 	l.barras["oxigeno"] = 100.0
99: 	l.barras["energia"] = 100.0
100: 	l.barras["alimentos"] = 100.0
101: 	l.barras["radiacion"] = 0.0
102: 
103: 
104: func _reunir(l, recurso: String, n: int) -> void:
105: 	# recoge n unidades de un recurso con las acciones reales del jugador
106: 	var intentos := 0
107: 	while int(l.mochila[recurso]) < n and intentos < 200:
108: 		intentos += 1
109: 		var hallado = null
110: 		for o in l.objetos:
111: 			if (recurso == "caja" and o["tipo"] == "cajas" or o["tipo"] == "veta" and o.get("recurso", "") == recurso) and int(o["unidades"]) > 0:
112: 				hallado = o
113: 				break
114: 		if hallado == null:
115: 			return
116: 		l.teletransportar(hallado["x"])
117: 		_lleno(l)
118: 		if recurso == "caja":
119: 			l.interactuar()
120: 		else:
121: 			l.mantener(0.4)
122: 		await get_tree().physics_frame
123: 
124: 
125: func _prueba() -> void:
126: 	Engine.time_scale = 6.0
127: 	var l = actual
128: 	l.control_externo = true
129: 	l.eventos_auto = false
130: 	await _esperar(0.5)
131: 	print("PRUEBA Mision Artemis")
132: 	_ver("el nivel carga sus objetos", l.objetos.size() >= 30)
133: 	await _captura("01_inicio")
134: 	# movimiento
135: 	var x0: float = l.jugador.position.x
136: 	l.dir_externa = 1.0
137: 	await _esperar(1.0)
138: 	_ver("camina a la derecha", l.jugador.position.x > x0 + 40.0)
139: 	l.dir_externa = 0.0
140: 	l.saltar()
141: 	await _esperar(0.25)
142: 	var y_salto: float = l.jugador.position.y
143: 	_ver("salta", not l.en_suelo and y_salto < l.suelo_en(l.jugador.position.x) - 15.0)
144: 	var e0: float = l.barras["energia"]
145: 	l.saltar()
146: 	await _esperar(0.3)
147: 	_ver("el impulso de mochila gasta energia", l.barras["energia"] < e0 - 5.0)
148: 	await _esperar(2.5)
149: 	_ver("vuelve al suelo", l.en_suelo)
150: 	# medidores
151: 	l.teletransportar(2000.0)
152: 	_lleno(l)
153: 	await _esperar(3.0)
154: 	_ver("fuera de la base baja el oxigeno", l.barras["oxigeno"] < 99.0)
155: 	_ver("lejos de la base sube la radiacion", l.barras["radiacion"] > 0.5)
156: 	var cupula = null
157: 	for o in l.objetos:
158: 		if o["id"] == "cupula":
159: 			cupula = o
160: 	l.teletransportar(cupula["x"])
161: 	l.barras["oxigeno"] = 40.0
162: 	l.interactuar()
163: 	_ver("entra a la cupula", l.dentro != null)
164: 	await _esperar(1.5)
165: 	_ver("dentro sube el oxigeno", l.barras["oxigeno"] > 55.0)
166: 	# lluvia solar
167: 	l.dir_externa = 1.0
168: 	await _esperar(0.2)
169: 	l.dir_externa = 0.0
170: 	_ver("sale al moverse", l.dentro == null)
171: 	l.teletransportar(300.0)
172: 	_lleno(l)
173: 	l.iniciar_lluvia(0.0)
174: 	await _esperar(2.0)
175: 	_ver("la lluvia solar sube la radiacion", l.barras["radiacion"] > 8.0)
176: 	await _captura("02_lluvia_solar")
177: 	l.estado_lluvia = 0
178: 	# meteorito
179: 	var antes: int = l.objetos.size()
180: 	l.teletransportar(330.0)
181: 	_lleno(l)
182: 	l.lanzar_meteorito(370.0, 0.6)      # un hueco libre de la pista: junto a un prop no deja veta
183: 	await _esperar(0.4)
184: 	await _captura("03_aviso_meteorito")
185: 	await _esperar(1.2)
186: 	_ver("el meteorito deja una veta nueva", l.objetos.size() == antes + 1)
187: 	# rescate
188: 	l.barras["oxigeno"] = 0.0
189: 	await _esperar(0.2)
190: 	_ver("sin oxigeno hay rescate en la cupula", l.rescates == 1 and absf(l.jugador.position.x - 616.0) < 5.0)
191: 	# dialogo
192: 	for o in l.objetos:
193: 		if o["tipo"] == "npc" and o["id"] == "comandante":
194: 			l.teletransportar(o["x"] - 10.0)
195: 	l.interactuar()
196: 	_ver("abre el dialogo de la comandante", not l.hud.dialogo.is_empty())
197: 	await _esperar(0.3)
198: 	await _captura("04_dialogo")
199: 	for i in 4:
200: 		l.interactuar()
201: 	_ver("el dialogo se cierra", l.hud.dialogo.is_empty())
202: 	# rover
203: 	l.teletransportar(l.rover["x"])
204: 	l.interactuar()
205: 	_ver("sube al rover", l.montado)
206: 	var xr: float = l.jugador.position.x
207: 	l.dir_externa = -1.0
208: 	await _esperar(1.0)
209: 	l.dir_externa = 0.0
210: 	_ver("el rover es mas rapido que caminar", xr - l.jugador.position.x > 100.0)
211: 	await _captura("05_rover")
212: 	l.teletransportar(1720.0)
213: 	l.cerca = null
214: 	l.interactuar()
215: 	_ver("baja del rover", not l.montado)
216: 	# fases del cohete
217: 	for f in 4:
218: 		var req: Dictionary = l.FASES[f]
219: 		for k in req:
220: 			var falta := int(req[k])
221: 			while falta > 0:
222: 				var lote := mini(falta, 4)
223: 				await _reunir(l, k, lote)
224: 				for o in l.objetos:
225: 					if o["tipo"] == "constructora":
226: 						l.teletransportar(o["x"])
227: 				l.interactuar()
228: 				falta -= lote
229: 		_ver("fase %d del cohete" % (f + 1), l.fase == f + 1)
230: 		if f == 1:
231: 			await _esperar(0.5)
232: 			await _captura("06_cohete_fase_2")
233: 	# despegue
234: 	_ver("armado, aun no puede despegar", not l.listo_para_despegar())
235: 	for o in l.objetos:
236: 		if o["tipo"] == "panel":
237: 			l.teletransportar(o["x"])
238: 			for i in 4:
239: 				l.mantener(0.3)
240: 	_ver("orienta los tres paneles", l.paneles_orientados == 3)
241: 	await _reunir(l, "hielo", 4)
242: 	await _captura("07_crater_hielo")
243: 	for o in l.objetos:
244: 		if o["tipo"] == "deposito":
245: 			l.teletransportar(o["x"])
246: 	l.interactuar()
247: 	_ver("el hielo llena el combustible", l.combustible >= 100.0)
248: 	var espera := 0
249: 	while l.bateria < 100.0 and espera < 60:
250: 		espera += 1
251: 		_lleno(l)
252: 		await _esperar(1.0)
253: 	_ver("los paneles cargan la bateria", l.bateria >= 100.0)
254: 	l.teletransportar(l.cohete["x"])
255: 	await _esperar(0.3)
256: 	await _captura("08_listo_para_despegar")
257: 	l.interactuar()
258: 	await _esperar(1.5)
259: 	await _captura("09_despegue")
260: 	await _esperar(3.0)
261: 	_ver("pasa al viaje", capitulo == "viaje")
262: 	await _esperar(4.0)
263: 	await _captura("10_viaje")
264: 	await _esperar(7.0)
265: 	_ver("llega a Marte", capitulo == "marte")
266: 	var m = actual
267: 	m.control_externo = true
268: 	await _esperar(0.5)
269: 	await _captura("11_marte_llegada")
270: 	for p in m.puntos:
271: 		if p["tipo"] == "bandera":
272: 			m.teletransportar(p["x"])
273: 			m.interactuar()
274: 	_ver("planta las tres banderas", m.banderas == 3)
275: 	await _esperar(0.8)
276: 	await _captura("12_marte_banderas")
277: 	for p in m.puntos:
278: 		if p["tipo"] == "modulo":
279: 			m.teletransportar(p["x"])
280: 			for i in 5:
281: 				m.mantener(0.3)
282: 	_ver("despliega los tres modulos", m.modulos == 3)
283: 	await _esperar(1.0)
284: 	await _captura("13_marte_base")
285: 	await _esperar(2.5)
286: 	_ver("llega al final", capitulo == "fin")
287: 	await _esperar(0.5)
288: 	await _captura("14_fin")
289: 	print("PRUEBA: %d de %d" % [_ok, _ok + _mal])
290: 	get_tree().quit(0 if _mal == 0 else 1)

===== Misión Artemis\codigo\viaje.gd =====
1: extends Node2D
2: 
3: # Capitulo 2: pantalla de carga animada. El cohete viaja de la Luna a Marte sobre una trayectoria de puntos.
4: # Si existe recursos/fondos_viaje/fondo.png (640 x 360) se usa de fondo; si no, el cielo de estrellas de la Luna.
5: 
6: signal llegada
7: 
8: const Hud := preload("hud.gd")
9: const DURACION := 9.0
10: const P0 := Vector2(112, 228)
11: const P1 := Vector2(300, 20)
12: const P2 := Vector2(528, 118)
13: const FRASES := [
14: 	"El cohete deja atrás la Luna.",
15: 	"Un viaje real a Marte dura muchos meses. En el libro, cabe en una página.",
16: 	"Marte se acerca: prepara las banderas.",
17: ]
18: 
19: var t := 0.0
20: var _cohete: Sprite2D
21: var _hud
22: 
23: 
24: func _ready() -> void:
25: 	var raiz: String = (get_script() as Script).resource_path.get_base_dir().get_base_dir()
26: 	var fondo := Sprite2D.new()
27: 	var propio: String = raiz + "/recursos/fondos_viaje/fondo.png"
28: 	fondo.texture = load(propio if ResourceLoader.exists(propio) else raiz + "/recursos/fondos_luna/5_polo_sur_sol_eterno/capa_0_espacio.png")
29: 	fondo.centered = false
30: 	fondo.z_index = -2
31: 	add_child(fondo)
32: 	_cohete = Sprite2D.new()
33: 	_cohete.texture = load(raiz + "/recursos/props/cohete_4.png")
34: 	_cohete.scale = Vector2(0.4, 0.4)
35: 	_cohete.z_index = 2
36: 	add_child(_cohete)
37: 	var cam := Camera2D.new()
38: 	cam.position = Vector2(320, 180)
39: 	add_child(cam)
40: 	cam.make_current()
41: 	_hud = Hud.new()
42: 	_hud.capitulo = "Capítulo 2 — El viaje"
43: 	add_child(_hud)
44: 
45: 
46: func _punto(k: float) -> Vector2:
47: 	return P0.lerp(P1, k).lerp(P1.lerp(P2, k), k)
48: 
49: 
50: func _process(delta: float) -> void:
51: 	t += delta
52: 	var k := clampf(t / DURACION, 0.0, 1.0)
53: 	k = k * k * (3.0 - 2.0 * k)
54: 	var p := _punto(k)
55: 	_cohete.position = p
56: 	_cohete.rotation = (_punto(minf(k + 0.01, 1.0)) - _punto(maxf(k - 0.01, 0.0))).angle() + PI * 0.5
57: 	_hud.aviso = FRASES[mini(int(t / DURACION * FRASES.size()), FRASES.size() - 1)]
58: 	_hud.pie = "Rumbo a Marte…"
59: 	queue_redraw()
60: 	if t >= DURACION:
61: 		set_process(false)
62: 		llegada.emit()
63: 
64: 
65: func _disco(c: Vector2, r: float, claro: Color, oscuro: Color, manchas: Array) -> void:
66: 	for y in range(-int(r), int(r) + 1):
67: 		var hw := floorf(sqrt(r * r - y * y))
68: 		draw_rect(Rect2(c.x - hw, c.y + y, hw * 2.0, 1.0), claro)
69: 		# lado en sombra, a la derecha, con borde escalonado
70: 		var corte := hw * 0.25 + float((y & 1)) * 1.0
71: 		draw_rect(Rect2(c.x + corte, c.y + y, hw - corte, 1.0), oscuro)
72: 	for m in manchas:
73: 		draw_circle(c + Vector2(m[0], m[1]), m[2], oscuro.lerp(claro, 0.35))
74: 
75: 
76: func _draw() -> void:
77: 	_disco(Vector2(84, 258), 52.0, Color("b4b9d0"), Color("4a4e68"), [[-22, -14, 7], [-8, 16, 9], [-30, 12, 5], [-12, -30, 4]])
78: 	_disco(Vector2(556, 100), 36.0, Color("d0703c"), Color("6e2f1c"), [[-14, -8, 6], [-6, 12, 8], [-20, 8, 3]])
79: 	draw_rect(Rect2(548, 65, 12, 2), Color("f4e4d8"))      # casquete polar
80: 	var k := clampf(t / DURACION, 0.0, 1.0)
81: 	k = k * k * (3.0 - 2.0 * k)
82: 	for i in 41:
83: 		var q := i / 40.0
84: 		draw_rect(Rect2(_punto(q) - Vector2(1, 1), Vector2(2, 2)), Color("62e4e0") if q <= k else Color("33405e"))
85: 	# llama del motor
86: 	var atras := -Vector2.from_angle(_cohete.rotation - PI * 0.5)
87: 	for i in 5:
88: 		draw_rect(Rect2(_cohete.position + atras * (34.0 + i * 3.0 + randf() * 3.0) - Vector2(1.5, 1.5), Vector2(3, 3)), Color("ffe08a") if i < 2 else Color("f08a5d"))
89: 	# barra de avance
90: 	draw_rect(Rect2(220, 330, 200, 6), Color("232a40"))
91: 	draw_rect(Rect2(220, 330, 200.0 * clampf(t / DURACION, 0.0, 1.0), 6), Color("62e4e0"))

===== Misión Artemis\codigo\nivel_marte.gd =====
1: extends Node2D
2: 
3: # Capitulo 3: Marte. PROVISIONAL: el arte y el diseno final los trabaja Domenica.
4: # Fondos: copia los PNG a recursos/fondos_marte/ con los mismos nombres de capa que la Luna y aparecen solos.
5: # Mientras no esten, cada capa es una silueta de color liso.
6: # Objetivos: plantar 3 banderas (EE. UU., Ecuador, IEEE IAS) y desplegar los 3 modulos de la base.
7: 
8: signal terminado
9: 
10: const Personaje := preload("personaje.gd")
11: const Fondo := preload("fondo_parallax.gd")
12: const Hud := preload("hud.gd")
13: 
14: const SUELO_Y := 304.0
15: const ANCHO := 1280.0
16: const CAMINAR := 80.0
17: const GRAVEDAD := 600.0           # Marte: 0,38 de la gravedad terrestre; el salto es mas corto que en la Luna
18: const SALTO := 158.0
19: const T_DESPLEGAR := 1.2
20: const RESERVA := [Color("1a0f14"), Color("ffe9c4"), Color("4a2018"), Color("6e2f1c"), Color("94441f")]
21: const BANDERAS := [["bandera_usa", "Estados Unidos", 420.0], ["bandera_ecuador", "Ecuador", 470.0], ["bandera_ieee", "IEEE IAS — ESPOL", 520.0]]
22: const MODULOS := [["cupula", "el hábitat", 640.0], ["invernadero", "el invernadero", 830.0], ["paneles", "los paneles solares", 1000.0]]
23: 
24: var control_externo := false
25: var dir_externa := 0.0
26: var raiz := ""
27: var jugador
28: var camara: Camera2D
29: var hud
30: var vel := Vector2.ZERO
31: var en_suelo := true
32: var puntos: Array = []            # {tipo, id, nombre, x, nodo, hecho}
33: var cerca = null
34: var banderas := 0
35: var modulos := 0
36: var fondos_reales := 0
37: var acabado := false
38: 
39: var _suelo: Node2D
40: var _progreso := 0.0
41: var _e_antes := false
42: var _s_antes := false
43: var _aviso := "Aterrizaste en Marte. Planta las tres banderas."
44: var _t_aviso := 5.0
45: 
46: 
47: func _ready() -> void:
48: 	raiz = (get_script() as Script).resource_path.get_base_dir().get_base_dir()
49: 	var fondo = Fondo.new()
50: 	add_child(fondo)
51: 	fondos_reales = fondo.armar(raiz + "/recursos/fondos_marte", RESERVA)
52: 	_suelo = Node2D.new()             # el suelo va en un nodo propio, por delante del fondo
53: 	_suelo.z_index = 1
54: 	_suelo.draw.connect(_dibujar_suelo)
55: 	add_child(_suelo)
56: 	var cohete := Sprite2D.new()
57: 	cohete.texture = load(raiz + "/recursos/props/cohete_4.png")
58: 	cohete.centered = false
59: 	cohete.position = Vector2(110, SUELO_Y - 160)
60: 	cohete.z_index = 2
61: 	add_child(cohete)
62: 	for b in BANDERAS:
63: 		_punto("bandera", b)
64: 	for m in MODULOS:
65: 		_punto("modulo", m)
66: 	jugador = Personaje.new()
67: 	jugador.personaje = "jugador"
68: 	jugador.position = Vector2(220, SUELO_Y)
69: 	jugador.z_index = 6
70: 	add_child(jugador)
71: 	camara = Camera2D.new()
72: 	camara.position = Vector2(320, 180)
73: 	add_child(camara)
74: 	camara.make_current()
75: 	hud = Hud.new()
76: 	hud.capitulo = "Capítulo 3 — Marte"
77: 	hud.pie = "← → / A D: moverse  ·  Espacio: saltar  ·  E: plantar / mantener: desplegar" + ("   ·   Fondos de Marte: provisionales" if fondos_reales == 0 else "")
78: 	add_child(hud)
79: 
80: 
81: func _punto(tipo: String, d: Array) -> void:
82: 	var s := Sprite2D.new()
83: 	s.texture = load(raiz + "/recursos/props/" + String(d[0]) + ".png")
84: 	s.centered = false
85: 	s.position = Vector2(float(d[2]) - s.texture.get_width() * 0.5, SUELO_Y - s.texture.get_height())
86: 	s.modulate = Color(0.38, 0.89, 0.88, 0.3)       # plano cian: todavia no existe
87: 	s.z_index = 2
88: 	add_child(s)
89: 	puntos.append({"tipo": tipo, "id": d[0], "nombre": d[1], "x": float(d[2]), "nodo": s, "hecho": false})
90: 
91: 
92: func _physics_process(delta: float) -> void:
93: 	var dir := dir_externa
94: 	if not control_externo:
95: 		dir = Input.get_axis("ui_left", "ui_right")
96: 		if Input.is_key_pressed(KEY_A):
97: 			dir -= 1.0
98: 		if Input.is_key_pressed(KEY_D):
99: 			dir += 1.0
100: 		dir = clampf(dir, -1.0, 1.0)
101: 		var e := Input.is_key_pressed(KEY_E) or Input.is_key_pressed(KEY_ENTER)
102: 		if e and not _e_antes:
103: 			interactuar()
104: 		if e:
105: 			mantener(delta)
106: 		else:
107: 			_progreso = 0.0
108: 		_e_antes = e
109: 		var s := Input.is_key_pressed(KEY_SPACE) or Input.is_key_pressed(KEY_W) or Input.is_key_pressed(KEY_UP)
110: 		if s and not _s_antes and en_suelo:
111: 			vel.y = -SALTO
112: 			en_suelo = false
113: 		_s_antes = s
114: 	var pos: Vector2 = jugador.position
115: 	pos.x = clampf(pos.x + dir * CAMINAR * delta, 180.0, ANCHO - 20.0)
116: 	if not en_suelo:
117: 		vel.y += GRAVEDAD * delta
118: 		pos.y += vel.y * delta
119: 		if pos.y >= SUELO_Y:
120: 			pos.y = SUELO_Y
121: 			en_suelo = true
122: 	jugador.position = pos
123: 	jugador.mirar(dir)
124: 	var anim := "quieto" if dir == 0.0 else "caminar"
125: 	if not en_suelo:
126: 		anim = "saltar"
127: 	if jugador.animation != anim:
128: 		jugador.play(anim)
129: 	camara.position.x = clampf(pos.x, 320.0, ANCHO - 320.0)
130: 	cerca = null
131: 	for p in puntos:
132: 		if not p["hecho"] and absf(p["x"] - pos.x) < 26.0 and (p["tipo"] == "bandera" or banderas >= 3):
133: 			cerca = p
134: 			break
135: 	_t_aviso -= delta
136: 	hud.aviso = _aviso if _t_aviso > 0.0 else ""
137: 	if banderas < 3:
138: 		hud.objetivo = {"titulo": "Objetivo 3: planta las banderas", "cuadros": [banderas, 3], "lineas": ["Estados Unidos, Ecuador e IEEE IAS"]}
139: 	else:
140: 		hud.objetivo = {"titulo": "Objetivo final: la base marciana", "cuadros": [modulos, 3], "lineas": ["Despliega los módulos (mantén E)"]}
141: 	hud.progreso = -1.0
142: 	if cerca != null:
143: 		var texto: String = ("E: plantar la bandera de " if cerca["tipo"] == "bandera" else "Mantén E: desplegar ") + String(cerca["nombre"])
144: 		hud.burbuja = {"texto": texto, "pos": Vector2(cerca["x"] - (camara.position.x - 320.0), SUELO_Y - 84.0)}
145: 		if _progreso > 0.0:
146: 			hud.progreso = _progreso / T_DESPLEGAR
147: 	else:
148: 		hud.burbuja = {}
149: 	_suelo.queue_redraw()
150: 
151: 
152: func teletransportar(x: float) -> void:
153: 	jugador.position = Vector2(x, SUELO_Y)
154: 	camara.position.x = clampf(x, 320.0, ANCHO - 320.0)
155: 	cerca = null
156: 	for p in puntos:
157: 		if not p["hecho"] and absf(p["x"] - x) < 26.0 and (p["tipo"] == "bandera" or banderas >= 3):
158: 			cerca = p
159: 			break
160: 
161: 
162: func interactuar() -> void:
163: 	if cerca != null and cerca["tipo"] == "bandera":
164: 		_hacer(cerca)
165: 		banderas += 1
166: 		_avisar("Bandera de %s plantada (%d de 3)." % [cerca["nombre"], banderas] if banderas < 3 else "¡Las tres banderas ondean en Marte! Ahora, la base.")
167: 		cerca = null
168: 
169: 
170: func mantener(delta: float) -> void:
171: 	if cerca == null or cerca["tipo"] != "modulo":
172: 		_progreso = 0.0
173: 		return
174: 	_progreso += delta
175: 	if _progreso >= T_DESPLEGAR:
176: 		_progreso = 0.0
177: 		_hacer(cerca)
178: 		modulos += 1
179: 		_avisar("Desplegaste %s (%d de 3)." % [cerca["nombre"], modulos])
180: 		cerca = null
181: 		if modulos >= 3 and not acabado:
182: 			acabado = true
183: 			get_tree().create_timer(2.0).timeout.connect(func(): terminado.emit())
184: 
185: 
186: func _hacer(p: Dictionary) -> void:
187: 	p["hecho"] = true
188: 	var s: Sprite2D = p["nodo"]
189: 	s.modulate = Color(3, 3, 3, 1)
190: 	create_tween().tween_property(s, "modulate", Color.WHITE, 0.6)
191: 
192: 
193: func _avisar(texto: String) -> void:
194: 	_aviso = texto
195: 	_t_aviso = 4.0
