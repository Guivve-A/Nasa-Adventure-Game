60: func desbloquear(id: String) -> void:
61: 	if paginas.has(id) or not _datos.has(id):
62: 		return
63: 	paginas.append(id)
64: 	# se ordenan como en el cuaderno, no como se ganaron
65: 	paginas.sort_custom(func(a, b): return _orden.find(a) < _orden.find(b))
66: 	_brillo = 1.0
67: 	_sin_leer += 1
68: 	_toast = "Nueva nota: " + String(_datos[id]["titulo"])
69: 	_t_toast = 2.4
70: 	nueva.emit(id)
71: 	if auto_abrir and not _ya_abrio:
72: 		_ya_abrio = true
73: 		get_tree().create_timer(0.6, true).timeout.connect(func(): abrir(id))
74: 
75: 
76: func abrir(id := "") -> void:
77: 	if paginas.is_empty():
78: 		return
79: 	abierto = true
80: 	actual = maxi(0, paginas.find(id)) if id != "" else clampi(actual, 0, paginas.size() - 1)
81: 	if id == "" and _sin_leer > 0:
82: 		actual = paginas.size() - 1
83: 	_sin_leer = 0
84: 	_brillo = 0.0
85: 	get_tree().paused = true
86: 
87: 
88: func cerrar() -> void:
89: 	abierto = false
90: 	get_tree().paused = false
91: 
92: 
93: func pasar(d: int) -> void:
94: 	actual = clampi(actual + d, 0, paginas.size() - 1)
95: 
