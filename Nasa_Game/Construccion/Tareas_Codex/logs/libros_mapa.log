97: func _process(delta: float) -> void:
98: 	_t += delta
99: 	_t_toast -= delta
100: 	if _brillo > 0.0 and _sin_leer == 0:
101: 		_brillo = maxf(0.0, _brillo - delta)
102: 	_lienzo.queue_redraw()
103: 
