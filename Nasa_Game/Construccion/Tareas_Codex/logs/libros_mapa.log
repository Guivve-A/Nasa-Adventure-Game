599: func _input(evento: InputEvent) -> void:
600: 	if control_externo or get_tree().paused or etapa != "reporte":
601: 		return
602: 	var tecla := evento as InputEventKey
603: 	if tecla != null and tecla.pressed and not tecla.echo:
604: 		if tecla.keycode in [KEY_UP, KEY_W]:
605: 			elegir_reporte(reporte_sel - 1)
606: 		elif tecla.keycode in [KEY_DOWN, KEY_S]:
607: 			elegir_reporte(reporte_sel + 1)
608: 	var clic := evento as InputEventMouseButton
609: 	if clic != null and clic.pressed and clic.button_index == MOUSE_BUTTON_LEFT:
610: 		var p: Vector2 = _ui.get_local_mouse_position()
611: 		for k in _rects:
612: 			if (_rects[k] as Rect2).has_point(p):
613: 				if k == "enviar":
614: 					enviar()
615: 				else:
616: 					elegir_reporte(int(k))
617: 					_confirmar_reporte()
