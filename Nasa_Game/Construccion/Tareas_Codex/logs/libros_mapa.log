366: 		mochila[k] = int(mochila[k]) / 2
367: 	barras["oxigeno"] = 60.0
368: 	barras["radiacion"] = 30.0
369: 	barras["energia"] = maxf(barras["energia"], 40.0)
370: 	barras["alimentos"] = maxf(barras["alimentos"], 40.0)
371: 	teletransportar(616.0)
372: 	avisar(causa + ": el equipo te llevó a la cúpula. Perdiste parte de la carga.", 5.0)
373: 
374: 
375: func teletransportar(x: float) -> void:
376: 	jugador.position = Vector2(x, suelo_en(x))
377: 	vel = Vector2.ZERO
378: 	en_suelo = true
379: 	if montado:
380: 		rover["x"] = x
381: 		(rover["nodo"] as Sprite2D).position = Vector2(x - 32.0, suelo_en(x) - 36.0)
382: 	camara.position.x = clampf(x, 320.0, ancho - 320.0)
383: 	_buscar_cerca()
384: 
385: 
386: func avisar(texto: String, dur := 3.0) -> void:
387: 	_aviso = texto
388: 	_t_aviso = dur
389: 
390: 
391: func _total(d: Dictionary) -> int:
392: 	var n := 0
393: 	for k in d:
394: 		n += int(d[k])
395: 	return n
396: 
397: 
398: func _capacidad() -> int:
399: 	return CAPACIDAD_ROVER if montado else CAPACIDAD
400: 
401: 
402: # ---------- interaccion ----------
403: func _buscar_cerca() -> void:
404: 	cerca = null
405: 	if dentro != null:
406: 		return
407: 	var mejor := 1e9
408: 	var x: float = jugador.position.x
409: 	for o in objetos:
410: 		var t: String = o["tipo"]
411: 		if t == "adorno" or t == "oxigeno" or t == "carga":
412: 			continue
413: 		if (t == "cajas" or t == "veta") and int(o["unidades"]) <= 0:
414: 			continue
415: 		if t == "rover" and montado:
416: 			continue
417: 		var d := absf(o["x"] - x)
418: 		if d < o["w"] * 0.5 + 14.0 and d < mejor:
419: 			mejor = d
420: 			cerca = o
421: 
422: 
423: func interactuar() -> void:
424: 	if lanzando >= 0.0:
425: 		return
426: 	if _habla != null:
427: 		_avanzar_dialogo()
428: 		return
429: 	if dentro != null:
430: 		_salir()
431: 		return
432: 	if cerca == null:
433: 		if montado:
434: 			_bajar()
435: 		return
436: 	match cerca["tipo"]:
437: 		"npc":
438: 			if montado:
439: 				_bajar()
440: 			_habla = cerca
441: 			_linea = -1
442: 			_avanzar_dialogo()
443: 		"cajas":
444: 			if _total(mochila) >= _capacidad():
445: 				avisar("Mochila llena: entrega en la constructora" + ("" if montado else " o usa el rover"))
446: 			else:
447: 				mochila["caja"] += 1
448: 				cerca["unidades"] -= 1
449: 				_refrescar(cerca)
450: 		"refugio":
451: 			if montado:
452: 				_bajar()
453: 			dentro = cerca
454: 			jugador.visible = false
455: 			avisar("Dentro de " + REFUGIOS[cerca["id"]] + ": a salvo. Muévete para salir.", 4.0)
456: 		"rover":
457: 			montado = true
458: 			jugador.visible = false
459: 			for k in ORDEN:
460: 				mochila[k] += maletero[k]
461: 				maletero[k] = 0
462: 			teletransportar(rover["x"])
463: 			avisar("En el rover: más rápido y con espacio para 10. E para bajar.")
464: 		"constructora":
465: 			_entregar()
466: 		"deposito":
467: 			_cargar_combustible()
468: 		"cohete":
469: 			if listo_para_despegar():
470: 				_despegar()
471: 			elif fase < 4:
472: 				avisar("El cohete va en la fase %d de 4. Lleva recursos a la constructora." % fase)
473: 			else:
474: 				avisar("Falta combustible o batería para despegar.")
475: 		_:
476: 			if montado:
477: 				_bajar()
478: 
479: 
480: func _bajar() -> void:
481: 	montado = false
482: 	jugador.visible = true
483: 	var sobra := _total(mochila) - CAPACIDAD
484: 	for k in ["hielo", "regolito", "ilmenita", "caja"]:
485: 		while sobra > 0 and int(mochila[k]) > 0:
486: 			mochila[k] -= 1
487: 			maletero[k] += 1
488: 			sobra -= 1
489: 	if _total(maletero) > 0:
490: 		avisar("Dejaste %d cosas en el maletero del rover." % _total(maletero))
491: 
492: 
493: func _salir() -> void:
494: 	dentro = null
495: 	jugador.visible = true
496: 
497: 
498: func _refrescar(o: Dictionary) -> void:
499: 	var n: Sprite2D = o["nodo"]
500: 	if int(o["unidades"]) <= 0:
501: 		n.visible = false
502: 	elif o["tipo"] == "veta":
503: 		n.modulate = Color(1, 1, 1).lerp(Color(0.6, 0.6, 0.7), 1.0 - float(o["unidades"]) / float(VETAS.get(o["id"], ["", 2])[1]))
504: 
505: 
506: func mantener(delta: float) -> void:
507: 	if cerca == null or _habla != null or lanzando >= 0.0:
508: 		_progreso = 0.0
509: 		return
510: 	var t: String = cerca["tipo"]
511: 	if t == "veta":
512: 		if montado:
513: 			avisar("Baja del rover para extraer (E lejos de la veta).")
514: 			return
515: 		if barras["energia"] <= 3.0:
516: 			avisar("Sin energía: recarga el traje en una estación de carga.")
517: 			return
518: 		if _total(mochila) >= _capacidad():
519: 			avisar("Mochila llena: entrega en la constructora o usa el rover.")
520: 			return
521: 		_progreso += delta
522: 		if _progreso >= T_EXTRAER:
523: 			_progreso = 0.0
524: 			mochila[cerca["recurso"]] += 1
525: 			cerca["unidades"] -= 1
526: 			barras["energia"] -= 3.0
527: 			polvos.append({"x": cerca["x"], "y": suelo_en(cerca["x"]) - 6.0, "t": 0.0, "color": Color("c4c9de")})
528: 			_refrescar(cerca)
529: 	elif t == "panel" and not cerca["orientado"]:
530: 		_progreso += delta
531: 		if _progreso >= T_PANEL:
532: 			_progreso = 0.0
533: 			cerca["orientado"] = true
534: 			paneles_orientados += 1
535: 			(cerca["nodo"] as Sprite2D).modulate = Color.WHITE
536: 			avisar("Panel limpio y orientado al Sol (%d de 3)." % paneles_orientados)
537: 	else:
538: 		_progreso = 0.0
539: 
540: 
541: func _disponible(k: String, destino_x: float) -> int:
542: 	var n := int(mochila[k])
543: 	if not montado and rover != null and absf(rover["x"] - destino_x) < 110.0:
544: 		n += int(maletero[k])
545: 	return n
546: 
547: 
548: func _gastar(k: String, n: int) -> void:
549: 	var de_mochila := mini(n, int(mochila[k]))
550: 	mochila[k] -= de_mochila
551: 	maletero[k] -= n - de_mochila
552: 
553: 
554: func _entregar() -> void:
555: 	if fase >= 4:
556: 		avisar("El cohete ya está armado. Ahora necesita combustible y batería.")
557: 		return
558: 	var req: Dictionary = FASES[fase]
559: 	var dado := 0
560: 	for k in req:
561: 		var falta := int(req[k]) - int(entregado[k])
562: 		var n := mini(falta, _disponible(k, cerca["x"]))
563: 		if n > 0:
564: 			_gastar(k, n)
565: 			entregado[k] += n
566: 			dado += n
567: 	var completa := true
568: 	for k in req:
569: 		if int(entregado[k]) < int(req[k]):
570: 			completa = false
571: 	if completa:
572: 		fase += 1
573: 		for k in ORDEN:
574: 			entregado[k] = 0
575: 		var s: Sprite2D = cohete["nodo"]
576: 		s.texture = load(raiz + "/recursos/props/cohete_%d.png" % fase)
577: 		s.modulate = Color(3, 3, 3)
578: 		create_tween().tween_property(s, "modulate", Color.WHITE, 0.8)
579: 		for i in 10:
580: 			polvos.append({"x": cohete["x"] + randf_range(-24, 24), "y": s.position.y + randf_range(20, 150), "t": -i * 0.05, "color": Color("f2b134")})
581: 		if fase < 4:
582: 			avisar("¡Fase %d de 4 lista! La constructora armó %s." % [fase, PARTES[fase - 1]], 4.5)
583: 		else:
584: 			avisar("¡Cohete armado! Ahora: hielo al depósito y paneles al Sol.", 6.0)
585: 	elif dado > 0:
586: 		avisar("Entregaste %d. Falta: %s." % [dado, _texto_falta()])
587: 	else:
588: 		avisar("Falta: %s." % _texto_falta())
589: 
590: 
591: func _texto_falta() -> String:
592: 	var partes: Array = []
593: 	var req: Dictionary = FASES[fase]
594: 	for k in req:
595: 		var f := int(req[k]) - int(entregado[k])
596: 		if f > 0:
597: 			partes.append("%d de %s" % [f, NOMBRES[k]])
598: 	return ", ".join(partes)
599: 
600: 
601: func _cargar_combustible() -> void:
602: 	if fase < 4:
603: 		avisar("Primero hay que armar el cohete.")
604: 	elif combustible >= 100.0:
605: 		avisar("El depósito está lleno.")
606: 	else:
607: 		var n := mini(int(ceil((100.0 - combustible) / 25.0)), _disponible("hielo", cerca["x"]))
608: 		if n <= 0:
609: 			avisar("Trae hielo del cráter en sombra, al final del mapa.")
610: 		else:
611: 			_gastar("hielo", n)
612: 			combustible = minf(100.0, combustible + 25.0 * n)
613: 			avisar("El hielo se convirtió en combustible: %d %%." % int(combustible))
614: 
615: 
616: func listo_para_despegar() -> bool:
617: 	return fase >= 4 and combustible >= 100.0 and bateria >= 100.0
