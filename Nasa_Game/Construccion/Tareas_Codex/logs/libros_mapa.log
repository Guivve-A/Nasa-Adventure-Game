121: # tiempo real en que la simulacion se corta
122: func _t_fin() -> float:
123: 	match causa:
124: 		"rasgado":
125: 			return T_ENTRADA + 1.6
126: 		"poco_freno":
127: 			return T_ENTRADA + T_PARACAIDAS + 0.8
128: 		"cohetes_tarde":
129: 			return T_ENTRADA + T_PARACAIDAS + T_COHETES * 0.45
130: 	return T_ENTRADA + T_PARACAIDAS + T_COHETES + 1.2
131: 
132: 
133: func aceptar() -> void:
134: 	# el programa probado se envia a la nave real
135: 	if estado == "resultado" and resultado != "perdida":
136: 		estado = "llegada"
137: 		_t_llegada = 0.0
138: 		nota.emit("siete")
