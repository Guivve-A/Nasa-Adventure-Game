3: # Fondo de Marte con parallax (mismas capas que fondo_parallax.gd de la Luna) en tres horas.
4: # Las tres horas estan apiladas en cada capa; hora 0 = dia, 1 = atardecer, 2 = noche, con valores intermedios
5: # para pasar de una a otra poco a poco. Como las montanas tienen la misma forma en las tres horas, el cambio es limpio.
6: 
7: const CAPAS := [["capa_0_espacio", 0.02], ["capa_0b_sol_tierra", 0.06], ["capa_1_montanas_lejanas", 0.18], ["capa_2_montanas_medias", 0.35], ["capa_3_colinas_cercanas", 0.6]]
8: const HORAS := ["dia", "atardecer", "noche"]
9: const ANCHO := 640.0
10: 
11: var hora := 0.0
12: var _sprites: Array = []         # por capa: [dia, atardecer, noche]
13: 
14: 
15: func armar(carpeta: String) -> void:
16: 	for i in CAPAS.size():
17: 		var p := Parallax2D.new()
18: 		p.scroll_scale = Vector2(CAPAS[i][1], 0.0)
19: 		p.repeat_size = Vector2(ANCHO, 0.0)
20: 		p.repeat_times = 3
21: 		add_child(p)
22: 		var tres: Array = []
23: 		for h in HORAS:
24: 			var s := Sprite2D.new()
25: 			s.texture = load(carpeta + "/" + h + "/" + CAPAS[i][0] + ".png")
26: 			s.centered = false
27: 			p.add_child(s)
28: 			tres.append(s)
29: 		_sprites.append(tres)
30: 	poner_hora(0.0)
31: 
32: 
33: # suelo caminable: una tira por hora que se repite a lo ancho del nivel
34: func armar_suelo(carpeta: String, ancho: float, y: float) -> Node2D:
35: 	var n := Node2D.new()
36: 	var tres: Array = []
37: 	for h in HORAS:
38: 		var s := Sprite2D.new()
39: 		s.texture = load(carpeta + "/suelo_marte_" + h + ".png")
40: 		s.centered = false
41: 		s.texture_repeat = CanvasItem.TEXTURE_REPEAT_ENABLED
42: 		s.region_enabled = true
43: 		s.region_rect = Rect2(0, 0, ancho, s.texture.get_height())
44: 		s.position = Vector2(0, y)
45: 		n.add_child(s)
46: 		tres.append(s)
47: 	_sprites.append(tres)
48: 	poner_hora(hora)
49: 	return n
50: 
51: 
52: func poner_hora(h: float) -> void:
53: 	hora = clampf(h, 0.0, 2.0)
54: 	var a := clampf(hora, 0.0, 1.0)            # cuanto atardecer encima del dia
55: 	var n := clampf(hora - 1.0, 0.0, 1.0)      # cuanta noche encima del atardecer
56: 	for i in _sprites.size():
57: 		var tres: Array = _sprites[i]
58: 		if i == 1:
59: 			# los astros cambian de lugar: cada hora se desvanece por separado
60: 			(tres[0] as Sprite2D).modulate.a = 1.0 - a
61: 			(tres[1] as Sprite2D).modulate.a = a - n
62: 			(tres[2] as Sprite2D).modulate.a = n
63: 		else:
64: 			(tres[0] as Sprite2D).modulate.a = 1.0
65: 			(tres[1] as Sprite2D).modulate.a = a
66: 			(tres[2] as Sprite2D).modulate.a = n

