539: func _resultado() -> void:
540: 	var lineas := explicacion()
541: 	var titulo := {"suave": "Aterrizaje suave", "duro": "Aterrizaje duro", "perdida": "La nave se perdería"}[resultado] as String
542: 	var col := {"suave": VERDE, "duro": AMBAR, "perdida": ROSA}[resultado] as Color
543: 	var r := Rect2(70, 30, 500, 114)
544: 	_caja(r, col, Color(0.043, 0.055, 0.102, 0.95))
545: 	_txt(r.position + Vector2(0, 20), titulo, col, 16, r.size.x, HORIZONTAL_ALIGNMENT_CENTER)
546: 	for i in lineas.size():
547: 		_txt(r.position + Vector2(0, 38 + i * 12), lineas[i], BLANCO, 7, r.size.x, HORIZONTAL_ALIGNMENT_CENTER)
548: 	if resultado == "perdida":
549: 		var b := Rect2(r.position.x + 120, r.end.y - 24, 180, 16)
550: 		_caja(b, AMBAR)
551: 		_txt(b.position + Vector2(0, 11), "Ajustar el programa  (Enter)", AMBAR, 7, b.size.x, HORIZONTAL_ALIGNMENT_CENTER)
552: 		_rects["ajustar"] = b
553: 	else:
554: 		var b1 := Rect2(r.position.x + 30, r.end.y - 24, 170, 16)
555: 		var b2 := Rect2(r.position.x + 220, r.end.y - 24, 170, 16)
556: 		_caja(b1, col)
557: 		_txt(b1.position + Vector2(0, 11), "Enviar y aterrizar  (Enter)", col, 7, b1.size.x, HORIZONTAL_ALIGNMENT_CENTER)
558: 		_caja(b2, SUAVE)
559: 		_txt(b2.position + Vector2(0, 11), "Ajustar el programa  (E)", SUAVE, 7, b2.size.x, HORIZONTAL_ALIGNMENT_CENTER)
560: 		_rects["aceptar"] = b1
561: 		_rects["ajustar"] = b2
