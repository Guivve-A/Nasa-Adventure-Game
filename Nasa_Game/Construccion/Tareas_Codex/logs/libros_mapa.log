346: 
347: func _caminar_con_teclas(destino: Vector3, limite_s: float = 40.0, radio: float = 0.32) -> bool:
348: 	var j: CharacterBody3D = Zonas.jugador
349: 	var restante := limite_s
350: 	var quieto := 0.0
351: 	var rodeos := 0
352: 	var ultima := j.global_position
353: 	var zona_inicial := Zonas.id_actual
354: 	while restante > 0.0:
355: 		if Zonas.ocupado or Zonas.jugador == null or Zonas.id_actual != zona_inicial:
356: 			_soltar_todo()
357: 			return true      # piso un umbral: el cambio de zona ya empezo
358: 		if Interfaz.ocupada():
359: 			_soltar_todo()
360: 			await _atender_interfaz()
361: 			continue
362: 		var d: Vector3 = destino - j.global_position
363: 		d.y = 0.0
364: 		if d.length() < radio:
365: 			_soltar_todo()
366: 			return true
367: 		_apuntar(d)
368: 		_tecla(KEY_SHIFT, d.length() > 2.5)
369: 		await get_tree().physics_frame
370: 		var paso := get_physics_process_delta_time()
371: 		restante -= paso
372: 		quieto += paso
373: 		if quieto > 0.9:
374: 			if j.global_position.distance_to(ultima) < 0.12:
375: 				# atascada contra algo: lo rodea como una persona, deslizandose a un lado y luego al otro
376: 				rodeos += 1
377: 				if rodeos > 10:
378: 					break
379: 				var lado := Vector3(-d.z, 0.0, d.x).normalized() * (1.0 if rodeos % 2 == 1 else -1.0)
380: 				_soltar_todo()
381: 				_apuntar(lado + d.normalized() * 0.45)
415: 
416: func _atender_interfaz(limite_s: float = 40.0) -> void:
417: 	# pulsa lo que pulsaria una persona hasta que la interfaz devuelve el control
418: 	var restante := limite_s
419: 	await _real(0.12)
420: 	while restante > 0.0:
421: 		if Zonas.ocupado or Interfaz.carga.visible:
422: 			await _real(0.1)
423: 		elif Interfaz.dialogo.visible:
424: 			if Interfaz.dialogo.get("_opciones").get_child_count() > 0:
425: 				await _toque(KEY_ENTER)      # elige la opcion con foco (la primera)
426: 			else:
427: 				await _toque(KEY_E)
428: 			await _real(0.1)
429: 		elif Interfaz.ocupada():
430: 			await _real(0.1)
431: 		else:
432: 			await _real(0.4)
433: 			if not Interfaz.ocupada() and not Zonas.ocupado:
434: 				return
435: 		restante -= 0.15
