105: func _input(evento: InputEvent) -> void:
106: 	var tecla := evento as InputEventKey
107: 	if tecla != null and tecla.pressed and not tecla.echo:
108: 		if tecla.keycode == KEY_TAB:
109: 			if abierto:
110: 				cerrar()
111: 			else:
112: 				abrir()
113: 			get_viewport().set_input_as_handled()
114: 		elif abierto:
115: 			if tecla.keycode == KEY_ESCAPE:
116: 				cerrar()
117: 			elif tecla.keycode in [KEY_LEFT, KEY_A]:
118: 				pasar(-1)
119: 			elif tecla.keycode in [KEY_RIGHT, KEY_D]:
120: 				pasar(1)
121: 			get_viewport().set_input_as_handled()
122: 	var clic := evento as InputEventMouseButton
123: 	if clic != null and clic.pressed and clic.button_index == MOUSE_BUTTON_LEFT:
124: 		var p: Vector2 = _lienzo.get_local_mouse_position()
125: 		if abierto:
126: 			if not HOJA.has_point(p):
127: 				cerrar()
128: 			elif p.x < HOJA.position.x + 40:
129: 				pasar(-1)
130: 			elif p.x > HOJA.end.x - 40:
131: 				pasar(1)
132: 			get_viewport().set_input_as_handled()
133: 		elif ICONO.grow(4).has_point(p) and not paginas.is_empty():
134: 			abrir()
135: 			get_viewport().set_input_as_handled()
