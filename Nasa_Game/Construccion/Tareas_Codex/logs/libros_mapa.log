211: # ---------- modelo simplificado del descenso ----------
212: # devuelve [altitud km, velocidad km/h, tiempo simulado s, fase]
213: func perfil(tr: float) -> Array:
214: 	var hc := alt_paracaidas
215: 	var hr := alt_cohetes
216: 	var vc := 1512.0 + (hc - 11.0) * 260.0 if hc >= 11.0 else 1512.0 - (11.0 - hc) * 70.0
217: 	if tr < T_ENTRADA:
218: 		var k := tr / T_ENTRADA
219: 		var h := lerpf(125.0, hc, 1.0 - pow(1.0 - k, 1.6))
220: 		return [h, lerpf(20000.0, vc, pow(k, 0.7)), lerpf(0.0, 240.0, k), "Entrada"]
221: 	tr -= T_ENTRADA
222: 	if tr < T_PARACAIDAS:
223: 		var k := tr / T_PARACAIDAS
224: 		var vfin := 320.0 if causa != "poco_freno" else 900.0
225: 		if causa == "rasgado":
226: 			vfin = vc
227: 		return [lerpf(hc, hr, k), lerpf(vc, vfin, sqrt(k)), lerpf(240.0, 360.0, k), "Paracaídas"]
228: 	tr -= T_PARACAIDAS
229: 	var k := clampf(tr / T_COHETES, 0.0, 1.0)
230: 	var v := lerpf(320.0, 2.0, k)
231: 	if causa == "cohetes_tarde" or causa == "poco_freno":
232: 		v = lerpf(320.0 if causa == "cohetes_tarde" else 900.0, 260.0, k)
233: 	return [lerpf(hr, 0.0, k), v, lerpf(360.0, 420.0, k), "Cohetes" if k < 1.0 else "En el suelo"]
234: 
235: 
236: static func numero(v: float, dec := 0) -> String:
237: 	var s := ("%." + str(dec) + "f") % v
238: 	var partes := s.split(".")
239: 	var ent: String = partes[0]
240: 	var con := ""
241: 	while ent.length() > 3:
242: 		con = " " + ent.right(3) + con
243: 		ent = ent.left(ent.length() - 3)
244: 	con = ent + con
245: 	if dec > 0:
246: 		con += "," + partes[1]
247: 	return con
248: 
