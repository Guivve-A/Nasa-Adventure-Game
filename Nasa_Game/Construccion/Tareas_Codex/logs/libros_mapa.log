195: func _clic(nombre: String) -> void:
196: 	if estado == "programa":
197: 		if nombre.begins_with("menos") or nombre.begins_with("mas"):
198: 			fila = int(nombre.right(1))
199: 			ajustar(-1 if nombre.begins_with("menos") else 1)
200: 		elif nombre.begins_with("fila"):
201: 			fila = int(nombre.right(1))
202: 		elif nombre == "probar":
203: 			probar()
204: 	elif estado == "resultado":
205: 		if nombre == "aceptar":
206: 			aceptar()
207: 		elif nombre == "ajustar":
208: 			reprogramar()
