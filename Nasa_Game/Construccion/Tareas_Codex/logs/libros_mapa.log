446: func _manos() -> void:
447: 	# el nucleo jugado con teclas: moverse, hablar, usar un objeto, jugar un minijuego, menus y umbral
448: 	_modo_manos(true, false)
449: 	Juego.nueva_partida()
450: 	await Zonas.ir_a("plantilla", "inicio")
451: 	await _atender_interfaz()
452: 	var j: CharacterBody3D = Zonas.jugador
453: 	await _real(0.6)
454: 	comprobar(not Interfaz.dialogo.visible, "manos.el_dialogo_se_cierra_con_E_y_no_se_reabre")
455: 	# moverse con D
456: 	var x0 := j.global_position.x
457: 	_tecla(KEY_D, true)
458: 	await _real(0.5)
459: 	_tecla(KEY_D, false)
460: 	await _real(0.2)
461: 	comprobar(j.global_position.x > x0 + 0.3, "manos.moverse_con_teclas", "x paso de %.2f a %.2f" % [x0, j.global_position.x])
462: 	# hablar con Orbita mirandolo de frente
463: 	var gato: Node3D = Zonas.companero.hablar
464: 	var hablo: bool = await _usar_con_teclas(gato)
465: 	comprobar(hablo, "manos.el_aviso_E_senala_a_orbita_al_mirarlo", "aviso en: %s" % str(j.get("objetivo")))
466: 	await _atender_interfaz()
467: 	comprobar(bool(Juego.bandera("hablo_orbita")), "manos.hablar_con_orbita")
468: 	# usar el cartel: abre el minijuego de plantilla, que aqui se juega con teclas de verdad
469: 	var llego: bool = await _caminar_con_teclas(Vector3(2.0, 0.0, 1.2))
470: 	comprobar(llego, "manos.caminar_hasta_el_cartel", str(j.global_position))
471: 	var cartel: Node3D = Zonas.actual.get_node_or_null("Cartel")
472: 	var uso: bool = await _usar_con_teclas(cartel)
479: 	var mj: Variant = anfitrion.get("_minijuego")
480: 	var limite := 40.0
481: 	while limite > 0.0 and mj != null and is_instance_valid(mj) and bool(mj.get("activo")):
482: 		var falta: float = float(mj.get("objetivo")) - float(mj.get("dial"))
483: 		_tecla(KEY_D, falta > 0.02)
484: 		_tecla(KEY_A, falta < -0.02)
485: 		await get_tree().process_frame
486: 		limite -= get_process_delta_time()
487: 	_soltar_todo()
488: 	await _real(0.5)
489: 	comprobar(bool(anfitrion.get("_resultado").get("superado", false)), "manos.minijuego_ganado_con_teclas", str(anfitrion.get("_resultado")))
490: 	await _toque(KEY_ENTER)                 # boton «Continuar»
491: 	await _atender_interfaz()
492: 	await _real(0.6)
493: 	comprobar(not anfitrion.visible and not Interfaz.dialogo.visible, "manos.intro_no_reabre_el_minijuego")
494: 	comprobar(bool(Juego.bandera("plantilla_minijuego")), "manos.la_zona_recibe_el_resultado")
495: 	# mapa, cuaderno y pausa
496: 	await _toque(KEY_M)
497: 	await _real(0.3)
498: 	comprobar(Interfaz.mapa.visible, "manos.mapa_con_M")
499: 	await _toque(KEY_ESCAPE)
500: 	await _real(0.5)
501: 	comprobar(not Interfaz.mapa.visible and not get_tree().paused, "manos.mapa_se_cierra_con_Esc")
502: 	await _toque(KEY_TAB)
503: 	await _real(0.3)
504: 	comprobar(Interfaz.cuaderno.visible, "manos.cuaderno_con_Tab")
505: 	await _toque(KEY_TAB)
506: 	await _real(0.5)
507: 	comprobar(not Interfaz.cuaderno.visible and not get_tree().paused, "manos.cuaderno_se_cierra_con_Tab")
508: 	await _toque(KEY_ESCAPE)
509: 	await _real(0.3)
510: 	comprobar(Interfaz.pausa.visible and get_tree().paused, "manos.pausa_con_Esc")
511: 	await _toque(KEY_ENTER)                 # boton «Continuar»
512: 	await _real(0.5)
513: 	comprobar(not Interfaz.pausa.visible and not get_tree().paused, "manos.pausa_continua_con_Intro")
514: 	# cruzar el umbral caminando

