329: func _programa() -> void:
330: 	var c := _lienzo
331: 	_caja(Rect2(70, 16, 500, 52), CREMA)
332: 	_txt(Vector2(70, 33), "Siete minutos de terror", CREMA, 16, 500, HORIZONTAL_ALIGNMENT_CENTER)
333: 	_txt(Vector2(70, 50), "La señal tarda unos 11 minutos en llegar a la Tierra y el descenso dura 7: nadie puede", BLANCO, 7, 500, HORIZONTAL_ALIGNMENT_CENTER)
334: 	_txt(Vector2(70, 61), "ayudarte en vivo. Programa la secuencia y pruébala en el simulador antes de enviarla.", BLANCO, 7, 500, HORIZONTAL_ALIGNMENT_CENTER)
335: 	# regla de altura
336: 	var x := 84.0
337: 	var y0 := 86.0
338: 	var y1 := 304.0
339: 	_caja(Rect2(40, 78, 96, 236), BORDE)
340: 	c.draw_line(Vector2(x, y0), Vector2(x, y1), SUAVE, 1.0)
341: 	for km in range(2, 21, 2):
342: 		var y := lerpf(y1, y0, km / 20.0)
343: 		c.draw_line(Vector2(x - 3, y), Vector2(x + (4 if km % 10 == 0 else 2), y), SUAVE, 1.0)
344: 		_txt(Vector2(x - 36, y + 3), "%d km" % km, SUAVE, 6)
345: 	var yp := lerpf(y1, y0, alt_paracaidas / 20.0)
346: 	var yc := lerpf(y1, y0, alt_cohetes / 20.0)
347: 	c.draw_rect(Rect2(x + 1, lerpf(y1, y0, 13.0 / 20.0), 3, lerpf(y1, y0, 7.0 / 20.0) - lerpf(y1, y0, 13.0 / 20.0)), Color(CIAN, 0.15))
348: 	c.draw_arc(Vector2(x + 18, yp - 4), 7, PI, TAU, 8, CIAN, 2.0)
349: 	c.draw_line(Vector2(x + 4, yp), Vector2(x + 30, yp), CIAN, 1.0)
350: 	c.draw_rect(Rect2(x + 14, yc - 3, 8, 6), AMBAR)
351: 	c.draw_line(Vector2(x + 4, yc), Vector2(x + 30, yc), AMBAR, 1.0)
352: 	c.draw_rect(Rect2(46, y1, 84, 6), Color("b5633a"))
353: 	# filas del programa
354: 	var filas := [
355: 		["Abrir el paracaídas a", "%d km" % int(alt_paracaidas), CIAN,
356: 			"El paracaídas frena mucho, pero si va demasiado rápido se rasga."],
357: 		["Encender los cohetes a", "%s km" % numero(alt_cohetes, 1), AMBAR,
358: 			"Los cohetes frenan los últimos metros. Tienen poco combustible."],
359: 		["Navegación por terreno", "Sí" if navegacion else "No", VERDE if navegacion else NARANJA,
360: 			"Una cámara compara el suelo con un mapa y busca un lugar plano."],
361: 	]
362: 	for i in 3:
363: 		var f: Array = filas[i]
364: 		var r := Rect2(150, 80 + i * 56, 420, 48)
365: 		var sel := i == fila
366: 		_caja(r, f[2] if sel else BORDE, Color(0.043, 0.055, 0.102, 0.92 if sel else 0.8))
367: 		_rects["fila" + str(i)] = r
368: 		_txt(r.position + Vector2(10, 16), "%d. %s" % [i + 1, f[0]], BLANCO, 8)
369: 		var caja_v := Rect2(r.end.x - 120, r.position.y + 6, 110, 16)
370: 		c.draw_rect(caja_v, Color("232a40"))
371: 		_txt(caja_v.position + Vector2(0, 12), f[1], f[2], 9, caja_v.size.x, HORIZONTAL_ALIGNMENT_CENTER)
372: 		_flecha(caja_v.position + Vector2(8, 8), -1, f[2] if sel else SUAVE)
373: 		_flecha(caja_v.position + Vector2(caja_v.size.x - 8, 8), 1, f[2] if sel else SUAVE)
374: 		_rects["menos" + str(i)] = Rect2(caja_v.position, Vector2(22, 16))
375: 		_rects["mas" + str(i)] = Rect2(caja_v.end.x - 22, caja_v.position.y, 22, 16)
376: 		_txt(r.position + Vector2(10, 38), f[3], SUAVE if not sel else BLANCO, 7)
377: 	var b := Rect2(250, 252, 220, 22)
378: 	var pulso := 0.75 + 0.25 * sin(_anim * 4.0)
379: 	_caja(b, AMBAR, Color(0.3, 0.2, 0.05, 0.9 * pulso))
380: 	_txt(b.position + Vector2(0, 15), "Probar en el simulador  (Enter)", AMBAR, 8, b.size.x, HORIZONTAL_ALIGNMENT_CENTER)
381: 	_rects["probar"] = b
382: 	var ayuda := "↑ ↓: elegir   ← →: cambiar" + ("" if intentos == 0 else "   ·   Intentos: %d" % intentos)
383: 	_txt(Vector2(150, 290), ayuda, SUAVE, 6)
