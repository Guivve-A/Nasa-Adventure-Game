152: func teletransportar(x: float) -> void:
153: 	jugador.position = Vector2(x, SUELO_Y)
154: 	camara.position.x = clampf(x, 320.0, ANCHO - 320.0)
155: 	cerca = null
156: 	for p in puntos:
157: 		if not p["hecho"] and absf(p["x"] - x) < 26.0 and (p["tipo"] == "bandera" or banderas >= 3):
158: 			cerca = p
159: 			break
160: 
161: 
162: func interactuar() -> void:
163: 	if cerca != null and cerca["tipo"] == "bandera":
164: 		_hacer(cerca)
165: 		banderas += 1
166: 		_avisar("Bandera de %s plantada (%d de 3)." % [cerca["nombre"], banderas] if banderas < 3 else "¡Las tres banderas ondean en Marte! Ahora, la base.")
167: 		cerca = null
168: 
169: 
170: func mantener(delta: float) -> void:
171: 	if cerca == null or cerca["tipo"] != "modulo":
172: 		_progreso = 0.0
173: 		return
174: 	_progreso += delta
175: 	if _progreso >= T_DESPLEGAR:
176: 		_progreso = 0.0
177: 		_hacer(cerca)
178: 		modulos += 1
179: 		_avisar("Desplegaste %s (%d de 3)." % [cerca["nombre"], modulos])
180: 		cerca = null
181: 		if modulos >= 3 and not acabado:
182: 			acabado = true
183: 			get_tree().create_timer(2.0).timeout.connect(func(): terminado.emit())
184: 
185: 
186: func _hacer(p: Dictionary) -> void:
187: 	p["hecho"] = true
188: 	var s: Sprite2D = p["nodo"]
189: 	s.modulate = Color(3, 3, 3, 1)
190: 	create_tween().tween_property(s, "modulate", Color.WHITE, 0.6)
191: 
