438: func _modo_manos(activo: bool, minijuegos_solos: bool) -> void:
439: 	Juego.modo_prueba = not activo
440: 	Juego.sin_guardar = true
441: 	Juego.minijuegos_solos = minijuegos_solos and activo
442: 	if not activo:
443: 		_soltar_todo()
