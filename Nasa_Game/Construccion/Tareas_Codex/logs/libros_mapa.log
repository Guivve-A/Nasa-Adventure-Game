96: func _cargar_datos() -> void:
97: 	var m: Variant = leer_json(RUTA_MISIONES)
98: 	if m is Dictionary:
99: 		misiones = m.get("misiones", [])
100: 	var f: Variant = leer_json(RUTA_FICHAS)
