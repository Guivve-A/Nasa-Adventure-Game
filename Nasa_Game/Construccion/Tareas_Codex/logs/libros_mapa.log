161: func _input(evento: InputEvent) -> void:
162: 	if control_externo or get_tree().paused:
163: 		return
164: 	var tecla := evento as InputEventKey
165: 	if tecla != null and tecla.pressed:
166: 		var k := tecla.keycode
167: 		if estado == "programa":
168: 			if k in [KEY_UP, KEY_W]:
169: 				fila = (fila + 2) % 3
170: 			elif k in [KEY_DOWN, KEY_S]:
171: 				fila = (fila + 1) % 3
172: 			elif k in [KEY_LEFT, KEY_A]:
173: 				ajustar(-1)
174: 			elif k in [KEY_RIGHT, KEY_D]:
175: 				ajustar(1)
176: 			elif k in [KEY_ENTER, KEY_KP_ENTER, KEY_SPACE] and not tecla.echo:
177: 				probar()
178: 		elif estado == "resultado" and not tecla.echo:
179: 			if k in [KEY_ENTER, KEY_KP_ENTER, KEY_SPACE]:
180: 				if resultado == "perdida":
181: 					reprogramar()
182: 				else:
183: 					aceptar()
184: 			elif k == KEY_E:
185: 				reprogramar()
186: 	var clic := evento as InputEventMouseButton
187: 	if clic != null and clic.pressed and clic.button_index == MOUSE_BUTTON_LEFT:
188: 		var p: Vector2 = _lienzo.get_local_mouse_position()
189: 		for nombre in _rects:
190: 			if (_rects[nombre] as Rect2).has_point(p):
191: 				_clic(nombre)
192: 				return
