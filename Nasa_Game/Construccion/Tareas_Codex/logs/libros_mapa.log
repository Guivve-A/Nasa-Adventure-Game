836: 		var ox: float = cerca["x"]
837: 		var pos := Vector2(ox - (camara.position.x - 320.0), suelo_en(ox) - minf(alto, 150.0))
838: 		hud.burbuja = {"texto": texto, "pos": pos, "color": Color("f2b134") if cerca["tipo"] in ["constructora", "deposito", "cohete"] else Color("62e4e0")}
839: 		if _progreso > 0.0:
840: 			hud.progreso = _progreso / (T_EXTRAER if cerca["tipo"] == "veta" else T_PANEL)
