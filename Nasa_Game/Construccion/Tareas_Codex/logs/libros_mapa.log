218: 	if not control_externo:
219: 		dir = Input.get_axis("ui_left", "ui_right")
220: 		if Input.is_key_pressed(KEY_A):
221: 			dir -= 1.0
222: 		if Input.is_key_pressed(KEY_D):
223: 			dir += 1.0
224: 		dir = clampf(dir, -1.0, 1.0)
225: 		correr = Input.is_key_pressed(KEY_SHIFT)
226: 		var e := Input.is_key_pressed(KEY_E) or Input.is_key_pressed(KEY_ENTER)
227: 		if e and not _e_antes:
228: 			interactuar()
229: 		if e:
230: 			mantener(delta)
231: 		else:
232: 			_progreso = 0.0
233: 		_e_antes = e
234: 		var s := Input.is_key_pressed(KEY_SPACE) or Input.is_key_pressed(KEY_W) or Input.is_key_pressed(KEY_UP)
235: 		if s and not _s_antes:
236: 			saltar()
237: 		_s_antes = s
238: 	if _habla != null:
239: 		dir = 0.0
240: 	if dentro != null:
241: 		if dir != 0.0:
242: 			_salir()
243: 		dir = 0.0
244: 	_mover(delta, dir, correr)
245: 	_medidores(delta, dir, correr)
246: 	_eventos(delta)
247: 	_buscar_cerca()
248: 	camara.position.x = clampf(jugador.position.x, 320.0, ancho - 320.0)
249: 	_t_aviso -= delta
250: 	_actualizar_hud()
251: 	_fx.queue_redraw()
