===== juego/nucleo/minijuego.gd =====
extends Control

# Base de todo minijuego. Cada uno vive en res://minijuegos/<id>/<id>.gd, empieza con
#   extends "res://nucleo/minijuego.gd"
# y tiene al lado su minijuego.json (titulo, instrucciones, controles, pistas y ficha del cuaderno).
#
# El anfitrion (interfaz/anfitrion.gd) pone el marco, el titulo, las instrucciones, las pistas de Orbita y la
# pantalla de resultado. El minijuego solo dibuja y juega dentro de su lienzo.
#
# Contrato:
#   _preparar()      arma los nodos y el estado inicial. El lienzo ya mide LIENZO (1120 x 520 px): usa "size".
#                    Con pantalla_completa = true (en _init()) mide 1280 x 720: 320 x 180 pixeles gordos x4.
#   _empezar()       el jugador pulso «Empezar»: arranca el juego.
#   _paso(delta)     se llama en cada cuadro mientras "activo" es true. Usa SIEMPRE delta para el tiempo
#                    (las pruebas aceleran el reloj); nunca la hora del sistema.
#   terminar(superado, puntos, detalle)   cierra la partida. "detalle" explica la causa en una frase:
#                    nunca «incorrecto», siempre el porque (regla de Orbita).
#   jugar_solo(acierta)   OBLIGATORIO para las pruebas: hace que el minijuego se juegue solo y termine,
#                    superado si acierta = true y no superado si es false, en menos de 40 s de juego.
#
# Dificultad: parametros.get("dificultad", 1) va de 1 (primera vez en la historia) a 3.
# Entradas: teclado (acciones mover_*, interactuar, saltar) y raton; todo lo que se pueda hacer con el raton
# debe poder hacerse tambien con el teclado.

signal terminado(resultado: Dictionary)

const Estilo := preload("res://interfaz/estilo.gd")
const LIENZO := Vector2(1120, 520)
const LIENZO_COMPLETO := Vector2(1280, 720)   # 320 x 180 pixeles gordos x4: toda la pantalla, sin margenes

var parametros: Dictionary = {}
var meta: Dictionary = {}       # contenido de minijuego.json
var activo := false
var tiempo := 0.0               # segundos de juego desde _empezar()
var dificultad := 1
var pantalla_completa := false  # true (ponlo en _init()): el lienzo mide LIENZO_COMPLETO y el anfitrion no deja margen
var _solo := 0                  # 0 = juega la persona; 1 = solo y acierta; -1 = solo y falla


func preparar(p: Dictionary, m: Dictionary) -> void:
	parametros = p
	meta = m
	dificultad = clampi(int(p.get("dificultad", 1)), 1, 3)
	var tam: Vector2 = LIENZO_COMPLETO if pantalla_completa else LIENZO
	custom_minimum_size = tam
	size = tam
	clip_contents = true
	focus_mode = Control.FOCUS_ALL
	_preparar()


func empezar() -> void:
	activo = true
	tiempo = 0.0
	grab_focus()
	_empezar()
	if _solo != 0:
		jugar_solo(_solo > 0)


func terminar(superado: bool, puntos: float = 0.0, detalle: String = "") -> void:
	if not activo:
		return
	activo = false
	terminado.emit({"superado": superado, "puntos": puntos, "detalle": detalle, "tiempo": tiempo})


func _process(delta: float) -> void:
	if activo:
		tiempo += delta
		_paso(delta)


# ------------------------------------------------------------------ para sobrescribir

func _preparar() -> void:
	pass


func _empezar() -> void:
	pass


func _paso(_delta: float) -> void:
	pass


func jugar_solo(_acierta: bool) -> void:
	# cada minijuego lo implementa; por defecto termina sin jugar para que la prueba lo delate
	terminar(false, 0.0, "Este minijuego todavía no sabe jugarse solo.")


# ------------------------------------------------------------------ utilidades

func eje_x() -> float:
	# -1..1 con izquierda y derecha (teclado o mando)
	return Input.get_axis("mover_izquierda", "mover_derecha")


func eje_y() -> float:
	# -1..1 con abajo y arriba (arriba = +1)
	return Input.get_axis("mover_abajo", "mover_arriba")


func texto(contenido: String, tam: int = 20, color: Color = Estilo.TINTA, peso: int = 500) -> Label:
	return Estilo.texto(contenido, tam, color, peso)


func sonar(nombre: String) -> void:
	Audio.sonar(nombre)


===== juego/nucleo/interfaz.gd =====
extends CanvasLayer

# Interfaz global (autoload "Interfaz"): HUD, dialogos, avisos, ventana de carga, pausa, cuaderno, menu
# principal y anfitrion de minijuegos. Las zonas y los minijuegos solo usan las funciones de este guion.
# ESTILO PROVISIONAL: la Fase 7 (UI/UX) no esta validada.
#
#   await Interfaz.decir([{"quien": "Órbita", "texto": "..."}])       dialogo
#   var i: int = await Interfaz.elegir("¿...?", ["Sí", "No"])          pregunta con opciones
#   Interfaz.aviso("Texto corto", 3.0)                                 aviso que se va solo
#   var r: Dictionary = await Interfaz.abrir_minijuego("seguidor", {"dificultad": 1})
#        r = {"superado": bool, "puntos": float, "detalle": String, "abandonado": bool (si salio)}

const Estilo := preload("res://interfaz/estilo.gd")
const Recursos := preload("res://nucleo/recursos.gd")
const Hud := preload("res://interfaz/hud.gd")
const Dialogo := preload("res://interfaz/dialogo.gd")
const VentanaCarga := preload("res://interfaz/ventana_carga.gd")
const Anfitrion := preload("res://interfaz/anfitrion.gd")
const Pausa := preload("res://interfaz/pausa.gd")
const Cuaderno := preload("res://interfaz/cuaderno.gd")
const Menu := preload("res://interfaz/menu.gd")
const Mapa := preload("res://interfaz/mapa.gd")

var raiz: Control
var hud: Control
var dialogo: Control
var carga: Control
var anfitrion: Control
var pausa: Control
var cuaderno: Control
var menu: Control
var mapa: Control
var velo: ColorRect
var _pausa_previa := false
var _ocupada_hasta := 0
var _mapa_desde_menu := false
var _hablando := false


func _ready() -> void:
	layer = 10
	process_mode = Node.PROCESS_MODE_ALWAYS
	raiz = Control.new()
	raiz.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	raiz.mouse_filter = Control.MOUSE_FILTER_IGNORE
	raiz.theme = Estilo.tema()
	add_child(raiz)
	hud = Hud.new()
	dialogo = Dialogo.new()
	cuaderno = Cuaderno.new()
	pausa = Pausa.new()
	menu = Menu.new()
	mapa = Mapa.new()
	anfitrion = Anfitrion.new()
	carga = VentanaCarga.new()
	for nodo in [hud, dialogo, cuaderno, pausa, menu, mapa, anfitrion, carga]:
		raiz.add_child(nodo)
	hud.visible = false
	velo = ColorRect.new()
	velo.color = Color("12181b")
	velo.modulate.a = 0.0
	velo.mouse_filter = Control.MOUSE_FILTER_IGNORE
	velo.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	raiz.add_child(velo)
	pausa.accion.connect(_accion_pausa)
	cuaderno.cerrado.connect(_cuaderno_cerrado)
	menu.elegido.connect(_accion_menu)
	mapa.cerrado.connect(_mapa_cerrado)
	mapa.viajar.connect(_mapa_viajar)


func _abierta() -> bool:
	return _hablando or dialogo.visible or anfitrion.visible or pausa.visible or cuaderno.visible or menu.visible or carga.visible or mapa.visible


func _process(_delta: float) -> void:
	if _abierta():
		_ocupada_hasta = Time.get_ticks_msec() + 300


func ocupada() -> bool:
	# true mientras haya algo abierto que bloquea a la protagonista, y 0,3 s mas: asi la pulsacion que
	# cierra un dialogo o un minijuego (E o Intro) no vuelve a usar el objeto que esta al lado
	return _abierta() or Time.get_ticks_msec() < _ocupada_hasta


# ------------------------------------------------------------------ dialogos y avisos

func decir(lineas: Variant, quien: String = "") -> void:
	while _hablando:
		await get_tree().process_frame
	_hablando = true
	await dialogo.decir(lineas, quien)
	_hablando = false


func elegir(pregunta: Variant, opciones: Array) -> int:
	while _hablando:
		await get_tree().process_frame
	_hablando = true
	var indice: int = await dialogo.elegir(pregunta, opciones)
	_hablando = false
	return indice


func aviso(texto: String, segundos: float = 3.0) -> void:
	if hud != null:
		hud.aviso(texto, segundos)


func indicar(texto: String) -> void:
	hud.indicar(texto)


func rotular(origen: Object, texto: String) -> void:
	hud.rotular(origen, texto)


func limpiar_rotulos() -> void:
	hud.limpiar_rotulos()


func mostrar_hud(ver: bool) -> void:
	hud.visible = ver


func anunciar_zona(meta: Dictionary) -> void:
	hud.anunciar_zona(meta)


# ------------------------------------------------------------------ carga y fundidos

func mostrar_carga(meta: Dictionary) -> void:
	await carga.mostrar(meta)


func ocultar_carga() -> void:
	await carga.ocultar()


func fundido(a_oscuro: bool, segundos: float = 0.4) -> void:
	var meta_alfa := 1.0 if a_oscuro else 0.0
	if Juego.modo_prueba:
		velo.modulate.a = meta_alfa
		await get_tree().process_frame
		return
	var t := velo.create_tween()
	t.tween_property(velo, "modulate:a", meta_alfa, segundos)
	await t.finished


# ------------------------------------------------------------------ minijuegos

func abrir_minijuego(id: String, parametros: Dictionary = {}) -> Dictionary:
	if not FileAccess.file_exists("res://minijuegos/%s/%s.gd" % [id, id]):
		# todavia no esta construido: no bloquea la historia, pero queda avisado
		print("AVISO minijuego en construccion: ", id)
		aviso("El reto «%s» todavía está en construcción." % id, 3.0)
		return {"superado": true, "puntos": 0.0, "detalle": "", "en_construccion": true}
	var estaba_en_pausa := get_tree().paused
	get_tree().paused = true
	var resultado: Dictionary = await anfitrion.jugar(id, parametros)
	get_tree().paused = estaba_en_pausa
	Juego.registrar_minijuego(id, resultado)
	return resultado


# ------------------------------------------------------------------ menu, pausa y cuaderno

func abrir_menu() -> void:
	mostrar_hud(false)
	menu.abrir()


func _en_juego() -> bool:
	return Zonas.actual != null and not Zonas.ocupado


func _input(evento: InputEvent) -> void:
	if evento is InputEventKey and evento.pressed and not evento.echo:
		if evento.keycode == KEY_F11:
			var modo := DisplayServer.window_get_mode()
			DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_WINDOWED if modo == DisplayServer.WINDOW_MODE_FULLSCREEN else DisplayServer.WINDOW_MODE_FULLSCREEN)
			return
		if evento.keycode == KEY_F12:
			capturar("res://capturas/captura_%d.png" % int(Time.get_unix_time_from_system()))
			return
	if anfitrion.visible or carga.visible or mapa.visible:
		return
	if menu.visible:
		return
	if evento.is_action_pressed("mapa") and _en_juego() and not ocupada():
		abrir_mapa(false)
		get_viewport().set_input_as_handled()
		return
	if evento.is_action_pressed("pausa"):
		if pausa.visible:
			_accion_pausa("continuar")
		elif cuaderno.visible:
			cuaderno.cerrar()
		elif _en_juego() and not ocupada():
			_abrir_pausa()
		else:
			return
		get_viewport().set_input_as_handled()
	elif evento.is_action_pressed("cuaderno"):
		if cuaderno.visible:
			cuaderno.cerrar()
		elif _en_juego() and not ocupada():
			abrir_cuaderno()
		else:
			return
		get_viewport().set_input_as_handled()


func _abrir_pausa() -> void:
	_pausa_previa = get_tree().paused
	get_tree().paused = true
	var opciones: Array = [["Continuar", "continuar"], ["Mapa", "mapa"], ["Cuaderno", "cuaderno"]]
	if Zonas.actual != null and Zonas.actual.has_method("despertar"):
		opciones.append(["Despertar", "despertar"])
	opciones.append(["Menú principal", "menu"])
	opciones.append(["Salir del juego", "salir"])
	pausa.abrir(opciones)


func _accion_pausa(nombre: String) -> void:
	pausa.cerrar()
	match nombre:
		"cuaderno":
			cuaderno.abrir()
		"mapa":
			_mapa_desde_menu = false
			mapa.abrir(false)
		"despertar":
			get_tree().paused = false
			Zonas.actual.call("despertar")
		"menu":
			get_tree().paused = false
			Juego.guardar()
			Zonas.cerrar()
			abrir_menu()
		"salir":
			Juego.guardar()
			salir()
		_:
			get_tree().paused = _pausa_previa


func abrir_cuaderno() -> void:
	_pausa_previa = get_tree().paused
	get_tree().paused = true
	Audio.sonar("pagina")
	cuaderno.abrir()


func _cuaderno_cerrado() -> void:
	get_tree().paused = _pausa_previa


func abrir_mapa(viaje: bool = false) -> void:
	# el mapa del mundo: lugares, conexiones y donde esta la protagonista
	_mapa_desde_menu = menu.visible
	if not _mapa_desde_menu:
		_pausa_previa = get_tree().paused
		get_tree().paused = true
	Audio.sonar("pagina")
	mapa.abrir(viaje)


func _mapa_cerrado() -> void:
	if not _mapa_desde_menu:
		get_tree().paused = _pausa_previa


func _mapa_viajar(id_zona: String) -> void:
	if _mapa_desde_menu:
		# visita libre desde el menu principal: todo abierto, para recorrer y validar cada escenario
		Juego.nueva_partida()
		Juego.poner_bandera("visita_libre")
		menu.cerrar()
	else:
		get_tree().paused = _pausa_previa
	Zonas.ir_a(id_zona, "inicio")


func _accion_menu(accion: String, dato: String) -> void:
	match accion:
		"nueva":
			Juego.nueva_partida()
			menu.cerrar()
			Zonas.ir_a(_zona_inicial(), "inicio")
		"continuar":
			if not Juego.cargar():
				Juego.nueva_partida()
			menu.cerrar()
			var zona: String = Juego.estado.get("zona", _zona_inicial())
			if not Zonas.existe(zona):
				zona = _zona_inicial()
			Zonas.ir_a(zona, Juego.estado.get("entrada", "inicio"))
		"minijuegos":
			menu.mostrar_minijuegos()
		"lugares":
			menu.mostrar_lugares()
		"mapa":
			abrir_mapa(true)
		"inicio":
			menu.mostrar_inicio()
		"minijuego":
			await abrir_minijuego(dato, {"dificultad": 1, "desde_menu": true})
			menu.mostrar_minijuegos()
		"lugar":
			# visita libre: los umbrales con requisito quedan abiertos para poder validar cada escenario
			Juego.nueva_partida()
			Juego.poner_bandera("visita_libre")
			menu.cerrar()
			Zonas.ir_a(dato, "inicio")
		"salir":
			salir()


func _zona_inicial() -> String:
	if Zonas.existe("habitacion"):
		return "habitacion"
	var lista := Zonas.catalogo(true)
	return lista[0]["id"] if not lista.is_empty() else ""


func capturar(ruta: String) -> void:
	await RenderingServer.frame_post_draw
	var imagen := get_viewport().get_texture().get_image()
	var destino := ProjectSettings.globalize_path(ruta) if ruta.begins_with("res://") else ruta
	imagen.save_png(destino)
	print("CAPTURA_OK ", destino)


func salir() -> void:
	print("FIN")
	Recursos.liberar()
	get_tree().quit()


===== juego/interfaz/menu.gd =====
extends Control

# Menu principal: nueva partida, continuar, minijuegos (galeria para jugarlos sueltos), lugares (para visitar
# y validar cada escenario) y salir. Estilo y titulo PROVISIONALES: «Luz cenicienta» es el nombre de trabajo
# del capitulo en el borrador de la Fase 2, sin aprobar; el titulo comercial no puede llevar «NASA».

signal elegido(accion: String, dato: String)

const Estilo := preload("res://interfaz/estilo.gd")

var _columna: VBoxContainer
var _fase := 0.12


func _ready() -> void:
	set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	visible = false
	var fondo := ColorRect.new()
	fondo.color = Estilo.NOCHE
	fondo.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	fondo.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(fondo)
	var cielo := Control.new()
	cielo.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	cielo.mouse_filter = Control.MOUSE_FILTER_IGNORE
	cielo.draw.connect(func(): _dibujar_cielo(cielo))
	add_child(cielo)
	_columna = VBoxContainer.new()
	_columna.add_theme_constant_override("separation", 10)
	_columna.position = Vector2(90, 70)
	add_child(_columna)
	var pie := Estilo.texto("Prototipo jugable v0 · arte y textos en validación · datos espaciales reales con su fuente", 14, Estilo.PETROLEO, 500)
	pie.autowrap_mode = TextServer.AUTOWRAP_OFF
	pie.position = Vector2(90, 680)
	add_child(pie)


func _dibujar_cielo(lienzo: Control) -> void:
	# estrellas fijas y la «Luna sonriente» del 12-11-2026 vista desde Guayaquil: 12,2 % iluminada
	var semilla := 7
	for i in 90:
		semilla = (semilla * 1103515245 + 12345) & 0x7fffffff
		var x := float(semilla % 1280)
		semilla = (semilla * 1103515245 + 12345) & 0x7fffffff
		var y := float(semilla % 720)
		semilla = (semilla * 1103515245 + 12345) & 0x7fffffff
		var brillo := 0.25 + float(semilla % 100) / 160.0
		lienzo.draw_circle(Vector2(x, y), 1.0 + float(semilla % 3) * 0.5, Color(Estilo.BRILLO, brillo))
	Estilo.luna(lienzo, Vector2(930, 300), 150.0, _fase, PI * 0.5 + 0.22, Estilo.CREMA, Color("2b3b44"))


func _titulo(texto: String, sub: String) -> void:
	for hijo in _columna.get_children():
		_columna.remove_child(hijo)
		hijo.queue_free()
	var t := Estilo.texto(texto, 62, Estilo.CREMA, 700)
	t.autowrap_mode = TextServer.AUTOWRAP_OFF
	_columna.add_child(t)
	var s := Estilo.texto(sub, 21, Estilo.CIAN, 500)
	s.custom_minimum_size = Vector2(560, 0)
	_columna.add_child(s)
	_columna.add_child(Estilo.separador(14))


func _boton(texto: String, accion: String, dato: String = "", principal: bool = false, detalle: String = "") -> Button:
	var b := Estilo.boton(texto, 23, principal)
	b.custom_minimum_size = Vector2(430, 50)
	b.alignment = HORIZONTAL_ALIGNMENT_LEFT
	b.pressed.connect(func(): elegido.emit(accion, dato))
	if detalle != "":
		b.tooltip_text = detalle
	_columna.add_child(b)
	return b


func abrir() -> void:
	visible = true
	mostrar_inicio()


func cerrar() -> void:
	visible = false


func mostrar_inicio() -> void:
	_titulo("Luz cenicienta", "Una estudiante de ingeniería de control de Guayaquil, su gato Órbita y la Luna de esta noche.")
	var primero: Button = null
	if Juego.hay_partida():
		primero = _boton("Continuar", "continuar", "", true)
		_boton("Nueva partida", "nueva")
	else:
		primero = _boton("Nueva partida", "nueva", "", true)
	_boton("Mapa del mundo", "mapa")
	_boton("Minijuegos", "minijuegos")
	_boton("Lugares", "lugares")
	_boton("Salir", "salir")
	primero.grab_focus.call_deferred()


func mostrar_minijuegos() -> void:
	_titulo("Minijuegos", "Cada reto enseña un dato espacial real o una idea de control. Aquí se juegan sueltos.")
	var primero: Button = null
	var cuadricula := GridContainer.new()
	cuadricula.columns = 2
	cuadricula.add_theme_constant_override("h_separation", 10)
	cuadricula.add_theme_constant_override("v_separation", 8)
	_columna.add_child(cuadricula)
	for m in Juego.catalogo_minijuegos():
		if m.get("oculto", false):
			continue
		var hecho: Dictionary = Juego.estado["minijuegos"].get(m["id"], {})
		var marca := "✓ " if hecho.get("superado", false) else ""
		var b := Estilo.boton(marca + String(m.get("titulo", m["id"])), 20)
		b.custom_minimum_size = Vector2(330, 46)
		b.alignment = HORIZONTAL_ALIGNMENT_LEFT
		b.tooltip_text = m.get("resumen", "")
		var id_mj: String = m["id"]
		var zona_mj: String = m.get("zona", "")
		if zona_mj != "":
			b.pressed.connect(func(): elegido.emit("lugar", zona_mj))
		else:
			b.pressed.connect(func(): elegido.emit("minijuego", id_mj))
		cuadricula.add_child(b)
		if primero == null:
			primero = b
	var volver := _boton("Volver", "inicio")
	(primero if primero != null else volver).grab_focus.call_deferred()


func mostrar_lugares() -> void:
	_titulo("Lugares", "Visita cada escenario por separado. Los marcados como provisionales esperan la validación del arte.")
	var primero: Button = null
	for z in Zonas.catalogo():
		var provisional: bool = String(z.get("estado_arte", "")).begins_with("provisional")
		var texto := String(z.get("nombre", z["id"])) + ("  (provisional)" if provisional else "")
		var b := _boton(texto, "lugar", z["id"])
		if primero == null:
			primero = b
	var volver := _boton("Volver", "inicio")
	(primero if primero != null else volver).grab_focus.call_deferred()


