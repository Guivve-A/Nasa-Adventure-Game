===== Misión Artemis\codigo\personaje.gd =====
1: extends AnimatedSprite2D
2: 
3: # Personaje lunar en pixel art (32 x 32 por cuadro) para Godot 4.
4: # Arma sus animaciones solo, a partir de recursos/personajes/<id>.png y <id>.json.
5: # La posicion del nodo es la de los pies, para apoyarlo directo en el suelo.
6: #
7: # Ids: jugador (quieto, caminar, saltar) y comandante, geologa, ingeniero, piloto, medica (quieto, hablar).
8: #
9: # Uso en el editor: crea un AnimatedSprite2D, asignale este script y escribe el id en "personaje".
10: # Uso por codigo:
11: #   var p = preload("personaje.gd").new()
12: #   p.personaje = "geologa"
13: #   add_child(p)
14: 
15: @export var personaje := "jugador"
16: @export var escala_pixel := 1.0    # el proyecto ya escala la pantalla: 1 = un pixel del arte
17: 
18: var tam := 32
19: 
20: 
21: func _ready() -> void:
22: 	cargar(personaje)
23: 
24: 
25: func cargar(id: String) -> void:
26: 	personaje = id
27: 	var base: String = (get_script() as Script).resource_path.get_base_dir().get_base_dir() + "/recursos/personajes/"
28: 	var hoja: Texture2D = load(base + id + ".png")
29: 	var datos: JSON = load(base + id + ".json")
30: 	if hoja == null or datos == null:
31: 		push_warning("personaje.gd: falta recursos/personajes/%s.png o .json" % id)
32: 		return
33: 	var meta: Dictionary = datos.data
34: 	tam = int(meta.get("tam", 32))
35: 	var marcos := SpriteFrames.new()
36: 	var anims: Dictionary = meta["animaciones"]
37: 	for nombre in anims:
38: 		var a: Dictionary = anims[nombre]
39: 		marcos.add_animation(nombre)
40: 		marcos.set_animation_speed(nombre, float(a["fps"]))
41: 		marcos.set_animation_loop(nombre, bool(a["bucle"]))
42: 		for c in int(a["cuadros"]):
43: 			var recorte := AtlasTexture.new()
44: 			recorte.atlas = hoja
45: 			recorte.region = Rect2(c * tam, int(a["fila"]) * tam, tam, tam)
46: 			marcos.add_frame(nombre, recorte)
47: 	if marcos.has_animation("default") and not anims.has("default"):
48: 		marcos.remove_animation("default")
49: 	sprite_frames = marcos
50: 	texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
51: 	centered = true
52: 	offset = Vector2(0, -tam * 0.5)
53: 	scale = Vector2(escala_pixel, escala_pixel)
54: 	play("quieto")
55: 
56: 
57: func mirar(direccion: float) -> void:
58: 	# los sprites miran a la derecha; con direccion negativa se voltean
59: 	if direccion != 0.0:
60: 		flip_h = direccion < 0.0

