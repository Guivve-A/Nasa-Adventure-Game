210: func _enlaces(ids: Array) -> void:
211: 	# cada umbral lleva a una zona que existe y a una entrada que esa zona define
212: 	for d in _destinos:
213: 		if not ids.has(d[0]) or d[2] == "":
214: 			continue
215: 		if not comprobar(Zonas.existe(d[2]), "%s.umbral_%s.destino_existe" % [d[0], d[1]], "la zona '%s' no existe todavia" % d[2]):
216: 			continue
217: 		if not _entradas_por_zona.has(d[2]):
218: 			Juego.nueva_partida()
219: 			await Zonas.ir_a(d[2], "inicio")
220: 			if Zonas.actual != null:
221: 				_entradas_por_zona[d[2]] = Zonas.actual.entradas.keys()
222: 		var entradas: Array = _entradas_por_zona.get(d[2], [])
223: 		comprobar(entradas.has(d[3]), "%s.umbral_%s.entrada_destino" % [d[0], d[1]], "'%s' no tiene la entrada '%s' (tiene %s)" % [d[2], d[3], str(entradas)])
