3: # Fuente pixel propia de la seccion de Marte (herramientas/fuente_pixel.py dibuja las letras).
4: # Arma un FontFile de mapa de bits a partir de recursos/fuente/pixel_marte.png y .json.
5: # Tamano base 8: los tamanos de 8 a 15 se ven a 1x y los de 16 o mas a 2x, siempre nitidos.
6: # Si falta una letra, se usa la fuente por defecto de Godot.
7: 
8: const BASE := 8
9: 
10: static var _fuente: FontFile
11: 
12: 
13: static func obtener() -> Font:
14: 	if _fuente != null:
15: 		return _fuente
16: 	var raiz: String = "res://recursos/fuente/"
17: 	var tex: Texture2D = load(raiz + "pixel_marte.png")
18: 	var meta: Dictionary = (load(raiz + "pixel_marte.json") as JSON).data
19: 	if tex == null:
20: 		return ThemeDB.fallback_font
21: 	var f := FontFile.new()
22: 	f.antialiasing = TextServer.FONT_ANTIALIASING_NONE
23: 	f.generate_mipmaps = false
24: 	f.multichannel_signed_distance_field = false
25: 	f.fixed_size = BASE
26: 	f.fixed_size_scale_mode = TextServer.FIXED_SIZE_SCALE_INTEGER_ONLY
27: 	f.fallbacks = [ThemeDB.fallback_font]
28: 	var tam := Vector2i(BASE, 0)
29: 	var asc := float(meta["ascenso"])
30: 	var alto := float(meta["alto"])
31: 	f.set_cache_ascent(0, BASE, asc)
32: 	f.set_cache_descent(0, BASE, alto - asc)
33: 	f.set_texture_image(0, tam, 0, tex.get_image())
34: 	var glifos: Dictionary = meta["glifos"]
35: 	for k in glifos:
36: 		var g: Array = glifos[k]
37: 		var cod := int(k)
38: 		var x := float(g[0])
39: 		var w := float(g[1])
40: 		f.set_glyph_advance(0, BASE, cod, Vector2(w + 1.0, 0.0))
41: 		f.set_glyph_offset(0, tam, cod, Vector2(0.0, -asc))
42: 		f.set_glyph_size(0, tam, cod, Vector2(w, alto))
43: 		f.set_glyph_uv_rect(0, tam, cod, Rect2(x, 0.0, w, alto))
44: 		f.set_glyph_texture_idx(0, tam, cod, 0)
45: 	_fuente = f
46: 	return f
