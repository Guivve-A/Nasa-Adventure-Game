extends Node

# Entradas reales: nunca llama a jugar_solo ni a los manejadores del minijuego.
const EVIDENCIA: String = "res://../Nasa_Game/Construccion/Minijuegos/telescopio/"
var _pulsadas: Dictionary = {}
var _raton: Vector2 = Vector2.ZERO
var _resultado: Dictionary = {}
var _listo: bool = false


func correr(pruebas: Node) -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	Juego.modo_prueba = false
	Juego.sin_guardar = true
	Juego.minijuegos_solos = false
	await _teclado(pruebas)
	await _raton_solo(pruebas)
	await _salidas(pruebas)
	_soltar()
	pruebas.comprobar(not get_tree().paused, "telescopio.manos.arbol_sin_pausa", "El anfitrion debe devolver la pausa previa.")
	Juego.modo_prueba = true


func _lanzar() -> void:
	_resultado = await Interfaz.abrir_minijuego("telescopio", {"dificultad": 1})
	_listo = true


func _abrir(p: Node, nombre: String, teclado: bool = true) -> Control:
	_listo = false
	_resultado = {}
	_lanzar()
	for i in 180:
		if Interfaz.anfitrion.visible:
			break
		await get_tree().process_frame
	await _real(0.12)
	var m: Control = Interfaz.anfitrion.get("_minijuego")
	if not p.comprobar(Interfaz.anfitrion.visible and m != null, "telescopio.%s.abierto" % nombre):
		return null
	p.comprobar(int(m.get("_auto")) == 0 and int(m.get("_solo")) == 0, "telescopio.%s.sin_piloto" % nombre)
	if nombre in ["teclado", "raton"]:
		await _captura(nombre + "_instrucciones")
	if teclado:
		await _toque(KEY_ENTER)
	else:
		await _clic(_boton("Empezar").get_global_rect().get_center())
	p.comprobar(bool(m.get("activo")), "telescopio.%s.Empezar" % nombre)
	return m


func _teclado(p: Node) -> void:
	var m: Control = await _abrir(p, "teclado")
	if m == null:
		return
	await _captura("teclado_buscar")
	await _limites(p, m, "buscar")
	# Cada tecla anunciada debe mover el eje correspondiente, sin pedir foco.
	for par in [[KEY_A, "acimut", -1], [KEY_D, "acimut", 1], [KEY_W, "altura", 1], [KEY_S, "altura", -1], [KEY_LEFT, "acimut", -1], [KEY_RIGHT, "acimut", 1], [KEY_UP, "altura", 1], [KEY_DOWN, "altura", -1]]:
		var antes: float = float(m.get(par[1]))
		await _sostener(int(par[0]), 0.06)
		p.comprobar((float(m.get(par[1])) - antes) * int(par[2]) > 0.0, "telescopio.teclado.buscar_%s" % OS.get_keycode_string(int(par[0])))
	# Los numeros son las lecturas que aparecen en la ayuda de BUSCAR.
	for i in 1800:
		var dx: float = 241.4 - float(m.get("acimut"))
		var dy: float = 20.0 - float(m.get("altura"))
		_tecla(KEY_A, dx < -0.3)
		_tecla(KEY_D, dx > 0.3)
		_tecla(KEY_W, dy > 0.3)
		_tecla(KEY_S, dy < -0.3)
		if absf(dx) <= 0.3 and absf(dy) <= 0.3:
			break
		await get_tree().process_frame
	_soltar()
	await _toque(KEY_E)
	p.comprobar(int(m.get("etapa")) == 1, "telescopio.teclado.E_confirma_busqueda")
	await _limites(p, m, "enfocar")
	for codigo in [KEY_A, KEY_D, KEY_LEFT, KEY_RIGHT]:
		var antes: float = float(m.get("enfoque"))
		await _sostener(codigo, 0.06)
		var signo: float = -1.0 if codigo in [KEY_A, KEY_LEFT] else 1.0
		p.comprobar((float(m.get("enfoque")) - antes) * signo > 0.0, "telescopio.teclado.enfocar_%s" % OS.get_keycode_string(codigo))
	_tecla(KEY_D, true)
	for i in 900:
		if _nitidez(m) >= 95.0:
			break
		await get_tree().process_frame
	_soltar()
	await _captura("teclado_enfocar")
	await _toque(KEY_ENTER)
	p.comprobar(int(m.get("etapa")) == 2, "telescopio.teclado.Intro_confirma_enfoque")
	for codigo in [KEY_A, KEY_D, KEY_W, KEY_S, KEY_LEFT, KEY_RIGHT, KEY_UP, KEY_DOWN]:
		var antes: Vector2 = m.get("mira")
		await _sostener(codigo, 0.06)
		var cambio: Vector2 = Vector2(m.get("mira")) - antes
		var direccion: Vector2 = Vector2.LEFT if codigo in [KEY_A, KEY_LEFT] else Vector2.RIGHT
		if codigo in [KEY_W, KEY_UP]:
			direccion = Vector2.UP
		elif codigo in [KEY_S, KEY_DOWN]:
			direccion = Vector2.DOWN
		p.comprobar(cambio.dot(direccion) > 0.0, "telescopio.teclado.mira_%s" % OS.get_keycode_string(codigo))
	for rasgo in 3:
		var destino: Vector2 = _marca_visible(m, rasgo)
		for i in 900:
			var d: Vector2 = destino - Vector2(m.get("mira"))
			_tecla(KEY_A, d.x < -4.0)
			_tecla(KEY_D, d.x > 4.0)
			_tecla(KEY_W, d.y < -4.0)
			_tecla(KEY_S, d.y > 4.0)
			if absf(d.x) <= 4.0 and absf(d.y) <= 4.0:
				_soltar()
				await get_tree().process_frame
				await get_tree().process_frame
				var restante: Vector2 = destino - Vector2(m.get("mira"))
				if absf(restante.x) <= 4.0 and absf(restante.y) <= 4.0:
					break
			await get_tree().process_frame
		_soltar()
		await _limites(p, m, "rasgo_%d" % rasgo)
		await _captura("teclado_rasgo_%d" % rasgo)
		await _toque([KEY_SPACE, KEY_E, KEY_ENTER][rasgo])
		p.comprobar(int(m.get("rasgo")) == rasgo + 1, "telescopio.teclado.marca_%d" % rasgo)
	await _victoria(p, "teclado", true)


func _raton_solo(p: Node) -> void:
	var m: Control = await _abrir(p, "raton", false)
	if m == null:
		return
	# Coordenadas de la Luna que se ve en el buscador, relativas al ocular.
	var ocular: Control = m.get("_superficie")
	var luna: Vector2 = ocular.get_global_rect().get_center() + Vector2((241.4 - float(m.get("acimut"))) * 6.0, (float(m.get("altura")) - 20.0) * 6.0)
	await _clic(luna)
	p.comprobar(absf(float(m.get("acimut")) - 241.4) < 0.01 and absf(float(m.get("altura")) - 20.0) < 0.01, "telescopio.raton.clic_centra_luna_visible")
	for par in [["_dial_az", "acimut", 241.0], ["_dial_alt", "altura", 20.3]]:
		var antes: float = float(m.get(par[1]))
		await _arrastrar(m.get(par[0]), float(par[2]))
		p.comprobar(absf(float(m.get(par[1])) - float(par[2])) < 0.1 and not is_equal_approx(antes, float(m.get(par[1]))), "telescopio.raton.arrastra_%s" % par[1])
	await _clic_confirmar(m)
	p.comprobar(int(m.get("etapa")) == 1, "telescopio.raton.boton_confirma_busqueda")
	await _arrastrar(m.get("_dial_foco"), 0.45)
	p.comprobar(absf(float(m.get("enfoque")) - 0.45) < 0.01, "telescopio.raton.arrastra_enfoque")
	await _mover(ocular.get_global_rect().get_center())
	var antes: float = float(m.get("enfoque"))
	await _rueda(MOUSE_BUTTON_WHEEL_DOWN)
	p.comprobar(float(m.get("enfoque")) < antes, "telescopio.raton.rueda_abajo")
	antes = float(m.get("enfoque"))
	await _rueda(MOUSE_BUTTON_WHEEL_UP)
	p.comprobar(float(m.get("enfoque")) > antes, "telescopio.raton.rueda_arriba")
	for i in 25:
		if _nitidez(m) >= 95.0:
			break
		await _rueda(MOUSE_BUTTON_WHEEL_UP)
	await _clic_confirmar(m)
	p.comprobar(int(m.get("etapa")) == 2, "telescopio.raton.boton_confirma_enfoque")
	for rasgo in 3:
		var local: Vector2 = _marca_visible(m, rasgo)
		var posicion: Vector2 = m.get_global_rect().position + local
		if rasgo == 1:
			await _clic(posicion)
		else:
			await _mover(posicion)
		p.comprobar(Vector2(m.get("mira")).distance_to(local) < 0.1, "telescopio.raton.mira_%d" % rasgo)
		await _captura("raton_rasgo_%d" % rasgo)
		await _clic_confirmar(m)
		p.comprobar(int(m.get("rasgo")) == rasgo + 1, "telescopio.raton.marca_%d" % rasgo)
	await _victoria(p, "raton", false)


func _marca_visible(m: Control, rasgo: int) -> Vector2:
	# Puntos observados en el ocular: frontera inferior, centro oscuro y guia.
	# No consulta objetivos del piloto ni llama a la funcion que decide aciertos.
	var ocular: Control = m.get("_superficie")
	var centro: Vector2 = ocular.get_rect().get_center()
	if rasgo == 0:
		return centro + Vector2(0, 114)
	if rasgo == 1:
		return centro
	return centro + Vector2(55, 118)


func _nitidez(m: Control) -> float:
	var lectura: Label = m.get("_lectura")
	var patron: RegEx = RegEx.new()
	patron.compile("Nitidez: ([0-9]+)")
	var coincidencia: RegExMatch = patron.search(lectura.text)
	return float(coincidencia.get_string(1)) if coincidencia != null else 0.0


func _victoria(p: Node, nombre: String, teclado: bool) -> void:
	await _real(0.12)
	var resultado: Dictionary = Interfaz.anfitrion.get("_resultado")
	var gano: bool = bool(resultado.get("superado", false))
	p.comprobar(gano, "telescopio.%s.superado" % nombre, str(resultado))
	print("TELESCOPIO_MANOS %s %s" % [nombre, str(resultado)])
	await _captura(nombre + "_resultado")
	if not gano:
		# Un fallo de la prueba no debe abrir otra partida sobre una aun activa.
		await _toque(KEY_ESCAPE)
		await _cerrado(p, nombre)
		return
	if teclado:
		await _toque(KEY_ENTER)
	else:
		var boton: Button = _boton("Continuar")
		if boton != null:
			await _clic(boton.get_global_rect().get_center())
	await _cerrado(p, nombre)


func _cerrado(p: Node, nombre: String) -> void:
	for i in 180:
		if _listo and not Interfaz.anfitrion.visible:
			break
		await get_tree().process_frame
	await _real(0.12)
	p.comprobar(_listo and not Interfaz.anfitrion.visible, "telescopio.%s.anfitrion_cerrado" % nombre)
	p.comprobar(not get_tree().paused, "telescopio.%s.sin_pausa" % nombre)


func _salidas(p: Node) -> void:
	# Esc desde instrucciones, las tres etapas y el resultado, con entradas reales.
	_listo = false
	_lanzar()
	await _real(0.12)
	await _toque(KEY_ESCAPE)
	await _cerrado(p, "Esc_instrucciones")
	var m: Control = await _abrir(p, "Esc_buscar")
	await _toque(KEY_ESCAPE)
	await _cerrado(p, "Esc_buscar")
	for etapa in [1, 2, 3]:
		m = await _abrir(p, "Esc_etapa_%d" % etapa)
		if m == null:
			return
		await _arrastrar(m.get("_dial_az"), 241.4)
		await _arrastrar(m.get("_dial_alt"), 20.0)
		await _clic_confirmar(m)
		if etapa >= 2:
			await _arrastrar(m.get("_dial_foco"), 0.60)
			await _clic_confirmar(m)
		if etapa == 3:
			for rasgo in 3:
				await _mover(m.get_global_rect().position + _marca_visible(m, rasgo))
				await _clic_confirmar(m)
			var resultado: Dictionary = Interfaz.anfitrion.get("_resultado")
			p.comprobar(bool(resultado.get("superado", false)), "telescopio.Esc_resultado.visible")
		else:
			p.comprobar(int(m.get("etapa")) == etapa, "telescopio.Esc_etapa_%d.alcanzada" % etapa)
		await _toque(KEY_ESCAPE)
		await _cerrado(p, "Esc_etapa_%d" % etapa)
	# La salida tambien debe estar disponible usando solo el raton.
	_listo = false
	_lanzar()
	await _real(0.12)
	await _clic(_boton("Salir").get_global_rect().get_center())
	await _cerrado(p, "raton_Salir_instrucciones")
	m = await _abrir(p, "raton_Salir_activo", false)
	var salir: Button = Interfaz.anfitrion.get("_salir")
	await _clic(salir.get_global_rect().get_center())
	await _cerrado(p, "raton_Salir_activo")


func _limites(p: Node, m: Control, nombre: String) -> void:
	await get_tree().process_frame
	var fuera: PackedStringArray = []
	for hijo in m.get_children():
		if hijo is Control and hijo.visible and hijo != m.get("_capa_mira"):
			if not Rect2(Vector2.ZERO, m.size).encloses(hijo.get_rect()):
				fuera.append("%s %s" % [hijo.name, str(hijo.get_rect())])
	p.comprobar(fuera.is_empty(), "telescopio.lienzo.%s" % nombre, str(fuera))


func _boton(nombre: String) -> Button:
	var columna: Control = Interfaz.anfitrion.get("_capa_columna")
	for nodo in columna.find_children("*", "Button", true, false):
		if nodo.text == nombre:
			return nodo
	return null


func _captura(nombre: String) -> void:
	if Juego.args.has("evidencia_manos"):
		await Interfaz.capturar(ProjectSettings.globalize_path(EVIDENCIA + "manos_" + nombre + ".png"))


func _real(segundos: float) -> void:
	await get_tree().create_timer(segundos, true, false, true).timeout


func _tecla(codigo: int, abajo: bool) -> void:
	if bool(_pulsadas.get(codigo, false)) == abajo:
		return
	_pulsadas[codigo] = abajo
	var evento: InputEventKey = InputEventKey.new()
	evento.physical_keycode = codigo
	evento.keycode = codigo
	evento.pressed = abajo
	Input.parse_input_event(evento)


func _toque(codigo: int) -> void:
	_tecla(codigo, true)
	await get_tree().process_frame
	await get_tree().physics_frame
	await get_tree().process_frame
	_tecla(codigo, false)
	await _real(0.04)


func _sostener(codigo: int, segundos: float) -> void:
	_tecla(codigo, true)
	await get_tree().process_frame
	await get_tree().physics_frame
	await get_tree().process_frame
	await _real(segundos)
	_tecla(codigo, false)
	await get_tree().process_frame
	await get_tree().process_frame


func _soltar() -> void:
	for codigo in _pulsadas.keys():
		_tecla(int(codigo), false)


func _mover(posicion: Vector2, arrastrando: bool = false) -> void:
	# parse_input_event recibe pixeles de ventana, tambien en headless (64x64).
	var transformacion: Transform2D = get_viewport().get_final_transform()
	var evento: InputEventMouseMotion = InputEventMouseMotion.new()
	evento.position = transformacion * posicion
	evento.global_position = evento.position
	evento.relative = transformacion * posicion - transformacion * _raton
	evento.button_mask = MOUSE_BUTTON_MASK_LEFT if arrastrando else 0
	_raton = posicion
	Input.parse_input_event(evento)
	await get_tree().process_frame


func _boton_raton(codigo: int, abajo: bool) -> void:
	var evento: InputEventMouseButton = InputEventMouseButton.new()
	evento.position = get_viewport().get_final_transform() * _raton
	evento.global_position = evento.position
	evento.button_index = codigo
	evento.button_mask = MOUSE_BUTTON_MASK_LEFT if abajo and codigo == MOUSE_BUTTON_LEFT else 0
	evento.pressed = abajo
	Input.parse_input_event(evento)


func _clic(posicion: Vector2) -> void:
	await _mover(posicion)
	_boton_raton(MOUSE_BUTTON_LEFT, true)
	await _real(0.04)
	_boton_raton(MOUSE_BUTTON_LEFT, false)
	await _real(0.06)


func _clic_confirmar(m: Control) -> void:
	var boton: Button = m.get("_confirmar_boton")
	await _clic(boton.get_global_rect().get_center())


func _rueda(codigo: int) -> void:
	_boton_raton(codigo, true)
	await get_tree().process_frame
	_boton_raton(codigo, false)
	await get_tree().process_frame


func _arrastrar(dial: HSlider, destino: float) -> void:
	var rect: Rect2 = dial.get_global_rect()
	var ancho: float = dial.get_theme_icon("grabber").get_width()
	var inicio: float = (dial.value - dial.min_value) / (dial.max_value - dial.min_value)
	var fin: float = (destino - dial.min_value) / (dial.max_value - dial.min_value)
	await _mover(rect.position + Vector2(ancho * 0.5 + inicio * (rect.size.x - ancho), rect.size.y * 0.5))
	_boton_raton(MOUSE_BUTTON_LEFT, true)
	await get_tree().process_frame
	await _mover(rect.position + Vector2(ancho * 0.5 + fin * (rect.size.x - ancho), rect.size.y * 0.5), true)
	_boton_raton(MOUSE_BUTTON_LEFT, false)
	await _real(0.06)
extends Node

# Comprobaciones especificas del carril; no modifican el anfitrion.
const Minijuego = preload("res://minijuegos/telescopio/telescopio.gd")


func _nuevo(dificultad: int) -> Control:
	var m: Control = Minijuego.new()
	add_child(m)
	m.preparar({"dificultad": dificultad}, Juego.info_minijuego("telescopio"))
	m.empezar()
	return m


func _liberar(m: Control) -> void:
	m.activo = false
	m.queue_free()
	await get_tree().process_frame


func correr(p: Node) -> void:
	for nivel in [1, 2, 3]:
		var m: Control = _nuevo(nivel)
		var resultado: Dictionary = {}
		m.terminado.connect(func(r: Dictionary): resultado.merge(r))
		m.jugar_solo(true)
		while m.activo and m.tiempo < 39:
			await get_tree().process_frame
		p.comprobar(bool(resultado.get("superado", false)) and m.marcas.size() == 3 and m.tiempo < 40, "telescopio.piloto_real_d%d" % nivel, str(resultado))
		print("TELESCOPIO_EVIDENCIA nivel=%d tiempo=%.3f marcas=%d" % [nivel, m.tiempo, m.marcas.size()])
		await _liberar(m)
	var m: Control = _nuevo(1)
	p.comprobar(m._causa_marca(m.CENTRO + Vector2(180, 0), 0) != "", "telescopio.fuera_del_disco")
	var terminador: Vector2 = m._objetivo_auto()
	p.comprobar(m._causa_marca(terminador, 0) == "", "telescopio.terminador_geometrico")
	p.comprobar(m._causa_marca(m.CENTRO, 0) != "", "telescopio.noche_no_es_frontera")
	p.comprobar(m._causa_marca(m.CENTRO, 1) == "", "telescopio.tierra_ilumina_noche")
	var brillante: Vector2 = m.CENTRO + (terminador - m.CENTRO).normalized() * m.RADIO * 0.89
	p.comprobar(m._causa_marca(brillante, 1).contains("Sol"), "telescopio.sol_no_es_cenicienta")
	p.comprobar(m._causa_marca(m.CENTRO + m.CRISIUM * m.RADIO, 2) == "", "telescopio.crisium_proyeccion_validada")
	p.comprobar(m._causa_marca(m.CENTRO, 2) != "", "telescopio.crisium_no_es_centro")
	m._confirmar()
	p.comprobar(m.etapa == 0 and m.revisiones == 1 and m._mensaje.text.contains("20,0Â°"), "telescopio.busqueda_alta_explica")
	m.acimut = m.datos["azimut_deg"]
	m.altura = m.datos["elevacion_deg"]
	m._confirmar()
	p.comprobar(m.etapa == 1, "telescopio.centrar_abre_enfoque")
	m._confirmar()
	p.comprobar(m.etapa == 1 and m._mensaje.text.contains("borroso"), "telescopio.enfoque_borroso_no_avanza")
	m.enfoque = m.FOCO
	m._confirmar()
	p.comprobar(m.etapa == 2, "telescopio.nitidez_abre_marcas")
	await _liberar(m)
	# Raton: centrar el objeto que aparece en el buscador, rueda y mira.
	m = _nuevo(1)
	var clic: InputEventMouseButton = InputEventMouseButton.new()
	clic.pressed = true
	clic.button_index = MOUSE_BUTTON_LEFT
	clic.position = m.CENTRO + Vector2((float(m.datos["azimut_deg"]) - m.acimut) * 6, (m.altura - float(m.datos["elevacion_deg"])) * 6)
	m._gui_input(clic)
	p.comprobar(m._centrada(), "telescopio.raton_centra_luna_visible")
	var confirmar: InputEventAction = InputEventAction.new()
	confirmar.action = "interactuar"
	confirmar.pressed = true
	m._input(confirmar)
	p.comprobar(m.etapa == 1, "telescopio.accion_teclado_confirma")
	clic.button_index = MOUSE_BUTTON_WHEEL_UP
	m._gui_input(clic)
	p.comprobar(is_equal_approx(m.enfoque, 0.145), "telescopio.rueda_raton_enfoca")
	m._dial_foco.value = m.FOCO
	m._input(confirmar)
	m.mira = m._objetivo_auto()
	m._input(confirmar)
	p.comprobar(m.etapa == 2 and m.rasgo == 1, "telescopio.marcar_terminador_real")
	var luz_solar: Vector2 = m.CENTRO + (terminador - m.CENTRO).normalized() * m.RADIO * 0.89
	var mover_raton: InputEventMouseMotion = InputEventMouseMotion.new()
	mover_raton.position = luz_solar
	m._gui_input(mover_raton)
	var fallo_luz: Dictionary = {}
	m.terminado.connect(func(r: Dictionary): fallo_luz.merge(r))
	for i in 5:
		m._input(confirmar)
	p.comprobar(not m.activo and not bool(fallo_luz.get("superado", true)) and String(fallo_luz.get("detalle", "")).contains("Sol"), "telescopio.fallo_real_al_senalar_sol")
	await _liberar(m)
	# El agotamiento de tiempo es real y usa la misma ruta de finalizacion.
	m = _nuevo(3)
	var agotado: Dictionary = {}
	m.terminado.connect(func(r: Dictionary): agotado.merge(r))
	m.tiempo = m.LIMITE
	m._paso(0.01)
	p.comprobar(not m.activo and not bool(agotado.get("superado", true)) and String(agotado.get("detalle", "")).contains("20,0Â°"), "telescopio.limite_150s_causal")
	await _liberar(m)
	if Juego.args.has("evidencia_telescopio"):
		await _capturas()


func _capturas() -> void:
	var m: Control = _nuevo(1)
	m.position = Vector2(80, 100)
	var base: String = ProjectSettings.globalize_path("res://../Nasa_Game/Construccion/Minijuegos/telescopio/")
	for etapa in [0, 1, 2, 3]:
		if etapa == 1:
			m.acimut = m.datos["azimut_deg"]
			m.altura = m.datos["elevacion_deg"]
			m._confirmar()
		elif etapa == 2:
			m.enfoque = m.FOCO
			m._confirmar()
		elif etapa == 3:
			m.mira = m._objetivo_auto()
			m._confirmar()
			m.mira = m._objetivo_auto()
			m._confirmar()
		m._refrescar()
		for i in 6:
			await get_tree().process_frame
		await Interfaz.capturar(base + "paso_%d.png" % etapa)
	await _liberar(m)
extends "res://nucleo/minijuego.gd"

# Una instantanea del cielo: el reloj de partida no avanza la efemeride.
# Los margenes y la escala del buscador son reglas didacticas, no medidas astronomicas.
const Recursos = preload("res://nucleo/recursos.gd")
const RAIZ: String = "res://minijuegos/telescopio/"
const VISTA: Rect2 = Rect2(16, 46, 620, 420)
const CENTRO: Vector2 = Vector2(326, 256)
const RADIO: float = 151.2
const ESCALA_BUSCADOR: float = 6.0
const FOCO: float = 0.62
const LIMITE: float = 150.0
const RASGOS: Array[String] = ["Terminador", "Luz cenicienta", "Mare Crisium"]
# Punto contrastado en la propuesta: (588,4; 522,4), centro (512; 360), radio 208,8.
const CRISIUM: Vector2 = Vector2(76.4 / 208.8, 162.4 / 208.8)

var datos: Dictionary = {}
var etapa: int = 0
var rasgo: int = 0
var acimut: float = 265.0
var altura: float = 42.0
var enfoque: float = 0.12
var mira: Vector2 = CENTRO
var revisiones: int = 0
var max_revisiones: int = 5
var margen_busqueda: float = 1.6
var margen_foco: float = 0.07
var margen_terminador: float = 0.12
var margen_crisium: float = 0.17
var marcas: Array[Vector2] = []
var _auto: int = 0
var _pulso: float = 0.0
var _observador: Vector3
var _sol: Vector3
var _norte: Vector3
var _este: Vector3
var _sn: Vector2
var _sb: Vector2
var _luna: ShaderMaterial
var _borroso: ShaderMaterial
var _ocular: SubViewport
var _superficie: TextureRect
var _capa_mira: Control
var _estado: Label
var _lectura: Label
var _altura_lectura: Label
var _tarea: Label
var _ayuda: Label
var _mensaje: Label
var _tiempo: Label
var _dial_az: HSlider
var _dial_alt: HSlider
var _dial_foco: HSlider
var _confirmar_boton: Button


func _preparar() -> void:
	datos = JSON.parse_string(FileAccess.get_file_as_string(RAIZ + "datos/luna.json"))
	max_revisiones = [5, 4, 3][dificultad - 1]
	margen_busqueda = [1.6, 1.2, 0.8][dificultad - 1]
	margen_foco = [0.07, 0.05, 0.035][dificultad - 1]
	margen_terminador = [0.12, 0.09, 0.065][dificultad - 1]
	margen_crisium = [0.17, 0.14, 0.11][dificultad - 1]
	_crear_luna()
	_estado = _etiqueta("", Vector2(24, 10), 610, 20, Estilo.TINTA)
	_tiempo = _etiqueta("", Vector2(674, 10), 416, 18, Estilo.TINTA)
	_etiqueta("Guayaquil Â· 12-11-2026 Â· 19:30", Vector2(674, 52), 416, 20)
	_etiqueta("12,2 % al Sol Â· 403 151 km\n20,0Â° de altura Â· creciente", Vector2(674, 84), 416, 20)
	_lectura = _etiqueta("", Vector2(674, 148), 416, 20)
	_altura_lectura = _etiqueta("", Vector2(674, 210), 416, 20)
	_dial_az = _dial(Vector2(674, 175), 200, 290, acimut)
	_dial_az.value_changed.connect(func(v: float): acimut = v)
	_dial_alt = _dial(Vector2(674, 235), 0, 70, altura)
	_dial_alt.value_changed.connect(func(v: float): altura = v)
	_dial_foco = _dial(Vector2(674, 210), 0, 1, enfoque)
	_dial_foco.value_changed.connect(func(v: float): enfoque = v)
	_tarea = _etiqueta("", Vector2(674, 284), 416, 22)
	_ayuda = _etiqueta("", Vector2(674, 321), 416, 18)
	_confirmar_boton = Estilo.boton("Confirmar Â· E / Intro / Espacio", 19, true)
	_confirmar_boton.position = Vector2(674, 420)
	_confirmar_boton.size = Vector2(416, 44)
	_confirmar_boton.focus_mode = Control.FOCUS_NONE
	_confirmar_boton.pressed.connect(_confirmar)
	add_child(_confirmar_boton)
	_mensaje = _etiqueta("", Vector2(24, 476), 1070, 18)
	_capa_mira = Control.new()
	_capa_mira.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_capa_mira.draw.connect(_dibujar_mira)
	add_child(_capa_mira)
	_refrescar()


func _etiqueta(contenido: String, pos: Vector2, ancho: float, tam: int, color: Color = Estilo.TINTA) -> Label:
	var l: Label = texto(contenido, tam, color)
	l.position = pos
	l.custom_minimum_size.x = ancho
	add_child(l)
	return l


func _dial(pos: Vector2, minimo: float, maximo: float, valor: float) -> HSlider:
	var d: HSlider = HSlider.new()
	d.position = pos
	d.size = Vector2(416, 30)
	d.min_value = minimo
	d.max_value = maximo
	d.step = 0.001
	d.value = valor
	d.focus_mode = Control.FOCUS_NONE
	d.add_theme_stylebox_override("slider", Estilo.caja(Estilo.PAPEL_SOMBRA, 4, 1))
	d.add_theme_stylebox_override("grabber_area", Estilo.caja(Estilo.CIAN_MEDIO, 4))
	add_child(d)
	return d


func _direccion(lon_deg: float, lat_deg: float) -> Vector3:
	var lon: float = deg_to_rad(lon_deg)
	var lat: float = deg_to_rad(lat_deg)
	return Vector3(cos(lat) * cos(lon), cos(lat) * sin(lon), sin(lat))


func _crear_luna() -> void:
	_observador = _direccion(datos["subobservador_lon_deg"], datos["subobservador_lat_deg"])
	_sol = _direccion(datos["subsolar_lon_deg"], datos["subsolar_lat_deg"])
	_norte = (Vector3(0, 0, 1) - _observador.z * _observador).normalized()
	_este = _observador.cross(_norte)
	var pa: float = deg_to_rad(float(datos["pa_polo_norte_deg"]) - float(datos["angulo_paralactico_deg"]))
	_sn = Vector2(-sin(pa), cos(pa))
	_sb = Vector2(-cos(pa), -sin(pa))
	_luna = ShaderMaterial.new()
	_luna.shader = load(RAIZ + "luna.gdshader")
	_luna.set_shader_parameter("color_luna", Recursos.textura(RAIZ + "texturas/luna_color_4k.jpg"))
	_luna.set_shader_parameter("normales_luna", Recursos.textura(RAIZ + "texturas/luna_normales.png"))
	_luna.set_shader_parameter("dir_obs", _observador)
	_luna.set_shader_parameter("dir_sol", _sol)
	_luna.set_shader_parameter("pa_norte", pa)
	var texturas: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(RAIZ + "texturas/texturas.json"))
	_luna.set_shader_parameter("lon_centro", deg_to_rad(float(texturas["lon_centro_deg"])))
	_luna.set_shader_parameter("centro", Vector2(0.5, 0.5))
	_luna.set_shader_parameter("aspecto", VISTA.size.x / VISTA.size.y)
	_luna.set_shader_parameter("radio_ocular", 0.48)
	_luna.set_shader_parameter("factor_cenicienta", (1.0 - cos(deg_to_rad(float(datos["angulo_fase_deg"])))) / 1.757)
	_ocular = SubViewport.new()
	_ocular.size = Vector2i(VISTA.size)
	_ocular.disable_3d = true
	_ocular.render_target_update_mode = SubViewport.UPDATE_ALWAYS
	add_child(_ocular)
	var lienzo: ColorRect = ColorRect.new()
	lienzo.size = VISTA.size
	lienzo.material = _luna
	_ocular.add_child(lienzo)
	_borroso = ShaderMaterial.new()
	_borroso.shader = load(RAIZ + "enfoque.gdshader")
	_superficie = TextureRect.new()
	_superficie.position = VISTA.position
	_superficie.size = VISTA.size
	_superficie.texture = _ocular.get_texture()
	_superficie.material = _borroso
	_superficie.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(_superficie)


func _empezar() -> void:
	_mensaje.text = "Busca la creciente baja en el oeste. El buscador amplÃ­a el campo de forma esquemÃ¡tica."
	_refrescar()


func _mover(mando: Vector2, delta: float) -> void:
	match etapa:
		0:
			acimut = clampf(acimut + mando.x * delta * 9.0, 200, 290)
			altura = clampf(altura + mando.y * delta * 9.0, 0, 70)
		1:
			enfoque = clampf(enfoque + mando.x * delta * 0.2, 0, 1)
		2:
			mira += Vector2(mando.x, -mando.y) * delta * 115.0
			mira = CENTRO + (mira - CENTRO).limit_length(193)


func _paso(delta: float) -> void:
	var mando: Vector2 = Vector2(eje_x(), eje_y())
	if _auto != 0:
		mando = _mando_auto(delta)
	_mover(mando, delta)
	_pulso += delta
	if _auto != 0 and _pulso >= 0.65:
		var listo: bool = _centrada() if etapa == 0 else absf(enfoque - FOCO) < margen_foco * 0.5
		if etapa == 2:
			listo = mira.distance_to(_objetivo_auto()) < 3.0
		if _auto < 0:
			listo = altura >= 57.0
		if listo:
			_pulso = 0.0
			_confirmar()
	if activo and tiempo >= LIMITE:
		terminar(false, 0, _causa_tiempo())
	_refrescar()


func _centrada() -> bool:
	return absf(acimut - float(datos["azimut_deg"])) <= margen_busqueda and absf(altura - float(datos["elevacion_deg"])) <= margen_busqueda


func _confirmar() -> void:
	if not activo:
		return
	if etapa == 0:
		if not _centrada():
			_revisar(_causa_busqueda())
			return
		etapa = 1
		_mensaje.text = "Luna centrada. Gira la rueda: compara el borde borroso con el borde nÃ­tido."
	elif etapa == 1:
		if absf(enfoque - FOCO) > margen_foco:
			_revisar("El borde sigue borroso: ajusta la rueda hasta que la nitidez llegue al umbral.")
			return
		etapa = 2
		_mensaje.text = "Imagen nÃ­tida. SeÃ±ala la frontera entre el dÃ­a y la noche lunar."
	else:
		var causa: String = _causa_marca(mira, rasgo)
		if causa != "":
			_revisar(causa)
			return
		marcas.append(mira)
		sonar("ok")
		rasgo += 1
		if rasgo == 3:
			print("TELESCOPIO d%d marcas=3 revisiones=%d tiempo=%.3f" % [dificultad, revisiones, tiempo])
			terminar(true, maxf(40, 100 - revisiones * 10), "Reconociste 3 rasgos: terminador, luz reflejada por la Tierra y Mare Crisium. El Sol ilumina el 12,2 %.")
			return
		_mensaje.text = "Terminador marcado. Ahora busca la parte oscura, iluminada por la Tierra." if rasgo == 1 else "Luz cenicienta marcada. Busca Mare Crisium: la guÃ­a encuadra su entorno."
	_refrescar()


func _revisar(causa: String) -> void:
	revisiones += 1
	_mensaje.text = causa
	sonar("error")
	if revisiones >= max_revisiones:
		terminar(false, 0, causa)
	_refrescar()


func _causa_busqueda() -> String:
	if altura > float(datos["elevacion_deg"]) + margen_busqueda:
		return "Buscas demasiado alto: esta noche la Luna estÃ¡ a 20,0Â° de altura. Baja el telescopio."
	if altura < float(datos["elevacion_deg"]) - margen_busqueda:
		return "Apuntas bajo la Luna: estÃ¡ a 20,0Â° de altura. Sube el telescopio."
	return "El acimut deja la Luna fuera del centro: apunta a 241,4Â°, hacia el oeste."


func _causa_tiempo() -> String:
	if etapa == 0:
		return "Se agotaron los 150 s. " + _causa_busqueda() if not _centrada() else "La Luna estaba centrada: faltÃ³ confirmar para pasar al enfoque."
	if etapa == 1:
		return "Se agotaron los 150 s sin confirmar una imagen nÃ­tida: el desenfoque impide distinguir los rasgos."
	return "Se agotaron los 150 s: faltÃ³ reconocer %s. %s" % [RASGOS[rasgo], _explicacion()]


func _punto_lunar(pantalla: Vector2) -> Vector3:
	# Inversa de la misma proyeccion ortografica que usa luna.gdshader.
	var d: Vector2 = (pantalla - CENTRO) / RADIO
	d.y = -d.y
	var z: float = sqrt(maxf(0, 1.0 - d.length_squared()))
	return (d.dot(_sn) * _norte + d.dot(_sb) * _este + z * _observador).normalized()


func _causa_marca(punto: Vector2, cual: int) -> String:
	var r: float = punto.distance_to(CENTRO) / RADIO
	if r >= 0.97:
		return "La mira estÃ¡ fuera del disco o sobre el borde exterior: busca el rasgo dentro de la Luna."
	var geo: float = _punto_lunar(punto).dot(_sol)
	match cual:
		0:
			if absf(geo) <= margen_terminador:
				return ""
			return "Esa zona recibe Sol." + " El terminador es la frontera interior entre el dÃ­a y la noche." if geo > 0 else "Esa zona estÃ¡ en la noche lunar: lleva la mira a su frontera con la sonrisa brillante."
		1:
			if geo < -0.12 and r < 0.88:
				return ""
			return "Esa zona brillante recibe luz del Sol; la luz cenicienta estÃ¡ en la parte oscura, iluminada por la Tierra." if geo >= -0.12 else "EstÃ¡s junto al borde exterior. Busca la parte oscura dentro del disco."
		2:
			if ((punto - CENTRO) / RADIO).distance_to(CRISIUM) <= margen_crisium:
				return ""
			return "La mira queda lejos de Mare Crisium: busca la mancha de abajo a la derecha, dentro de la guÃ­a."
	return ""


func _explicacion() -> String:
	return ["Frontera entre el dÃ­a y la noche lunar.", "Parte oscura con luz reflejada por la Tierra.", "Mancha identificada en la prueba del ocular."][rasgo]


func _objetivo_auto() -> Vector2:
	if rasgo == 0:
		# En el eje de la luz, el terminador cruza a -cos(fase) radios.
		var solar: Vector2 = Vector2(_sol.dot(_norte), _sol.dot(_este))
		var eje: Vector2 = (_sn * solar.x + _sb * solar.y).normalized()
		eje.y = -eje.y
		return CENTRO + eje * (-cos(deg_to_rad(float(datos["angulo_fase_deg"])))) * RADIO
	if rasgo == 1:
		return CENTRO
	return CENTRO + CRISIUM * RADIO


func _mando_auto(delta: float) -> Vector2:
	# Solo mueve las mismas variables con las mismas velocidades y pulsa confirmar.
	if etapa == 0:
		var destino: Vector2 = Vector2(float(datos["azimut_deg"]), float(datos["elevacion_deg"])) if _auto > 0 else Vector2(acimut, 58)
		return (destino - Vector2(acimut, altura)).clamp(Vector2.ONE * -9 * delta, Vector2.ONE * 9 * delta) / maxf(9 * delta, 0.0001)
	if etapa == 1:
		return Vector2(clampf((FOCO - enfoque) / maxf(delta * 0.2, 0.0001), -1, 1), 0)
	var diferencia: Vector2 = _objetivo_auto() - mira
	diferencia.y = -diferencia.y
	return diferencia.limit_length(115 * delta) / maxf(delta * 115, 0.0001)


func _input(evento: InputEvent) -> void:
	if not activo or _auto != 0:
		return
	if evento.is_action_pressed("interactuar") or evento.is_action_pressed("saltar"):
		_confirmar()
		get_viewport().set_input_as_handled()


func _gui_input(evento: InputEvent) -> void:
	if not activo or _auto != 0:
		return
	if evento is InputEventMouseButton and evento.pressed:
		if etapa == 1 and evento.button_index in [MOUSE_BUTTON_WHEEL_UP, MOUSE_BUTTON_WHEEL_DOWN]:
			enfoque = clampf(enfoque + (0.025 if evento.button_index == MOUSE_BUTTON_WHEEL_UP else -0.025), 0, 1)
		elif evento.button_index == MOUSE_BUTTON_LEFT and evento.position.distance_to(CENTRO) < 195:
			if etapa == 0:
				acimut = clampf(acimut + (evento.position.x - CENTRO.x) / ESCALA_BUSCADOR, 200, 290)
				altura = clampf(altura - (evento.position.y - CENTRO.y) / ESCALA_BUSCADOR, 0, 70)
			elif etapa == 2:
				mira = evento.position
	if evento is InputEventMouseMotion and etapa == 2 and evento.position.distance_to(CENTRO) < 195:
		mira = evento.position
	_refrescar()


func _refrescar() -> void:
	_estado.text = ["1 / 3 Â· BUSCAR", "2 / 3 Â· ENFOCAR", "3 / 3 Â· SEÃ‘ALAR"][etapa]
	_tiempo.text = "%d s Â· Revisiones: %d / %d" % [maxi(0, ceili(LIMITE - tiempo)), revisiones, max_revisiones]
	_dial_az.visible = etapa == 0
	_dial_alt.visible = etapa == 0
	_dial_foco.visible = etapa == 1
	_altura_lectura.visible = etapa == 0
	_dial_az.set_value_no_signal(acimut)
	_dial_alt.set_value_no_signal(altura)
	_dial_foco.set_value_no_signal(enfoque)
	if etapa == 0:
		_lectura.text = ("Acimut: %.1fÂ°" % acimut).replace(".", ",")
		_altura_lectura.text = ("Altura: %.1fÂ°" % altura).replace(".", ",")
		_tarea.text = "Centra la Luna y confirma"
		_ayuda.text = "A D / â† â†’: acimut Â· W S / â†‘ â†“: altura\nRatÃ³n: pulsa la Luna o usa los diales.\nObjetivo: 241,4Â° Â· 20,0Â°"
	elif etapa == 1:
		var nitidez: float = maxf(0, 100 * (1 - absf(enfoque - FOCO)))
		_lectura.text = ("Rueda: %.0f / 100\nNitidez: %.0f %% Â· umbral: %.1f %%" % [enfoque * 100, nitidez, (1 - margen_foco) * 100]).replace(".", ",")
		_tarea.text = "Gira la rueda y confirma"
		_ayuda.text = "A D / â† â†’: girar la rueda\nRatÃ³n: dial; rueda sobre el ocular.\nAlcanza el umbral de nitidez."
	else:
		_lectura.text = "Marcas: %d / 3\nâœ“ = rasgo ya reconocido" % marcas.size()
		_tarea.text = "%d / 3 Â· %s" % [mini(3, rasgo + 1), RASGOS[mini(rasgo, 2)]]
		_ayuda.text = _explicacion() if rasgo < 3 else "Los 3 rasgos estÃ¡n reconocidos."
		_ayuda.text += "\nWASD / flechas o ratÃ³n: mueve la mira."
	var desplazamiento: Vector2 = Vector2((float(datos["azimut_deg"]) - acimut) * ESCALA_BUSCADOR, (altura - float(datos["elevacion_deg"])) * ESCALA_BUSCADOR)
	desplazamiento.y = -desplazamiento.y
	_luna.set_shader_parameter("desplazamiento", desplazamiento / VISTA.size.y if etapa == 0 else Vector2.ZERO)
	_luna.set_shader_parameter("radio", 0.035 if etapa == 0 else RADIO / VISTA.size.y)
	_borroso.set_shader_parameter("desenfoque", 0.0 if etapa == 0 else absf(enfoque - FOCO) * 30)
	if _capa_mira != null:
		_capa_mira.queue_redraw()
	queue_redraw()


func _dibujar_mira() -> void:
	var c: Vector2 = mira if etapa == 2 else CENTRO
	if etapa != 1:
		_capa_mira.draw_arc(c, 11, 0, TAU, 32, Estilo.CIAN, 2, true)
		for eje in [Vector2(1, 0), Vector2(0, 1)]:
			_capa_mira.draw_line(c - eje * 18, c - eje * 5, Estilo.CIAN, 2, true)
			_capa_mira.draw_line(c + eje * 5, c + eje * 18, Estilo.CIAN, 2, true)
	for i in marcas.size():
		_capa_mira.draw_circle(marcas[i], 5, Estilo.CREMA)
		_capa_mira.draw_string(Estilo.fuente(), marcas[i] + Vector2(9, -8), "âœ“ %d" % (i + 1), HORIZONTAL_ALIGNMENT_LEFT, -1, 18, Estilo.CREMA)
	if etapa == 2 and rasgo == 2:
		# Guia amplia de localizacion; el area aceptada es menor y sigue la textura.
		_capa_mira.draw_arc(CENTRO + CRISIUM * RADIO, 38, 0, TAU, 48, Estilo.CREMA, 1.5, true)
	if etapa == 1:
		var rueda: Vector2 = Vector2(930, 258)
		_capa_mira.draw_circle(rueda, 19, Estilo.PAPEL_SOMBRA)
		_capa_mira.draw_arc(rueda, 19, 0, TAU, 32, Estilo.TINTA, 2, true)
		_capa_mira.draw_line(rueda, rueda + Vector2.from_angle(enfoque * TAU) * 16, Estilo.CIAN_MEDIO, 3, true)


func _draw() -> void:
	draw_style_box(Estilo.caja(Estilo.PAPEL_SOMBRA, 12, 2), Rect2(658, 42, 448, 426))
	draw_style_box(Estilo.caja(Estilo.PETROLEO, 12, 2), Rect2(12, 42, 628, 428))


func jugar_solo(acierta: bool) -> void:
	_auto = 1 if acierta else -1
extends "res://nucleo/minijuego.gd"

# El seguidor que tiembla, en version de salon recreativo.
#
# La Luna cruza el cielo y el visor de la camara la persigue con un motor que tiene inercia:
#     v' = EMPUJE * mando - roce * (v - base) + viento          x' = v
# "mando" es la tecla (-1, 0 o 1), "roce" sube con el freno y "base" es 0 o la velocidad del cielo
# (prealimentacion). Quien juega ES el lazo de control: empujar es la ganancia y frenar, la amortiguacion.
# Si empuja de mas, se pasa de la Luna y oscila; si no empuja, el cielo se le escapa.
#
# Mision: tener la Luna dentro del visor hasta llenar la barra REC (60 s de video, comprimidos en 24 s de
# juego). Tres vidas: cada corte de senal (la Luna demasiado tiempo fuera) gasta una. El limite es el amanecer.
#
# Todo se dibuja con _draw() en una rejilla de 280 x 130 pixeles gordos (x4 = 1120 x 520), sin imagenes.
# Coeficientes y umbrales son reglas del juego, no datos de una camara real. El unico dato real es el giro
# aparente del cielo (ficha cielo_15_grados) y las ideas de control de las fichas realimentacion, ganancia,
# amortiguacion y prealimentacion.

