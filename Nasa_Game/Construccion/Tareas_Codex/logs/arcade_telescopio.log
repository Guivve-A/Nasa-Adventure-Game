+	elif etapa == 1:
+		if disparo:
+			if absf(enfoque - 0.5) <= ventana_foco:
+				_cambiar(2)
+				mira = CENTRO
+				puntos += 200
+				sonar("salto")
+			else:
+				_golpe("El borde quedó desenfocado: pulsa cuando la aguja cruce la franja nítida.")
+	elif etapa == 2:
+		velocidad = velocidad.move_toward(mando * 42.0, 500.0 * dt)
