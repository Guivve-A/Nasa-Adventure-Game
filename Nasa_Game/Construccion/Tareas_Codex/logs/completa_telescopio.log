from pathlib import Path
import struct, hashlib
folder=Path('Nasa_Game/Construccion/Minijuegos/telescopio')
for name in ('completa_1.png','completa_2.png','completa_3.png'):
    data=(folder/name).read_bytes()
    assert data[:8]==b'\\x89PNG\\r\\n\\x1a\\n'
    size=struct.unpack('>II',data[16:24])
    assert size==(1280,720),size
    print(name, size, len(data), hashlib.sha256(data).hexdigest()[:16])
for name in ('completa_contrato.log','completa_manos.log'):
    data=(folder/name).read_bytes()
    s=data.decode('utf-16' if data.startswith(b'\\xff\\xfe') else 'utf-8')
    print(name,'PRUEBA_OK=',s.count('PRUEBA_OK'),'PRUEBA_FALLO=',s.count('PRUEBA_FALLO'))
p=folder/'INFORME_COMPLETA.md'
