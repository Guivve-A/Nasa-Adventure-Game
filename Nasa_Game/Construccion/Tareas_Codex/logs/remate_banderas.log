var necesarios: int = 4
var ventana: float = 0.15
var margen: float = 5.0
var golpes: Array[int] = [0, 0]
var compas: Array[float] = [0.0, 0.31]
var marca: Array[float] = [0.0, 0.62]
var enfriar: float = 0.0
