# ---------------------------------------------------------------- estado de la partida (lo que se ve)
var fase: int = 0
var cartel: float = 0.0           # segundos que quedan del cartel de mision (el juego espera)
var reloj: float = 99.0           # cuenta atras
var limite: float = 99.0
var vidas: int = 3
