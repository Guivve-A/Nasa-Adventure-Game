extends Node

# Cobertura adicional: dos modos, cortes, regla de un cambio y paso fijo.
const Seguidor = preload("res://minijuegos/seguidor/seguidor.gd")

func correr(p: Node) -> void:
	for modo in ["normal", "prealimentacion"]:
		for d in [1, 2, 3]:
			for acierta in [true, false]:
				var m: Control = _nuevo(modo, d)
				var resultado: Dictionary = {}
				m.terminado.connect(func(r: Dictionary): resultado.merge(r))
				m.jugar_solo(acierta)
				for cuadro in 4000:
					if not m.activo:
						break
					m.tiempo += 0.01
					m._paso(0.01)
				p.comprobar(not m.activo and m.tiempo < 40 and resultado.get("superado") == acierta, "seguidor.%s.d%d.auto_%s" % [modo, d, acierta], str(resultado))
				m.free()
	var regla: Control = _nuevo("normal", 1)
	regla.diales[0].value = 8
	regla.diales[1].value = 5
	regla._probar()
	p.comprobar(regla.pruebas == 0 and not regla.probando, "seguidor.bloquea_dos_cambios")
	regla._conservar(1)
	regla._probar()
	p.comprobar(regla.pruebas == 1 and regla.usados[0] == 16 and regla.usados[1] == 5, "seguidor.conserva_un_cambio")
	regla.free()
	var finales: Array[float] = []
	for delta in [1.0 / 30.0, 1.0 / 144.0, 0.19]:
		var m: Control = _nuevo("prealimentacion", 3)
		m.diales[2].value = 15
		m._probar()
		while m.probando:
			m._paso(delta)
		finales.append(m.posicion)
		m.free()
	p.comprobar(absf(finales[0] - finales[1]) < 0.000001 and absf(finales[0] - finales[2]) < 0.000001, "seguidor.paso_fijo_independiente_del_cuadro", str(finales))
	# El error de rampa sin anticipacion no desaparece por esperar mas.
	var sin_ff: Control = _nuevo("prealimentacion", 1)
	sin_ff._probar()
	while sin_ff.probando:
		sin_ff._paso(0.02)
	p.comprobar(sin_ff.error_final > 0.12 and sin_ff.error_final < 0.16, "seguidor.rampa_atraso_constante", str(sin_ff.error_final))
	sin_ff.free()
	p.comprobar(Juego.estado.get("cuaderno", []).has("prealimentacion"), "seguidor.anota_prealimentacion")
	var teclado: Control = _nuevo("normal", 1)
	Input.action_press("mover_derecha")
	for i in 60:
		teclado._paso(1.0 / 60.0)
	Input.action_release("mover_derecha")
	p.comprobar(teclado.valores[0] >= 20.5, "seguidor.teclado_acumula_pasos_del_dial", str(teclado.valores))
	teclado.free()
	if Juego.args.has("captura_seguidor"):
		await _captura(String(Juego.args["captura_seguidor"]))


func _nuevo(modo: String, d: int) -> Control:
	var m: Control = Seguidor.new()
	add_child(m)
	m.preparar({"modo": modo, "dificultad": d}, Juego.info_minijuego("seguidor"))
	m.set_process(false)
	m.empezar()
	return m


func _captura(ruta: String) -> void:
	var capa: CanvasLayer = CanvasLayer.new()
	add_child(capa)
	var fondo: ColorRect = ColorRect.new()
	fondo.color = Color("f6e7c8")
	fondo.size = Vector2(1280, 720)
	capa.add_child(fondo)
	var m: Control = _nuevo("prealimentacion", 3)
	m.reparent(capa)
	m.position = Vector2(80, 100)
	m._probar()
	while m.probando:
		m._paso(0.02)
	m.diales[2].value = 15
	m._probar()
	for i in 160:
		m._paso(0.02)
	await get_tree().process_frame
	await RenderingServer.frame_post_draw
	var imagen: Image = get_viewport().get_texture().get_image()
	var error: Error = imagen.save_png(ruta)
	print("CAPTURA_SEGUIDOR ", ruta, " error=", error)
	capa.queue_free()
extends "res://nucleo/minijuego.gd"

# Motor didactico normalizado: inercia 1, rozamiento viscoso 0.6.
# x'' = K(r-x) - (D+0.6)x' + (D+0.6)v_conocida.
# Derivada de la medida: evita un impulso al cambiar la referencia.
const H: float = 1.0 / 240.0
const DURACION: float = 5.0
const ROCE: float = 0.6
const BANDA: float = 0.04
const SOBRE: float = 0.05
const ERROR_FINAL: float = 0.015
const GIRO: float = 15.0
const RELOJ: float = 720.0

var rampa: bool = false
var valores: Array[float] = [16.0, 1.0, 0.0]
var base: Array[float] = []
var usados: Array[float] = []
var diales: Array[HSlider] = []
var nombres: Array[Label] = []
var seleccion: int = 0
var pruebas: int = 0
var max_pruebas: int = 5
var probando: bool = false
var acumulado: float = 0.0
var reloj: float = 0.0
var posicion: float = 0.0
var velocidad: float = 0.0
var sobrepaso: float = 0.0
var ultimo_fuera: float = 0.0
var error_final: float = 0.0
var asentamiento: float = 0.0
var trazo: Array[Vector3] = []
var anterior: Array[Vector3] = []
var medidas: String = "Sin medir"
var medidas_antes: String = "Sin prueba anterior"
var estado: Label
var contador: Label
var lectura: Label
var lectura_antes: Label
var boton: Button
var elegir: Array[Button] = []
var _auto: int = 0
var _pausa_auto: float = 0.0
var _ajuste_resto: float = 0.0


func _preparar() -> void:
	rampa = parametros.get("modo", "") == "prealimentacion"
	max_pruebas = 7 - dificultad
	if rampa:
		valores = [8.0, 5.0, 0.0]
	elif dificultad > 1:
		valores = [4.0 if dificultad == 2 else 2.0, 1.0, 0.0]
	base = valores.duplicate()
	contador = _label("", Vector2(20, 8), 1080, 20)
	_label("ACTUAL Â· respuesta continua", Vector2(356, 48), 350)
	_label("ANTERIOR Â· respuesta discontinua", Vector2(738, 48), 360)
	for i in (3 if rampa else 2):
		var y: float = 66.0 + i * 76.0
		nombres.append(_label("", Vector2(20, y), 320, 18))
		var dial: HSlider = HSlider.new()
		dial.position = Vector2(24, y + 29)
		dial.size = Vector2(300, 28)
		dial.min_value = 1.0 if i == 0 else 0.0
		dial.max_value = 25.0 if i == 0 else (14.0 if i == 1 else GIRO)
		dial.step = 0.5
		dial.value = valores[i]
		dial.focus_mode = Control.FOCUS_NONE
		var id_ficha: String = ["ganancia", "amortiguacion", "prealimentacion"][i]
		dial.tooltip_text = String(Juego.ficha(id_ficha).get("texto", ""))
		dial.value_changed.connect(func(v: float): _cambiar(i, v))
		add_child(dial)
		diales.append(dial)
		var rotulo: String = ["Solo ganancia", "Solo amortiguaciÃ³n", "Solo cielo conocido"][i]
		var conservar: Button = Estilo.boton(rotulo, 16)
		conservar.position = Vector2(356 + i * 246, 426)
		conservar.size = Vector2(238, 38)
		conservar.focus_mode = Control.FOCUS_NONE
		conservar.pressed.connect(func(): _conservar(i))
		add_child(conservar)
		elegir.append(conservar)
	boton = Estilo.boton("Probar Â· E / Intro", 20, true)
	boton.position = Vector2(20, 306)
	boton.size = Vector2(308, 44)
	boton.focus_mode = Control.FOCUS_NONE
	boton.pressed.connect(_probar)
	add_child(boton)
	_label("â†‘ â†“ elegir Â· â† â†’ ajustar\nEspacio: conservar solo el elegido", Vector2(20, 360), 310)
	_label("Modelo didÃ¡ctico: inercia y roce.\nCrema: luz Â· cian: motor.\nEn rampa, 1 = 15Â°.", Vector2(20, 414), 310)
	lectura = _label("", Vector2(356, 365), 360)
	lectura_antes = _label("", Vector2(738, 365), 360)
	estado = _label("Cambia 1 parÃ¡metro y compara las curvas.", Vector2(20, 473), 1080, 18)
