diff --git a/juego/minijuegos/seguidor/prueba_manos.gd b/juego/minijuegos/seguidor/prueba_manos.gd
new file mode 100644
index 0000000000000000000000000000000000000000..90730f35d2a9b9ebd814441742d38bd4a20e1450
--- /dev/null
+++ b/juego/minijuegos/seguidor/prueba_manos.gd
@@ -0,0 +1,337 @@
+extends Node
+
+# Solo lee el estado visible; todas las jugadas entran por eventos fisicos.
+var p: Node
+var final: Dictionary = {}
+var devuelto: bool = false
+
+
+func correr(pruebas: Node) -> void:
+	p = pruebas
+	process_mode = Node.PROCESS_MODE_ALWAYS
+	Juego.modo_prueba = false
+	Juego.sin_guardar = true
+	Juego.minijuegos_solos = false
+	await _teclado()
+	await _raton()
+	await _rampa(false)
+	await _rampa(true)
+	for fase in ["instrucciones", "ajuste", "medicion"]:
+		await _escape(fase)
+		await _salir_raton(fase)
+	p.comprobar(not Interfaz.anfitrion.visible, "seguidor.manos.anfitrion_cerrado", str(final))
+	p.comprobar(not get_tree().paused, "seguidor.manos.arbol_sin_pausa", str(get_tree().paused))
+	Juego.modo_prueba = true
+
+
+func _lanzar(parametros: Dictionary) -> void:
+	final = await Interfaz.abrir_minijuego("seguidor", parametros)
+	devuelto = true
+
+
+func _abrir(parametros: Dictionary, raton: bool = false, empezar: bool = true) -> Control:
+	devuelto = false
+	final = {}
+	_lanzar(parametros)
+	var limite: int = Time.get_ticks_msec() + 3000
+	while not Interfaz.anfitrion.visible and Time.get_ticks_msec() < limite:
+		await get_tree().process_frame
+	await _real(0.12)
+	var m: Control = Interfaz.anfitrion.get("_minijuego")
+	p.comprobar(m != null and Interfaz.anfitrion.visible, "seguidor.manos.abre_por_interfaz", str(parametros))
+	if m == null:
+		return null
+	p.comprobar(int(m.get("_solo")) == 0 and int(m.get("_auto")) == 0, "seguidor.manos.sin_piloto", str(parametros))
+	if Juego.args.has("captura_manos") and not raton:
+		await _captura("instrucciones", m)
+	if empezar:
+		if raton:
+			await _clic(_boton_capa("Empezar"))
+		else:
+			await _toque(KEY_ENTER)
+		p.comprobar(bool(m.get("activo")), "seguidor.manos.empezar_" + ("raton" if raton else "intro"), str(parametros))
+		await _lienzo(m)
+	return m
+
+
+func _teclado() -> void:
+	var m: Control = await _abrir({"dificultad": 1})
+	if m == null:
+		return
+	for par in [[KEY_S, 1], [KEY_W, 0], [KEY_DOWN, 1], [KEY_UP, 0]]:
+		await _toque(int(par[0]))
+		p.comprobar(int(m.get("seleccion")) == int(par[1]), "seguidor.teclado.elegir_%s" % str(par[0]), str(m.get("seleccion")))
+	for codigo in [KEY_D, KEY_A, KEY_RIGHT, KEY_LEFT]:
+		var antes: float = m.get("valores")[0]
+		_tecla(codigo, true)
+		await _real(0.22)
+		_tecla(codigo, false)
+		await _real(0.04)
+		var despues: float = m.get("valores")[0]
+		p.comprobar(despues > antes if codigo in [KEY_D, KEY_RIGHT] else despues < antes, "seguidor.teclado.ajustar_%s" % str(codigo), "%s -> %s" % [antes, despues])
+	await _ajustar(m, 0, 17.0)
+	await _toque(KEY_S)
+	await _ajustar(m, 1, 2.0)
+	await _toque(KEY_E)
+	p.comprobar(not bool(m.get("probando")) and int(m.get("pruebas")) == 0, "seguidor.teclado.bloquea_varios_cambios", str(m.get("estado").text))
+	await _toque(KEY_SPACE)
+	p.comprobar(_valores(m, [16.0, 2.0, 0.0]), "seguidor.teclado.espacio_conserva_amortiguacion", str(m.get("valores")))
+	await _toque(KEY_W)
+	await _ajustar(m, 0, 17.0)
+	await _toque(KEY_SPACE)
+	p.comprobar(_valores(m, [17.0, 1.0, 0.0]), "seguidor.teclado.espacio_conserva_ganancia", str(m.get("valores")))
+	await _ajustar(m, 0, 16.0)
+	await _toque(KEY_E)
+	p.comprobar(bool(m.get("probando")), "seguidor.teclado.E_prueba", str(m.get("pruebas")))
+	await _medicion(m)
+	p.comprobar(bool(m.get("activo")) and float(m.get("sobrepaso")) > 0.05, "seguidor.teclado.observa_oscilacion", str(m.get("medidas")))
+	await _toque(KEY_DOWN)
+	# La instruccion propone la mitad del dial: no consulta la solucion del piloto.
+	var dial: HSlider = m.get("diales")[1]
+	await _ajustar(m, 1, (dial.min_value + dial.max_value) * 0.5)
+	await _toque(KEY_ENTER)
+	p.comprobar(bool(m.get("probando")), "seguidor.teclado.intro_prueba", str(m.get("pruebas")))
+	await _captura("teclado", m)
+	await _medicion(m)
+	p.comprobar(not bool(m.get("activo")) and int(m.get("pruebas")) == 2, "seguidor.teclado.gana_segunda_medicion", str(m.get("pruebas")))
+	p.comprobar(not m.get("anterior").is_empty(), "seguidor.teclado.compara_anterior", str(m.get("medidas_antes")))
+	await _cerrar_ganado("teclado", false)
+
+
+func _raton() -> void:
+	var m: Control = await _abrir({"dificultad": 1}, true)
+	if m == null:
+		return
+	await _arrastrar(m, 0, 18.0)
+	await _arrastrar(m, 1, 3.0)
+	await _clic(m.get("boton"))
+	p.comprobar(not bool(m.get("probando")) and int(m.get("pruebas")) == 0, "seguidor.raton.bloquea_varios_cambios", str(m.get("estado").text))
+	await _clic(m.get("elegir")[0])
+	p.comprobar(_valores(m, [18.0, 1.0, 0.0]) and int(m.get("seleccion")) == 0, "seguidor.raton.solo_ganancia", str(m.get("valores")))
+	await _arrastrar(m, 1, 3.0)
+	await _clic(m.get("elegir")[1])
+	p.comprobar(_valores(m, [16.0, 3.0, 0.0]) and int(m.get("seleccion")) == 1, "seguidor.raton.solo_amortiguacion", str(m.get("valores")))
+	await _arrastrar(m, 1, 1.0)
+	await _clic(m.get("boton"))
+	p.comprobar(bool(m.get("probando")), "seguidor.raton.probar", str(m.get("pruebas")))
+	await _medicion(m)
+	p.comprobar(bool(m.get("activo")) and float(m.get("sobrepaso")) > 0.05, "seguidor.raton.observa_oscilacion", str(m.get("medidas")))
+	var dial: HSlider = m.get("diales")[1]
+	await _arrastrar(m, 1, (dial.min_value + dial.max_value) * 0.5)
+	await _clic(m.get("boton"))
+	await _captura("raton", m)
+	await _medicion(m)
+	p.comprobar(not bool(m.get("activo")) and int(m.get("pruebas")) == 2, "seguidor.raton.gana_segunda_medicion", str(m.get("pruebas")))
+	p.comprobar(not m.get("anterior").is_empty(), "seguidor.raton.compara_anterior", str(m.get("medidas_antes")))
+	await _cerrar_ganado("raton", true)
+
+
+func _rampa(raton: bool) -> void:
+	var nombre: String = "rampa_" + ("raton" if raton else "teclado")
+	var m: Control = await _abrir({"dificultad": 1, "modo": "prealimentacion"}, raton)
+	if m == null:
+		return
+	if raton:
+		await _arrastrar(m, 0, 9.0)
+		await _arrastrar(m, 1, 6.0)
+		await _arrastrar(m, 2, 5.0)
+		await _clic(m.get("elegir")[2])
+	else:
+		await _ajustar(m, 0, 9.0)
+		await _toque(KEY_S)
+		await _ajustar(m, 1, 6.0)
+		await _toque(KEY_S)
+		await _ajustar(m, 2, 5.0)
+		await _toque(KEY_SPACE)
+	p.comprobar(_valores(m, [8.0, 5.0, 5.0]) and int(m.get("seleccion")) == 2, "seguidor." + nombre + ".solo_cielo", str(m.get("valores")))
+	# Los 15 grados/h aparecen en las instrucciones y en el dial del cielo.
+	if raton:
+		await _arrastrar(m, 2, 15.0)
+		await _clic(m.get("boton"))
+	else:
+		await _ajustar(m, 2, 15.0)
+		await _toque(KEY_E)
+	await _medicion(m)
+	p.comprobar(not bool(m.get("activo")) and int(m.get("pruebas")) == 1, "seguidor." + nombre + ".gana_primera_medicion", str(m.get("pruebas")))
+	await _cerrar_ganado(nombre, raton, not raton)
+
+
+func _cerrar_ganado(nombre: String, raton: bool, escape_resultado: bool = false) -> void:
+	await _real(0.12)
+	var resultado: Dictionary = Interfaz.anfitrion.get("_resultado")
+	p.comprobar(bool(resultado.get("superado", false)), "seguidor." + nombre + ".superado", str(resultado))
+	if escape_resultado:
+		await _toque(KEY_ESCAPE)
+	elif raton:
+		await _clic(_boton_capa("Continuar"))
+	else:
+		await _toque(KEY_ENTER)
+	await _real(0.12)
+	p.comprobar(devuelto and not Interfaz.anfitrion.visible and bool(final.get("superado", false)), "seguidor." + nombre + ".cierra_" + ("esc_resultado" if escape_resultado else "continuar"), str(final))
+	p.comprobar(not get_tree().paused, "seguidor." + nombre + ".sin_pausa", str(get_tree().paused))
+	if Interfaz.anfitrion.visible:
+		await _toque(KEY_ESCAPE)
+
+
+func _escape(fase: String) -> void:
+	var m: Control = await _abrir({"dificultad": 1}, false, fase != "instrucciones")
+	if m == null:
+		return
+	if fase == "medicion":
+		await _toque(KEY_E)
+		p.comprobar(bool(m.get("probando")), "seguidor.esc.durante_medicion", str(m.get("reloj")))
+	await _toque(KEY_ESCAPE)
+	await _real(0.12)
+	p.comprobar(devuelto and not Interfaz.anfitrion.visible and bool(final.get("abandonado", false)), "seguidor.esc." + fase, str(final))
+	p.comprobar(not get_tree().paused, "seguidor.esc." + fase + ".sin_pausa", str(get_tree().paused))
+
+
+func _salir_raton(fase: String) -> void:
+	var m: Control = await _abrir({"dificultad": 1}, true, fase != "instrucciones")
+	if m == null:
+		return
+	if fase == "medicion":
+		await _clic(m.get("boton"))
+	var salir: Button = _boton_capa("Salir") if fase == "instrucciones" else Interfaz.anfitrion.get("_salir")
+	await _clic(salir)
+	await _real(0.12)
+	p.comprobar(devuelto and not Interfaz.anfitrion.visible and bool(final.get("abandonado", false)), "seguidor.raton.salir_" + fase, str(final))
+	p.comprobar(not get_tree().paused, "seguidor.raton.salir_" + fase + ".sin_pausa", str(get_tree().paused))
+	if Interfaz.anfitrion.visible:
+		await _toque(KEY_ESCAPE)
+
+
+func _valores(m: Control, esperados: Array) -> bool:
+	var valores: Array = m.get("valores")
+	for i in esperados.size():
+		if absf(float(valores[i]) - float(esperados[i])) > 0.01:
+			return false
+	return true
+
+
+func _ajustar(m: Control, indice: int, destino: float) -> void:
+	var actual: float = m.get("valores")[indice]
+	var codigo: int = KEY_D if destino > actual else KEY_A
+	var limite: int = Time.get_ticks_msec() + 6000
+	_tecla(codigo, true)
+	while Time.get_ticks_msec() < limite:
+		actual = m.get("valores")[indice]
+		if (codigo == KEY_D and actual >= destino) or (codigo == KEY_A and actual <= destino):
+			break
+		await get_tree().process_frame
+	_tecla(codigo, false)
+	await _real(0.04)
+	p.comprobar(is_equal_approx(float(m.get("valores")[indice]), destino), "seguidor.teclado.dial_%d" % indice, str(m.get("valores")))
+
+
+func _medicion(m: Control) -> void:
+	var limite: int = Time.get_ticks_msec() + 8000
+	while is_instance_valid(m) and bool(m.get("probando")) and Time.get_ticks_msec() < limite:
+		await get_tree().process_frame
+	p.comprobar(is_instance_valid(m) and not bool(m.get("probando")), "seguidor.manos.medicion_termina", "limite 8 s reales")
+	await _real(0.12)
+
+
+func _tecla(codigo: int, abajo: bool) -> void:
+	var evento: InputEventKey = InputEventKey.new()
+	evento.physical_keycode = codigo
+	evento.keycode = codigo
+	evento.pressed = abajo
+	Input.parse_input_event(evento)
+
+
+func _toque(codigo: int) -> void:
+	_tecla(codigo, true)
+	await get_tree().process_frame
+	await get_tree().physics_frame
+	await get_tree().process_frame
+	_tecla(codigo, false)
+	await _real(0.04)
+
+
+func _real(segundos: float) -> void:
+	await get_tree().create_timer(segundos, true, false, true).timeout
+
+
+func _boton_capa(rotulo: String) -> Button:
+	var columna: Control = Interfaz.anfitrion.get("_capa_columna")
+	for control in columna.find_children("*", "Button", true, false):
+		if control.text == rotulo:
+			return control as Button
+	return null
+
+
+func _mover(posicion: Vector2, anterior: Vector2, pulsado: bool) -> void:
+	var evento: InputEventMouseMotion = InputEventMouseMotion.new()
+	# parse_input_event recibe coordenadas de ventana, tambien con --headless.
+	var transformacion: Transform2D = get_viewport().get_final_transform()
+	evento.position = transformacion * posicion
+	evento.global_position = evento.position
+	evento.relative = transformacion * posicion - transformacion * anterior
+	evento.button_mask = MOUSE_BUTTON_MASK_LEFT if pulsado else 0
+	Input.parse_input_event(evento)
+
+
+func _raton_boton(posicion: Vector2, pulsado: bool) -> void:
+	var evento: InputEventMouseButton = InputEventMouseButton.new()
+	evento.position = get_viewport().get_final_transform() * posicion
+	evento.global_position = evento.position
+	evento.button_index = MOUSE_BUTTON_LEFT
+	evento.button_mask = MOUSE_BUTTON_MASK_LEFT if pulsado else 0
+	evento.pressed = pulsado
+	Input.parse_input_event(evento)
+
+
+func _clic(control: Control) -> void:
+	if not p.comprobar(control != null and control.is_visible_in_tree(), "seguidor.raton.boton_disponible", str(control)):
+		return
+	var centro: Vector2 = control.get_global_rect().get_center()
+	_mover(centro, centro, false)
+	await _real(0.04)
+	_raton_boton(centro, true)
+	await _real(0.04)
+	_raton_boton(centro, false)
+	await _real(0.08)
+
+
+func _arrastrar(m: Control, indice: int, destino: float) -> void:
+	var dial: HSlider = m.get("diales")[indice]
+	var rect: Rect2 = dial.get_global_rect()
+	var asa: float = dial.get_theme_icon("grabber").get_width()
+	var inicio: Vector2 = rect.position + Vector2(asa * 0.5 + dial.ratio * (rect.size.x - asa), rect.size.y * 0.5)
+	var ratio: float = (destino - dial.min_value) / (dial.max_value - dial.min_value)
+	var fin: Vector2 = rect.position + Vector2(asa * 0.5 + ratio * (rect.size.x - asa), rect.size.y * 0.5)
+	_mover(inicio, inicio, false)
+	await _real(0.04)
+	_raton_boton(inicio, true)
+	await _real(0.04)
+	var anterior: Vector2 = inicio
+	for paso in range(1, 7):
+		var punto: Vector2 = inicio.lerp(fin, float(paso) / 6.0)
+		_mover(punto, anterior, true)
+		anterior = punto
+		await get_tree().process_frame
+	_raton_boton(fin, false)
+	await _real(0.08)
+	p.comprobar(is_equal_approx(dial.value, destino) and int(m.get("seleccion")) == indice, "seguidor.raton.arrastra_dial_%d" % indice, "destino=%s valor=%s seleccion=%s" % [destino, dial.value, m.get("seleccion")])
+
+
+func _lienzo(m: Control) -> void:
+	await get_tree().process_frame
+	var fuera: Array[String] = []
+	var lienzo: Rect2 = m.get_global_rect().grow(0.5)
+	for hijo in m.get_children():
+		if hijo is Control and hijo.is_visible_in_tree() and not lienzo.encloses(hijo.get_global_rect()):
+			fuera.append("%s %s" % [hijo.name, hijo.get_global_rect()])
+	p.comprobar(fuera.is_empty(), "seguidor.manos.controles_en_1120x520", str(fuera))
+
+
+func _captura(nombre: String, m: Control) -> void:
+	await _real(0.5)
+	await _lienzo(m)
+	if not Juego.args.has("captura_manos"):
+		return
+	await RenderingServer.frame_post_draw
+	var ruta: String = String(Juego.args["captura_manos"]) + "_" + nombre + ".png"
+	var error: Error = get_viewport().get_texture().get_image().save_png(ruta)
+	p.comprobar(error == OK, "seguidor.captura." + nombre, ruta)
