from pathlib import Path
import json
p=Path('juego/minijuegos/seguidor/minijuego.json')
d=json.loads(p.read_text(encoding='utf-8'))
d['instrucciones'][0]='Elige con W/S o ↑/↓ y ajusta con A/D o ←/→; también puedes arrastrar cada dial. Cambia solo 1 parámetro por prueba.'
d['instrucciones'][1]='Pulsa E, Intro o Probar y observa 5 s. Si la curva cruza y vuelve, sube amortiguación hacia la mitad del dial y compara con la anterior discontinua.'
d['instrucciones'][2]='Busca la franja ±4 % antes del límite, sobrepaso máximo 5 % y error final ≤1,5 %. Si cambiaste varios diales, Espacio o Solo… conserva el elegido.'
d['instrucciones'][3]='En rampa, anticipa unos 15°/h del cielo (reloj ×720). Esc o Salir permite abandonar en cualquier momento.'
d['controles']='W/S o ↑/↓: elegir. A/D o ←/→: ajustar. E/Intro: Probar. Espacio: conservar elegido. Ratón: arrastrar diales; Probar y Solo… . Esc/Salir: salir.'
p.write_text(json.dumps(d,ensure_ascii=False,indent=2)+'\\n',encoding='utf-8')
p=Path('juego/minijuegos/seguidor/seguidor.gd')
s=p.read_text(encoding='utf-8').replace('_label(\"↑ ↓ elegir · ← → ajustar\\\\nEspacio: conservar solo el elegido\",', '_label(\"W/S · ↑/↓ elegir; A/D · ←/→ ajustar\\\\nEspacio: conservar solo el elegido\",')
s=s.replace('estado = _label(\"Cambia 1 parámetro y compara las curvas.\", Vector2(20, 473), 1080, 18)', 'estado = _label(\"Prueba y observa: si oscila, sube amortiguación hacia la mitad del dial.\", Vector2(20, 472), 1080, 16)')
s=s.replace('func _conservar(indice: int) -> void:\\n\\tif not activo or probando:\\n\\t\\treturn\\n', 'func _conservar(indice: int) -> void:\\n\\tif not activo or probando:\\n\\t\\treturn\\n\\tseleccion = indice\\n')
p.write_text(s,encoding='utf-8')
