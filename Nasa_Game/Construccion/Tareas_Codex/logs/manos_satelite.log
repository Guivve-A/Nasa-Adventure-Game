 var _nota: Label
 var _accion: Button
 var _ajustes: Array[Button] = []
+var _piezas_controles: Array[Control] = []
+var _huecos_controles: Array[Control] = []
 
 
 func _preparar() -> void:
+	# Regiones reales de entrada: conservan el dibujo y propagan al lienzo.
+	for i in 4:
+		_piezas_controles.append(_region(_rect_pieza(i), "Pieza%d" % i, PIEZAS[i]))
+		_huecos_controles.append(_region(_rect_hueco(i), "Hueco%d" % i, FUNCIONES[i]))
 	_cabecera = _etiqueta("", Vector2(24, 10), 1072, 22)
 	_etiqueta("Pegaso: primer satélite ecuatoriano · Cubo de 10 cm · 2 paneles de 27 cm", Vector2(24, 45), 1072, 18)
 	_nota = _etiqueta("", Vector2(650, 86), 418, 20)
@@ -60,6 +66,17 @@
 	_refrescar()
 
 
+func _region(rectangulo: Rect2, nombre: String, ayuda: String) -> Control:
+	var region: Control = Control.new()
+	region.name = nombre
+	region.position = rectangulo.position
+	region.size = rectangulo.size
+	region.mouse_filter = Control.MOUSE_FILTER_PASS
+	region.tooltip_text = ayuda
+	add_child(region)
+	return region
+
+
 func _etiqueta(contenido: String, pos: Vector2, ancho: float, tam: int) -> Label:
 	var l: Label = texto(contenido, tam, Estilo.TINTA)
 	l.position = pos
@@ -260,6 +277,8 @@
 func _input(evento: InputEvent) -> void:
 	if not activo or _auto != 0 or fase >= 2:
 		return
+	if evento is InputEventKey and evento.echo:
+		return
 	if evento.is_action_pressed("saltar"):
 		_confirmar()
 	elif evento.is_action_pressed("interactuar"):
@@ -317,6 +336,8 @@
 func _refrescar() -> void:
 	if _cabecera == null:
 		return
+	for region in _piezas_controles + _huecos_controles:
+		region.visible = fase == 0
 	_cabecera.text = "%s · Nivel %d · %.0f s disponibles" % ["1 / 2 · Montaje" if fase == 0 else "2 / 2 · Balance de energía", dificultad, maxf(0.0, LIMITE_S - tiempo)]
 	for i in 5:
 		_ajustes[i].visible = fase != 0
@@ -324,7 +345,7 @@
 		_ajustes[i].add_theme_stylebox_override("normal", Estilo.caja(Estilo.CREMA if seleccion == i else Estilo.PAPEL, 8, 3 if seleccion == i else 1))
 	_nota.visible = fase == 0
 	if fase == 0:
-		_nota.text = "KIT DEL CLUB\n\n4 subsistemas, 4 funciones.\n\nMontaje didáctico, no un plano real de Pegaso.\n\nE: tomar / colocar\nFlechas: elegir"
+		_nota.text = "KIT DEL CLUB\n\n4 subsistemas, 4 funciones.\n\nMontaje didáctico, no un plano real de Pegaso.\n\nE / Intro: tomar / colocar\nFlechas / WASD: elegir\nRatón: arrastra o haz clic en pieza y hueco."
 		_lectura.text = _mensaje
 		_estado.text = "Maqueta didáctica · Sin escala\n\nComprueba el montaje para pasar al balance."
 		_accion.text = "Comprobar · Espacio"
