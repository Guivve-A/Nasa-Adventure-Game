extends Control

# Anfitrion de minijuegos: pone el marco comun (titulo, instrucciones, controles, pistas de Orbita y resultado)
# alrededor de cualquier minijuego de res://minijuegos/<id>/. Asi todos se presentan igual.
#
# minijuego.json:
#   {"titulo": "...", "resumen": "una frase", "instrucciones": ["paso 1", "paso 2"], "controles": "texto",
#    "pistas": ["mirada", "frase", "respuesta"], "ficha": "id_de_ficha", "orden": 1, "escena": "1.2"}

signal _boton(accion: String)

const Estilo := preload("res://interfaz/estilo.gd")
const LIENZO := Vector2(1120, 520)

var _marco: PanelContainer
var _titulo: Label
var _controles: Label
var _hueco: Control
var _capa: PanelContainer
var _capa_columna: VBoxContainer
var _salir: Button
var _minijuego: Control = null
var _resultado: Dictionary = {}
var _pendiente := false
var _pista := 0


func _ready() -> void:
	set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	visible = false
	var velo := ColorRect.new()
	velo.color = Color(Estilo.NOCHE, 0.93)
	velo.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	add_child(velo)

	_marco = Estilo.panel(Estilo.PAPEL, 16, 4, 16)
	add_child(_marco)
	var columna := VBoxContainer.new()
	columna.add_theme_constant_override("separation", 8)
	_marco.add_child(columna)
	var cabecera := HBoxContainer.new()
	_titulo = Estilo.texto("", 28, Estilo.TINTA, 700)
	_titulo.autowrap_mode = TextServer.AUTOWRAP_OFF
	_titulo.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	cabecera.add_child(_titulo)
	_salir = Estilo.boton("Salir (Esc)", 16)
	_salir.custom_minimum_size = Vector2(130, 36)
	_salir.focus_mode = Control.FOCUS_NONE
	_salir.pressed.connect(_abandonar)
	cabecera.add_child(_salir)
	columna.add_child(cabecera)
	var fondo_lienzo := Estilo.panel(Color("fbf3df"), 8, 2, 0)
	_hueco = Control.new()
	_hueco.custom_minimum_size = LIENZO
	_hueco.clip_contents = true
	fondo_lienzo.add_child(_hueco)
	columna.add_child(fondo_lienzo)
	_controles = Estilo.texto("", 16, Estilo.TINTA_SUAVE, 500)
	_controles.custom_minimum_size = Vector2(LIENZO.x, 0)
	columna.add_child(_controles)

	_capa = Estilo.panel(Color(Estilo.PAPEL, 0.98), 16, 4, 26)
	_capa.custom_minimum_size = Vector2(720, 0)
	_capa_columna = VBoxContainer.new()
	_capa_columna.add_theme_constant_override("separation", 12)
	_capa.add_child(_capa_columna)
	_capa.visible = false
	add_child(_capa)


func _process(_delta: float) -> void:
	if not visible:
		return
	_capa.reset_size()
	_marco.position = (size - _marco.size) * 0.5
	_capa.position = (size - _capa.size) * 0.5


func _unhandled_input(evento: InputEvent) -> void:
	if visible and _minijuego != null and evento.is_action_pressed("pausa"):
		get_viewport().set_input_as_handled()
		_abandonar()


func _abandonar() -> void:
	if _minijuego != null and _minijuego.get("activo"):
		_minijuego.set("activo", false)
		_resultado = {"superado": false, "abandonado": true, "puntos": 0.0, "detalle": ""}
		_pendiente = false
	elif _capa.visible:
		_boton.emit("salir")


func _al_terminar(resultado: Dictionary) -> void:
	_resultado = resultado
	_pendiente = false


func _llenar_capa(titulo: String, color: Color, lineas: Array, botones: Array) -> void:
	for hijo in _capa_columna.get_children():
		_capa_columna.remove_child(hijo)
		hijo.queue_free()
	_capa_columna.add_child(Estilo.texto(titulo, 30, color, 700))
	for l in lineas:
		if l is Control:
			_capa_columna.add_child(l)
		elif str(l) != "":
			var etiqueta := Estilo.texto(str(l), 20, Estilo.TINTA, 500)
			etiqueta.custom_minimum_size = Vector2(660, 0)
			_capa_columna.add_child(etiqueta)
	var fila := HBoxContainer.new()
	fila.add_theme_constant_override("separation", 12)
	fila.alignment = BoxContainer.ALIGNMENT_END
	var primero: Button = null
	for par in botones:
		var b := Estilo.boton(par[0], 20, par.size() > 2)
		b.custom_minimum_size = Vector2(170, 46)
		var accion: String = par[1]
		b.pressed.connect(func(): _boton.emit(accion))
		fila.add_child(b)
		if primero == null:
			primero = b
	_capa_columna.add_child(Estilo.separador(4))
	_capa_columna.add_child(fila)
	_capa.visible = true
	_capa.reset_size()
	if primero != null:
		primero.grab_focus.call_deferred()


func _ficha_control(id_ficha: String) -> Control:
	var f := Juego.ficha(id_ficha)
	if f.is_empty():
		return Estilo.separador(0)
	var caja := Estilo.panel(Color("fffaf0"), 10, 2, 12)
	var columna := VBoxContainer.new()
	columna.add_child(Estilo.texto("AL CUADERNO · %s" % String(f.get("titulo", "")).to_upper(), 14, Estilo.PETROLEO, 700))
	var cuerpo := Estilo.texto(f.get("texto", ""), 18, Estilo.TINTA, 500)
	cuerpo.custom_minimum_size = Vector2(630, 0)
	columna.add_child(cuerpo)
	columna.add_child(Estilo.texto("Fuente: %s" % f.get("fuente", ""), 14, Estilo.TINTA_SUAVE, 500))
	caja.add_child(columna)
	return caja


func jugar(id: String, parametros: Dictionary) -> Dictionary:
	var meta := Juego.info_minijuego(id)
	var ruta := "res://minijuegos/%s/%s.gd" % [id, id]
	if meta.is_empty() or not FileAccess.file_exists(ruta):
		print("AVISO minijuego inexistente: ", id)
		return {"superado": false, "error": "no existe", "puntos": 0.0}
	var guion: Variant = load(ruta)
	visible = true
	_titulo.text = meta.get("titulo", id)
	_controles.text = meta.get("controles", "")
	_marco.reset_size()
	_pista = 0
	var solo := 0
	if Juego.modo_prueba or Juego.minijuegos_solos:
		solo = -1 if parametros.get("fallar", false) else 1
	var final: Dictionary = {}
	while true:
		if _minijuego != null and is_instance_valid(_minijuego):
			_minijuego.queue_free()
		_minijuego = guion.new()
		_hueco.add_child(_minijuego)
		_minijuego.position = Vector2.ZERO
		_minijuego.terminado.connect(_al_terminar)
		_minijuego.set("_solo", solo)
		_minijuego.preparar(parametros, meta)
		if solo == 0:
			var lineas: Array = [meta.get("resumen", "")]
			var n := 1
			for paso in meta.get("instrucciones", []):
				lineas.append("%d. %s" % [n, paso])
				n += 1
			if _pista > 0:
				var pistas: Array = meta.get("pistas", [])
				if not pistas.is_empty():
					lineas.append("Órbita: «%s»" % pistas[mini(_pista - 1, pistas.size() - 1)])
			_llenar_capa(meta.get("titulo", id), Estilo.TINTA, lineas, [["Empezar", "empezar", true], ["Salir", "salir"]])
			var accion: String = await _boton
			_capa.visible = false
			if accion == "salir":
				final = {"superado": false, "abandonado": true, "puntos": 0.0}
				break
		_pendiente = true
		_minijuego.empezar()
		while _pendiente:
			await get_tree().process_frame
		final = _resultado
		print("MINIJUEGO %s superado=%s puntos=%.1f detalle=%s" % [id, str(final.get("superado", false)), float(final.get("puntos", 0.0)), str(final.get("detalle", ""))])
		if solo != 0 or final.get("abandonado", false):
			break
		var siguiente := ""
		if final.get("superado", false):
			Audio.sonar("ok")
			var id_ficha: String = meta.get("ficha", "")
			var extra: Array = [final.get("detalle", "")]
			if id_ficha != "":
				Juego.anotar(id_ficha)
				extra.append(_ficha_control(id_ficha))
			_llenar_capa("¡Logrado!", Estilo.CIAN_MEDIO, extra, [["Continuar", "continuar", true], ["Otra vez", "reintentar"]])
			siguiente = await _boton
		else:
			Audio.sonar("error")
			_pista += 1
			_llenar_capa("Casi", Estilo.TERRACOTA, [final.get("detalle", ""), "Órbita puede darte una pista antes del próximo intento."], [["Reintentar", "reintentar", true], ["Salir", "salir"]])
			siguiente = await _boton
		_capa.visible = false
		if siguiente != "reintentar":
			break
	if final.get("superado", false):
		var ficha_final: String = meta.get("ficha", "")
		if ficha_final != "":
			Juego.anotar(ficha_final)
	if _minijuego != null and is_instance_valid(_minijuego):
		_minijuego.queue_free()
	_minijuego = null
	_capa.visible = false
	visible = false
	return final
"""Ejecuta el juego (carpeta juego/) con Godot 4.7.2: de uno en uno, y lo cierra si se cuelga.

Varios agentes trabajan a la vez en este equipo (2 nucleos, 8 GB, Intel HD 620). Dos Godot abiertos a la vez
falsean los fps y pueden agotar la memoria, asi que este envoltorio toma un candado global
(juego/.candado_godot) y espera su turno. Tambien mata el proceso si no sale solo (pasa en la HD 620).

Uso:
  python -I herramientas/juego_ejecutar.py [--ventana] [--max=<s>] [--todo] [--importar] -- <argumentos del juego>

  (sin --ventana)  corre con --headless: logica, fisica y guiones, sin GPU. Sirve para las pruebas.
  --ventana        abre la ventana real: capturas (--captura=<png>) y mediciones de fps (--medir=<s>).
  --max=<s>        tiempo maximo en segundos (por defecto 240).
  --todo           imprime toda la salida de Godot, no solo las lineas clave.
  --importar       antes de ejecutar, corre "--headless --import" (crea .godot y la cache de clases).
  --proyecto=<carpeta>  otro proyecto de Godot bajo el mismo candado, con su escena si hace falta. Ejemplo:
                   python -I herramientas/juego_ejecutar.py --ventana --proyecto=pruebas/escena_exploracion
                     res://vista_previa.tscn -- --glb=<glb> --animacion=caminar --tiempo=0.3 --captura=<png>
                   (en esos proyectos el fin lo marcan CAPTURA_OK o MEDIDA)

Argumentos del juego (los lee juego/principal.gd):
  --prueba=<nombre>          nucleo | zonas | minijuegos | recorrido | zona:<id> | minijuego:<id>
  --zona=<id> [--entrada=<nombre>]   abre una zona directamente
  --minijuego=<id>           abre un minijuego directamente
  --auto                     dialogos sin esperas y minijuegos que se juegan solos
  --captura=<png> [--espera=<s>]     guarda una captura tras <s> segundos (por defecto 2) y sale
  --medir=<s>                mide fps durante <s> segundos y sale
  --ritmo=<f>                Engine.time_scale (las pruebas usan 8)
  --pos=x,z  --mira=x,z      coloca a la protagonista (con --zona) para una captura

Marcadores de la salida: PRUEBA_OK, PRUEBA_FALLO, CAPTURA_OK, MEDIDA y FIN.
Codigo de salida: 0 si no hubo errores de guion, PRUEBA_FALLO ni tiempo agotado; 1 en caso contrario.
"""
import os
import subprocess
import sys
import threading
import time
from pathlib import Path

sys.stdout.reconfigure(encoding="utf-8")
RAIZ = Path(__file__).resolve().parent.parent
PROYECTO = RAIZ / "juego"
GODOT_POR_DEFECTO = r"C:\Users\guill\Downloads\Godot_v4.7.2-stable_win64.exe\Godot_v4.7.2-stable_win64_console.exe"


def ruta_godot():
    """Ejecutable de Godot 4.7.2 (version de consola). En otro equipo se indica con la variable de entorno
    GODOT_EXE o escribiendo la ruta en herramientas/godot_local.txt (una linea; ese archivo no se comparte)."""
    local = Path(__file__).resolve().parent / "godot_local.txt"
    if os.environ.get("GODOT_EXE"):
        return os.environ["GODOT_EXE"]
    if local.exists():
        return local.read_text(encoding="utf-8").strip().strip('"')
    return GODOT_POR_DEFECTO


GODOT = ruta_godot()
CANDADO = PROYECTO / ".candado_godot"
CLAVES = ("PRUEBA_", "CAPTURA_OK", "MEDIDA", "FIN", "ZONA ", "MINIJUEGO ", "AVISO ", "SCRIPT ERROR", "Parse Error",
          "ERROR:", "   at:", "WARNING: res")
ERRORES = ("SCRIPT ERROR", "Parse Error", "PRUEBA_FALLO", "Failed to load script", "Cannot open file",
           "Invalid call", "Invalid access", "Invalid assignment", "Nonexistent function")
GRACIA_S = 6.0
CANDADO_VIEJO_S = 900.0
ESPERA_CANDADO_S = 2400.0


def matar(proceso):
    subprocess.run(["taskkill", "/T", "/F", "/PID", str(proceso.pid)], capture_output=True)


def tomar_candado():
    inicio = time.time()
    avisado = False
    while True:
        try:
            descriptor = os.open(str(CANDADO), os.O_CREAT | os.O_EXCL | os.O_WRONLY)
            os.write(descriptor, f"{os.getpid()} {time.time():.0f}".encode())
            os.close(descriptor)
            return
        except FileExistsError:
            try:
                edad = time.time() - CANDADO.stat().st_mtime
            except FileNotFoundError:
                continue
            if edad > CANDADO_VIEJO_S:
                try:
                    CANDADO.unlink()
                except OSError:
                    pass
                continue
            if time.time() - inicio > ESPERA_CANDADO_S:
                raise SystemExit("No se pudo tomar el candado de Godot (otro proceso lo tiene hace demasiado)")
            if not avisado:
                print("(esperando turno: otro Godot esta corriendo)", flush=True)
                avisado = True
            time.sleep(1.5)


def soltar_candado():
    try:
        CANDADO.unlink()
    except OSError:
        pass


def correr(orden, maximo, todo, marcas_fin=("FIN",)):
    inicio = time.time()
    proceso = subprocess.Popen(orden, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                               encoding="utf-8", errors="replace")
    estado = {"fin": None, "errores": 0, "lineas": 0}

    def leer():
        for linea in proceso.stdout:
            estado["lineas"] += 1
            texto = linea.rstrip()
            if todo or any(c in texto for c in CLAVES):
                print(texto, flush=True)
            if any(e in texto for e in ERRORES):
                estado["errores"] += 1
            if any(texto.startswith(m) or (m != "FIN" and m in texto) for m in marcas_fin):
                estado["fin"] = time.time()

    hilo = threading.Thread(target=leer, daemon=True)
    hilo.start()
    resultado = "ok"
    while proceso.poll() is None:
        ahora = time.time()
        if estado["fin"] is not None and ahora - estado["fin"] > GRACIA_S:
            matar(proceso)
            resultado = "ok (Godot no salio solo: se cerro)"
            break
        if ahora - inicio > maximo:
            matar(proceso)
            resultado = "TIEMPO AGOTADO"
            estado["errores"] += 1
            break
        time.sleep(0.2)
    hilo.join(timeout=3.0)
    return resultado, estado, time.time() - inicio


def main():
    if "--" not in sys.argv:
        raise SystemExit(__doc__)
    corte = sys.argv.index("--")
    previos, juego = sys.argv[1:corte], sys.argv[corte + 1:]
    ventana = "--ventana" in previos
    todo = "--todo" in previos
    importar = "--importar" in previos
    maximo = 240.0
    proyecto = PROYECTO
    escena = []
    for p in previos:
        if p.startswith("--max="):
            maximo = float(p.split("=", 1)[1])
        elif p.startswith("--proyecto="):
            # otro proyecto de Godot (p. ej. pruebas/escena_exploracion) bajo el mismo candado
            proyecto = (RAIZ / p.split("=", 1)[1]).resolve()
        elif p.startswith("res://"):
            escena.append(p)
    propio = proyecto == PROYECTO
    marcas_fin = ("FIN",) if propio else ("FIN", "CAPTURA_OK", "MEDIDA")
    if not Path(GODOT).exists():
        raise SystemExit(f"No se encuentra Godot en {GODOT}. Define GODOT_EXE o escribe la ruta en herramientas/godot_local.txt")
    tomar_candado()
    try:
        if importar or (propio and not (PROYECTO / ".godot").exists()):
            r, e, t = correr([GODOT, "--headless", "--path", str(proyecto), "--import"], 300.0, False, ("FIN_NUNCA",))
            print(f"[importar: {r}, {t:.0f} s]", flush=True)
        orden = [GODOT, "--path", str(proyecto), *escena]
        if not ventana:
            orden.append("--headless")
        orden += ["--", *juego]
        resultado, estado, segundos = correr(orden, maximo, todo, marcas_fin)
    finally:
        soltar_candado()
    print(f"[godot: {resultado}; {segundos:.0f} s; lineas={estado['lineas']}; errores={estado['errores']}]", flush=True)
    sys.exit(1 if estado["errores"] else 0)


if __name__ == "__main__":
    main()
	pass


func _paso(_delta: float) -> void:
	pass


func jugar_solo(_acierta: bool) -> void:
	# cada minijuego lo implementa; por defecto termina sin jugar para que la prueba lo delate
	terminar(false, 0.0, "Este minijuego todavía no sabe jugarse solo.")


