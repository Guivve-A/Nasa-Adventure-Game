	draw_colored_polygon(PackedVector2Array([Vector2(25, 205), Vector2(197, 122), Vector2(375, 181), Vector2(577, 136), Vector2(577, 337), Vector2(25, 337)]), Estilo.PAPEL_SOMBRA)
