import math
sites=[(95,34),(190,32),(241,99),(108,101)]
craters=[(64,43),(144,53),(179,99),(87,82),(229,57)]
def add(a,b): return (a[0]+b[0],a[1]+b[1])
def sub(a,b): return (a[0]-b[0],a[1]-b[1])
def mul(a,s): return (a[0]*s,a[1]*s)
def length(a): return math.hypot(*a)
def unit(a): return mul(a,1/length(a)) if length(a) else (0,0)
def towards(a,b,d):
    diff=sub(b,a)
    return b if length(diff)<=d else add(a,mul(unit(diff),d))
for level in (1,2,3):
    p=(41.,72.); v=(0.,0.); z=vz=0.; carried=False; delivered=0; progress=0.; seals=3; immune=0.; hits=[]
    for step in range(120*80):
        dt=1/120
        target=(27,72) if carried else sites[delivered]
        diff=sub(target,p)
        action=not carried and length(diff)<9
        if action: direction=(0,0)
        else:
            heading=unit(diff)
            for c in craters[:(3,4,5)[level-1]]:
                offset=sub(c,p); front=sum(a*b for a,b in zip(offset,heading)); lateral=offset[0]*heading[1]-offset[1]*heading[0]
                if 0<front<min(32,length(diff)) and abs(lateral)<(6,8,10)[level-1]+9:
                    side=1 if lateral>=0 else -1
                    diff=add(mul(heading,10),mul((-heading[1],heading[0]),side*24)); break
            braking=sub(diff,mul(v,.23))
            direction=unit(tuple((1 if x>0 else -1) if abs(x)>2.5 else 0 for x in braking))
        if action:
            v=towards(v,(0,0),180*dt); z=max(0,z-32*dt); vz=0
        else:
            v=towards(v,mul(direction,43),(100 if z<=0 else 65)*dt)
            if z<=0 and length(direction)>.1: vz=30; z=.01
            if z>0: vz-=64.96*dt; z=max(0,z+vz*dt)
        p=add(p,mul(v,dt)); p=(max(9,min(270,p[0])),max(29,min(110,p[1])))
        immune=max(0,immune-dt)
        for c in craters[:(3,4,5)[level-1]]:
            if length(sub(p,c))<(6,8,10)[level-1] and z<2 and immune<=0:
                out=unit(sub(p,c)); p=add(c,mul(out,(6,8,10)[level-1]+4)); v=mul(out,30); seals-=1; immune=1.6; hits.append(round(step/120,2))
        if action and z<=.1:
            progress+=dt
            if progress >= (1.7 if delivered==3 else .7): carried=True; progress=0
        else: progress=max(0,progress-dt)
        if carried and length(sub(p,(27,72)))<14:
            delivered+=1; carried=False
            if delivered==4: break
        if seals<=0: break
    print('d',level,'time',round(step/120+3,2),'delivered',delivered,'seals',seals,'hits',hits,'p',p)
