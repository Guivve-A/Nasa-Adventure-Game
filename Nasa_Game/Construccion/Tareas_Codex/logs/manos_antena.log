diff --git a/juego/minijuegos/antena/prueba_manos.gd b/juego/minijuegos/antena/prueba_manos.gd
new file mode 100644
index 0000000000000000000000000000000000000000..c71b290fe19f069814db67c796e6ba1b39ab1431
--- /dev/null
+++ b/juego/minijuegos/antena/prueba_manos.gd
@@ -0,0 +1,283 @@
+extends Node
+
+# Entradas del jugador por el anfitrion real; nunca llama al piloto ni al modelo.
+var _pulsadas: Dictionary = {}
+var _devuelto: bool = false
+var _resultado: Dictionary = {}
+var _raton: Vector2 = Vector2.ZERO
+
+
+func correr(pruebas: Node) -> void:
+	process_mode = Node.PROCESS_MODE_ALWAYS
+	Juego.modo_prueba = false
+	Juego.sin_guardar = true
+	Juego.minijuegos_solos = false
+	await _teclado(pruebas)
+	await _raton_solo(pruebas)
+	await _escapes(pruebas)
+	_soltar_todo()
+	pruebas.comprobar(not Interfaz.anfitrion.visible, "antena.manos.anfitrion_cerrado", str(_resultado))
+	pruebas.comprobar(not get_tree().paused, "antena.manos.arbol_sin_pausa", "La apertura debe restaurar la pausa previa.")
+	Juego.modo_prueba = true
+
+
+func _abrir() -> void:
+	_resultado = await Interfaz.abrir_minijuego("antena", {"dificultad": 1})
+	_devuelto = true
+
+
+func _apertura(pruebas: Node, parte: String) -> Control:
+	_devuelto = false
+	_resultado = {}
+	_abrir()
+	var visible: bool = await _hasta(func() -> bool: return Interfaz.anfitrion.visible, 3.0)
+	pruebas.comprobar(visible, "antena.%s.abre_anfitrion" % parte, "Apertura asincrona por Interfaz.")
+	await _real(0.12)
+	var mj: Control = Interfaz.anfitrion.get("_minijuego")
+	if mj != null:
+		pruebas.comprobar(int(mj.get("_solo")) == 0 and int(mj.get("_auto")) == 0, "antena.%s.sin_piloto" % parte, "Solo eventos fisicos.")
+	return mj
+
+
+func _teclado(pruebas: Node) -> void:
+	var mj: Control = await _apertura(pruebas, "teclado")
+	if mj == null:
+		return
+	await _captura("manos_instrucciones")
+	await _toque(KEY_ENTER)
+	pruebas.comprobar(bool(mj.get("activo")), "antena.teclado.empezar_con_Intro", "El foco inicial debe estar en Empezar.")
+	for codigo in [KEY_D, KEY_A, KEY_RIGHT, KEY_LEFT]:
+		var antes: float = float(mj.get("ganancia"))
+		_tecla(codigo, true)
+		await _real(0.10)
+		_tecla(codigo, false)
+		await _real(0.04)
+		var despues: float = float(mj.get("ganancia"))
+		var sube: bool = codigo == KEY_D or codigo == KEY_RIGHT
+		pruebas.comprobar(despues > antes if sube else despues < antes, "antena.teclado.ganancia_%s" % OS.get_keycode_string(codigo), "%.1f -> %.1f" % [antes, despues])
+	await _ajustar_teclas(mj)
+	_comprobar_lienzo(pruebas, mj)
+	await _captura("manos_inicio")
+	await _toque(KEY_E)
+	pruebas.comprobar(bool(mj.get("_corriendo")), "antena.teclado.Probar_con_E", "E inicia el paso, sin foco en el boton.")
+	var fija: float = float(mj.get("ganancia"))
+	_tecla(KEY_D, true)
+	await _real(0.12)
+	_tecla(KEY_D, false)
+	pruebas.comprobar(is_equal_approx(fija, float(mj.get("ganancia"))), "antena.teclado.ganancia_fija_durante_paso", "No se modifica la regla del modelo.")
+	await _victoria(pruebas, mj, "teclado")
+	await _captura("manos_resultado")
+	await _toque(KEY_ENTER)
+	await _cerrado(pruebas, "teclado.Continuar_con_Intro")
+
+
+func _raton_solo(pruebas: Node) -> void:
+	var mj: Control = await _apertura(pruebas, "raton")
+	if mj == null:
+		return
+	var empezar: Button = _boton_capa("Empezar")
+	pruebas.comprobar(empezar != null, "antena.raton.Empezar_existe", "Debe ser pulsable con el raton.")
+	if empezar == null:
+		return
+	await _clic(empezar)
+	pruebas.comprobar(bool(mj.get("activo")), "antena.raton.Empezar_responde", "Clic izquierdo.")
+	var dial: HSlider = mj.get("_dial")
+	var marca: Label = mj.get("_inicio")
+	var rect: Rect2 = dial.get_global_rect()
+	var antes: float = float(mj.get("ganancia"))
+	await _mover(_punto_dial(dial, antes))
+	_boton_raton(true)
+	await _real(0.04)
+	await _mover(_punto_dial(dial, lerpf(dial.min_value, dial.max_value, 0.55)), true)
+	await _real(0.06)
+	var alto: float = float(mj.get("ganancia"))
+	pruebas.comprobar(alto > antes, "antena.raton.arrastrar_sube_ganancia", "%.1f -> %.1f" % [antes, alto])
+	await _mover(_punto_dial(dial, lerpf(dial.min_value, dial.max_value, 0.04)), true)
+	await _real(0.06)
+	pruebas.comprobar(float(mj.get("ganancia")) < alto, "antena.raton.arrastrar_baja_ganancia", str(mj.get("ganancia")))
+	# Apunta a la marca visible, sin escribir el valor del deslizador.
+	await _mover(Vector2(marca.get_global_rect().get_center().x, rect.get_center().y), true)
+	_boton_raton(false)
+	await _real(0.08)
+	pruebas.comprobar(absf(float(mj.get("ganancia")) - _objetivo_visible(mj)) < 0.15, "antena.raton.marca_INICIO", str(mj.get("ganancia")))
+	var probar: Button = mj.get("_boton")
+	await _clic(probar)
+	pruebas.comprobar(bool(mj.get("_corriendo")), "antena.raton.Probar_responde", "El clic inicia el paso.")
+	await _real(2.0)
+	await _captura("manos_paso")
+	await _victoria(pruebas, mj, "raton")
+	var continuar: Button = _boton_capa("Continuar")
+	pruebas.comprobar(continuar != null, "antena.raton.Continuar_existe", "Resultado accesible al raton.")
+	if continuar != null:
+		await _clic(continuar)
+	await _cerrado(pruebas, "raton.Continuar_con_clic")
+
+
+func _escapes(pruebas: Node) -> void:
+	for fase in ["instrucciones", "ajuste", "paso", "resultado"]:
+		var mj: Control = await _apertura(pruebas, "Esc_" + fase)
+		if mj == null:
+			return
+		if fase != "instrucciones":
+			await _toque(KEY_ENTER)
+		if fase == "paso":
+			await _toque(KEY_SPACE)
+			pruebas.comprobar(bool(mj.get("_corriendo")), "antena.teclado.Probar_con_Espacio", "No requiere foco en Probar.")
+		if fase == "resultado":
+			await _ajustar_teclas(mj)
+			await _toque(KEY_ENTER)
+			pruebas.comprobar(bool(mj.get("_corriendo")), "antena.teclado.Probar_con_Intro", "Intro inicia el paso despues de Empezar.")
+			await _victoria(pruebas, mj, "Esc_resultado")
+		await _toque(KEY_ESCAPE)
+		await _cerrado(pruebas, "Esc_" + fase)
+	# La salida alternativa con raton tambien debe restaurar la pausa.
+	var mj: Control = await _apertura(pruebas, "salir_raton")
+	if mj != null:
+		await _clic(_boton_capa("Empezar"))
+		var salir: Button = Interfaz.anfitrion.get("_salir")
+		await _clic(salir)
+		await _cerrado(pruebas, "raton.Salir_con_clic")
+
+
+func _objetivo_visible(mj: Control) -> float:
+	var dial: HSlider = mj.get("_dial")
+	var marca: Label = mj.get("_inicio")
+	var rect: Rect2 = dial.get_global_rect()
+	var agarre: float = float(dial.get_theme_icon("grabber").get_width())
+	var fraccion: float = (marca.get_global_rect().get_center().x - rect.position.x - agarre * 0.5) / (rect.size.x - agarre)
+	return lerpf(dial.min_value, dial.max_value, fraccion)
+
+
+func _ajustar_teclas(mj: Control) -> void:
+	# Lee la marca del lienzo y el numero de GANANCIA, como mirando la pantalla.
+	var objetivo: float = _objetivo_visible(mj)
+	var limite: int = Time.get_ticks_msec() + 4000
+	while bool(mj.get("activo")) and Time.get_ticks_msec() < limite:
+		var falta: float = objetivo - float(mj.get("ganancia"))
+		if absf(falta) < 0.15:
+			break
+		_tecla(KEY_D, falta > 0.0)
+		_tecla(KEY_A, falta < 0.0)
+		await get_tree().process_frame
+	_soltar_todo()
+	await _real(0.06)
+
+
+func _victoria(pruebas: Node, mj: Control, parte: String) -> void:
+	var termino: bool = await _hasta(func() -> bool: return not bool(mj.get("activo")), 15.0)
+	await _real(0.12)
+	var resultado: Dictionary = Interfaz.anfitrion.get("_resultado")
+	pruebas.comprobar(termino and int(mj.get("pruebas")) > 0 and bool(resultado.get("superado", false)), "antena.%s.superado" % parte, str(resultado))
+	pruebas.comprobar(int(mj.get("pruebas")) == 1, "antena.%s.gana_primer_intento_con_marca_visible" % parte, "No hace falta memorizar ganancias.")
+
+
+func _cerrado(pruebas: Node, parte: String) -> void:
+	var cerrado: bool = await _hasta(func() -> bool: return _devuelto and not Interfaz.anfitrion.visible, 2.0)
+	pruebas.comprobar(cerrado, "antena.%s.anfitrion_cerrado" % parte, str(_resultado))
+	pruebas.comprobar(not get_tree().paused, "antena.%s.sin_pausa" % parte, "El anfitrion devuelve el control.")
+	if not cerrado:
+		# Limpieza por entrada real para no dejar otra apertura esperando encima.
+		await _toque(KEY_ESCAPE)
+		await _hasta(func() -> bool: return _devuelto and not Interfaz.anfitrion.visible, 2.0)
+
+
+func _comprobar_lienzo(pruebas: Node, mj: Control) -> void:
+	var lienzo: Rect2 = mj.get_global_rect()
+	var dentro: bool = true
+	var detalle: String = ""
+	for hijo in mj.get_children():
+		if hijo is Control and not lienzo.encloses(hijo.get_global_rect()):
+			dentro = false
+			detalle += "%s %s; " % [hijo.name, str(hijo.get_global_rect())]
+	pruebas.comprobar(dentro, "antena.manos.controles_y_textos_dentro_de_1120x520", detalle)
+	var dial: HSlider = mj.get("_dial")
+	var boton: Button = mj.get("_boton")
+	pruebas.comprobar(dial.focus_mode == Control.FOCUS_NONE and boton.focus_mode == Control.FOCUS_NONE, "antena.manos.entradas_no_dependen_del_foco", "Las acciones se reciben en _input y _paso.")
+
+
+func _boton_capa(titulo: String) -> Button:
+	var capa: Control = Interfaz.anfitrion.get("_capa")
+	for nodo in capa.find_children("*", "Button", true, false):
+		var boton: Button = nodo
+		if boton.text == titulo:
+			return boton
+	return null
+
+
+func _punto_dial(dial: HSlider, valor: float) -> Vector2:
+	var rect: Rect2 = dial.get_global_rect()
+	var agarre: float = float(dial.get_theme_icon("grabber").get_width())
+	return Vector2(rect.position.x + agarre * 0.5 + (valor - dial.min_value) / (dial.max_value - dial.min_value) * (rect.size.x - agarre), rect.get_center().y)
+
+
+func _tecla(codigo: int, abajo: bool) -> void:
+	if bool(_pulsadas.get(codigo, false)) == abajo:
+		return
+	_pulsadas[codigo] = abajo
+	var evento: InputEventKey = InputEventKey.new()
+	evento.physical_keycode = codigo
+	evento.keycode = codigo
+	evento.pressed = abajo
+	Input.parse_input_event(evento)
+
+
+func _toque(codigo: int) -> void:
+	_tecla(codigo, true)
+	await get_tree().process_frame
+	await get_tree().physics_frame
+	await get_tree().process_frame
+	_tecla(codigo, false)
+	await _real(0.05)
+
+
+func _soltar_todo() -> void:
+	for codigo in _pulsadas.keys():
+		_tecla(int(codigo), false)
+
+
+func _mover(posicion: Vector2, arrastrando: bool = false) -> void:
+	var evento: InputEventMouseMotion = InputEventMouseMotion.new()
+	evento.position = posicion
+	evento.global_position = posicion
+	evento.relative = posicion - _raton
+	evento.button_mask = MOUSE_BUTTON_MASK_LEFT if arrastrando else 0
+	_raton = posicion
+	Input.parse_input_event(evento)
+	await get_tree().process_frame
+
+
+func _boton_raton(abajo: bool) -> void:
+	var evento: InputEventMouseButton = InputEventMouseButton.new()
