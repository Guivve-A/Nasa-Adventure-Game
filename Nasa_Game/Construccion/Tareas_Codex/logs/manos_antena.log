extends Node

const Antena = preload("res://minijuegos/antena/antena.gd")


func correr(pruebas: Node) -> void:
	for dificultad in [1, 2, 3]:
		for ganancia in [0.4, 1.2, 3.0, 12.0]:
			var nodo: Control = Antena.new()
			add_child(nodo)
			nodo.preparar({"dificultad": dificultad}, {})
			nodo.empezar()
			nodo.set_process(false)
			nodo._dial.value = ganancia
			nodo._probar()
			var cuadros: int = 0
			while nodo._corriendo and cuadros < 2400:
				nodo._process(1.0 / 144.0)
				cuadros += 1
			var util: float = nodo.sostenido / nodo.duracion
			print("BARRIDO d%d K=%.1f util=%.4f cruces=%d" % [dificultad, ganancia, util, nodo.cruces])
			pruebas.comprobar((util >= 0.8) == is_equal_approx(ganancia, 3.0), "antena.modelo.d%d.K%.1f" % [dificultad, ganancia])
			if ganancia == 12.0:
				pruebas.comprobar(nodo.cruces >= 5, "antena.d%d.ganancia_alta_oscila" % dificultad)
			var previo: PackedVector2Array = nodo._trazo.duplicate()
			if nodo.activo:
				nodo._probar()
				pruebas.comprobar(nodo._anterior == previo and nodo._trazo.size() == 1, "antena.d%d.K%.1f.compara_pruebas" % [dificultad, ganancia])
			else:
				var reintento: Control = Antena.new()
				add_child(reintento)
				reintento.preparar({"dificultad": dificultad}, {})
				pruebas.comprobar(reintento._anterior == previo, "antena.d%d.historial_al_reabrir" % dificultad)
				reintento.free()
			nodo.activo = false
			nodo.free()
	# El ajuste acumula fracciones: funciona tambien con cuadros muy cortos.
	var teclado: Control = Antena.new()
	add_child(teclado)
	teclado.preparar({}, {})
	teclado.empezar()
	teclado.set_process(false)
	for i in 144:
		teclado._ajustar(1.0, 1.0 / 144.0)
	pruebas.comprobar(is_equal_approx(teclado.ganancia, 7.2), "antena.teclado_144_cuadros")
	teclado.activo = false
	teclado.free()
	# El piloto completo pasa por el deslizador y las tres pruebas reales al fallar.
	for acierta in [true, false]:
		var piloto: Control = Antena.new()
		add_child(piloto)
		piloto.preparar({"dificultad": 2}, {})
		piloto.empezar()
		piloto.set_process(false)
		piloto.jugar_solo(acierta)
		var resultado: Dictionary = {}
		piloto.terminado.connect(func(r: Dictionary): resultado.merge(r, true))
		while piloto.activo and piloto.tiempo < 40.0:
			piloto._process(0.19)
		pruebas.comprobar(not piloto.activo and bool(resultado.get("superado", not acierta)) == acierta, "antena.d2.piloto_%s" % str(acierta))
		pruebas.comprobar(piloto.tiempo < 40.0, "antena.d2.piloto_limite_%s" % str(acierta))
		print("PILOTO d2 acierta=%s tiempo=%.3f" % [str(acierta), piloto.tiempo])
		piloto.free()
# Antena â€” escena 2.1

Implementado el minijuego Â«Rastrear como en el CotopaxiÂ». Solo se escribieron archivos de `juego/minijuegos/antena/` y esta carpeta. No hubo archivos previos de antena que continuar. No se instalaron ni descargaron recursos.

## Archivos

- `juego/minijuegos/antena/antena.gd`: modelo, interfaz, teclado/ratÃ³n y piloto real.
- `juego/minijuegos/antena/minijuego.json`: metadatos, 3 instrucciones, 3 pistas, ficha `ganancia`, escena `2.1`, orden 2.
- `juego/minijuegos/antena/prueba_modelo.gd`: comprobaciones del modelo, historial, teclado y piloto.
- Evidencia: `prueba_minijuego.log`, `prueba_modelo.log`, `captura.log`, `vista.png`, `comparacion.png` y esta nota.

## Modelo y reglas

ParÃ¡metros **didÃ¡cticos**, no mediciones ni reconstrucciÃ³n del equipo histÃ³rico. Las Ãºnicas cifras histÃ³ricas que muestra el lienzo vienen literalmente de `estacion_cotopaxi`: 3 650 m, operaciÃ³n de 1957 a 1981 y entrega en 1982. El concepto de ganancia procede de `ganancia` y `FUENTES.md`. No se vincula la estaciÃ³n con el Apolo 11 ni se muestran emblemas.

- Paso fijo de integraciÃ³n: 1/120 s, acumulado exclusivamente con `delta`. Orden proporcional `u = K Ã— (objetivo âˆ’ antena)`, limitada a Â±95Â°/s; retardo puro de 30 pasos (0,25 s) y respuesta de velocidad de primer orden con constante de 0,12 s.
- GANANCIA: 0,4â€“12,0, pasos de 0,1. Inicial: 1,2. El teclado mueve 6 unidades/s y acumula fracciones para no depender de la frecuencia de cuadros. Se congela durante cada prueba.
- Objetivo angular: `âˆ’60 + 120 Ã— [p âˆ’ 0,1 sin(2Ï€p)/(2Ï€)]` grados, con `p = t / duraciÃ³n`. Antena inicial: âˆ’72Â°, velocidad inicial 0. El arco dibujado sigue este mismo Ã¡ngulo.
- Duraciones de dificultad 1/2/3: 10 / 8,5 / 7 s. D1 sin viento. D2 y D3 tienen dos rÃ¡fagas opuestas, centradas en el 32 % y 65 % del paso; cada una dura 0,64 s con perfil coseno al cuadrado. Picos: 8 y 14Â°/s, respectivamente, sumados como perturbaciÃ³n de la velocidad.
- SeÃ±al normalizada: `100 Ã— exp[âˆ’(error / 14Â°)Â²]`. Se acumula tiempo Ãºnicamente con seÃ±al **>70 %**. Victoria si ese tiempo alcanza **â‰¥80 %** del paso: 8 / 6,8 / 5,6 s. La banda sombreada de la grÃ¡fica corresponde aproximadamente a Â±8,36Â°; misma escala Â±40Â° y duraciÃ³n en ambas grÃ¡ficas.
- Hasta 3 pruebas completas; al fallar una se puede modificar K y comparar con la anterior. El anfitriÃ³n recibe el resultado al superar o agotar las 3 pruebas. LÃ­mite de sesiÃ³n: 180 s. El historial persiste al reabrir/reintentar dentro del mismo anfitriÃ³n y dificultad.
- El piloto ajusta el mismo deslizador y llama al mismo botÃ³n. Usa K=3,0 para acertar y K=12,0 para fallar; no fuerza el resultado. El camino de fallo completa las 3 pruebas. La duraciÃ³n mÃ¡xima nominal del piloto es unos 32 s en D1, inferior a 40 s; la prueba adicional midiÃ³ D2: 8,93 s al acertar y 27,93 s al fallar, con cuadros de 0,19 s.

## ValidaciÃ³n

Prueba solicitada ejecutada con el envoltorio y su candado global:

```text
python -I herramientas/juego_ejecutar.py -- --prueba=minijuego:antena --ritmo=8 --todo
```

TambiÃ©n se repitiÃ³ con `--todo` antes de `--` para guardar toda la salida del envoltorio:

```text
PRUEBAS hechas=13 fallos=0
FIN
[godot: ok; 7 s; lineas=31; errores=0]
```

K=3,0: D1 94,000 %, D2 92,549 %, D3 83,810 % de tiempo Ãºtil. K=12,0: D1 26,083 %, D2 25,490 %, D3 24,881 %, con 14/11/9 cruces del error por cero. K=0,4 y 1,2: 0 % Ãºtil en las tres dificultades. El fallo explica que las correcciones grandes llegan tarde, el haz se pasa y oscila.

