extends Node

const Antena = preload("res://minijuegos/antena/antena.gd")


func correr(pruebas: Node) -> void:
	for dificultad in [1, 2, 3]:
		for ganancia in [0.4, 1.2, 3.0, 12.0]:
			var nodo: Control = Antena.new()
			add_child(nodo)
			nodo.preparar({"dificultad": dificultad}, {})
			nodo.empezar()
			nodo.set_process(false)
			nodo._dial.value = ganancia
			nodo._probar()
			var cuadros: int = 0
			while nodo._corriendo and cuadros < 2400:
				nodo._process(1.0 / 144.0)
				cuadros += 1
			var util: float = nodo.sostenido / nodo.duracion
			print("BARRIDO d%d K=%.1f util=%.4f cruces=%d" % [dificultad, ganancia, util, nodo.cruces])
			pruebas.comprobar((util >= 0.8) == is_equal_approx(ganancia, 3.0), "antena.modelo.d%d.K%.1f" % [dificultad, ganancia])
			if ganancia == 12.0:
				pruebas.comprobar(nodo.cruces >= 5, "antena.d%d.ganancia_alta_oscila" % dificultad)
			var previo: PackedVector2Array = nodo._trazo.duplicate()
			if nodo.activo:
				nodo._probar()
				pruebas.comprobar(nodo._anterior == previo and nodo._trazo.size() == 1, "antena.d%d.K%.1f.compara_pruebas" % [dificultad, ganancia])
			else:
				var reintento: Control = Antena.new()
				add_child(reintento)
				reintento.preparar({"dificultad": dificultad}, {})
				pruebas.comprobar(reintento._anterior == previo, "antena.d%d.historial_al_reabrir" % dificultad)
				reintento.free()
			nodo.activo = false
			nodo.free()
	# El ajuste acumula fracciones: funciona tambien con cuadros muy cortos.
	var teclado: Control = Antena.new()
	add_child(teclado)
	teclado.preparar({}, {})
	teclado.empezar()
	teclado.set_process(false)
	for i in 144:
		teclado._ajustar(1.0, 1.0 / 144.0)
	pruebas.comprobar(is_equal_approx(teclado.ganancia, 7.2), "antena.teclado_144_cuadros")
	teclado.activo = false
	teclado.free()
	# El piloto completo pasa por el deslizador y las tres pruebas reales al fallar.
	for acierta in [true, false]:
		var piloto: Control = Antena.new()
		add_child(piloto)
		piloto.preparar({"dificultad": 2}, {})
		piloto.empezar()
		piloto.set_process(false)
		piloto.jugar_solo(acierta)
		var resultado: Dictionary = {}
		piloto.terminado.connect(func(r: Dictionary): resultado.merge(r, true))
		while piloto.activo and piloto.tiempo < 40.0:
			piloto._process(0.19)
		pruebas.comprobar(not piloto.activo and bool(resultado.get("superado", not acierta)) == acierta, "antena.d2.piloto_%s" % str(acierta))
		pruebas.comprobar(piloto.tiempo < 40.0, "antena.d2.piloto_limite_%s" % str(acierta))
		print("PILOTO d2 acierta=%s tiempo=%.3f" % [str(acierta), piloto.tiempo])
		piloto.free()
extends CanvasLayer

# Interfaz global (autoload "Interfaz"): HUD, dialogos, avisos, ventana de carga, pausa, cuaderno, menu
# principal y anfitrion de minijuegos. Las zonas y los minijuegos solo usan las funciones de este guion.
# ESTILO PROVISIONAL: la Fase 7 (UI/UX) no esta validada.
#
#   await Interfaz.decir([{"quien": "Órbita", "texto": "..."}])       dialogo
#   var i: int = await Interfaz.elegir("¿...?", ["Sí", "No"])          pregunta con opciones
#   Interfaz.aviso("Texto corto", 3.0)                                 aviso que se va solo
#   var r: Dictionary = await Interfaz.abrir_minijuego("seguidor", {"dificultad": 1})
#        r = {"superado": bool, "puntos": float, "detalle": String, "abandonado": bool (si salio)}

const Estilo := preload("res://interfaz/estilo.gd")
const Recursos := preload("res://nucleo/recursos.gd")
const Hud := preload("res://interfaz/hud.gd")
const Dialogo := preload("res://interfaz/dialogo.gd")
const VentanaCarga := preload("res://interfaz/ventana_carga.gd")
const Anfitrion := preload("res://interfaz/anfitrion.gd")
const Pausa := preload("res://interfaz/pausa.gd")
const Cuaderno := preload("res://interfaz/cuaderno.gd")
const Menu := preload("res://interfaz/menu.gd")
const Mapa := preload("res://interfaz/mapa.gd")

var raiz: Control
var hud: Control
var dialogo: Control
var carga: Control
var anfitrion: Control
var pausa: Control
var cuaderno: Control
var menu: Control
var mapa: Control
var velo: ColorRect
var _pausa_previa := false
var _ocupada_hasta := 0
var _mapa_desde_menu := false
var _hablando := false


func _ready() -> void:
	layer = 10
	process_mode = Node.PROCESS_MODE_ALWAYS
	raiz = Control.new()
	raiz.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	raiz.mouse_filter = Control.MOUSE_FILTER_IGNORE
	raiz.theme = Estilo.tema()
	add_child(raiz)
	hud = Hud.new()
	dialogo = Dialogo.new()
	cuaderno = Cuaderno.new()
	pausa = Pausa.new()
	menu = Menu.new()
	mapa = Mapa.new()
	anfitrion = Anfitrion.new()
	carga = VentanaCarga.new()
	for nodo in [hud, dialogo, cuaderno, pausa, menu, mapa, anfitrion, carga]:
		raiz.add_child(nodo)
	hud.visible = false
	velo = ColorRect.new()
	velo.color = Color("12181b")
	velo.modulate.a = 0.0
	velo.mouse_filter = Control.MOUSE_FILTER_IGNORE
	velo.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	raiz.add_child(velo)
	pausa.accion.connect(_accion_pausa)
	cuaderno.cerrado.connect(_cuaderno_cerrado)
	menu.elegido.connect(_accion_menu)
	mapa.cerrado.connect(_mapa_cerrado)
	mapa.viajar.connect(_mapa_viajar)


func _abierta() -> bool:
	return _hablando or dialogo.visible or anfitrion.visible or pausa.visible or cuaderno.visible or menu.visible or carga.visible or mapa.visible


func _process(_delta: float) -> void:
	if _abierta():
		_ocupada_hasta = Time.get_ticks_msec() + 300


func ocupada() -> bool:
	# true mientras haya algo abierto que bloquea a la protagonista, y 0,3 s mas: asi la pulsacion que
	# cierra un dialogo o un minijuego (E o Intro) no vuelve a usar el objeto que esta al lado
	return _abierta() or Time.get_ticks_msec() < _ocupada_hasta


# ------------------------------------------------------------------ dialogos y avisos

func decir(lineas: Variant, quien: String = "") -> void:
	while _hablando:
		await get_tree().process_frame
	_hablando = true
	await dialogo.decir(lineas, quien)
	_hablando = false


func elegir(pregunta: Variant, opciones: Array) -> int:
	while _hablando:
		await get_tree().process_frame
	_hablando = true
	var indice: int = await dialogo.elegir(pregunta, opciones)
	_hablando = false
	return indice


func aviso(texto: String, segundos: float = 3.0) -> void:
	if hud != null:
		hud.aviso(texto, segundos)


func indicar(texto: String) -> void:
	hud.indicar(texto)


func rotular(origen: Object, texto: String) -> void:
	hud.rotular(origen, texto)


func limpiar_rotulos() -> void:
	hud.limpiar_rotulos()


func mostrar_hud(ver: bool) -> void:
	hud.visible = ver


func anunciar_zona(meta: Dictionary) -> void:
	hud.anunciar_zona(meta)


# ------------------------------------------------------------------ carga y fundidos

func mostrar_carga(meta: Dictionary) -> void:
	await carga.mostrar(meta)


func ocultar_carga() -> void:
	await carga.ocultar()


func fundido(a_oscuro: bool, segundos: float = 0.4) -> void:
	var meta_alfa := 1.0 if a_oscuro else 0.0
	if Juego.modo_prueba:
		velo.modulate.a = meta_alfa
		await get_tree().process_frame
		return
	var t := velo.create_tween()
	t.tween_property(velo, "modulate:a", meta_alfa, segundos)
	await t.finished


# ------------------------------------------------------------------ minijuegos

func abrir_minijuego(id: String, parametros: Dictionary = {}) -> Dictionary:
	if not FileAccess.file_exists("res://minijuegos/%s/%s.gd" % [id, id]):
		# todavia no esta construido: no bloquea la historia, pero queda avisado
		print("AVISO minijuego en construccion: ", id)
		aviso("El reto «%s» todavía está en construcción." % id, 3.0)
		return {"superado": true, "puntos": 0.0, "detalle": "", "en_construccion": true}
	var estaba_en_pausa := get_tree().paused
	get_tree().paused = true
	var resultado: Dictionary = await anfitrion.jugar(id, parametros)
	get_tree().paused = estaba_en_pausa
	Juego.registrar_minijuego(id, resultado)
	return resultado


# ------------------------------------------------------------------ menu, pausa y cuaderno

func abrir_menu() -> void:
	mostrar_hud(false)
	menu.abrir()


func _en_juego() -> bool:
	return Zonas.actual != null and not Zonas.ocupado


func _input(evento: InputEvent) -> void:
	if evento is InputEventKey and evento.pressed and not evento.echo:
		if evento.keycode == KEY_F11:
			var modo := DisplayServer.window_get_mode()
			DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_WINDOWED if modo == DisplayServer.WINDOW_MODE_FULLSCREEN else DisplayServer.WINDOW_MODE_FULLSCREEN)
			return
		if evento.keycode == KEY_F12:
			capturar("res://capturas/captura_%d.png" % int(Time.get_unix_time_from_system()))
			return
	if anfitrion.visible or carga.visible or mapa.visible:
		return
	if menu.visible:
		return
	if evento.is_action_pressed("mapa") and _en_juego() and not ocupada():
		abrir_mapa(false)
		get_viewport().set_input_as_handled()
		return
	if evento.is_action_pressed("pausa"):
		if pausa.visible:
			_accion_pausa("continuar")
		elif cuaderno.visible:
			cuaderno.cerrar()
		elif _en_juego() and not ocupada():
			_abrir_pausa()
		else:
			return
		get_viewport().set_input_as_handled()
	elif evento.is_action_pressed("cuaderno"):
		if cuaderno.visible:
			cuaderno.cerrar()
		elif _en_juego() and not ocupada():
			abrir_cuaderno()
		else:
			return
		get_viewport().set_input_as_handled()


func _abrir_pausa() -> void:
	_pausa_previa = get_tree().paused
	get_tree().paused = true
	var opciones: Array = [["Continuar", "continuar"], ["Mapa", "mapa"], ["Cuaderno", "cuaderno"]]
	if Zonas.actual != null and Zonas.actual.has_method("despertar"):
		opciones.append(["Despertar", "despertar"])
	opciones.append(["Menú principal", "menu"])
	opciones.append(["Salir del juego", "salir"])
	pausa.abrir(opciones)


func _accion_pausa(nombre: String) -> void:
	pausa.cerrar()
	match nombre:
		"cuaderno":
			cuaderno.abrir()
		"mapa":
			_mapa_desde_menu = false
			mapa.abrir(false)
		"despertar":
			get_tree().paused = false
			Zonas.actual.call("despertar")
		"menu":
			get_tree().paused = false
			Juego.guardar()
			Zonas.cerrar()
			abrir_menu()
		"salir":
			Juego.guardar()
			salir()
		_:
			get_tree().paused = _pausa_previa


func abrir_cuaderno() -> void:
	_pausa_previa = get_tree().paused
	get_tree().paused = true
	Audio.sonar("pagina")
	cuaderno.abrir()


func _cuaderno_cerrado() -> void:
	get_tree().paused = _pausa_previa


func abrir_mapa(viaje: bool = false) -> void:
	# el mapa del mundo: lugares, conexiones y donde esta la protagonista
	_mapa_desde_menu = menu.visible
	if not _mapa_desde_menu:
		_pausa_previa = get_tree().paused
		get_tree().paused = true
	Audio.sonar("pagina")
	mapa.abrir(viaje)


func _mapa_cerrado() -> void:
	if not _mapa_desde_menu:
		get_tree().paused = _pausa_previa


func _mapa_viajar(id_zona: String) -> void:
	if _mapa_desde_menu:
		# visita libre desde el menu principal: todo abierto, para recorrer y validar cada escenario
		Juego.nueva_partida()
		Juego.poner_bandera("visita_libre")
		menu.cerrar()
	else:
		get_tree().paused = _pausa_previa
	Zonas.ir_a(id_zona, "inicio")


func _accion_menu(accion: String, dato: String) -> void:
	match accion:
		"nueva":
			Juego.nueva_partida()
			menu.cerrar()
			Zonas.ir_a(_zona_inicial(), "inicio")
		"continuar":
			if not Juego.cargar():
				Juego.nueva_partida()
			menu.cerrar()
			var zona: String = Juego.estado.get("zona", _zona_inicial())
			if not Zonas.existe(zona):
				zona = _zona_inicial()
			Zonas.ir_a(zona, Juego.estado.get("entrada", "inicio"))
		"minijuegos":
			menu.mostrar_minijuegos()
		"lugares":
			menu.mostrar_lugares()
		"mapa":
			abrir_mapa(true)
		"inicio":
			menu.mostrar_inicio()
		"minijuego":
			await abrir_minijuego(dato, {"dificultad": 1, "desde_menu": true})
			menu.mostrar_minijuegos()
		"lugar":
			# visita libre: los umbrales con requisito quedan abiertos para poder validar cada escenario
			Juego.nueva_partida()
			Juego.poner_bandera("visita_libre")
			menu.cerrar()
			Zonas.ir_a(dato, "inicio")
		"salir":
			salir()


func _zona_inicial() -> String:
	if Zonas.existe("habitacion"):
		return "habitacion"
	var lista := Zonas.catalogo(true)
	return lista[0]["id"] if not lista.is_empty() else ""


func capturar(ruta: String) -> void:
	await RenderingServer.frame_post_draw
	var imagen := get_viewport().get_texture().get_image()
	var destino := ProjectSettings.globalize_path(ruta) if ruta.begins_with("res://") else ruta
	imagen.save_png(destino)
	print("CAPTURA_OK ", destino)


func salir() -> void:
	print("FIN")
	Recursos.liberar()
	get_tree().quit()
extends Node

# Pruebas automaticas del juego (sin ventana). Se corren con:
#   python -I herramientas/juego_ejecutar.py -- --prueba=<nombre> --ritmo=8
# Nombres: nucleo | zonas | zona:<id> | minijuegos | minijuego:<id> | recorrido | manos | recorrido_manos
# (manos y recorrido_manos juegan con teclas simuladas, como una persona: usar --ritmo=2)
# Cada comprobacion imprime PRUEBA_OK o PRUEBA_FALLO; el envoltorio sale con 1 si hay algun fallo.

var fallos := 0
var hechas := 0


func comprobar(condicion: bool, nombre: String, detalle: String = "") -> bool:
	hechas += 1
	if condicion:
		print("PRUEBA_OK ", nombre)
	else:
		fallos += 1
		print("PRUEBA_FALLO ", nombre, (": " + detalle) if detalle != "" else "")
	return condicion


func correr(cual: String) -> void:
	var nombre := cual.get_slice(":", 0)
	var dato := cual.get_slice(":", 1) if cual.contains(":") else ""
	match nombre:
		"nucleo":
			await _nucleo()
		"zonas":
			await _zonas()
		"zona":
			await _zona(dato)
			await _enlaces([dato])
		"minijuegos":
			for m in Juego.catalogo_minijuegos():
				if String(m.get("zona", "")) == "":
					await _minijuego(m["id"])
		"minijuego":
			await _minijuego(dato)
		"recorrido":
			await _recorrido()
		"manos":
			await _manos()
		"recorrido_manos":
			await _recorrido_manos()
		"guion":
			# prueba propia de un carril: un guion con  func correr(pruebas: Node) -> void  que usa
			# pruebas.comprobar(condicion, nombre, detalle). Ejemplo: --prueba=guion:res://base/prueba_base.gd
			var ruta := cual.substr(cual.find(":") + 1)
			var guion: Variant = load(ruta) if ResourceLoader.exists(ruta) else null
			if comprobar(guion != null, "guion_de_prueba_existe", ruta):
				var nodo: Node = guion.new()
				add_child(nodo)
				await nodo.correr(self)
				nodo.queue_free()
		_:
			comprobar(false, "prueba_desconocida", cual)
	print("PRUEBAS hechas=%d fallos=%d" % [hechas, fallos])


func _esperar(segundos: float) -> void:
	await get_tree().create_timer(segundos).timeout


# ------------------------------------------------------------------ nucleo

func _nucleo() -> void:
	comprobar(not Zonas.catalogo(true).is_empty(), "catalogo_de_zonas")
	comprobar(not Juego.catalogo_minijuegos().is_empty(), "catalogo_de_minijuegos")
	comprobar(not Juego.fichas.is_empty(), "fichas_del_cuaderno", "datos/datos_espaciales.json vacio o ilegible")
	comprobar(not Juego.misiones.is_empty(), "misiones", "datos/misiones.json vacio o ilegible")
	Juego.nueva_partida()
	var llego: bool = await Zonas.ir_a("plantilla", "inicio")
	comprobar(llego and Zonas.actual != null, "ir_a_plantilla")
	if Zonas.actual == null:
		return
	await _esperar(0.6)
	var j: CharacterBody3D = Zonas.jugador
	comprobar(j != null and j.is_on_floor(), "protagonista_en_el_suelo", "y=%.2f" % (j.global_position.y if j != null else -99.0))
	comprobar(j.modelo != null, "modelo_de_la_protagonista_cargado")
	comprobar(Zonas.companero.modelo != null, "modelo_de_orbita_cargado")
	var ok: bool = await j.caminar_hasta(Vector3(2.0, 0.0, 1.0))
	comprobar(ok and j.global_position.distance_to(Vector3(2.0, j.global_position.y, 1.0)) < 0.5, "piloto_camina_hasta_un_punto", str(j.global_position))
	await Interfaz.decir(["Prueba de diálogo.", {"quien": "Órbita", "texto": "Miau."}])
	comprobar(not Interfaz.dialogo.visible, "dialogo_se_cierra")
	var elegido: int = await Interfaz.elegir("¿Seguimos?", ["Sí", "No"])
	comprobar(elegido == 0, "pregunta_con_opciones")
	var cartel: Node3D = Zonas.actual.get_node_or_null("Cartel")
	comprobar(cartel != null, "interactuable_existe")
	if cartel != null:
		await cartel.usar(j)
		comprobar(bool(Juego.bandera("plantilla_minijuego")), "minijuego_desde_la_zona", "la zona no puso la bandera tras el minijuego")
	Juego.poner_bandera("plantilla_paso_1")
	Juego.poner_bandera("plantilla_paso_2")
	comprobar(Juego.estado["misiones_hechas"].has("m_plantilla") or Juego.misiones.filter(func(m): return m.get("id") == "m_plantilla").is_empty(), "mision_se_completa")
	# cruza el umbral del fondo y vuelve a entrar por la otra entrada
	ok = await j.caminar_hasta(Vector3(0.0, 0.0, -4.2))
	await _esperar(1.2)
	comprobar(Zonas.id_actual == "plantilla" and j.global_position.z > 2.0, "umbral_cambia_de_entrada", "z=%.2f" % j.global_position.z)
	Zonas.cerrar()
	await _esperar(0.2)
	comprobar(Zonas.actual == null, "zona_cerrada")


# ------------------------------------------------------------------ zonas

var _entradas_por_zona := {}
var _destinos := []        # [zona origen, nombre del umbral, zona destino, entrada destino]


func _zonas() -> void:
	var ids: Array = []
	for z in Zonas.catalogo(true):
		ids.append(z["id"])
	for id in ids:
		await _zona(id)
	await _enlaces(ids)


func _zona(id: String) -> void:
	var meta := Zonas.info(id)
	for clave in ["nombre", "lugar", "momento", "estado_arte"]:
		comprobar(String(meta.get(clave, "")) != "", "%s.zona_json.%s" % [id, clave])
	Juego.nueva_partida()
	Juego.poner_bandera("visita_libre")
	var llego: bool = await Zonas.ir_a(id, "inicio")
	if not comprobar(llego and Zonas.actual != null, "%s.carga" % id):
		return
	var zona: Node3D = Zonas.actual
	var j: CharacterBody3D = Zonas.jugador
	var entradas: Dictionary = zona.entradas
	_entradas_por_zona[id] = entradas.keys()
	comprobar(entradas.has("inicio"), "%s.entrada_inicio" % id)
	var umbrales: Array = []
	for u in get_tree().get_nodes_in_group("umbrales"):
		if zona.is_ancestor_of(u):
			umbrales.append(u)
			_destinos.append([id, String(u.name), u.destino_zona, u.destino_entrada])
	comprobar(not umbrales.is_empty() or zona.has_method("despertar"), "%s.tiene_salida" % id, "la zona no tiene umbrales ni despertar()")
	# cada entrada: suelo firme, sitio despejado y lejos de caer en un umbral
	for nombre in entradas:
		var punto: Dictionary = entradas[nombre]
		j.colocar(punto["pos"] + Vector3(0.0, 0.05, 0.0), punto["mira"])
		await _esperar(0.5)
		var caida: float = absf(j.global_position.y - punto["pos"].y)
		comprobar(j.is_on_floor() and caida < 0.4, "%s.entrada_%s.suelo" % [id, nombre], "en_suelo=%s y=%.2f (pedida %.2f)" % [str(j.is_on_floor()), j.global_position.y, punto["pos"].y])
		var corrida: float = Vector2(j.global_position.x - punto["pos"].x, j.global_position.z - punto["pos"].z).length()
		comprobar(corrida < 0.25, "%s.entrada_%s.despejada" % [id, nombre], "algo la empuja %.2f m" % corrida)
		for u in umbrales:
			var d: float = Vector2(u.global_position.x - punto["pos"].x, u.global_position.z - punto["pos"].z).length()
			if absf(u.global_position.y - punto["pos"].y) < 1.2:
				comprobar(d > u.radio + 0.5, "%s.entrada_%s.lejos_de_%s" % [id, nombre, u.name], "a %.2f m: volveria a cruzar al llegar" % d)
	# cada umbral: tramo despejado de 2 x 2 m alrededor
	for u in umbrales:
		comprobar(_despejado(u.global_position, 0.85), "%s.umbral_%s.despejado" % [id, u.name], "hay colisiones a menos de 0,85 m de la marca")
