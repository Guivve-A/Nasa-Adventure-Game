+extends Node
+
+func _abrir() -> void:
+	await Interfaz.abrir_minijuego("antena", {"dificultad": 1})
+
+func correr(_pruebas: Node) -> void:
+	process_mode = Node.PROCESS_MODE_ALWAYS
+	Juego.modo_prueba = false
+	Juego.sin_guardar = true
+	_abrir()
+	await get_tree().create_timer(0.2).timeout
+	var ventana: Window = get_window()
+	print("DIAG size=", ventana.size, " final=", get_viewport().get_final_transform(), " screen=", get_viewport().get_screen_transform())
+	for metodo in get_viewport().get_method_list():
+		var nombre: String = metodo["name"]
+		if "mouse" in nombre or "input" in nombre:
+			print("METODO ", nombre)
+	var capa: Control = Interfaz.anfitrion.get("_capa")
+	var boton: Button = capa.find_children("*", "Button", true, false)[0]
+	for paso in 3:
+		if paso == 1:
+			ventana.size = Vector2i(1280, 720)
+			await get_tree().process_frame
+		if paso == 2 and get_viewport().has_method("notify_mouse_entered"):
+			get_viewport().call("notify_mouse_entered")
+		var pos: Vector2 = boton.get_global_rect().get_center()
+		var movimiento: InputEventMouseMotion = InputEventMouseMotion.new()
+		movimiento.position = pos
+		movimiento.global_position = pos
+		Input.parse_input_event(movimiento)
+		await get_tree().create_timer(0.1).timeout
+		print("DIAG paso=", paso, " pos=", pos, " raton=", get_viewport().get_mouse_position(), " hover=", get_viewport().gui_get_hovered_control(), " final=", get_viewport().get_final_transform(), " wsize=", ventana.size)
+		for abajo in [true, false]:
+			var clic: InputEventMouseButton = InputEventMouseButton.new()
+			clic.position = pos
+			clic.global_position = pos
+			clic.button_index = MOUSE_BUTTON_LEFT
+			clic.pressed = abajo
+			Input.parse_input_event(clic)
+			await get_tree().create_timer(0.1).timeout
+		var mj: Control = Interfaz.anfitrion.get("_minijuego")
+		print("DIAG activo=", mj.get("activo"))
+		if bool(mj.get("activo")):
+			break
+	Juego.modo_prueba = true
