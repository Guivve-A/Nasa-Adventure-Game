	elif fase == 3:
		_r(36, 49, 208, 22, Estilo.NOCHE)
		_centro("SIN OXIGENO" if oxigeno <= 0 else "TRAJE SIN SELLOS", 55, Estilo.CORAL, 2)


func _hud() -> void:
	_r(0, 0, 280, 18, Estilo.NOCHE)
	_r(0, 17, 280, 1, Estilo.PETROLEO)
	_texto(str(int(puntos)).pad_zeros(4), 3, 3, Estilo.CREMA, 2)
	_texto("O2", 42, 4, Estilo.CIAN)
	_r(54, 3, 59, 10, Estilo.PETROLEO)
	_r(55, 4, 57 * oxigeno / LIMITES[dificultad - 1], 8, Estilo.CORAL if oxigeno < 20 else Estilo.CIAN)
