	oxigeno = maxf(0.0, oxigeno - dt)
	_inmune = maxf(0.0, _inmune - dt)
	_pausa_muestra = maxf(0.0, _pausa_muestra - dt)
	for m in muestras:
		var espera: float = m["espera"]
		m["espera"] = maxf(0.0, espera - dt)
		var p: Vector2 = m["pos"]
		var v: Vector2 = m["v"]
		p += v * dt
		m["pos"] = Vector2(clampf(p.x, 12, 266), clampf(p.y, 28, 108))
