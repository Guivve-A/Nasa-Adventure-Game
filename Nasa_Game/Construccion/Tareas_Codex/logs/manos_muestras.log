dificultad = 1..3
  juego\ARQUITECTURA.md:131:func _empezar() -> void: ...           # el jugador pulsó «Empezar»
  juego\ARQUITECTURA.md:132:func _paso(delta: float) -> void: ...  # cada cuadro mientras activo; usa SIEMPRE delta, 
nunca la hora del sistema
  juego\ARQUITECTURA.md:133:func jugar_solo(acierta: bool) -> void: ...   # OBLIGATORIO: se juega solo y termina 
(superado o no) en menos de 40 s de juego
