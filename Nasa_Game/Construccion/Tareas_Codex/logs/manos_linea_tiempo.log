+extends Node
+
+# Solo observa etiquetas y estado; todas las acciones entran por el viewport.
+var _resultado: Dictionary = {}
+var _devuelto: bool = false
+var _raton: Vector2 = Vector2.ZERO
+
+
+func correr(pruebas: Node) -> void:
+	process_mode = Node.PROCESS_MODE_ALWAYS
+	Juego.modo_prueba = false
+	Juego.sin_guardar = true
+	Juego.minijuegos_solos = false
+	await _teclado(pruebas)
+	await _solo_raton(pruebas)
+	await _salidas(pruebas)
+	pruebas.comprobar(not Interfaz.anfitrion.visible, "linea.manos.anfitrion_cerrado", str(_resultado))
+	pruebas.comprobar(not get_tree().paused, "linea.manos.arbol_sin_pausa", "La apertura debe restaurar la pausa previa.")
+	Juego.modo_prueba = true
+
+
+func _abrir(nivel: int) -> void:
+	_resultado = await Interfaz.abrir_minijuego("linea_tiempo", {"dificultad": nivel})
+	_devuelto = true
+
+
+func _apertura(pruebas: Node, parte: String, nivel: int = 1) -> Control:
+	_devuelto = false
+	_resultado = {}
+	_abrir(nivel)
+	var abierta: bool = await _hasta(func() -> bool: return Interfaz.anfitrion.visible)
+	pruebas.comprobar(abierta, "linea.%s.abre" % parte, "Interfaz.abrir_minijuego en otra corrutina.")
+	await _real(0.12)
+	var mj: Control = Interfaz.anfitrion.get("_minijuego")
+	if mj != null:
+		pruebas.comprobar(int(mj.get("_solo")) == 0 and int(mj.get("_auto")) == 0, "linea.%s.sin_piloto" % parte, "Ni jugar_solo ni llamadas directas al modelo.")
+	return mj
+
+
+func _teclado(pruebas: Node) -> void:
+	var mj: Control = await _apertura(pruebas, "teclado")
+	if mj == null:
+		return
+	await _captura("manos_instrucciones")
+	await _toque(KEY_ENTER)
+	pruebas.comprobar(bool(mj.get("activo")), "linea.teclado.Empezar_Intro", "Foco inicial del anfitrion.")
+	# Todas las alternativas anunciadas, sin tomar la tarjeta.
+	for par in [[KEY_D, 1], [KEY_A, -1], [KEY_RIGHT, 1], [KEY_LEFT, -1], [KEY_S, 1], [KEY_W, -1], [KEY_DOWN, 1], [KEY_UP, -1]]:
+		var antes: int = int(mj.get("seleccion"))
+		await _toque(int(par[0]))
+		pruebas.comprobar(int(mj.get("seleccion")) == antes + int(par[1]), "linea.teclado.elegir_%s" % OS.get_keycode_string(int(par[0])), str(mj.get("seleccion")))
+	for tecla in [KEY_E, KEY_ENTER]:
+		await _toque(tecla)
+		pruebas.comprobar(bool(mj.get("tomada")), "linea.teclado.tomar_%s" % OS.get_keycode_string(tecla), "No requiere foco en un boton.")
+		for par in [[KEY_D, 1], [KEY_A, -1], [KEY_RIGHT, 1], [KEY_LEFT, -1]]:
+			var titulos: Array = mj.get("_titulos")
+			var antes: int = int(mj.get("seleccion"))
+			var titulo: String = titulos[antes].text
+			await _toque(int(par[0]))
+			pruebas.comprobar(int(mj.get("seleccion")) == antes + int(par[1]) and titulos[antes + int(par[1])].text == titulo, "linea.teclado.mover_%s_con_%s" % [OS.get_keycode_string(int(par[0])), OS.get_keycode_string(tecla)], titulo)
+		await _toque(tecla)
+		pruebas.comprobar(not bool(mj.get("tomada")), "linea.teclado.soltar_%s" % OS.get_keycode_string(tecla), "La tarjeta queda colocada.")
+	pruebas.comprobar(int(mj.get("comprobaciones")) == 0, "linea.teclado.mover_no_gasta", str(mj.get("comprobaciones")))
+	await _toque(KEY_SPACE)
+	pruebas.comprobar(int(mj.get("comprobaciones")) == 1 and bool(mj.get("activo")), "linea.teclado.Comprobar_Espacio", "La primera comprobacion ofrece pistas, no derrota.")
+	await _resolver(mj, false, pruebas)
+	_comprobar_lienzo(pruebas, mj, "teclado_d1")
+	await _captura("manos_teclado")
+	await _toque(KEY_SPACE)
+	await _victoria(pruebas, "teclado")
+	await _captura("manos_resultado")
+	await _toque(KEY_ENTER)
+	await _cierre(pruebas, "teclado.Continuar_Intro")
+
+
+func _solo_raton(pruebas: Node) -> void:
+	var mj: Control = await _apertura(pruebas, "raton")
+	if mj == null:
+		return
+	await _clic(_boton_capa("Empezar"))
+	pruebas.comprobar(bool(mj.get("activo")), "linea.raton.Empezar", "Clic en el anfitrion real.")
+	var paneles: Array = mj.get("_paneles")
+	var titulos: Array = mj.get("_titulos")
+	var primero: String = titulos[0].text
+	# Prueba tomar, cruzar varios huecos y soltar, y luego deshace con raton.
+	await _mover(paneles[0].get_global_rect().get_center())
+	_boton_raton(true)
+	await _real(0.06)
+	pruebas.comprobar(bool(mj.get("tomada")), "linea.raton.tomar", "Clic izquierdo sobre la tarjeta.")
+	await _mover(paneles[2].get_global_rect().get_center(), true)
+	pruebas.comprobar(titulos[2].text == primero and int(mj.get("seleccion")) == 2, "linea.raton.arrastrar_derecha_varios_huecos", str(mj.get("orden")))
+	_boton_raton(false)
+	await _real(0.06)
+	pruebas.comprobar(not bool(mj.get("tomada")) and not bool(mj.get("_arrastrando")), "linea.raton.soltar", "Liberar el boton coloca la tarjeta.")
+	await _arrastrar(paneles[2], paneles[0])
+	pruebas.comprobar(titulos[0].text == primero, "linea.raton.arrastrar_izquierda", str(mj.get("orden")))
+	var comprobar: Button = mj.get("_comprobar_boton")
+	await _clic(comprobar)
+	pruebas.comprobar(int(mj.get("comprobaciones")) == 1 and bool(mj.get("activo")), "linea.raton.Comprobar", "Boton independiente del foco.")
+	await _resolver(mj, true, pruebas)
+	_comprobar_lienzo(pruebas, mj, "raton_d1")
+	await _captura("manos_raton")
+	await _clic(comprobar)
+	await _victoria(pruebas, "raton")
+	await _clic(_boton_capa("Continuar"))
+	await _cierre(pruebas, "raton.Continuar_clic")
+
+
+func _resolver(mj: Control, raton: bool, pruebas: Node) -> void:
+	# Lee la pista ampliada de cada tarjeta, como al seleccionarla en pantalla.
+	# No consulta HITOS, indices cronologicos ni fechas ocultas para decidir.
+	var titulos: Array = mj.get("_titulos")
+	var paneles: Array = mj.get("_paneles")
+	var pista_usada: bool = false
+	for pasada in 3:
+		var movidas: int = 0
+		for i in titulos.size():
+			if raton:
+				await _clic(paneles[i])
+			else:
+				await _elegir(mj, i)
+			var detalle: Label = mj.get("_detalle")
+			var inicio: int = detalle.text.find("Va después de «")
+			if inicio < 0:
+				continue
+			pista_usada = true
+			var nombre: String = detalle.text.substr(inicio + "Va después de «".length()).get_slice("»", 0)
+			var anterior: int = -1
+			for j in titulos.size():
+				if titulos[j].text == nombre:
+					anterior = j
+			if anterior < 0:
+				continue
+			var destino: int = anterior if i < anterior else anterior + 1
+			if destino == i:
+				continue
+			if raton:
+				await _arrastrar(paneles[i], paneles[destino])
+			else:
+				await _toque(KEY_E)
+				for paso in absi(destino - i):
+					await _toque(KEY_A if destino < i else KEY_D)
+				await _toque(KEY_ENTER)
+			movidas += 1
+		if movidas == 0:
+			break
+	pruebas.comprobar(pista_usada, "linea.%s.resuelve_leyendo_pistas_visibles" % ("raton" if raton else "teclado"), "Sin conocer los numeros y sin escribir el estado.")
+
+
+func _elegir(mj: Control, destino: int) -> void:
+	for intento in 12:
+		var seleccion: int = int(mj.get("seleccion"))
+		if seleccion == destino:
+			return
+		await _toque(KEY_RIGHT if destino > seleccion else KEY_LEFT)
+
+
+func _victoria(pruebas: Node, parte: String) -> void:
+	var aparece: bool = await _hasta(func() -> bool: return _boton_capa("Continuar") != null)
+	var resultado: Dictionary = Interfaz.anfitrion.get("_resultado")
+	pruebas.comprobar(aparece and bool(resultado.get("superado", false)), "linea.%s.ganado" % parte, str(resultado))
+
+
+func _cierre(pruebas: Node, parte: String) -> void:
+	var cerrado: bool = await _hasta(func() -> bool: return _devuelto and not Interfaz.anfitrion.visible)
+	pruebas.comprobar(cerrado, "linea.%s.anfitrion_cerrado" % parte, str(_resultado))
+	pruebas.comprobar(not get_tree().paused, "linea.%s.sin_pausa" % parte, "Devuelve el control al juego.")
+
+
+func _salidas(pruebas: Node) -> void:
+	for fase in ["instrucciones", "jugando", "tomada", "arrastrando", "resultado"]:
+		var mj: Control = await _apertura(pruebas, "Esc_" + fase)
+		if mj == null:
+			return
+		if fase != "instrucciones":
+			await _toque(KEY_ENTER)
+		if fase == "tomada":
+			await _toque(KEY_E)
+		if fase == "arrastrando":
+			var paneles: Array = mj.get("_paneles")
+			await _mover(paneles[0].get_global_rect().get_center())
+			_boton_raton(true)
+			await _real(0.05)
+		if fase == "resultado":
+			await _toque(KEY_SPACE)
+			await _resolver(mj, false, pruebas)
+			await _toque(KEY_SPACE)
+			await _victoria(pruebas, "Esc_resultado")
+		await _toque(KEY_ESCAPE)
+		if fase == "arrastrando":
+			_boton_raton(false)
+		await _cierre(pruebas, "Esc_" + fase)
+	# El mayor numero de tarjetas tambien debe caber, sin tocar sus reglas.
+	var mayor: Control = await _apertura(pruebas, "lienzo_d3", 3)
+	if mayor != null:
+		await _toque(KEY_ENTER)
+		await _toque(KEY_SPACE)
+		for i in 9:
+			await _elegir(mayor, i)
+			_comprobar_lienzo(pruebas, mayor, "d3_tarjeta_%d" % i)
+		await _captura("manos_nivel3")
+		await _clic(Interfaz.anfitrion.get("_salir"))
+		await _cierre(pruebas, "Salir_clic")
+
+
+func _comprobar_lienzo(pruebas: Node, mj: Control, parte: String) -> void:
+	var lienzo: Rect2 = Rect2(Vector2.ZERO, Vector2(1120, 520))
+	var fuera: Array[String] = []
+	for nodo in mj.get_children():
+		if nodo is Control and nodo.visible and not lienzo.encloses(Rect2(nodo.position, nodo.size)):
+			fuera.append("%s: %s" % [nodo.name, str(Rect2(nodo.position, nodo.size))])
+	pruebas.comprobar(fuera.is_empty(), "linea.%s.todo_dentro_1120x520" % parte, "; ".join(fuera))
+
+
+func _boton_capa(nombre: String) -> Button:
+	var capa: Control = Interfaz.anfitrion.get("_capa")
+	if not capa.visible:
+		return null
+	for nodo in capa.find_children("*", "Button", true, false):
+		if nodo.text == nombre:
+			return nodo as Button
+	return null
+
+
+func _tecla(codigo: int, abajo: bool) -> void:
+	var evento: InputEventKey = InputEventKey.new()
+	evento.physical_keycode = codigo
+	evento.keycode = codigo
+	evento.pressed = abajo
+	Input.parse_input_event(evento)
+
+
+func _toque(codigo: int) -> void:
+	_tecla(codigo, true)
+	await get_tree().process_frame
+	await get_tree().physics_frame
+	await get_tree().process_frame
+	_tecla(codigo, false)
+	await _real(0.04)
+
+
+func _mover(posicion: Vector2, arrastrando: bool = false) -> void:
+	# Ventana y lienzo difieren tambien en headless (ventana de 64 x 64).
+	var transformacion: Transform2D = get_viewport().get_final_transform()
+	var evento: InputEventMouseMotion = InputEventMouseMotion.new()
+	evento.position = transformacion * posicion
+	evento.global_position = evento.position
+	evento.relative = transformacion * posicion - transformacion * _raton
+	evento.button_mask = MOUSE_BUTTON_MASK_LEFT if arrastrando else 0
+	_raton = posicion
+	Input.parse_input_event(evento)
+	await get_tree().process_frame
+
+
+func _boton_raton(abajo: bool) -> void:
+	var evento: InputEventMouseButton = InputEventMouseButton.new()
+	evento.button_index = MOUSE_BUTTON_LEFT
+	evento.button_mask = MOUSE_BUTTON_MASK_LEFT if abajo else 0
+	evento.position = get_viewport().get_final_transform() * _raton
+	evento.global_position = evento.position
+	evento.pressed = abajo
+	Input.parse_input_event(evento)
+
+
+func _clic(control: Control) -> void:
+	if control == null:
+		return
+	await _mover(control.get_global_rect().get_center())
+	_boton_raton(true)
+	await _real(0.05)
+	_boton_raton(false)
+	await _real(0.08)
+
+
+func _arrastrar(origen: Control, destino: Control) -> void:
+	await _mover(origen.get_global_rect().get_center())
+	_boton_raton(true)
+	await _real(0.05)
+	await _mover(destino.get_global_rect().get_center(), true)
+	_boton_raton(false)
+	await _real(0.08)
+
+
+func _hasta(condicion: Callable) -> bool:
+	var limite: int = Time.get_ticks_msec() + 3000
+	while not bool(condicion.call()) and Time.get_ticks_msec() < limite:
+		await get_tree().process_frame
+	return bool(condicion.call())
+
+
+func _real(segundos: float) -> void:
+	await get_tree().create_timer(segundos, true, false, true).timeout
+
+
+func _captura(nombre: String) -> void:
+	if Juego.args.has("capturas_manos") and DisplayServer.get_name() != "headless":
+		await Interfaz.capturar(ProjectSettings.globalize_path("res://../Nasa_Game/Construccion/Minijuegos/linea_tiempo/" + nombre + ".png"))

