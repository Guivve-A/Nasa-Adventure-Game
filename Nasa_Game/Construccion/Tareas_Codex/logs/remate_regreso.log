---
name: improve-existing-game
description: Understand and extend an existing game repository, feature, scene, or mechanic with minimal justified changes and regression checks.
---

# Improve Existing Game


1. Inspect project and engine version, run instructions, build baseline, scenes and source ownership; do not replace the whole project with a fresh scaffold.
2. Identify exact requested behavior and relevant scenes/scripts/assets. Specify expected observable acceptance criteria before editing.
3. Create the smallest change compatible with current architecture. Preserve save files, user data, asset licenses, input mappings and unrelated styling.
4. Run original tests and a focused regression test for the change, plus one smoke test in the relevant level or scene when tools permit.
5. If existing implementation is broken, distinguish pre-existing failures from introduced ones; avoid claiming the entire game passes if only isolated checks ran.
6. Deliver diff summary, changed files, evidence, remaining risks, and reversible instructions.

## Execution truth and safeguards
- A skill is an instruction workflow, not a remotely running game engine or a separately running AI agent. Inspect tools and repo state before claiming execution.
- Preserve existing projects, names, dependencies, save formats, and user work unless a change is explicitly requested. Obtain approval for deployment, payments, destructive edits, publication, and major third-party connections.
- Avoid reproducing protected commercial characters, levels, dialogue, soundtracks, logos, or copyrighted assets unless authorized. For assets, record origin and license. Read `../../references/security-and-rights.md`.
- Report what was implemented, what was actually run, what failed, and what remains unverified; never describe proposed tests as passed.
---
name: playtest-optimize
description: Verify gameplay, usability, performance, bugs, and game feel through measured playtests and reproducible evidence.
---

# Playtest Optimize


1. Read `../../references/testing-and-evidence.md` and choose checks for actual platform and engine. Distinguish compile success, scene launch, interactive playtest and full release qualification.
2. Run real build/import tests, then verify player input, menu, progression, collision, score, win/lose, restart, save/load, pause, resize and asset/audio loading as relevant.
3. For 3D, review camera occlusion, clipping, collision/navigability, visual readability and frame performance under representative load.
4. Collect evidence with timestamps in logs or test artifacts as appropriate; no invented screenshots, benchmark frames or 'playtested' claims.
5. Profile performance before optimizing; prioritize frame-time spikes, asset bloat, overdraw, expensive physics and leaks. Report device/browser/hardware conditions for measurements.
6. Evaluate subjective fun and difficulty through actual human players; automated agents can assess controls and pacing proxies, not certify fun.
7. Apply a bounded fix-and-retest loop; fail the gate when essential mechanics are unverified or broken.

## Execution truth and safeguards
- A skill is an instruction workflow, not a remotely running game engine or a separately running AI agent. Inspect tools and repo state before claiming execution.
- Preserve existing projects, names, dependencies, save formats, and user work unless a change is explicitly requested. Obtain approval for deployment, payments, destructive edits, publication, and major third-party connections.
- Avoid reproducing protected commercial characters, levels, dialogue, soundtracks, logos, or copyrighted assets unless authorized. For assets, record origin and license. Read `../../references/security-and-rights.md`.
- Report what was implemented, what was actually run, what failed, and what remains unverified; never describe proposed tests as passed.
extends Node

# Pruebas del carril: orden, entradas y umbrales del modelo compartido con el piloto.
const Regreso := preload("res://minijuegos/regreso/regreso.gd")


func _crear(d: int = 1) -> Control:
	var m: Control = Regreso.new()
	add_child(m)
	m.preparar({"dificultad": d}, Juego.info_minijuego("regreso"))
	m.empezar()
	m.set_process(false)
	return m


func _tecla(m: Control, accion: String) -> void:
	var evento: InputEventAction = InputEventAction.new()
	evento.action = accion
	evento.pressed = true
	m._input(evento)


func _correr(m: Control, dt: float = 1.0 / 60.0) -> Dictionary:
	var resultado: Dictionary = {}
	m.terminado.connect(func(r: Dictionary): resultado.merge(r))
	while m.activo and m.tiempo < 39.0:
		m.tiempo += dt
		m._paso(dt)
	return resultado


func correr(p: Node) -> void:
	var m: Control = _crear()
	_tecla(m, "interactuar")
	_tecla(m, "mover_abajo")
	p.comprobar(m.orden[0] == 0 and m.orden[1] == 1 and m.seleccion == 1, "regreso.teclado_toma_y_mueve")
	_tecla(m, "interactuar")
	_tecla(m, "mover_abajo")
	p.comprobar(m.seleccion == 2 and m.orden[2] == 2, "regreso.teclado_suelta_y_selecciona")
	# Arrastra paracaidas debajo de la reentrada por el mismo gui_input del lienzo.
	var clic: InputEventMouseButton = InputEventMouseButton.new()
	clic.button_index = MOUSE_BUTTON_LEFT
	clic.pressed = true
	clic.position = m._rect_tarjeta(3).get_center()
	m._gui_input(clic)
	var arrastre: InputEventMouseMotion = InputEventMouseMotion.new()
	arrastre.button_mask = MOUSE_BUTTON_MASK_LEFT
	arrastre.position = m._rect_tarjeta(4).get_center()
	m._gui_input(arrastre)
	clic.pressed = false
	clic.position = arrastre.position
	m._gui_input(clic)
	p.comprobar(m.orden == [0, 1, 2, 3, 4, 5] and not m.tomada, "regreso.raton_arrastra_y_suelta")
	m._boton.pressed.emit()
	p.comprobar(m.fase == 1 and m.comprobaciones == 1, "regreso.boton_comprobar_inicia_reentrada")
	m._pulsar_giro(-1.0)
	m._paso(0.5)
	p.comprobar(m.giro < 0.0 and m.angulo < 6.0, "regreso.raton_corrige_con_fisica")
	var previo: float = m.giro
	m._soltar_giro()
	m._paso(0.01)
	p.comprobar(m._raton == 0.0 and m.giro < 0.0 and absf(m.giro - previo) < 3.0, "regreso.soltar_conserva_inercia")
	m.free()
	# Cualquier par consecutivo invertido produce una causa propia.
	for i in 5:
		m = _crear()
		m.orden.assign([0, 1, 2, 3, 4, 5])
		m.seleccion = i
		m._mover(1)
		var r: Dictionary = {}
		m.terminado.connect(func(dato: Dictionary): r.merge(dato))
		_tecla(m, "saltar")
		p.comprobar(not m.activo and not r.get("superado", true) and r.get("detalle", "") == m.CAUSAS[i], "regreso.par_%d_causa_real" % i)
		m.free()
	# Los tres niveles, con pasos normales y cuadros largos del reloj acelerado.
	for d in [1, 2, 3]:
		for dt in [1.0 / 60.0, 0.2]:
			m = _crear(d)
			m.jugar_solo(true)
			var resultado: Dictionary = _correr(m, dt)
			p.comprobar(resultado.get("superado", false) and m.tiempo < 40.0 and m.vuelo >= 20.0 and m.dentro >= 16.0 and m.calor < 100.0, "regreso.piloto_d%d_dt%.3f" % [d, dt])
			print("REGRESO_QA d%d dt=%.3f total=%.3f dentro=%.3f calor=%.2f" % [d, dt, m.tiempo, m.dentro, m.calor])
			m.free()
		m = _crear(d)
		m.jugar_solo(false)
		var fallo: Dictionary = _correr(m)
		p.comprobar(not fallo.get("superado", true) and m.calor >= 100.0 and m.vuelo < 20.0 and m.tiempo < 40.0, "regreso.piloto_falla_por_calor_d%d" % d)
		m.free()
	m = _crear()
	p.comprobar(m._anterior.size() > 2 and m._dato_anterior.contains("calor 100"), "regreso.intento_previo_persistente")
	m.orden.assign([0, 1, 2, 3, 4, 5])
	m._comprobar()
	m.calor = 99.9
	m.angulo = m.margen + 2.0
	m._integrar(0.1, 0.0)
	p.comprobar(not m.activo and m.calor == 100.0, "regreso.umbral_calor_100")
	m.free()
	m = _crear()
	m.orden.assign([0, 1, 2, 3, 4, 5])
	m._comprobar()
	m.vuelo = 19.999
	m.dentro = 15.0
	m.angulo = 0.0
	m._integrar(0.01, 0.0)
	p.comprobar(not m.activo and m.fase == 1, "regreso.exige_16_s_dentro")
	m.free()
	m = _crear()
	m.tiempo = 150.0
	m._paso(0.01)
	p.comprobar(not m.activo, "regreso.limite_orden_150_s")
	m.free()
	# La simulacion sincronica acumula voces: deja acabar el audio antes de cerrar.
	await get_tree().create_timer(0.3, true, false, true).timeout
			paracaidas -= 1
			_t_tela = 0.8
			_sacudida = 0.25
			sonar("error")
			_rasgados.append([cap_x - 5.0, Y_CAP - 18.0, _fx.randf_range(-14.0, 14.0), -70.0])
			if paracaidas <= 0:
				_perder(CAUSA_PRONTO, "caida")
		else:
			_abrir_paracaidas()
	elif prof > franja_fin + 4.0:
		_perder(CAUSA_TARDE, "caida")


func _abrir_paracaidas() -> void:
	abiertos = paracaidas
	_prof_abrio = prof
	_alt_abrio = _y_altimetro()
	mar_prof = prof + DIST_MAR
	var lejos: float = _azar.randf_range(_nivel(45.0, 55.0, 65.0), _nivel(85.0, 100.0, 115.0))
	var lado: float = 1.0 if _azar.randf() < 0.5 else -1.0
	diana_x = cap_x + lado * lejos
	if diana_x < 36.0 or diana_x > CAMPO - 36.0:
		diana_x = cap_x - lado * lejos
	diana_x = clampf(diana_x, 36.0, CAMPO - 36.0)
	_viento_dir = 1.0 if _azar.randf() < 0.5 else -1.0
	puntos += 100.0 * abiertos
	_a_fase(PARACAIDAS)
	_sacudida = 0.2
	_destellar(Estilo.PAPEL, 0.45)
	sonar("salto")
	_estallar(cap_x, Y_CAP - 12.0, 10, Estilo.PAPEL, 30.0)


func _tic_paracaidas(dt: float) -> void:
	vuelo += dt
	velocidad = move_toward(velocidad, V_PARACAIDAS[abiertos], 90.0 * dt)
	prof += velocidad * dt
	viento = _viento_max * _viento_dir * (0.55 + 0.45 * sin(0.8 * _t_fase + _f1))
	cap_vx += (clampf(mando_x, -1.0, 1.0) * EMPUJE + viento - ROCE_PARACAIDAS * cap_vx) * dt
	_mover_x(dt)
	# colgada de las telas, la capsula se endereza sola y se mece
	angulo = lerpf(angulo, clampf(cap_vx * 0.4, -20.0, 20.0), minf(6.0 * dt, 1.0))
	giro = 0.0
	calor = maxf(calor - 12.0 * dt, 0.0)
	if prof >= mar_prof - 6.0:
		prof = mar_prof - 6.0
		var lejos: float = absf(cap_x - diana_x)
		_estallar(cap_x, _y_capsula() + 5.0, 22, Estilo.PAPEL, 45.0)
		if lejos <= diana_medio:
			puntos += 100.0 + 300.0 * (1.0 - lejos / diana_medio)
			_a_fase(AMERIZADO)
			_destellar(Estilo.PAPEL, 0.4)
			sonar("logro")
		else:
			_sacudida = 0.3
			_perder(CAUSA_FUERA, "fuera")


func _perder(causa: String, tipo: String) -> void:
	_causa = causa
	_tipo_perdida = tipo
	_a_fase(PERDIDO)
	_sacudida = maxf(_sacudida, 0.4)
	if tipo == "calor":
		_destellar(Estilo.CORAL, 0.7)
		_estallar(cap_x, Y_CAP, 30, Estilo.CORAL, 70.0)


# ------------------------------------------------------------------ piloto de las pruebas

func _piloto() -> void:
	# juega con las mismas reglas: solo escribe mando_x, mando_abajo y _pulso, como las teclas
	mando_x = 0.0
	mando_abajo = false
	if fase == INTRO:
		_pulso = _t_fase > 0.2
		return
	if _auto < 0:
		# gira sin soltar: el escudo queda de lado y el calor sube
		mando_x = 1.0
		return
	if fase == REENTRADA:
		var destino: float = _carril_libre()
		var inclinacion: float = clampf((destino - cap_x) * 0.9 - cap_vx * 0.8, -margen * 0.72, margen * 0.72)
		mando_x = _mando_giro(inclinacion)
		var despejado: bool = absf(destino - cap_x) < 3.0
		for b in bolsas:
			if bool(b["viva"]) and Y_CAP + float(b["prof"]) - prof > Y_CAP - 14.0 and absf(float(b["x"]) - cap_x) < float(b["r"]) + 22.0:
				despejado = false
		if calor > 50.0:
			_picada_ok = false
		elif calor < 28.0:
			_picada_ok = true
		mando_abajo = despejado and _picada_ok and absf(angulo) < margen * 0.6 and prof < LARGO - 30.0
	elif fase == FRANJA:
		mando_x = _mando_giro(clampf(-cap_vx * 0.8, -margen * 0.5, margen * 0.5))
		if prof >= franja_ini + 4.0:
			_pulso = true
	elif fase == PARACAIDAS:
		var falta: float = (diana_x - cap_x) - cap_vx * 0.6
		mando_x = signf(falta) if absf(falta) > 1.5 else 0.0


func _mando_giro(objetivo: float) -> float:
	# pulsos de tecla: frena antes de llegar, porque la capsula conserva el giro
	var falta: float = (objetivo - angulo) - giro * 0.16
	return signf(falta) if absf(falta) > 1.5 else 0.0


func _carril_libre() -> float:
	var mejor: float = cap_x
	var costo_mejor: float = _costo_carril(cap_x)
	var c: float = X_MIN + 8.0
	while c <= X_MAX - 8.0:
		var costo: float = _costo_carril(c)
		if costo < costo_mejor - 0.01:
			costo_mejor = costo
			mejor = c
		c += 4.0
	return mejor


func _costo_carril(c: float) -> float:
	var costo: float = absf(c - cap_x) + absf(c - 131.0) * 0.05
	for b in bolsas:
		if not bool(b["viva"]):
			continue
		var r: float = b["r"]
		var by: float = Y_CAP + float(b["prof"]) - prof
		if by < Y_CAP - r - 6.0:
			continue
		var llegada: float = maxf(by - Y_CAP, 0.0) / maxf(velocidad, 1.0)
		var bx: float = float(b["x"]) + float(b["vx"]) * llegada
		var holgura: float = minf(absf(bx - c), absf(float(b["x"]) - c)) - (r + 11.0)
		if holgura < 0.0:
			costo += 300.0 + 6000.0 / (by - Y_CAP + r + 30.0) - holgura * 4.0
	return costo


# ------------------------------------------------------------------ efectos

func _destellar(color: Color, fuerza: float) -> void:
	_destello = fuerza
	_destello_color = color


func _estallar(x: float, y: float, cuantas: int, color: Color, fuerza: float) -> void:
	for i in cuantas:
		var a: float = _fx.randf_range(0.0, TAU)
		var v: float = _fx.randf_range(fuerza * 0.3, fuerza)
		_chispa(x, y, cos(a) * v, sin(a) * v, _fx.randf_range(0.35, 0.8), color)


func _chispa(x: float, y: float, vx: float, vy: float, vida: float, color: Color) -> void:
	if _chispas.size() < 110:
		_chispas.append([x, y, vx, vy, vida, vida, color])


func _tic_efectos(dt: float) -> void:
	_inmune = maxf(_inmune - dt, 0.0)
	_t_tela = maxf(_t_tela - dt, 0.0)
	_destello = maxf(_destello - dt * 1.6, 0.0)
	if _sacudida > 0.0:
		_sacudida = maxf(_sacudida - dt, 0.0)
		_desvio = Vector2(roundf(_fx.randf_range(-1.6, 1.6)), roundf(_fx.randf_range(-1.6, 1.6))) if _sacudida > 0.0 else Vector2.ZERO
	var cy: float = _y_capsula()
	if fase == REENTRADA:
		# estela: el aire caliente queda arriba, porque la capsula cae
		var lado: float = -6.0 if _fx.randf() < 0.5 else 6.0
		_chispa(cap_x + lado + _fx.randf_range(-1.0, 1.0), cy + 1.0, _fx.randf_range(-4.0, 4.0), -velocidad * 1.3, 0.35, Estilo.NARANJA if calor < 60.0 else Estilo.CORAL)
		if mando_abajo:
			_chispa(cap_x + _fx.randf_range(-5.0, 5.0), cy + 6.0, _fx.randf_range(-10.0, 10.0), -velocidad * 1.6, 0.3, Estilo.DORADO)
