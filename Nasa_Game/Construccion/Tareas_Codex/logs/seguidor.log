	{"ficha": "disco_apolo11", "titulo": "Disco del Apolo 11", "fecha": "1969", "epoca": "Mensajes rumbo a la Luna.", "dato": "LlevÃ³ mensajes de 73 paÃ­ses, incluido Ecuador."},
	{"ficha": "apolo_soyuz_1975", "titulo": "Apoyo al Apolo-Soyuz", "fecha": "1975", "epoca": "DespuÃ©s del viaje del disco.", "dato": "Quito participÃ³ con el indicativo QUI en la red de apoyo."},
	{"ficha": "sts2_despedida", "titulo": "Despedida del STS-2", "fecha": "14-11-1981", "epoca": "El cierre de la estaciÃ³n.", "dato": "Engle y Truly se despidieron de 75 empleados."},
