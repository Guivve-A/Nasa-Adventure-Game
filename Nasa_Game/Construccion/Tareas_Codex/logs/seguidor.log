	{"ficha": "exa_2007", "titulo": "Nace la EXA", "fecha": "2007", "epoca": "Comienzos del siglo XXI.", "dato": "OrganizaciÃ³n no gubernamental sin fines de lucro."},
	{"ficha": "pegaso_lanzamiento", "titulo": "Lanzamiento de Pegaso", "fecha": "2013", "epoca": "DespuÃ©s del nacimiento de EXA.", "dato": "Se lanzÃ³ desde Jiuquan, segÃºn el equipo de Pegaso."},
	{"ficha": "acuerdos_artemisa", "titulo": "Acuerdos Artemisa", "fecha": "21-06-2023", "epoca": "DespuÃ©s de Pegaso.", "dato": "Ecuador fue el paÃ­s firmante n.Âº 26."}
]
