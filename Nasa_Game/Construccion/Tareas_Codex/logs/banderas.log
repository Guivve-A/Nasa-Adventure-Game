extends Control

# Base de todo minijuego. Cada uno vive en res://minijuegos/<id>/<id>.gd, empieza con
#   extends "res://nucleo/minijuego.gd"
# y tiene al lado su minijuego.json (titulo, instrucciones, controles, pistas y ficha del cuaderno).
#
# El anfitrion (interfaz/anfitrion.gd) pone el marco, el titulo, las instrucciones, las pistas de Orbita y la
# pantalla de resultado. El minijuego solo dibuja y juega dentro de su lienzo.
#
# Contrato:
#   _preparar()      arma los nodos y el estado inicial. El lienzo ya mide LIENZO (1120 x 520 px): usa "size".
#   _empezar()       el jugador pulso «Empezar»: arranca el juego.
#   _paso(delta)     se llama en cada cuadro mientras "activo" es true. Usa SIEMPRE delta para el tiempo
#                    (las pruebas aceleran el reloj); nunca la hora del sistema.
#   terminar(superado, puntos, detalle)   cierra la partida. "detalle" explica la causa en una frase:
#                    nunca «incorrecto», siempre el porque (regla de Orbita).
#   jugar_solo(acierta)   OBLIGATORIO para las pruebas: hace que el minijuego se juegue solo y termine,
#                    superado si acierta = true y no superado si es false, en menos de 40 s de juego.
#
# Dificultad: parametros.get("dificultad", 1) va de 1 (primera vez en la historia) a 3.
# Entradas: teclado (acciones mover_*, interactuar, saltar) y raton; todo lo que se pueda hacer con el raton
# debe poder hacerse tambien con el teclado.

signal terminado(resultado: Dictionary)

const Estilo := preload("res://interfaz/estilo.gd")
const LIENZO := Vector2(1120, 520)

var parametros: Dictionary = {}
var meta: Dictionary = {}       # contenido de minijuego.json
var activo := false
var tiempo := 0.0               # segundos de juego desde _empezar()
var dificultad := 1
var _solo := 0                  # 0 = juega la persona; 1 = solo y acierta; -1 = solo y falla


func preparar(p: Dictionary, m: Dictionary) -> void:
	parametros = p
	meta = m
	dificultad = clampi(int(p.get("dificultad", 1)), 1, 3)
	custom_minimum_size = LIENZO
	size = LIENZO
	clip_contents = true
	focus_mode = Control.FOCUS_ALL
	_preparar()


func empezar() -> void:
	activo = true
	tiempo = 0.0
	grab_focus()
	_empezar()
	if _solo != 0:
		jugar_solo(_solo > 0)


func terminar(superado: bool, puntos: float = 0.0, detalle: String = "") -> void:
	if not activo:
		return
	activo = false
	terminado.emit({"superado": superado, "puntos": puntos, "detalle": detalle, "tiempo": tiempo})


func _process(delta: float) -> void:
	if activo:
		tiempo += delta
		_paso(delta)


# ------------------------------------------------------------------ para sobrescribir

func _preparar() -> void:
	pass


func _empezar() -> void:
	pass


func _paso(_delta: float) -> void:
	pass


func jugar_solo(_acierta: bool) -> void:
	# cada minijuego lo implementa; por defecto termina sin jugar para que la prueba lo delate
	terminar(false, 0.0, "Este minijuego todavía no sabe jugarse solo.")


# ------------------------------------------------------------------ utilidades

func eje_x() -> float:
	# -1..1 con izquierda y derecha (teclado o mando)
	return Input.get_axis("mover_izquierda", "mover_derecha")


func eje_y() -> float:
	# -1..1 con abajo y arriba (arriba = +1)
	return Input.get_axis("mover_abajo", "mover_arriba")


func texto(contenido: String, tam: int = 20, color: Color = Estilo.TINTA, peso: int = 500) -> Label:
	return Estilo.texto(contenido, tam, color, peso)


func sonar(nombre: String) -> void:
	Audio.sonar(nombre)
extends Control

# Anfitrion de minijuegos: pone el marco comun (titulo, instrucciones, controles, pistas de Orbita y resultado)
# alrededor de cualquier minijuego de res://minijuegos/<id>/. Asi todos se presentan igual.
#
# minijuego.json:
#   {"titulo": "...", "resumen": "una frase", "instrucciones": ["paso 1", "paso 2"], "controles": "texto",
#    "pistas": ["mirada", "frase", "respuesta"], "ficha": "id_de_ficha", "orden": 1, "escena": "1.2"}

signal _boton(accion: String)

const Estilo := preload("res://interfaz/estilo.gd")
const LIENZO := Vector2(1120, 520)

var _marco: PanelContainer
var _titulo: Label
var _controles: Label
var _hueco: Control
var _capa: PanelContainer
var _capa_columna: VBoxContainer
var _salir: Button
var _minijuego: Control = null
var _resultado: Dictionary = {}
var _pendiente := false
var _pista := 0


func _ready() -> void:
	set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	visible = false
	var velo := ColorRect.new()
	velo.color = Color(Estilo.NOCHE, 0.93)
	velo.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	add_child(velo)

	_marco = Estilo.panel(Estilo.PAPEL, 16, 4, 16)
	add_child(_marco)
	var columna := VBoxContainer.new()
	columna.add_theme_constant_override("separation", 8)
	_marco.add_child(columna)
	var cabecera := HBoxContainer.new()
	_titulo = Estilo.texto("", 28, Estilo.TINTA, 700)
	_titulo.autowrap_mode = TextServer.AUTOWRAP_OFF
	_titulo.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	cabecera.add_child(_titulo)
	_salir = Estilo.boton("Salir (Esc)", 16)
	_salir.custom_minimum_size = Vector2(130, 36)
	_salir.focus_mode = Control.FOCUS_NONE
	_salir.pressed.connect(_abandonar)
	cabecera.add_child(_salir)
	columna.add_child(cabecera)
	var fondo_lienzo := Estilo.panel(Color("fbf3df"), 8, 2, 0)
	_hueco = Control.new()
	_hueco.custom_minimum_size = LIENZO
	_hueco.clip_contents = true
	fondo_lienzo.add_child(_hueco)
	columna.add_child(fondo_lienzo)
	_controles = Estilo.texto("", 16, Estilo.TINTA_SUAVE, 500)
	_controles.custom_minimum_size = Vector2(LIENZO.x, 0)
	columna.add_child(_controles)

	_capa = Estilo.panel(Color(Estilo.PAPEL, 0.98), 16, 4, 26)
	_capa.custom_minimum_size = Vector2(720, 0)
	_capa_columna = VBoxContainer.new()
	_capa_columna.add_theme_constant_override("separation", 12)
	_capa.add_child(_capa_columna)
	_capa.visible = false
	add_child(_capa)


func _process(_delta: float) -> void:
	if not visible:
		return
	_capa.reset_size()
	_marco.position = (size - _marco.size) * 0.5
	_capa.position = (size - _capa.size) * 0.5


func _unhandled_input(evento: InputEvent) -> void:
	if visible and _minijuego != null and evento.is_action_pressed("pausa"):
		get_viewport().set_input_as_handled()
		_abandonar()


func _abandonar() -> void:
	if _minijuego != null and _minijuego.get("activo"):
		_minijuego.set("activo", false)
		_resultado = {"superado": false, "abandonado": true, "puntos": 0.0, "detalle": ""}
		_pendiente = false
	elif _capa.visible:
		_boton.emit("salir")


func _al_terminar(resultado: Dictionary) -> void:
	_resultado = resultado
	_pendiente = false


func _llenar_capa(titulo: String, color: Color, lineas: Array, botones: Array) -> void:
	for hijo in _capa_columna.get_children():
		_capa_columna.remove_child(hijo)
		hijo.queue_free()
	_capa_columna.add_child(Estilo.texto(titulo, 30, color, 700))
	for l in lineas:
		if l is Control:
			_capa_columna.add_child(l)
		elif str(l) != "":
			var etiqueta := Estilo.texto(str(l), 20, Estilo.TINTA, 500)
			etiqueta.custom_minimum_size = Vector2(660, 0)
			_capa_columna.add_child(etiqueta)
	var fila := HBoxContainer.new()
	fila.add_theme_constant_override("separation", 12)
	fila.alignment = BoxContainer.ALIGNMENT_END
	var primero: Button = null
	for par in botones:
		var b := Estilo.boton(par[0], 20, par.size() > 2)
		b.custom_minimum_size = Vector2(170, 46)
		var accion: String = par[1]
		b.pressed.connect(func(): _boton.emit(accion))
		fila.add_child(b)
		if primero == null:
			primero = b
	_capa_columna.add_child(Estilo.separador(4))
	_capa_columna.add_child(fila)
	_capa.visible = true
	_capa.reset_size()
	if primero != null:
		primero.grab_focus.call_deferred()


func _ficha_control(id_ficha: String) -> Control:
	var f := Juego.ficha(id_ficha)
	if f.is_empty():
		return Estilo.separador(0)
	var caja := Estilo.panel(Color("fffaf0"), 10, 2, 12)
	var columna := VBoxContainer.new()
	columna.add_child(Estilo.texto("AL CUADERNO · %s" % String(f.get("titulo", "")).to_upper(), 14, Estilo.PETROLEO, 700))
	var cuerpo := Estilo.texto(f.get("texto", ""), 18, Estilo.TINTA, 500)
	cuerpo.custom_minimum_size = Vector2(630, 0)
	columna.add_child(cuerpo)
	columna.add_child(Estilo.texto("Fuente: %s" % f.get("fuente", ""), 14, Estilo.TINTA_SUAVE, 500))
	caja.add_child(columna)
	return caja


func jugar(id: String, parametros: Dictionary) -> Dictionary:
	var meta := Juego.info_minijuego(id)
	var ruta := "res://minijuegos/%s/%s.gd" % [id, id]
	if meta.is_empty() or not FileAccess.file_exists(ruta):
		print("AVISO minijuego inexistente: ", id)
		return {"superado": false, "error": "no existe", "puntos": 0.0}
	var guion: Variant = load(ruta)
	visible = true
	_titulo.text = meta.get("titulo", id)
	_controles.text = meta.get("controles", "")
	_marco.reset_size()
	_pista = 0
	var solo := 0
	if Juego.modo_prueba:
		solo = -1 if parametros.get("fallar", false) else 1
	var final: Dictionary = {}
	while true:
		if _minijuego != null and is_instance_valid(_minijuego):
			_minijuego.queue_free()
		_minijuego = guion.new()
		_hueco.add_child(_minijuego)
		_minijuego.position = Vector2.ZERO
		_minijuego.terminado.connect(_al_terminar)
		_minijuego.set("_solo", solo)
		_minijuego.preparar(parametros, meta)
		if solo == 0:
			var lineas: Array = [meta.get("resumen", "")]
			var n := 1
			for paso in meta.get("instrucciones", []):
				lineas.append("%d. %s" % [n, paso])
				n += 1
			if _pista > 0:
				var pistas: Array = meta.get("pistas", [])
				if not pistas.is_empty():
					lineas.append("Órbita: «%s»" % pistas[mini(_pista - 1, pistas.size() - 1)])
			_llenar_capa(meta.get("titulo", id), Estilo.TINTA, lineas, [["Empezar", "empezar", true], ["Salir", "salir"]])
			var accion: String = await _boton
			_capa.visible = false
			if accion == "salir":
				final = {"superado": false, "abandonado": true, "puntos": 0.0}
				break
		_pendiente = true
		_minijuego.empezar()
		while _pendiente:
			await get_tree().process_frame
		final = _resultado
		print("MINIJUEGO %s superado=%s puntos=%.1f detalle=%s" % [id, str(final.get("superado", false)), float(final.get("puntos", 0.0)), str(final.get("detalle", ""))])
		if solo != 0 or final.get("abandonado", false):
			break
		var siguiente := ""
		if final.get("superado", false):
			Audio.sonar("ok")
			var id_ficha: String = meta.get("ficha", "")
			var extra: Array = [final.get("detalle", "")]
			if id_ficha != "":
				Juego.anotar(id_ficha)
				extra.append(_ficha_control(id_ficha))
			_llenar_capa("¡Logrado!", Estilo.CIAN_MEDIO, extra, [["Continuar", "continuar", true], ["Otra vez", "reintentar"]])
			siguiente = await _boton
		else:
			Audio.sonar("error")
			_pista += 1
			_llenar_capa("Casi", Estilo.TERRACOTA, [final.get("detalle", ""), "Órbita puede darte una pista antes del próximo intento."], [["Reintentar", "reintentar", true], ["Salir", "salir"]])
			siguiente = await _boton
		_capa.visible = false
		if siguiente != "reintentar":
			break
	if final.get("superado", false):
		var ficha_final: String = meta.get("ficha", "")
		if ficha_final != "":
			Juego.anotar(ficha_final)
	if _minijuego != null and is_instance_valid(_minijuego):
		_minijuego.queue_free()
	_minijuego = null
	_capa.visible = false
	visible = false
	return final
extends RefCounted

# Estilo PROVISIONAL de la interfaz: el cuaderno de ingenieria de la Biblia de arte (seccion 6), con la paleta
# maestra. La Fase 7 (UI/UX, tipografia y accesibilidad) no esta validada por Guillermo: colores, fuentes y
# tamanos esperan su veredicto. Las fuentes son las del sistema (no se descargo ninguna).

const PAPEL := Color("f6e7c8")
const PAPEL_SOMBRA := Color("e6d2a8")
const CREMA := Color("f8c991")
const TINTA := Color("322c1d")
const TINTA_SUAVE := Color("6a5d48")
const PETROLEO := Color("516b7c")
const NOCHE := Color("1c282e")
const CIAN := Color("62e4e0")
const CIAN_MEDIO := Color("36b1b2")
const BRILLO := Color("cef8f5")
const CORAL := Color("e46043")
const DORADO := Color("daaa25")
const NARANJA := Color("f4a159")
const TERRACOTA := Color("924930")
const VERDE := Color("6d6a2b")

static var _fuentes: Dictionary = {}
static var _tema: Theme = null


static func fuente(peso: int = 500, mano: bool = false) -> Font:
	# "mano" = letra manuscrita para sellos y notas del cuaderno
	var clave := "%d%s" % [peso, "m" if mano else ""]
	if not _fuentes.has(clave):
		var f := SystemFont.new()
		if mano:
			f.font_names = PackedStringArray(["Segoe Print", "Ink Free", "Comic Sans MS", "Segoe UI"])
		else:
			f.font_names = PackedStringArray(["Bahnschrift", "Segoe UI", "Trebuchet MS", "Verdana"])
		f.font_weight = peso
		_fuentes[clave] = f
	return _fuentes[clave]


static func caja(color: Color, radio: int = 12, borde: int = 0, color_borde: Color = TINTA, margen: int = 14) -> StyleBoxFlat:
	var s := StyleBoxFlat.new()
	s.bg_color = color
	s.set_corner_radius_all(radio)
	s.set_border_width_all(borde)
	s.border_color = color_borde
	s.set_content_margin_all(margen)
	s.anti_aliasing = true
	return s


static func texto(contenido: String, tam: int = 20, color: Color = TINTA, peso: int = 500, mano: bool = false) -> Label:
	var l := Label.new()
	l.text = contenido
	l.add_theme_font_override("font", fuente(peso, mano))
	l.add_theme_font_size_override("font_size", tam)
	l.add_theme_color_override("font_color", color)
	l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	l.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return l


static func linea(contenido: String, tam: int = 20, color: Color = TINTA, peso: int = 500) -> Label:
	# etiqueta de una sola linea (sin salto automatico): para filas, cabeceras y contadores
	var l := texto(contenido, tam, color, peso)
	l.autowrap_mode = TextServer.AUTOWRAP_OFF
	return l


static func boton(contenido: String, tam: int = 22, principal: bool = false) -> Button:
	var b := Button.new()
	b.text = contenido
	b.add_theme_font_override("font", fuente(600))
	b.add_theme_font_size_override("font_size", tam)
	var fondo := CIAN if principal else PAPEL
	b.add_theme_stylebox_override("normal", caja(fondo, 10, 3, TINTA, 12))
	b.add_theme_stylebox_override("hover", caja(fondo.lightened(0.25), 10, 3, TINTA, 12))
	b.add_theme_stylebox_override("pressed", caja(PETROLEO, 10, 3, TINTA, 12))
	b.add_theme_stylebox_override("focus", caja(Color(0, 0, 0, 0), 10, 4, CIAN_MEDIO, 12))
	b.add_theme_stylebox_override("disabled", caja(PAPEL_SOMBRA.darkened(0.1), 10, 2, TINTA_SUAVE, 12))
	for estado in ["font_color", "font_hover_color", "font_focus_color"]:
		b.add_theme_color_override(estado, TINTA)
	b.add_theme_color_override("font_pressed_color", PAPEL)
	b.add_theme_color_override("font_disabled_color", TINTA_SUAVE)
	b.custom_minimum_size = Vector2(0, tam * 2 + 6)
	b.pressed.connect(func(): Audio.sonar("pulsar"))
	return b


static func panel(color: Color = PAPEL, radio: int = 14, borde: int = 3, margen: int = 18) -> PanelContainer:
	var p := PanelContainer.new()
	p.add_theme_stylebox_override("panel", caja(color, radio, borde, TINTA, margen))
	return p


static func tema() -> Theme:
	if _tema == null:
		_tema = Theme.new()
		_tema.default_font = fuente(500)
		_tema.default_font_size = 20
		_tema.set_color("font_color", "Label", TINTA)
	return _tema


static func separador(alto: int = 10) -> Control:
	var c := Control.new()
	c.custom_minimum_size = Vector2(0, alto)
	c.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return c


static func luna(lienzo: CanvasItem, centro: Vector2, radio: float, fase: float, giro: float = 0.0, lado_luz: Color = CREMA, lado_sombra: Color = Color("3b4a52")) -> void:
	# dibuja la Luna con su fase (0 = nueva, 0,5 = llena, 1 = nueva) dentro de _draw() de "lienzo".
	# "giro" en radianes: con PI/2 el borde iluminado queda abajo, la «Luna sonriente» del ecuador.
	lienzo.draw_set_transform(centro, giro, Vector2.ONE)
	lienzo.draw_circle(Vector2.ZERO, radio, lado_sombra)
	var k := cos(TAU * fase)              # 1 en nueva, -1 en llena
	var signo := 1.0 if fase <= 0.5 else -1.0
	var puntos := PackedVector2Array()
	var pasos := 24
	for i in pasos + 1:
		var t := PI * float(i) / float(pasos)
		puntos.append(Vector2(signo * radio * sin(t), -radio * cos(t)))
	for i in pasos + 1:
		var t := PI * float(pasos - i) / float(pasos)
		puntos.append(Vector2(signo * k * radio * sin(t), -radio * cos(t)))
	if absf(k) < 0.999:
		lienzo.draw_colored_polygon(puntos, lado_luz)
	lienzo.draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)

