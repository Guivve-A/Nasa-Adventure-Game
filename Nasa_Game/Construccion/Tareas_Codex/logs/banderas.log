+	if paso == 4:
+		if absf(alturas[1] - alturas[0]) > 1.0:
+			seleccion = 1
+			_ajustar(signf(alturas[0] - alturas[1]), minf(delta, absf(alturas[0] - alturas[1]) / 45.0))
