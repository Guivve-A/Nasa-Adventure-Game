+				if p.distance_to(SITIOS[i]) <= 35.0:
+					seleccion = i
+					_accion()
+		queue_redraw()
+
+
+func _piloto(delta: float) -> void:
+	_pulso += delta
+	if paso == 2:
+		if absf(fase - 0.5) < ventana * 0.65:
+			_accion()
+		return
+	if paso == 3 and _auto > 0:
+		_ajustar(1.0, delta)
+		if extension[seleccion] >= 0.999:
+			if seleccion == 0:
+				_cambiar(1)
+			else:
+				_accion()
