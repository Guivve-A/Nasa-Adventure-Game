+		draw_colored_polygon(PackedVector2Array([p, p + Vector2(20, -8), p + Vector2(35, 4), p + Vector2(8, 8)]), Estilo.PETROLEO.lerp(Estilo.PAPEL_SOMBRA, luz))
+	_letra(PASOS[paso], Vector2(24, 34), 24)
