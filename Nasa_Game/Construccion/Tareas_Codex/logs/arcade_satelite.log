extends Node

# Juega por el anfitrion y por Input; no llama a manejadores ni al piloto.
var _resultado: Dictionary = {}
var _devuelto: bool = false
var _pulsadas: Dictionary = {}
var _cursor: Vector2 = Vector2.ZERO


func correr(pruebas: Node) -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	Juego.modo_prueba = false
	Juego.sin_guardar = true
	Juego.minijuegos_solos = false
	await _teclado(pruebas)
	await _raton(pruebas)
	await _salidas(pruebas)
	pruebas.comprobar(not Interfaz.anfitrion.visible, "satelite.manos.anfitrion_cerrado")
	pruebas.comprobar(not get_tree().paused, "satelite.manos.arbol_sin_pausa")
	Juego.modo_prueba = true


func _lanzar() -> void:
	_resultado = await Interfaz.abrir_minijuego("satelite", {"dificultad": 1})
	_devuelto = true


func _abrir(p: Node, parte: String) -> Control:
	_resultado = {}
	_devuelto = false
	_lanzar()
	var visible: bool = await _hasta(func() -> bool: return Interfaz.anfitrion.visible, 3.0)
	p.comprobar(visible, "satelite.%s.abre_anfitrion" % parte)
	await _real(0.12)
	var mj: Control = Interfaz.anfitrion.get("_minijuego")
	p.comprobar(mj != null and int(mj.get("_auto")) == 0 and int(mj.get("_solo")) == 0, "satelite.%s.sin_piloto" % parte)
	return mj


func _teclado(p: Node) -> void:
	var mj: Control = await _abrir(p, "teclado")
	if mj == null:
		return
	await _captura("manos_instrucciones")
	await _toque(KEY_ENTER)
	p.comprobar(bool(mj.get("activo")), "satelite.teclado.Empezar_Intro")
	for codigo in [KEY_A, KEY_D, KEY_W, KEY_S, KEY_LEFT, KEY_RIGHT, KEY_UP, KEY_DOWN]:
		var antes: int = int(mj.get("seleccion"))
		var paso: int = -1 if codigo in [KEY_A, KEY_W, KEY_LEFT, KEY_UP] else 1
		await _toque(codigo)
		p.comprobar(int(mj.get("seleccion")) == posmod(antes + paso, 4), "satelite.teclado.elegir_%s" % OS.get_keycode_string(codigo))
	await _toque(KEY_E)
	p.comprobar(bool(mj.get("tomada")), "satelite.teclado.tomar_E")
	var h: int = int(mj.get("hueco"))
	await _toque(KEY_UP)
	p.comprobar(int(mj.get("hueco")) == posmod(h - 2, 4), "satelite.teclado.hueco_arriba_dos_columnas")
	await _toque(KEY_DOWN)
	p.comprobar(int(mj.get("hueco")) == h, "satelite.teclado.hueco_abajo_dos_columnas")
	# Coloca la pieza tomada y despues el resto, mirando seleccion y funciones.
	await _montar(mj)
	p.comprobar(int(mj.get("fase")) == 1, "satelite.teclado.montaje_Enter_y_Comprobar_Espacio")
	_lienzo(p, mj, "ajustes_teclado")
	for codigo in [KEY_A, KEY_D, KEY_LEFT, KEY_RIGHT, KEY_E, KEY_ENTER]:
		var antes: int = int(mj.get("paneles"))
		var paso: int = -1 if codigo in [KEY_A, KEY_LEFT] else 1
		await _toque(codigo)
		p.comprobar(int(mj.get("paneles")) == posmod(antes + paso, 3), "satelite.teclado.cambiar_%s" % OS.get_keycode_string(codigo))
	for codigo in [KEY_W, KEY_S, KEY_UP, KEY_DOWN]:
		var antes: int = int(mj.get("seleccion"))
		await _toque(codigo)
		var paso: int = -1 if codigo in [KEY_W, KEY_UP] else 1
		p.comprobar(int(mj.get("seleccion")) == posmod(antes + paso, 5), "satelite.teclado.fila_%s" % OS.get_keycode_string(codigo))
	for fila in [1, 2, 3, 4]:
		await _fila(mj, fila)
		var propiedad: String = ["", "antena", "computadora", "radio_sol", "radio_sombra"][fila]
		var antes: bool = bool(mj.get(propiedad))
		await _toque(KEY_E)
		p.comprobar(bool(mj.get(propiedad)) != antes, "satelite.teclado.ajuste_%s" % propiedad)
		await _toque(KEY_ENTER)
	await _configurar(mj)
	await _captura("manos_teclado_balance")
	await _toque(KEY_SPACE)
	p.comprobar(int(mj.get("fase")) == 2, "satelite.teclado.Probar_Espacio")
	await _victoria(p, mj, "teclado")
	await _captura("manos_resultado")
	await _toque(KEY_ENTER)
	await _cerrado(p, "teclado.Continuar_Intro")


func _montar(mj: Control) -> void:
	for i in 4:
		var piezas: Array = mj.get("piezas")
		if int(piezas[i]) == i:
			continue
		if not bool(mj.get("tomada")):
			for paso in 4:
				if int(mj.get("seleccion")) == i:
					break
				await _toque(KEY_S)
			await _toque(KEY_E)
		for paso in 4:
			if int(mj.get("hueco")) == int(mj.get("seleccion")):
				break
			await _toque(KEY_D)
		await _toque(KEY_ENTER)
	await _toque(KEY_SPACE)


func _fila(mj: Control, destino: int) -> void:
	for paso in 5:
		if int(mj.get("seleccion")) == destino:
			return
		await _toque(KEY_DOWN)


func _configurar(mj: Control) -> void:
	await _fila(mj, 0)
	for paso in 3:
		if int(mj.get("paneles")) == 2:
			break
		await _toque(KEY_D)
	for fila in [1, 2, 3, 4]:
		await _fila(mj, fila)
		var propiedad: String = ["", "antena", "computadora", "radio_sol", "radio_sombra"][fila]
		var deseado: bool = fila != 4
		if bool(mj.get(propiedad)) != deseado:
			await _toque(KEY_E)


func _raton(p: Node) -> void:
	var mj: Control = await _abrir(p, "raton")
	if mj == null:
		return
	await _clic(_boton("Empezar"))
	p.comprobar(bool(mj.get("activo")), "satelite.raton.Empezar_clic")
	_lienzo(p, mj, "montaje_raton")
	var piezas: Array = mj.get("_piezas_controles")
	var huecos: Array = mj.get("_huecos_controles")
	for i in 4:
		var pieza: Control = piezas[i]
		var hueco: Control = huecos[i]
		if i % 2 == 0:
			await _mover(pieza.get_global_rect().get_center())
			await _boton_raton(true)
			await _mover(hueco.get_global_rect().get_center(), true)
			await _boton_raton(false)
		else:
			await _clic(pieza)
			p.comprobar(bool(mj.get("tomada")), "satelite.raton.tomar_clic_%d" % i)
			await _clic(hueco)
		var instaladas: Array = mj.get("piezas")
		p.comprobar(int(instaladas[i]) == i and not bool(mj.get("tomada")), "satelite.raton.%s_pieza_%d" % ["arrastrar" if i % 2 == 0 else "colocar_clic", i])
	await _captura("manos_raton_montaje")
	var accion: Button = mj.get("_accion")
	await _clic(accion)
	p.comprobar(int(mj.get("fase")) == 1, "satelite.raton.Comprobar_clic")
	var ajustes: Array = mj.get("_ajustes")
	for i in 5:
		var ajuste: Button = ajustes[i]
		var propiedad: String = ["paneles", "antena", "computadora", "radio_sol", "radio_sombra"][i]
		var antes: int = int(mj.get(propiedad))
		await _clic(ajuste)
		p.comprobar(int(mj.get(propiedad)) != antes, "satelite.raton.ajuste_%s" % propiedad)
		# Paneles: abre los dos. Computadora y radio al sol: vuelve a encender.
		if i in [0, 2, 3]:
			await _clic(ajuste)
	await _captura("manos_raton_balance")
	_lienzo(p, mj, "ajustes_raton")
	await _clic(accion)
	p.comprobar(int(mj.get("fase")) == 2, "satelite.raton.Probar_clic")
	await _victoria(p, mj, "raton")
	await _clic(_boton("Continuar"))
	await _cerrado(p, "raton.Continuar_clic")


func _victoria(p: Node, mj: Control, parte: String) -> void:
	var termino: bool = await _hasta(func() -> bool: return not bool(mj.get("activo")), 12.0)
	await _real(0.12)
	var resultado: Dictionary = Interfaz.anfitrion.get("_resultado")
	p.comprobar(termino and int(mj.get("fase")) == 3 and bool(resultado.get("superado", false)), "satelite.%s.superado_primer_intento" % parte, str(resultado))


func _salidas(p: Node) -> void:
	for fase in ["instrucciones", "pieza_tomada", "ajustes", "sol", "sombra", "resultado"]:
		var mj: Control = await _abrir(p, "Esc_" + fase)
		if mj == null:
			return
		if fase != "instrucciones":
			await _toque(KEY_ENTER)
		if fase == "pieza_tomada":
			await _toque(KEY_E)
		elif fase in ["ajustes", "sol", "sombra", "resultado"]:
			await _montar(mj)
			if fase != "ajustes":
				await _configurar(mj)
				await _toque(KEY_SPACE)
				if fase == "sombra":
					var sombra: bool = await _hasta(func() -> bool: return int(mj.get("fase")) == 3, 6.0)
					p.comprobar(sombra, "satelite.Esc_alcanza_sombra")
				elif fase == "resultado":
					await _victoria(p, mj, "Esc_resultado")
		await _toque(KEY_ESCAPE)
		await _cerrado(p, "Esc_" + fase)
	var mj: Control = await _abrir(p, "salir_raton")
	if mj != null:
		await _clic(_boton("Empezar"))
		var salir: Button = Interfaz.anfitrion.get("_salir")
		await _clic(salir)
		await _cerrado(p, "raton.Salir_clic")


func _cerrado(p: Node, parte: String) -> void:
	var cerrado: bool = await _hasta(func() -> bool: return _devuelto and not Interfaz.anfitrion.visible, 2.0)
	p.comprobar(cerrado, "satelite.%s.anfitrion_cerrado" % parte, str(_resultado))
	p.comprobar(not get_tree().paused, "satelite.%s.sin_pausa" % parte)
	if not cerrado:
		await _toque(KEY_ESCAPE)
		await _real(0.1)


func _lienzo(p: Node, mj: Control, parte: String) -> void:
	var fuera: Array[String] = []
	var lienzo: Rect2 = mj.get_global_rect()
	for hijo in mj.get_children():
		if hijo is Control and hijo.visible and not lienzo.encloses(hijo.get_global_rect()):
			fuera.append("%s %s" % [hijo.name, str(hijo.get_global_rect())])
	p.comprobar(fuera.is_empty(), "satelite.%s.dentro_1120x520" % parte, str(fuera))


func _boton(contenido: String) -> Button:
	var columna: VBoxContainer = Interfaz.anfitrion.get("_capa_columna")
	for nodo in columna.find_children("*", "Button", true, false):
		if nodo.text == contenido:
			return nodo
	return null


func _real(segundos: float) -> void:
	await get_tree().create_timer(segundos, true, false, true).timeout


func _hasta(condicion: Callable, segundos: float) -> bool:
	var limite: int = Time.get_ticks_msec() + int(segundos * 1000.0)
	while not bool(condicion.call()) and Time.get_ticks_msec() < limite:
		await get_tree().process_frame
	return bool(condicion.call())


func _tecla(codigo: int, abajo: bool) -> void:
	if bool(_pulsadas.get(codigo, false)) == abajo:
		return
	_pulsadas[codigo] = abajo
	var evento: InputEventKey = InputEventKey.new()
	evento.physical_keycode = codigo
	evento.keycode = codigo
	evento.pressed = abajo
	Input.parse_input_event(evento)


func _toque(codigo: int) -> void:
	_tecla(codigo, true)
	await _real(0.035)
	_tecla(codigo, false)
	await _real(0.035)


func _mover(posicion: Vector2, pulsado: bool = false) -> void:
	# Input recibe pixeles de ventana, distintos del lienzo logico en headless.
	var transformacion: Transform2D = get_viewport().get_final_transform()
	var evento: InputEventMouseMotion = InputEventMouseMotion.new()
	evento.position = transformacion * posicion
	evento.global_position = evento.position
	evento.relative = transformacion * posicion - transformacion * _cursor
	evento.button_mask = MOUSE_BUTTON_MASK_LEFT if pulsado else 0
	_cursor = posicion
	Input.parse_input_event(evento)
	await _real(0.05)


func _boton_raton(abajo: bool) -> void:
	var evento: InputEventMouseButton = InputEventMouseButton.new()
	evento.position = get_viewport().get_final_transform() * _cursor
	evento.global_position = evento.position
	evento.button_index = MOUSE_BUTTON_LEFT
	evento.button_mask = MOUSE_BUTTON_MASK_LEFT if abajo else 0
	evento.pressed = abajo
	Input.parse_input_event(evento)
	await _real(0.05)


func _clic(control: Control) -> void:
	if control == null:
		return
	await _mover(control.get_global_rect().get_center())
	await _boton_raton(true)
	await _boton_raton(false)


func _captura(nombre: String) -> void:
	if DisplayServer.get_name() == "headless" or not Juego.args.has("capturas_manos"):
		return
	await RenderingServer.frame_post_draw
	var ruta: String = ProjectSettings.globalize_path("res://../Nasa_Game/Construccion/Minijuegos/satelite/%s.png" % nombre)
	var error: Error = get_viewport().get_texture().get_image().save_png(ruta)
	print("SATELITE_CAPTURA ", nombre, " error=", error)
