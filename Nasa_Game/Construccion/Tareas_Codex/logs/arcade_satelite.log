# ------------------------------------------------------------------ contrato

func _preparar() -> void:
	texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	var modo: String = str(parametros.get("modo", Juego.args.get("modo", "")))
	modo_cielo = modo == "prealimentacion"
	var i := dificultad - 1
	dur_pasada = T_PASADA[i]
	n_pasadas = PASADAS[i]
	medio = MEDIO_VISOR[i]
	margen = float(medio - RADIO)
	t_corte = T_CORTE[i]
	vel_cielo = 300.0 / dur_pasada
	azar.seed = 7919 * dificultad + (13 if modo_cielo else 0)
	chispa.seed = 4242
	for n in 40:
		estrellas.append(Vector3(chispa.randf_range(0.0, 300.0), chispa.randf_range(17.0, 96.0), float(chispa.randi_range(0, 3))))
	var cuantas: int = NUBES[i]
	for n in cuantas:
		nubes.append(_nueva_nube(chispa.randf_range(30.0, 260.0)))
	queue_redraw()


func _empezar() -> void:
	if _solo == 0 and not Juego.modo_prueba:
		azar.randomize()
	var i := dificultad - 1
	fase = 1
	t_fase = 0.0
	viento_prox = PRIMER_VIENTO[i]
	gracia = GRACIA[i]
	sonar("pulsar")


func _paso(delta: float) -> void:
	t_dibujo += delta
	_animar(delta)
	match fase:
		1:
			t_fase += delta
			if t_fase >= T_MISION:
				fase = 2
				sonar("salto")
		2:
			if _auto == 0:
				_leer_mandos()
			acumulado = minf(acumulado + delta, 1.0)
			while acumulado >= PASO and fase == 2:
				acumulado -= PASO
				_avanzar()
		3:
			t_fase += delta
			if t_fase >= T_FINAL:
				_cerrar()
	queue_redraw()


func jugar_solo(acierta: bool) -> void:
	# el piloto no toca el visor: decide "mando", "freno" y el boton del cielo, igual que las teclas
	_auto = 1 if acierta else -1


# ------------------------------------------------------------------ mandos

func _leer_mandos() -> void:
	mando = eje_x()
	freno = Input.is_action_pressed("saltar") or (not modo_cielo and Input.is_action_pressed("interactuar"))
	if Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT):
		# raton (opcional): mantener el boton empuja el motor hacia el puntero
		var p: Vector2 = get_local_mouse_position() / float(ESCALA)
		if p.x >= 0.0 and p.x <= float(ANCHO) and p.y >= 15.0 and p.y <= 116.0 and absf(p.x - visor_x) > 3.0:
			mando = signf(p.x - visor_x)
	if Input.is_mouse_button_pressed(MOUSE_BUTTON_RIGHT):
		freno = true


func _input(evento: InputEvent) -> void:
	if not activo or fase != 2 or _auto != 0 or not modo_cielo:
		return
	if evento.is_action_pressed("interactuar"):
		_pulsar_cielo()
		get_viewport().set_input_as_handled()


func _gui_input(evento: InputEvent) -> void:
	if not activo or fase != 2 or _auto != 0 or not modo_cielo:
		return
	if evento is InputEventMouseButton and evento.pressed and evento.button_index == MOUSE_BUTTON_LEFT:
		var p: Vector2 = evento.position / float(ESCALA)
		if Rect2(96, 117, 60, 12).has_point(p):
			_pulsar_cielo()
			accept_event()


func _pulsar_cielo() -> void:
	# el boton «velocidad del cielo»: el motor ya gira al ritmo del cielo y solo queda corregir
	cielo = not cielo
	brillo_boton = 0.6
	sonar("recoger" if cielo else "pulsar")
	if cielo:
		_chispas(125.0, 122.0, 10, Estilo.CIAN, 26.0)
		_poner_cartel("MOTOR AL RITMO DEL CIELO", 1.5)


func _piloto() -> void:
	var e := luna_x - visor_x
	var sobra := visor_v - vel_cielo
	if _auto > 0:
		if modo_cielo and not cielo and reloj > 0.4:
			_pulsar_cielo()
		# acerca el visor y frena antes de llegar: la orden mira el error y tambien la velocidad
		var orden := 6.0 * e - 3.5 * sobra
		mando = 0.0 if absf(orden) < 8.0 else signf(orden)
		var base := vel_cielo if cielo else 0.0
		freno = absf(sobra) > 20.0 and (visor_v - base) * sobra > 0.0 and absf(e) < 0.45 * absf(sobra) + 4.0
	elif _auto < 0:
		# empuja a fondo hacia la Luna y no suelta ni frena: se pasa de largo y oscila
		_pulso -= PASO
		if _pulso <= 0.0:
			_pulso = 1.3
			_lado = 1.0 if e >= 0.0 else -1.0
		mando = _lado
		freno = false


# ------------------------------------------------------------------ fisica y reglas

func _arco(x: float) -> float:
	# la senda de la Luna (y del visor, que va montado sobre ella)
	return SUELO_ARCO - ALTO_ARCO * sin(PI * clampf((x + 10.0) / 300.0, 0.0, 1.0))


func _avanzar() -> void:
	if _auto == 1 or _auto == -1:
		_piloto()
	reloj += PASO
	t_pasada += PASO
	if t_pasada >= dur_pasada:
		if pasada >= n_pasadas:
			_acabar(false, "amanece")
			return
		pasada += 1
		t_pasada = 0.0
		var g: float = GRACIA[dificultad - 1]
		gracia = maxf(gracia, g)
		_poner_cartel("PASADA %d" % pasada, 1.4)
		sonar("salto")
	luna_x = -10.0 + 300.0 * t_pasada / dur_pasada
	_soplar()
	var base := vel_cielo if cielo else 0.0
	var roce := ROCE_FRENO if freno else ROCE
	visor_v += (EMPUJE * mando - roce * (visor_v - base) + viento) * PASO
	visor_x += visor_v * PASO
	if visor_x < X_MIN:
		visor_x = X_MIN
		visor_v = maxf(visor_v, 0.0)
	elif visor_x > X_MAX:
		visor_x = X_MAX
		visor_v = minf(visor_v, 0.0)
	var e := luna_x - visor_x
	var antes := dentro
	dentro = absf(e) <= margen
	nitido = absf(e) <= NITIDO
	var a_la_vista := luna_x >= 8.0 and luna_x <= 272.0
	gracia = maxf(0.0, gracia - PASO)
	if dentro:
		if not antes:
			sonar("recoger")
			_chispas(luna_x, _arco(luna_x), 6, Estilo.BRILLO, 22.0)
		racha += PASO
		_estancia += PASO
		t_dentro += PASO
		if cielo:
			t_con_cielo += PASO
		var tramo := int(video / 4.0)
		video = minf(VIDEO_META, video + VIDEO_RITMO * PASO)
		puntos += VIDEO_RITMO * PASO * 10.0 * float(_multiplicador()) * (2.0 if nitido else 1.0)
		senal = minf(1.0, senal + PASO / (t_corte * 0.5))
		if int(video / 4.0) != tramo:
			sonar("tic")
			_chispas(72.0 + video * 1.5, 7.0, 4, Estilo.DORADO, 14.0)
		if video >= VIDEO_META:
			_acabar(true, "")
			return
	else:
		racha = 0.0
		var lado := 1 if e > 0.0 else -1
		if _ultimo_lado != 0 and lado != _ultimo_lado and _estancia < 1.0 and a_la_vista:
			rebotes += 1          # cruzo la Luna de lado a lado sin quedarse: se paso
		_ultimo_lado = lado
		_estancia = 0.0
		if a_la_vista and gracia <= 0.0:
			senal -= PASO / t_corte
			if e > 0.0:
				t_atras += PASO
			else:
				t_delante += PASO
			if senal <= 0.0:
				_cortar()


func _multiplicador() -> int:
	return 1 + mini(3, int(racha / 4.0))


func _soplar() -> void:
	match viento_fase:
		0:
			viento = 0.0
			if reloj >= viento_prox:
				viento_fase = 1
				viento_t = 0.0
				viento_dir = 1 if azar.randf() < 0.5 else -1
				viento_dur = azar.randf_range(1.2, 2.0)
				sonar("radio")
		1:
			viento_t += PASO
			if viento_t >= 0.8:
				viento_fase = 2
				viento_t = 0.0
				rachas_viento += 1
				sacudida = maxf(sacudida, 0.15)
		2:
			viento_t += PASO
			var k := viento_t / viento_dur
			var forma := minf(1.0, minf(k, 1.0 - k) * 5.0)
			var f: float = FUERZA[dificultad - 1]
			viento = float(viento_dir) * f * (1.0 + 0.12 * float(pasada - 1)) * forma
			if k >= 1.0:
				viento_fase = 0
				viento = 0.0
				var calma: Array = CALMA[dificultad - 1]
				var c0: float = calma[0]
				var c1: float = calma[1]
				viento_prox = reloj + azar.randf_range(c0, c1)


func _cortar() -> void:
	vidas -= 1
	cortes += 1
	senal = 1.0
	gracia = 2.5
				_calor_bolsas += _golpe
				_inmune = 0.7
				_sacudida = 0.3
				_destellar(Estilo.CORAL, 0.5)
				sonar("error")
				_estallar(bx, by, 18, Estilo.NARANJA, 50.0)
			elif by < Y_CAP - r - 8.0 and not bool(b["contada"]):
				b["contada"] = true
				esquivadas += 1
				puntos += 50.0
				sonar("recoger")
				_carteles.append([cap_x - 6.0, Y_CAP - 16.0, "+50", 0.8])
		i -= 1


func _tic_franja(dt: float, pulso: bool) -> void:
	vuelo += dt
	_girar(dt, 0.5)
	velocidad = move_toward(velocidad, V_FRANJA, ACEL_CAIDA * dt)
	prof += velocidad * dt
	calor = maxf(calor - 12.0 * dt, 0.0)
	_chocar_bolsas(dt)
	if pulso:
		if prof < franja_ini:
			# todavia va demasiado rapido: el aire arranca la tela
			paracaidas -= 1
			_t_tela = 0.8
			_sacudida = 0.25
			sonar("error")
			_rasgados.append([cap_x - 5.0, Y_CAP - 18.0, _fx.randf_range(-14.0, 14.0), -70.0])
			if paracaidas <= 0:
				_perder(CAUSA_PRONTO, "caida")
		else:
			_abrir_paracaidas()
	elif prof > franja_fin + 4.0:
		_perder(CAUSA_TARDE, "caida")


func _abrir_paracaidas() -> void:
	abiertos = paracaidas
	_prof_abrio = prof
	_alt_abrio = _y_altimetro()
	mar_prof = prof + DIST_MAR
	var lejos: float = _azar.randf_range(_nivel(45.0, 55.0, 65.0), _nivel(85.0, 100.0, 115.0))
	var lado: float = 1.0 if _azar.randf() < 0.5 else -1.0
	diana_x = cap_x + lado * lejos
	if diana_x < 36.0 or diana_x > CAMPO - 36.0:
		diana_x = cap_x - lado * lejos
	diana_x = clampf(diana_x, 36.0, CAMPO - 36.0)
	_viento_dir = 1.0 if _azar.randf() < 0.5 else -1.0
	puntos += 100.0 * abiertos
	_a_fase(PARACAIDAS)
	_sacudida = 0.2
	_destellar(Estilo.PAPEL, 0.45)
	sonar("salto")
	_estallar(cap_x, Y_CAP - 12.0, 10, Estilo.PAPEL, 30.0)


func _tic_paracaidas(dt: float) -> void:
	vuelo += dt
	velocidad = move_toward(velocidad, V_PARACAIDAS[abiertos], 90.0 * dt)
	prof += velocidad * dt
	viento = _viento_max * _viento_dir * (0.55 + 0.45 * sin(0.8 * _t_fase + _f1))
	cap_vx += (clampf(mando_x, -1.0, 1.0) * EMPUJE + viento - ROCE_PARACAIDAS * cap_vx) * dt
	_mover_x(dt)
	# colgada de las telas, la capsula se endereza sola y se mece
	angulo = lerpf(angulo, clampf(cap_vx * 0.4, -20.0, 20.0), minf(6.0 * dt, 1.0))
	giro = 0.0
	calor = maxf(calor - 12.0 * dt, 0.0)
	if prof >= mar_prof - 6.0:
		prof = mar_prof - 6.0
		var lejos: float = absf(cap_x - diana_x)
		_estallar(cap_x, _y_capsula() + 5.0, 22, Estilo.PAPEL, 45.0)
		if lejos <= diana_medio:
			puntos += 100.0 + 300.0 * (1.0 - lejos / diana_medio)
			_a_fase(AMERIZADO)
			_destellar(Estilo.PAPEL, 0.4)
			sonar("logro")
		else:
			_sacudida = 0.3
			_perder(CAUSA_FUERA, "fuera")


func _perder(causa: String, tipo: String) -> void:
	_causa = causa
	_tipo_perdida = tipo
	_a_fase(PERDIDO)
	_sacudida = maxf(_sacudida, 0.4)
	if tipo == "calor":
		_destellar(Estilo.CORAL, 0.7)
		_estallar(cap_x, Y_CAP, 30, Estilo.CORAL, 70.0)


# ------------------------------------------------------------------ piloto de las pruebas

func _piloto() -> void:
	# juega con las mismas reglas: solo escribe mando_x, mando_abajo y _pulso, como las teclas
	mando_x = 0.0
	mando_abajo = false
	if fase == INTRO:
		_pulso = _t_fase > 0.2
		return
	if _auto < 0:
		# gira sin soltar: el escudo queda de lado y el calor sube
		mando_x = 1.0
		return
	if fase == REENTRADA:
		var destino: float = _carril_libre()
		var inclinacion: float = clampf((destino - cap_x) * 0.9 - cap_vx * 0.8, -margen * 0.72, margen * 0.72)
		mando_x = _mando_giro(inclinacion)
		var despejado: bool = absf(destino - cap_x) < 3.0
		for b in bolsas:
			if bool(b["viva"]) and Y_CAP + float(b["prof"]) - prof > Y_CAP - 14.0 and absf(float(b["x"]) - cap_x) < float(b["r"]) + 22.0:
				despejado = false
		if calor > 50.0:
			_picada_ok = false
		elif calor < 28.0:
			_picada_ok = true
		mando_abajo = despejado and _picada_ok and absf(angulo) < margen * 0.6 and prof < LARGO - 30.0
	elif fase == FRANJA:
		mando_x = _mando_giro(clampf(-cap_vx * 0.8, -margen * 0.5, margen * 0.5))
		if prof >= franja_ini + 4.0:
			_pulso = true
	elif fase == PARACAIDAS:
		var falta: float = (diana_x - cap_x) - cap_vx * 0.6
		mando_x = signf(falta) if absf(falta) > 1.5 else 0.0


func _mando_giro(objetivo: float) -> float:
	# pulsos de tecla: frena antes de llegar, porque la capsula conserva el giro
	var falta: float = (objetivo - angulo) - giro * 0.16
	return signf(falta) if absf(falta) > 1.5 else 0.0


func _carril_libre() -> float:
	var mejor: float = cap_x
	var costo_mejor: float = _costo_carril(cap_x)
	var c: float = X_MIN + 8.0
	while c <= X_MAX - 8.0:
		var costo: float = _costo_carril(c)
		if costo < costo_mejor - 0.01:
			costo_mejor = costo
			mejor = c
		c += 4.0
	return mejor


func _costo_carril(c: float) -> float:
	var costo: float = absf(c - cap_x) + absf(c - 131.0) * 0.05
	for b in bolsas:
		if not bool(b["viva"]):
			continue
		var r: float = b["r"]
		var by: float = Y_CAP + float(b["prof"]) - prof
		if by < Y_CAP - r - 6.0:
			continue
		var llegada: float = maxf(by - Y_CAP, 0.0) / maxf(velocidad, 1.0)
		var bx: float = float(b["x"]) + float(b["vx"]) * llegada
		var holgura: float = minf(absf(bx - c), absf(float(b["x"]) - c)) - (r + 11.0)
		if holgura < 0.0:
			costo += 300.0 + 6000.0 / (by - Y_CAP + r + 30.0) - holgura * 4.0
	return costo


# ------------------------------------------------------------------ efectos

func _destellar(color: Color, fuerza: float) -> void:
	_destello = fuerza
	_destello_color = color


func _estallar(x: float, y: float, cuantas: int, color: Color, fuerza: float) -> void:
