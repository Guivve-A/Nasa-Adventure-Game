+	var ficha: Dictionary = Juego.ficha("modulo_mando")
+	_orden_nodos.append(_etiqueta(String(ficha["texto"]), Vector2(736, 100), 352, 20))
+	ficha = Juego.ficha("muestras_apolo11")
