+	add_child(_termometro)
+	_vuelo_nodos.append(_termometro)
+	_vuelo_nodos.append(_etiqueta("Calor del sueño · límite 100 · sin °C\n20 s de vuelo · al menos 16 s en el margen", Vector2(704, 192), 392, 16))
+	for lado in [-1, 1]:
