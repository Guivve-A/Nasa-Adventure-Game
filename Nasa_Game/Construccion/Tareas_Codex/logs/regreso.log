extends "res://nucleo/minijuego.gd"

# Unidades fisicas: km y s. Constantes del modelo indicadas en el encargo.
# Alturas: ficha pegaso_orbita (627 x 654 km); no reproduce su orbita real.
const MU: float = 398600.0
const RADIO: float = 6371.0
const PASO: float = 2.0
const ACELERACION: float = 300.0
const LIMITE_VUELO: float = 9600.0
const LIMITE_PARTIDA: float = 180.0
# Corte didactico, no espesor medido de la atmosfera. No se simula arrastre.
const CORTE_ATMOSFERA: float = 120.0
const CENTRO: Vector2 = Vector2(345, 246)

var altura: float = 627.0
var margen: float = 150.0
var circular: float = 0.0
var velocidad: float = 7.2
var posicion: Vector2 = Vector2.ZERO
var vector_velocidad: Vector2 = Vector2.ZERO
var minima: float = 0.0
var maxima: float = 0.0
var angulo: float = 0.0
var segundos_fisicos: float = 0.0
var _acumulado: float = 0.0
var _volando: bool = false
var _auto: int = 0
var _trazo: PackedVector2Array = PackedVector2Array()
var _anterior: PackedVector2Array = PackedVector2Array()
var _dato_anterior: String = "Anterior: aún no hay lanzamiento"
var _dial: HSlider
var _lanzar_boton: Button
var _velocidad_texto: Label
var _lecturas: Label
var _estado: Label
var _progreso: ProgressBar


func _preparar() -> void:
	altura = 654.0 if dificultad == 3 else 627.0
	margen = [150.0, 80.0, 40.0][dificultad - 1]
	circular = sqrt(MU / (RADIO + altura))
	posicion = Vector2(RADIO + altura, 0)
	minima = altura
	maxima = altura
	# El hueco del anfitrion sobrevive al nodo que reemplaza al reintentar.
	var clave: String = "orbita_anterior_%d" % dificultad
	if get_parent().has_meta(clave):
		var registro: Dictionary = get_parent().get_meta(clave)
		_anterior = registro["trazo"]
		_dato_anterior = registro["dato"]
	_etiqueta("TIERRA · SIMULADOR 2D", Vector2(44, 26), 600, 18, Estilo.PAPEL)
	_etiqueta("— Actual     · · · Anterior", Vector2(44, 472), 590, 18, Estilo.PAPEL)
	_etiqueta("Altura de partida: %.0f km\nPegaso: 627 × 654 km (ficha)" % altura, Vector2(706, 22), 390, 21)
	_etiqueta("Modelo circular idealizado\nμ = 398 600 km³/s² · R = 6 371 km", Vector2(706, 88), 390, 17)
	_etiqueta("v = √(μ / r) = %.3f km/s\nCálculo propio · tiempo ×300" % circular, Vector2(706, 143), 390, 19)
	_velocidad_texto = _etiqueta("", Vector2(706, 211), 390, 22)
	_dial = HSlider.new()
	_dial.position = Vector2(706, 249)
	_dial.size = Vector2(386, 34)
	_dial.min_value = 5.0
	_dial.max_value = 11.5
	_dial.step = 0.001
	_dial.value = velocidad
	_dial.focus_mode = Control.FOCUS_NONE
	_dial.add_theme_stylebox_override("slider", Estilo.caja(Estilo.PAPEL_SOMBRA, 4, 1))
	_dial.add_theme_stylebox_override("grabber_area", Estilo.caja(Estilo.CIAN_MEDIO, 4))
	_dial.value_changed.connect(_cambiar_velocidad)
	add_child(_dial)
	_lanzar_boton = Estilo.boton("Lanzar", 22, true)
	_lanzar_boton.position = Vector2(706, 294)
	_lanzar_boton.size = Vector2(386, 48)
	_lanzar_boton.focus_mode = Control.FOCUS_NONE
	_lanzar_boton.pressed.connect(_lanzar)
	add_child(_lanzar_boton)
	_lecturas = _etiqueta("", Vector2(706, 356), 390, 20)
	_estado = _etiqueta("", Vector2(44, 400), 590, 18, Estilo.PAPEL)
	_progreso = ProgressBar.new()
	_progreso.position = Vector2(44, 432)
	_progreso.size = Vector2(590, 18)
	_progreso.add_theme_font_size_override("font_size", 16)
	_progreso.show_percentage = false
	_progreso.max_value = TAU
	_progreso.add_theme_stylebox_override("background", Estilo.caja(Estilo.TINTA, 3, 0, Estilo.TINTA, 0))
	_progreso.add_theme_stylebox_override("fill", Estilo.caja(Estilo.CIAN, 3, 0, Estilo.TINTA, 0))
	add_child(_progreso)
	_actualizar()


func _etiqueta(contenido: String, lugar: Vector2, ancho: float, tam: int, color: Color = Estilo.TINTA) -> Label:
	var l: Label = texto(contenido, tam, color)
	l.position = lugar
	l.custom_minimum_size = Vector2(ancho, 0)
	add_child(l)
	return l


func _empezar() -> void:
	_estado.text = "Preparado · 0 vueltas"


func _cambiar_velocidad(valor: float) -> void:
	if not _volando:
		velocidad = valor
		_actualizar()


func _ajustar(mando: float, delta: float) -> void:
	_dial.value = clampf(velocidad + mando * delta * 0.6, 5.0, 11.5)


func _input(evento: InputEvent) -> void:
	if not activo or _volando or _auto != 0:
		return
	if evento.is_action_pressed("interactuar") or evento.is_action_pressed("saltar"):
		_lanzar()
		get_viewport().set_input_as_handled()


func _paso(delta: float) -> void:
	if not _volando:
		var mando: float = eje_x()
		if _auto != 0:
			var objetivo: float = snappedf(circular, 0.001) if _auto > 0 else 5.5
			mando = clampf((objetivo - velocidad) / maxf(delta * 0.6, 0.0001), -1.0, 1.0)
			_ajustar(mando, delta)
			if absf(velocidad - objetivo) <= 0.0011:
				_lanzar()
		else:
			_ajustar(mando, delta)
	else:
		_acumulado += delta * ACELERACION
		while _acumulado >= PASO and activo:
			_acumulado -= PASO
			_integrar()
	if activo and tiempo >= LIMITE_PARTIDA:
		var causa: String = "Pasaron 180 s sin lanzar: el satélite necesita velocidad tangencial para rodear la Tierra." if not _volando else "La sesión llegó a 180 s antes de completar la vuelta. Lanza antes para poder observarla completa."
		terminar(false, 0, causa)
	_actualizar()
	queue_redraw()


func _lanzar() -> void:
	if not activo or _volando:
		return
	_volando = true
	_dial.editable = false
	_lanzar_boton.disabled = true
	_lanzar_boton.text = "En vuelo…"
	vector_velocidad = Vector2(0, -velocidad)
	_trazo.append(posicion)
	sonar("tic")


func _gravedad(punto: Vector2) -> Vector2:
	var radio: float = punto.length()
	return -MU * punto / (radio * radio * radio)


func _integrar() -> void:
	# Velocity Verlet: dos evaluaciones de gravedad, paso fijo, sin reloj externo.
	var previa: Vector2 = posicion
	var aceleracion: Vector2 = _gravedad(posicion)
	posicion += vector_velocidad * PASO + aceleracion * (0.5 * PASO * PASO)
	vector_velocidad += (aceleracion + _gravedad(posicion)) * (0.5 * PASO)
	segundos_fisicos += PASO
	angulo += absf(previa.angle_to(posicion))
	var h: float = posicion.length() - RADIO
	minima = minf(minima, h)
	maxima = maxf(maxima, h)
	if int(segundos_fisicos) % 8 == 0:
		_trazo.append(posicion)
	if h <= CORTE_ATMOSFERA:
		_finalizar(false, "Con %.3f km/s falta velocidad: roza la atmósfera y cae. Corte del modelo: 120 km; sin arrastre." % velocidad)
	elif angulo >= TAU:
		if maxima - minima < margen:
			_finalizar(true, "Una vuelta completa: altura mínima %.1f km y máxima %.1f km. Diferencia %.1f km < %.0f km." % [minima, maxima, maxima - minima, margen])
		else:
			var causa: String = "Sobra velocidad: la órbita se alarga en una elipse." if velocidad > circular else "Falta velocidad: la órbita baja y se alarga en una elipse."
			_finalizar(false, "%s Diferencia %.1f km; debe ser menor que %.0f km." % [causa, maxima - minima, margen])
	elif posicion.length() >= 2.0 * (RADIO + altura) and vector_velocidad.length_squared() * 0.5 - MU / posicion.length() >= 0.0:
		_finalizar(false, "Con %.3f km/s sobra velocidad: la energía orbital no es negativa y el satélite se escapa." % velocidad)
	elif segundos_fisicos >= LIMITE_VUELO:
		_finalizar(false, "Sobra velocidad: la elipse se alarga y no cierra una vuelta en 9 600 s simulados. Reduce la velocidad.")


func _finalizar(gana: bool, causa: String) -> void:
	_trazo.append(posicion)
	get_parent().set_meta("orbita_anterior_%d" % dificultad, {"trazo": _trazo.duplicate(), "dato": "Anterior: %.3f km/s · mín. %.0f / máx. %.0f km" % [velocidad, minima, maxima]})
	print("ORBITA d%d v=%.3f min=%.3f max=%.3f giro=%.6f fisica=%.0f juego=%.3f" % [dificultad, velocidad, minima, maxima, angulo, segundos_fisicos, tiempo])
	terminar(gana, 100.0 if gana else 0.0, causa)


func _actualizar() -> void:
	_velocidad_texto.text = "Velocidad tangencial: %.3f km/s" % velocidad
	_lecturas.text = "Mínima: %.1f km · Máxima: %.1f km\nDiferencia: %.1f / < %.0f km\n\n%s" % [minima, maxima, maxima - minima, margen, _dato_anterior]
	_progreso.value = minf(angulo, TAU)
	if _volando:
		_estado.text = "Vuelta: %.0f %% · Tiempo simulado: %.0f s" % [minf(100.0, angulo / TAU * 100.0), segundos_fisicos]
	queue_redraw()


func _pantalla(punto: Vector2, escala: float) -> Vector2:
	return CENTRO + punto * escala


func _draw() -> void:
	draw_style_box(Estilo.caja(Estilo.PETROLEO, 12, 2), Rect2(24, 16, 650, 484))
	var alcance: float = RADIO + altura
	for trazo in [_trazo, _anterior]:
		for punto in trazo:
			alcance = maxf(alcance, punto.length())
	var escala: float = 148.0 / alcance
	_dibujar_tierra(escala)
	draw_arc(CENTRO, (RADIO + CORTE_ATMOSFERA) * escala, 0, TAU, 64, Color(Estilo.PAPEL, 0.45), 1.0, true)
	for i in range(1, _anterior.size()):
		if i % 4 < 2:
			draw_line(_pantalla(_anterior[i - 1], escala), _pantalla(_anterior[i], escala), Color(Estilo.PAPEL, 0.38), 2.0, true)
	if _trazo.size() > 1:
		var linea: PackedVector2Array = PackedVector2Array()
		for punto in _trazo:
			linea.append(_pantalla(punto, escala))
		draw_polyline(linea, Estilo.CIAN, 2.5, true)
	var sat: Vector2 = _pantalla(posicion, escala)
	draw_line(sat + Vector2(-17, 0), sat + Vector2(17, 0), Estilo.TINTA, 5)
	draw_rect(Rect2(sat - Vector2(20, 6), Vector2(12, 12)), Estilo.CREMA)
	draw_rect(Rect2(sat + Vector2(8, -6), Vector2(12, 12)), Estilo.CREMA)
	draw_rect(Rect2(sat - Vector2(6, 6), Vector2(12, 12)), Estilo.CIAN)
	if not _volando:
		draw_line(sat + Vector2(0, -14), sat + Vector2(0, -48), Estilo.CIAN, 3, true)
		draw_line(sat + Vector2(0, -48), sat + Vector2(-6, -38), Estilo.CIAN, 3, true)
		draw_line(sat + Vector2(0, -48), sat + Vector2(6, -38), Estilo.CIAN, 3, true)


func _dibujar_tierra(escala: float) -> void:
	# Siluetas esquematicas; los triangulos suaves dan volumen al disco.
	var radio: float = RADIO * escala
	var borde: PackedVector2Array = PackedVector2Array()
	for i in 32:
		borde.append(CENTRO + Vector2.from_angle(TAU * i / 32.0) * radio)
	draw_colored_polygon(borde, Estilo.PETROLEO)
	for i in 12:
		var a: float = TAU * float(i) / 12.0
		var b: float = a + TAU / 12.0
		var triangulo: PackedVector2Array = PackedVector2Array([CENTRO + Vector2(-0.2, -0.15) * radio, CENTRO + Vector2.from_angle(a) * radio, CENTRO + Vector2.from_angle(b) * radio])
		draw_colored_polygon(triangulo, Color(Estilo.PAPEL if i > 5 else Estilo.TINTA, 0.08 + 0.02 * (i % 3)))
	var america: PackedVector2Array = PackedVector2Array([Vector2(-0.60, -0.67), Vector2(-0.2, -0.82), Vector2(0.02, -0.65), Vector2(-0.11, -0.3), Vector2(-0.25, -0.22), Vector2(-0.22, 0.02), Vector2(-0.06, 0.13), Vector2(0.04, 0.43), Vector2(-0.18, 0.77), Vector2(-0.31, 0.50), Vector2(-0.32, 0.22), Vector2(-0.50, 0.08), Vector2(-0.43, -0.16), Vector2(-0.7, -0.29)])
	var africa: PackedVector2Array = PackedVector2Array([Vector2(0.15, -0.62), Vector2(0.42, -0.78), Vector2(0.68, -0.62), Vector2(0.82, -0.3), Vector2(0.54, -0.12), Vector2(0.32, -0.12), Vector2(0.37, 0.1), Vector2(0.55, 0.22), Vector2(0.43, 0.58), Vector2(0.2, 0.45), Vector2(0.09, 0.17), Vector2(0.15, -0.05), Vector2(0.0, -0.19), Vector2(0.04, -0.37)])
	for tierra in [america, africa]:
		var puntos: PackedVector2Array = PackedVector2Array()
		for punto in tierra:
			puntos.append(CENTRO + punto * radio)
		draw_colored_polygon(puntos, Estilo.VERDE)
		draw_polyline(puntos, Estilo.CREMA, 1, true)
	draw_polyline(borde, Estilo.PAPEL_SOMBRA, 1.5, true)


func jugar_solo(acierta: bool) -> void:
	# Mueve el mismo deslizador y pulsa el mismo lanzamiento; no fuerza resultados.
	_auto = 1 if acierta else -1

extends "res://nucleo/minijuego.gd"

# Fechas y contenido: fichas locales y FUENTES.md; no se citan textos de misiones.
# El anio del disco figura en el campo fuente de disco_apolo11.
const HITOS: Array = [
	{"ficha": "observatorio_quito", "titulo": "Observatorio de Quito", "fecha": "1873", "epoca": "Siglo XIX.", "dato": "Pertenece a la Escuela Politécnica Nacional."},
	{"ficha": "estacion_cotopaxi", "titulo": "Estación Quito", "fecha": "1957", "epoca": "Mediados del siglo XX.", "dato": "Al pie del Cotopaxi, a 3 650 m."},
	{"ficha": "disco_apolo11", "titulo": "Disco del Apolo 11", "fecha": "1969", "epoca": "Mensajes rumbo a la Luna.", "dato": "Llevó mensajes de 73 países, incluido Ecuador."},
	{"ficha": "apolo_soyuz_1975", "titulo": "Apoyo al Apolo-Soyuz", "fecha": "1975", "epoca": "Después del viaje del disco.", "dato": "Quito participó con el indicativo QUI en la red de apoyo."},
	{"ficha": "sts2_despedida", "titulo": "Despedida del STS-2", "fecha": "14-11-1981", "epoca": "El cierre de la estación.", "dato": "Engle y Truly se despidieron de 75 empleados."},
	{"ficha": "estacion_entrega", "titulo": "Entrega a Ecuador", "fecha": "01-07-1982", "epoca": "Tras el cierre de la estación.", "dato": "La instalación se entregó a Ecuador, a CLIRSEN."},
	{"ficha": "exa_2007", "titulo": "Nace la EXA", "fecha": "2007", "epoca": "Comienzos del siglo XXI.", "dato": "Organización no gubernamental sin fines de lucro."},
	{"ficha": "pegaso_lanzamiento", "titulo": "Lanzamiento de Pegaso", "fecha": "2013", "epoca": "Después del nacimiento de EXA.", "dato": "Se lanzó desde Jiuquan, según el equipo de Pegaso."},
	{"ficha": "acuerdos_artemisa", "titulo": "Acuerdos Artemisa", "fecha": "21-06-2023", "epoca": "Después de Pegaso.", "dato": "Ecuador fue el país firmante n.º 26."}
]
const PISTAS_CLARAS: Array[String] = [
	"Primero: siglo XIX.", "Antes del disco lunar.", "Antes de Apolo-Soyuz.",
	"Antes del STS-2.", "Antes de la entrega.", "Antes de nacer EXA.",
	"Antes de Pegaso.", "Antes de Artemisa.", "Último hito."
]

var orden: Array[int] = []
var seleccion: int = 0
var tomada: bool = false
var comprobaciones: int = 0
var max_comprobaciones: int = 4
var _marcas: Array[bool] = []
var _reveladas: Dictionary = {}
var _pistas_claras: Dictionary = {}
var _paneles: Array[Panel] = []
var _titulos: Array[Label] = []
var _pistas: Array[Label] = []
var _fechas: Array[Label] = []
var _estados: Array[Label] = []
var _contador: Label
var _detalle: Label
var _mensaje: Label
var _comprobar_boton: Button
var _arrastrando: bool = false
var _auto: int = 0
var _pulso: float = 0.0
var _auto_inicio: bool = false


func _preparar() -> void:
	# En la primera dificultad solo hay un par invertido.
	if dificultad == 1:
		orden.assign([0, 2, 1, 7, 8])
	elif dificultad == 2:
		orden.assign([2, 0, 1, 5, 3, 8, 7])
	else:
		orden.assign([2, 0, 1, 5, 3, 4, 8, 6, 7])
		max_comprobaciones = 3
	_marcas.resize(orden.size())
	_marcas.fill(false)
	_contador = _etiqueta("", Vector2(24, 10), Vector2(1072, 30), 20)
	_etiqueta("MÁS ANTIGUO  →  MÁS RECIENTE", Vector2(24, 43), Vector2(1072, 28), 16)
	for i in orden.size():
		var rect: Rect2 = _rect_tarjeta(i)
		var panel: Panel = Panel.new()
		panel.position = rect.position
		panel.size = rect.size
		panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
		add_child(panel)
		_paneles.append(panel)
		_estados.append(_etiqueta("", rect.position + Vector2(8, 8), Vector2(rect.size.x - 16, 24), 16))
		_titulos.append(_etiqueta("", rect.position + Vector2(8, 38), Vector2(rect.size.x - 16, 104), 16))
		_pistas.append(_etiqueta("", rect.position + Vector2(8, 149), Vector2(rect.size.x - 16, 100), 16))
		_fechas.append(_etiqueta("", rect.position + Vector2(5, 263), Vector2(rect.size.x - 10, 30), 16))
	_mensaje = _etiqueta("", Vector2(24, 383), Vector2(1072, 26), 16)
	_detalle = _etiqueta("", Vector2(24, 414), Vector2(1072, 56), 18)
	_comprobar_boton = Estilo.boton("Comprobar · Espacio", 18, true)
	_comprobar_boton.position = Vector2(806, 474)
	_comprobar_boton.size = Vector2(290, 42)
	_comprobar_boton.focus_mode = Control.FOCUS_NONE
	_comprobar_boton.pressed.connect(_comprobar)
	add_child(_comprobar_boton)
	_etiqueta("E / Intro: tomar o soltar · ← →: elegir o mover", Vector2(24, 479), Vector2(770, 30), 16)
	_refrescar()


func _etiqueta(contenido: String, pos: Vector2, medida: Vector2, tam: int) -> Label:
	var etiqueta: Label = texto(contenido, tam, Estilo.TINTA, 600)
	etiqueta.position = pos
	etiqueta.custom_minimum_size = Vector2(medida.x, 0)
	etiqueta.size = medida
	add_child(etiqueta)
	return etiqueta


func _rect_tarjeta(i: int) -> Rect2:
	var ancho: float = (1072.0 - float(orden.size() - 1) * 8.0) / float(orden.size())
	return Rect2(24.0 + float(i) * (ancho + 8.0), 79.0, ancho, 298.0)


func _empezar() -> void:
	_refrescar()


func _paso(delta: float) -> void:
	if _auto == 0:
		return
	_pulso += delta
	if _pulso < 0.3:
		return
	_pulso = 0.0
	# Mismas operaciones de seleccion, movimiento adyacente y comprobacion que la persona.
	if not _auto_inicio:
		_auto_inicio = true
		if _auto < 0:
			seleccion = 0
			_mover(1)
		_comprobar()
		return
	if _auto < 0:
		_comprobar()
		return
	for i in range(orden.size() - 1):
		if orden[i] > orden[i + 1]:
			seleccion = i + 1
			_mover(-1)
			return
	_comprobar()


func _input(evento: InputEvent) -> void:
	if not activo or _auto != 0:
		return
	if evento.is_action_pressed("saltar"):
		_comprobar()
	elif evento.is_action_pressed("interactuar"):
		tomada = not tomada
		_refrescar()
	elif evento.is_action_pressed("mover_izquierda"):
		_desplazar(-1)
	elif evento.is_action_pressed("mover_derecha"):
		_desplazar(1)
	elif evento.is_action_pressed("mover_arriba"):
		seleccion = maxi(seleccion - 1, 0)
		_refrescar()
	elif evento.is_action_pressed("mover_abajo"):
		seleccion = mini(seleccion + 1, orden.size() - 1)
		_refrescar()
	else:
		return
	get_viewport().set_input_as_handled()


func _desplazar(direccion: int) -> void:
	if tomada:
		_mover(direccion)
	else:
		seleccion = clampi(seleccion + direccion, 0, orden.size() - 1)
		_refrescar()


func _mover(direccion: int) -> void:
	var destino: int = seleccion + direccion
	if destino < 0 or destino >= orden.size():
		return
	var hito: int = orden[seleccion]
	orden[seleccion] = orden[destino]
	orden[destino] = hito
	seleccion = destino
	_marcas.fill(false)
	_refrescar()


func _gui_input(evento: InputEvent) -> void:
	if not activo or _auto != 0:
		return
	if evento is InputEventMouseButton and evento.button_index == MOUSE_BUTTON_LEFT:
		if evento.pressed:
			for i in orden.size():
				if _rect_tarjeta(i).has_point(evento.position):
					seleccion = i
					tomada = true
					_arrastrando = true
					grab_focus()
					_refrescar()
					break
		else:
			_arrastrando = false
			tomada = false
			_refrescar()
	elif evento is InputEventMouseMotion and _arrastrando:
		if (evento.button_mask & MOUSE_BUTTON_MASK_LEFT) == 0:
			_arrastrando = false
			tomada = false
			_refrescar()
			return
		for i in orden.size():
			if _rect_tarjeta(i).has_point(Vector2(evento.position.x, 100)):
				while seleccion != i:
					_mover(1 if i > seleccion else -1)
				break


func _pista_clara(hito: int) -> String:
	var anteriores: Array[int] = []
	for otro in orden:
		if otro < hito:
			anteriores.append(otro)
	if anteriores.is_empty():
		return "Es el hito más antiguo de estas %d tarjetas." % orden.size()
	anteriores.sort()
	var anterior: Dictionary = HITOS[anteriores.back()]
	return "Va después de «%s»." % anterior["titulo"]


func _causa() -> String:
	for i in range(orden.size() - 1):
		if orden[i] > orden[i + 1]:
			var antes: Dictionary = HITOS[orden[i + 1]]
			var despues: Dictionary = HITOS[orden[i]]
			return "«%s» (%s) vino antes que «%s» (%s); ese par quedó al revés." % [antes["titulo"], antes["fecha"], despues["titulo"], despues["fecha"]]
	return "Todos los hitos avanzan de la fecha más antigua a la más reciente."


func _comprobar() -> void:
	if not activo:
		return
	comprobaciones += 1
	tomada = false
	_arrastrando = false
	var bien: int = 0
	for i in orden.size():
		var izquierda: bool = i == 0 or orden[i - 1] < orden[i]
		var derecha: bool = i == orden.size() - 1 or orden[i] < orden[i + 1]
		_marcas[i] = izquierda and derecha
		if _marcas[i]:
			_reveladas[orden[i]] = true
			bien += 1
		else:
			_pistas_claras[orden[i]] = true
	_refrescar()
	if bien == orden.size():
		terminar(true, 100.0, "Ordenaste %d hitos: de 1873 al 21-06-2023. El disco llevó mensajes de 73 países, incluido Ecuador." % orden.size())
	elif comprobaciones >= max_comprobaciones:
		terminar(false, 0.0, "Usaste las %d comprobaciones. %s" % [max_comprobaciones, _causa()])
	else:
		sonar("pagina")


func _refrescar() -> void:
	_contador.text = "%d tarjetas · Comprobaciones: %d de %d" % [orden.size(), comprobaciones, max_comprobaciones]
	for i in orden.size():
		var hito: Dictionary = HITOS[orden[i]]
		var fondo: Color = Estilo.CREMA if _marcas[i] else Estilo.PAPEL
		var borde: Color = Estilo.CIAN_MEDIO if i == seleccion else Estilo.TINTA_SUAVE
		_paneles[i].add_theme_stylebox_override("panel", Estilo.caja(fondo, 5, 4 if i == seleccion else 2, borde, 0))
		_estados[i].text = "%d · %s" % [i + 1, "✓" if _marcas[i] else ("↔" if i == seleccion and tomada else "○")]
		_titulos[i].text = hito["titulo"]
		_pistas[i].text = PISTAS_CLARAS[orden[i]] if _pistas_claras.has(orden[i]) and not _marcas[i] else String(hito["epoca"])
		# Las fechas ya descubiertas se conservan, pero las marcas se borran al mover.
		_fechas[i].text = hito["fecha"] if _reveladas.has(orden[i]) else "Fecha oculta"
		_fechas[i].add_theme_color_override("font_color", Estilo.PETROLEO)
	var elegido: Dictionary = HITOS[orden[seleccion]]
	_mensaje.text = "Tarjeta %d %s · ✓ = orden con sus vecinas · Las fechas descubiertas se conservan." % [seleccion + 1, "tomada" if tomada else "seleccionada"]
	var pista: String = _pista_clara(orden[seleccion]) if _pistas_claras.has(orden[seleccion]) else String(elegido["epoca"])
	_detalle.text = "%s: %s %s" % [elegido["titulo"], elegido["dato"], pista]


func jugar_solo(acierta: bool) -> void:
	_auto = 1 if acierta else -1
	_pulso = 0.0


**Consecuencia de diseño:** la protagonista camina bajo la Tierra casi llena, la misma luz que vio como luz cenicienta desde el Mirador. Encaja con la luz de noche de la [[Biblia de arte]] §7 (principal azul fría, sombra azul profunda). La cámara alta no ve el cielo, así que hay 4 tomas con cámara baja: llegada, foto con el sitio, banderas y despedida.

**Cómo se calculó:** distancia angular entre el sitio y los puntos subsolar y subterrestre de `externos/nasa_svs_5587_tabla/mooninfo_2026.json`, hora por hora. Hay que repetirlo con Horizons antes del texto final (F2-15).

### 4.3 Qué se hace

**Caminar a 1/6 g (3.1)**
- 1,624 m/s² (L6). Al acelerar y frenar se nota la inercia: frenar exige anticipación. El paso a saltos es el más eficiente.
- Sin sonido exterior: solo traje, respiración y la voz de Órbita por la radio del casco.
- La caja de cartón aterriza **fuera del límite de descenso de 2 km** (R4). El mapa lunar está a escala 1:4 y el cuaderno lo dice: los 2 km se recorren en unos 500 m de juego.
- Órbita lleva un casco de burbuja y flota un poco más porque pesa menos; sus huellas son las únicas de gato en la Luna (chiste recurrente de C).

**Recolectar muestras con las herramientas del Apolo 11 (3.2 y 3.3)**

| Herramienta | Para qué | Objetivo en el juego | Dato |
|---|---|---|---|
| Cucharón de caja | Suelo y fragmentos pequeños | Regolito fino junto a un cráter pequeño | L1 |
| Pinzas pequeñas | Rocas sueltas | Una roca oscura de basalto | L1 |
| Tubo de núcleo de 2 cm y martillo | Una columna que conserva las capas | Dos golpes de más rompen el ritmo; uno de menos deja el tubo corto | L3 |
| Bolsa numerada, croquis y ficha | Ligar la muestra a su registro | 3 muestras registradas | L4 |

- **Bolsa equivocada:** la muestra no se pierde; se corrige el registro, igual que en el taller se anota qué cambió.
- **Nadie se lleva nada de la Luna:** al despertar, las bolsas vuelven como páginas del cuaderno, no como rocas (B).
- **Lo que no es del Apolo 11** (rastrillo, tubos de 4 cm, gnomon con 3 fotos antes y 1 después; el gnomon en el Apolo 11 es **pv**) va en la secundaria S8, declarado como equipo de los Apolo 15 a 17 (L2, L3, L4).

**Ver el Apolo respetando su sitio (3.4)**
- Anillo de luz cian tenue a 75 m de la etapa de descenso (R3). El cian es interacción según la biblia; aquí significa «mira, no toques». Cruzarlo no castiga: la protagonista se detiene sola y Órbita dice por qué. El juego lo presenta como buena costumbre, no como ley (R3 son recomendaciones; R5 solo obliga a acuerdos con NASA).
- Con zoom se ven la etapa de descenso, sus patas y las huellas de 1969. La placa se ve sin texto legible; su contenido no se cita (pv).
- **La bandera del Apolo 11 no se muestra en pie** (L11). Órbita cuenta que, según Aldrin, la derribó el despegue.
- **Momento emocional:** Órbita recuerda que el mensaje de Ecuador viajó en un disco del tamaño de una moneda de 50 centavos (A4). Que el disco quedara en el sitio es **pv**: hasta verificarlo, el texto dice «viajó hasta aquí», no «está aquí».
- **Foto «vista con el Apolo»:** la protagonista y Órbita en primer plano, la etapa de descenso al fondo y la Tierra arriba. Es la recompensa de la misión y la imagen del capítulo.

**Colocar juntas las banderas de Estados Unidos y Ecuador (3.5)**

1. **Elegir el sitio:** la «Loma de las Dos Banderas» (ficción), a unos 150 m de la etapa de descenso: el doble del radio de protección y sin huellas históricas.
2. **Armar los conjuntos:** dos banderas nuevas del mismo tamaño, 0,91 × 1,52 m, con mástil de 2,44 m y barra horizontal (L10). Malla fija con pliegues modelados (B).
3. **Hincar el mástil:** golpear con ritmo, no con fuerza. La profundidad real del Apolo 11 es pv; la mecánica no depende de la cifra.
4. **Extender la barra:** si no se extiende del todo, la tela queda ondulada, como le pasó a la tripulación del Apolo 11 (L10, Platoff). No hay viento.
5. **Igualar alturas:** las dos a la misma altura, separadas lo justo para que ninguna tape a la otra.
6. **Ceremonia:** la protagonista recuerda que en 2011 Ronnie Nader dijo que la EXA quería poner la bandera ecuatoriana en la Luna (*Sobrevuelo* 2011, p. 25; 03a). Se presenta como un sueño dicho en voz alta, no como un hecho.
7. **Amanece:** la luz del Sol entra rasante y la escena queda 10 s en silencio, sin interfaz.

- **Dato:** el art. II del Tratado del Espacio prohíbe la apropiación nacional (R1). Ecuador es el firmante n.º 26 de los Acuerdos Artemisa (E1), lo que no le da un vuelo lunar. La misión expresa cooperación.
- **Bandera de Ecuador:** con escudo, para que no se confunda con la de Colombia; proporción 3:2 según el instructivo de 2009 (copia no oficial, pv contra el original). La Constitución la reconoce como símbolo patrio (R8). Antes de publicar, opinión de un abogado (03a, #25).
- **Reglas fijas:** no se pueden soltar, tirar ni dañar; no hay animación de caída; no se toca la bandera histórica; no son premio ni chiste.

### 4.4 Cómo se vuelve (3.6)

1. **Orden del regreso** en el cuaderno, 6 pasos: despegue de la etapa de ascenso, encuentro en órbita lunar, separación del módulo de servicio, reentrada con el escudo térmico, paracaídas y amerizaje (L12, L13).
2. **Reentrada jugable (C):** la caja de cartón cae hacia la Tierra y el jugador mantiene el escudo por delante, dentro de un margen de ángulo. Es un lazo de control, el oficio de la protagonista.
3. **Sensaciones (A):** el calor de la reentrada se vuelve el sol de la mañana en la cara; los paracaídas, la cortina que abre Elena.
4. **Montaje cruzado:** antes de despertar, 8 s de Elena en el patio, de noche, mirando la Luna acostada (lectura C de la frase).
5. **Amerizaje:** Órbita vuelca el vaso de agua de la mesita. Ella despierta mojada y riéndose a las 06:30.
6. **Cierre:** el cuaderno muestra las fichas del sueño con el sello «Sueño» y los datos con «Dato medido». El Apolo 11 trajo 21,5 kg; el 17, 110,5 kg; las 6 misiones, 382 kg (L5 corr.). Ella trajo 4 bolsas que pesan cero, y una idea.

**Volver a soñar:** desde el final del acto III, la cama ofrece «Soñar otra vez» cualquier noche. Las banderas siguen donde se plantaron. «Despertar» está siempre en el menú del cuaderno: no hay muerte en el sueño.

### 4.5 La frase ambigua: «siendo vista con el Apolo que llegó a la Tierra»

| Lectura | Qué significaría | Cómo se juega | A favor | En contra |
|---|---|---|---|---|
| **A** | Verla **junto al módulo lunar del Apolo 11**, que sigue en la Luna | Foto de 3.4 con la etapa de descenso al fondo | Fiel a L12 y R3; barata; ya está en la ruta | La etapa de descenso nunca «llegó a la Tierra» |
| **B** | El Apolo que **sí volvió**: el módulo de mando | Regreso de 3.6 con sus 6 pasos y el lazo de control del escudo, con la caja de cartón en vez de la cápsula real | Cumple «llegó a la Tierra» al pie de la letra (L13) | No muestra la cápsula real, para evitar insignias |
| **C** | Ser **vista desde la Tierra** | Montaje de 8 s de Elena mirando la Luna desde el patio | Cierra el arco familiar | No muestra ningún Apolo |
| **D** | **Testigo en 1969** o vista por un astronauta | El sueño ocurre en 1969, o una silueta la saluda | Muy emotiva | Mostraría astronautas reales o lo parecería; 2 cinemáticas caras. **No se recomienda** |

**Recomendación (F2-08):** A + B + C, como está en la ruta. D, descartada.

> **Pregunta abierta para Guillermo:** ¿qué quisiste decir con «siendo vista con el Apolo que llegó a la Tierra»? ¿A, B, C, D, una mezcla u otra cosa?

