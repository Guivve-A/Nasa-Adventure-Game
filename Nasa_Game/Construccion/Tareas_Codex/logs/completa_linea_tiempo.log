var aviso: String = ""
var aviso_t: float = 0.0
var final_t: float = 0.0
var gana: bool = false
var causa: String = ""
var _auto: int = 0
var _pulso: bool = false
var _acum: float = 0.0
var _intro: float = 0.0
var _nuevo_peligro: float = 2.7
var _azar: RandomNumberGenerator = RandomNumberGenerator.new()

func _preparar() -> void:
	texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	limite = [100.0, 90.0, 80.0][dificultad - 1]
	radio_placa = [16.0, 13.0, 10.0][dificultad - 1]
	_azar.seed = int(parametros.get("semilla", 7319 + dificultad))
	# Busca el primer anio de cuatro cifras en texto, luego en fuente (disco).
	var expresion: RegEx = RegEx.new()
	expresion.compile("(?:18|19|20)[0-9]{2}")
	for id in FICHAS:
		var ficha: Dictionary = Juego.ficha(id)
		if ficha.is_empty():
			continue
		var resultado: RegExMatch = expresion.search(str(ficha.get("texto", "")))
		if resultado == null:
			resultado = expresion.search(str(ficha.get("fuente", "")))
		if id == "estacion_entrega":
			var fechas: Array[RegExMatch] = expresion.search_all(str(ficha.get("texto", "")))
			if not fechas.is_empty():
				resultado = fechas.back()
		if resultado != null:
			hitos.append({"id": id, "anio": int(resultado.get_string()), "icono": FICHAS.find(id)})
	hitos.sort_custom(func(a: Dictionary, b: Dictionary) -> bool: return int(a["anio"]) < int(b["anio"]))
	for fila in hitos.size():
		var columna: int = (fila * 2 + 1) % 3
		for c in 3:
			var indice: int = fila if c == columna else (fila + 1 + (c if c < columna else c - 1)) % hitos.size()
			placas.append({"fila": fila, "columna": c, "hito": indice, "pos": Vector2(COLUMNAS[c], 55.0 + fila * 70.0), "revelada": false})
	queue_redraw()

func _empezar() -> void:
	fase = 0
	sonar("radio")

func jugar_solo(acierta: bool) -> void:
	_auto = 1 if acierta else -1

func _input(evento: InputEvent) -> void:
	if activo and _auto == 0 and (evento.is_action_pressed("interactuar") or evento.is_action_pressed("saltar")):
		_pulso = true
		get_viewport().set_input_as_handled()

func _paso(delta: float) -> void:
	_acum += delta
	while _acum >= DT and activo:
		_acum -= DT
		if _auto != 0:
			_piloto()
		else:
			mando = Vector2(eje_x(), eje_y()).limit_length()
		_tic(DT)
	queue_redraw()

func _tic(dt: float) -> void:
	_animar(dt)
	if fase == 0:
		_intro += dt
		_pulso = false
		if _intro >= 2.0:
			fase = 1
		return
	if fase == 2:
		final_t += dt
		if final_t >= 1.3:
			terminar(gana, puntos, causa)
		return
	reloj += dt
	if reloj >= limite:
		_final(false, "Se acabó el tiempo antes de completar los nueve hitos en orden.")
		return
	if descanso > 0.0:
		descanso -= dt
		_pulso = false
		return
	var pulsado: bool = _pulso
	_pulso = false
	if pulsado and salto <= 0.0:
		salto = 0.75
		sonar("salto")
	velocidad = velocidad.move_toward(mando * rapidez, dt * 320.0)
	jugadora += velocidad * dt
	jugadora.x = clampf(jugadora.x, 37.0, 243.0)
	var cima: float = 55.0 + siguiente * 70.0
	jugadora.y = clampf(jugadora.y, maxf(-8.0, cima - 88.0), cima + 12.0)
	if salto > 0.0:
		salto = maxf(0.0, salto - dt)
		altura = sin(PI * salto / 0.75) * 14.0
		if salto <= 0.0:
			altura = 0.0
			_aterrizar()
	if fase != 1 or descanso > 0.0:
		return
	_nuevo_peligro -= dt
	if _nuevo_peligro <= 0.0:
		_nuevo_peligro = [3.5, 2.6, 1.9][dificultad - 1]
		var coco: bool = _azar.randf() < 0.6
		var lado: int = -1 if _azar.randf() < 0.5 else 1
		peligros.append({"pos": Vector2(_azar.randf_range(45, 235), cima + 65.0) if coco else Vector2(30 if lado > 0 else 250, cima - 25.0), "vel": Vector2(10.0 * lado, -[24.0, 32.0, 42.0][dificultad - 1]) if coco else Vector2(lado * [28.0, 39.0, 51.0][dificultad - 1], 0), "coco": coco})
	for i in range(peligros.size() - 1, -1, -1):
		var peligro: Dictionary = peligros[i]
		var pos: Vector2 = peligro["pos"]
		var vel: Vector2 = peligro["vel"]
		pos += vel * dt
		peligro["pos"] = pos
		if inmune <= 0.0 and altura < 5.0 and pos.distance_to(jugadora) < (8.0 if bool(peligro["coco"]) else 10.0):
			peligros.remove_at(i)
			_golpe("Los cocos y las iguanas te alcanzaron a ras del mosaico; salta para pasarlos.")
		elif pos.y < cima - 110.0 or pos.x < 20.0 or pos.x > 260.0:
			peligros.remove_at(i)

func _aterrizar() -> void:
	for placa in placas:
		if int(placa["fila"]) != siguiente:
			continue
		var p: Vector2 = placa["pos"]
		if absf(jugadora.x - p.x) <= radio_placa and absf(jugadora.y - p.y) <= 9.0:
			if int(placa["hito"]) != siguiente:
				_golpe("Esa placa pertenece a otro momento: sigue el pictograma pendiente antes de subir.")
				return
			placa["revelada"] = true
			var hito: Dictionary = hitos[siguiente]
			aviso = "%s %d" % [NOMBRES[int(hito["icono"])], int(hito["anio"])]
			aviso_t = 2.3
			puntos += 100 + 25 * vidas
			_estallar(p, Estilo.DORADO)
			destello = 0.12
			descanso = 0.85
			velocidad = Vector2.ZERO
			siguiente += 1
			sonar("recoger")
			if siguiente == hitos.size():
				_final(true, "Del observatorio de %d a los Acuerdos de %d: cada hito ocupa su lugar en el tiempo." % [int(hitos[0]["anio"]), int(hitos.back()["anio"])])
			return

func _golpe(motivo: String) -> void:
	if inmune > 0.0:
		return
	vidas -= 1
	inmune = 2.0
	destello = 0.25
	sacudida = 0.3
	_estallar(jugadora, Estilo.CORAL)
	sonar("error")
	jugadora.y = 55.0 + siguiente * 70.0 - 25.0
	velocidad = Vector2.ZERO
	salto = 0.0
	altura = 0.0
	if vidas <= 0:
		_final(false, motivo)

func _final(superado: bool, motivo: String) -> void:
	fase = 2
	gana = superado
	causa = motivo
	sonar("logro" if superado else "error")

func _piloto() -> void:
	# Solo manda direcciones y salto; no escribe placas, vidas ni progreso.
	mando = Vector2.ZERO
	if fase != 1 or descanso > 0.0:
		return
	var objetivo: Vector2 = jugadora
	for placa in placas:
		if int(placa["fila"]) == siguiente and ((int(placa["hito"]) == siguiente) == (_auto > 0)):
			objetivo = placa["pos"]
			break
	var diferencia: Vector2 = objetivo - jugadora - velocidad * 0.09
	mando.x = signf(diferencia.x) if absf(diferencia.x) > 1.0 else 0.0
	mando.y = signf(diferencia.y) if absf(diferencia.y) > 1.0 else 0.0
	mando = mando.limit_length()
	if salto <= 0.0:
		if jugadora.distance_to(objetivo) < 7.0:
			_pulso = true
		for peligro in peligros:
			var pos: Vector2 = peligro["pos"]
			var vel: Vector2 = peligro["vel"]
			if (pos + vel * 0.24).distance_to(jugadora) < 13.0:
				_pulso = true

func _animar(dt: float) -> void:
	inmune = maxf(0.0, inmune - dt)
	destello = maxf(0.0, destello - dt)
	sacudida = maxf(0.0, sacudida - dt)
	aviso_t = maxf(0.0, aviso_t - dt)
	for i in range(particulas.size() - 1, -1, -1):
		var p: Dictionary = particulas[i]
		p["vida"] = float(p["vida"]) - dt
		var pos: Vector2 = p["pos"]
		var vel: Vector2 = p["vel"]
		p["pos"] = pos + vel * dt
		p["vel"] = vel + Vector2(0, -45) * dt
		if float(p["vida"]) <= 0.0:
			particulas.remove_at(i)

func _estallar(pos: Vector2, color: Color) -> void:
	for i in 18:
		particulas.append({"pos": pos, "vel": Vector2.from_angle(_azar.randf() * TAU) * _azar.randf_range(9, 30), "vida": 0.7, "color": color})

func _camara() -> float:
	return maxf(0.0, jugadora.y - 28.0)

func _pantalla(pos: Vector2) -> Vector2:
	return Vector2(pos.x, 111.0 - pos.y + _camara())

func _r(x: float, y: float, w: float, h: float, color: Color) -> void:
	draw_rect(Rect2(floorf(x), floorf(y), w, h), color)

func _sprite(mapa: Array, pos: Vector2, color: Color, escala: int = 1) -> void:
	var pal: Dictionary = {"h": Estilo.TERRACOTA, "p": Estilo.CREMA, "c": Estilo.DORADO, "j": Estilo.PETROLEO}
	for y in mapa.size():
		var fila: String = mapa[y]
		for x in fila.length():
			var c: String = fila[x]
			if c != ".":
				var tinta: Color = pal.get(c, color)
				_r(pos.x + x * escala, pos.y + y * escala, escala, escala, tinta)

func _escribir(t: String, x: float, y: float, color: Color, escala: int = 1) -> void:
	var cx: float = x
	for i in t.length():
		var c: String = t[i]
		var mapa: Array = LETRAS.get(c, LETRAS[" "])
		_sprite(mapa, Vector2(cx, y), color, escala)
		var fila: String = mapa[0]
		cx += (fila.length() + 1) * escala

func _draw() -> void:
	draw_set_transform(Vector2.ZERO, 0.0, Vector2(4, 4))
	_r(0, 0, 280, 130, Estilo.NOCHE)
	var desvio: Vector2 = Vector2(roundf(sin(reloj * 83.0)), roundf(cos(reloj * 91.0))) if sacudida > 0.0 else Vector2.ZERO
	draw_set_transform(desvio * 4, 0.0, Vector2(4, 4))
	# Laterales: casas del cerro y plantas; el centro es un mosaico escalonado.
	for i in 12:
		var y: float = fposmod(i * 15.0 + _camara() * 0.5, 130.0)
		for x in [3, 257]:
			_r(x, y, 19, 13, Estilo.TINTA if i % 2 == 0 else Estilo.PETROLEO.darkened(0.5))
			_r(x + 3, y + 4, 3, 3, Estilo.NARANJA)
			_r(x + 11, y + 4, 3, 3, Estilo.DORADO)
	for i in range(-2, 55):
		var y: float = _pantalla(Vector2(0, i * 14.0)).y
		if y < 24 or y > 132:
			continue
		_r(30, y, 220, 13, Estilo.TINTA_SUAVE if i % 5 == 0 else Estilo.TINTA)
		_r(30, y, 220, 1, Estilo.NARANJA if i % 5 == 0 else Estilo.PETROLEO)
		for x in range(33, 249, 9):
			_r(x + (4 if i % 2 else 0), y + 5, 3, 2, Estilo.PETROLEO if i % 3 else Estilo.TERRACOTA)
		_r(28, y, 2, 14, Estilo.CREMA)
		_r(250, y, 2, 14, Estilo.CREMA)
	for placa in placas:
		var p: Vector2 = _pantalla(placa["pos"])
		if p.y < 29.0 or p.y > 125.0:
			continue
		var fila: int = placa["fila"]
		var indice: int = placa["hito"]
		var hito: Dictionary = hitos[indice]
		var revelada: bool = placa["revelada"]
		var borde: Color = Estilo.DORADO if revelada else Estilo.PETROLEO
		if dificultad == 1 and fila == siguiente and indice == siguiente:
			borde = Estilo.CIAN
		_r(p.x - 19, p.y - 12, 38, 25, borde)
		_r(p.x - 18, p.y - 11, 36, 22, Estilo.NOCHE)
		_sprite(ICONOS[int(hito["icono"])], p + Vector2(-4, -9), Estilo.CREMA if fila <= siguiente else Estilo.TINTA_SUAVE)
		if revelada:
			_escribir(str(hito["anio"]), p.x - 15, p.y + 1, Estilo.DORADO, 2)
		else:
			_escribir("E", p.x - 1, p.y + 3, Estilo.CIAN if fila == siguiente else Estilo.PETROLEO)
	for peligro in peligros:
		var p: Vector2 = _pantalla(peligro["pos"])
		if p.y > 30 and p.y < 126:
			_sprite(COCO if bool(peligro["coco"]) else IGUANA, p - Vector2(4, 4), Estilo.NARANJA if bool(peligro["coco"]) else Estilo.CORAL)
	for particula in particulas:
		var p: Vector2 = _pantalla(particula["pos"])
		var color: Color = particula["color"]
		_r(p.x, p.y, 1, 1, color)
	var chica: Vector2 = _pantalla(jugadora)
	_r(chica.x - 3, chica.y, 7, 2, Estilo.PETROLEO)
	if inmune <= 0.0 or fmod(inmune, 0.3) > 0.15:
		_sprite(CHICA, chica - Vector2(3, 10 + altura), Estilo.CREMA)
	draw_set_transform(Vector2.ZERO, 0.0, Vector2(4, 4))
	_r(0, 0, 280, 29, Estilo.NOCHE)
	_r(0, 28, 280, 1, Estilo.PETROLEO)
	_escribir(str(puntos).pad_zeros(4), 4, 2, Estilo.CREMA, 2)
	_escribir("%d/9" % siguiente, 104, 2, Estilo.DORADO, 2)
	for i in 3:
		_sprite(["#.#", "###", ".#."], Vector2(169 + 12 * i, 4), Estilo.CREMA if i < vidas else Estilo.TINTA_SUAVE, 2)
	_escribir(str(int(ceil(maxf(0, limite - reloj)))).pad_zeros(3), 249, 2, Estilo.CREMA, 2)
	if siguiente < hitos.size():
		var hito: Dictionary = hitos[siguiente]
		_escribir("SIGUE", 4, 19, Estilo.CIAN)
		_sprite(ICONOS[int(hito["icono"])], Vector2(28, 17), Estilo.CREMA)
		_escribir(NOMBRES[int(hito["icono"])], 43, 19, Estilo.PAPEL)
	if aviso_t > 0.0:
		_r(0, 119, 280, 11, Estilo.NOCHE)
		_escribir(aviso, 7, 122, Estilo.DORADO)
	if destello > 0.0:
		_r(28, 29, 224, 101, Color(Estilo.CREMA if descanso > 0 else Estilo.CORAL, destello))
	if fase == 0:
		_r(34, 40, 212, 62, Estilo.NOCHE)
		for i in 3:
			_r(108 + i * 20, 76 - i * 9, 20, 4, Estilo.CIAN)
		_sprite(CHICA, Vector2(112, 63), Estilo.CREMA)
		_escribir("SUBE LOS HITOS EN ORDEN", 44, 87, Estilo.CREMA, 2)
	if fase == 2:
		_r(47, 44, 186, 29, Estilo.NOCHE)
		_escribir("CIMA DEL TIEMPO" if gana else "OTRO INTENTO", 62, 53, Estilo.DORADO if gana else Estilo.CORAL, 2)
extends Node

# Observa el pictograma del marcador, las placas y los animales visibles.
# Todas las acciones pasan por Input.parse_input_event, nunca por el modelo.
var _resultado: Dictionary = {}
var _devuelto: bool = false
var _pulsadas: Dictionary = {}

func correr(pruebas: Node) -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	Juego.modo_prueba = false
	Juego.sin_guardar = true
	Juego.minijuegos_solos = false
	for nivel in [1, 2, 3]:
		await _manos(pruebas, nivel)
	pruebas.comprobar(not Interfaz.anfitrion.visible, "linea.manos.anfitrion_cerrado")
	pruebas.comprobar(not get_tree().paused, "linea.manos.arbol_sin_pausa")
	Juego.modo_prueba = true

func _abrir(nivel: int) -> void:
	_resultado = await Interfaz.abrir_minijuego("linea_tiempo", {"dificultad": nivel})
	_devuelto = true

func _manos(pruebas: Node, nivel: int) -> void:
	_devuelto = false
	_resultado = {}
	_abrir(nivel)
	for i in 120:
		await get_tree().process_frame
		if Interfaz.anfitrion.visible and Interfaz.anfitrion.get("_capa").visible:
			break
	await _real(0.12)
	var mj: Control = Interfaz.anfitrion.get("_minijuego")
	if not pruebas.comprobar(mj != null, "linea.manos.d%d.abre" % nivel):
		return
	pruebas.comprobar(int(mj.get("_auto")) == 0 and int(mj.get("_solo")) == 0, "linea.manos.d%d.sin_piloto" % nivel)
	await _toque(KEY_ENTER)
	pruebas.comprobar(bool(mj.get("activo")), "linea.manos.d%d.Empezar_Intro" % nivel)
	var saltos: int = 0
	var max_progreso: int = 0
	var arriba: int = KEY_W if nivel == 2 else KEY_UP
	var abajo: int = KEY_S if nivel == 2 else KEY_DOWN
	var izquierda: int = KEY_A if nivel == 2 else KEY_LEFT
	var derecha: int = KEY_D if nivel == 2 else KEY_RIGHT
	var accion: int = KEY_SPACE if nivel == 2 else KEY_E
	while is_instance_valid(mj) and bool(mj.get("activo")) and float(mj.get("tiempo")) < 110.0:
		var mov: Vector2 = Vector2.ZERO
		var pulsar: bool = false
		if int(mj.get("fase")) == 1 and float(mj.get("descanso")) <= 0.0:
			var siguiente: int = int(mj.get("siguiente"))
			max_progreso = maxi(max_progreso, siguiente)
			var hitos: Array = mj.get("hitos")
			var pendiente: Dictionary = hitos[siguiente]
			var icono_hud: int = int(pendiente["icono"])
			var placas: Array = mj.get("placas")
			var pos: Vector2 = mj.get("jugadora")
			var velocidad: Vector2 = mj.get("velocidad")
			var objetivo: Vector2 = pos
			for placa in placas:
				var hito: Dictionary = hitos[int(placa["hito"])]
				# Compara los dibujos, sin leer anios ni ordenar fichas ocultas.
				if int(placa["fila"]) == siguiente and int(hito["icono"]) == icono_hud:
					objetivo = placa["pos"]
					break
			var diferencia: Vector2 = objetivo - pos - velocidad * 0.09
			mov.x = signf(diferencia.x) if absf(diferencia.x) > 1.0 else 0.0
			mov.y = signf(diferencia.y) if absf(diferencia.y) > 1.0 else 0.0
			if float(mj.get("salto")) <= 0.0:
				pulsar = pos.distance_to(objetivo) < 7.0
				var peligros: Array = mj.get("peligros")
				for peligro in peligros:
					var animal: Vector2 = peligro["pos"]
					var marcha: Vector2 = peligro["vel"]
					if (animal + marcha * 0.24).distance_to(pos) < 13.0:
						pulsar = true
		_tecla(izquierda, mov.x < 0)
		_tecla(derecha, mov.x > 0)
		_tecla(arriba, mov.y > 0)
		_tecla(abajo, mov.y < 0)
		if pulsar and not bool(_pulsadas.get(accion, false)):
			saltos += 1
		_tecla(accion, pulsar)
		await get_tree().process_frame
	_soltar()
	await _real(0.15)
	var resultado: Dictionary = Interfaz.anfitrion.get("_resultado")
	pruebas.comprobar(bool(resultado.get("superado", false)), "linea.manos.d%d.gana_solo_teclas" % nivel, str(resultado))
	pruebas.comprobar(saltos >= 9 and max_progreso >= 8, "linea.manos.d%d.nueve_saltos_reales" % nivel, "saltos=%d progreso=%d" % [saltos, max_progreso])
	print("LINEA_MANOS nivel=%d saltos=%d tiempo=%.2f vidas=%d" % [nivel, saltos, float(mj.get("tiempo")), int(mj.get("vidas"))])
	await _toque(KEY_ENTER)
	for i in 120:
		await get_tree().process_frame
		if _devuelto:
			break
	pruebas.comprobar(_devuelto and not Interfaz.anfitrion.visible, "linea.manos.d%d.Continuar_Intro_cierra" % nivel)
	pruebas.comprobar(bool(_resultado.get("superado", false)) and not get_tree().paused, "linea.manos.d%d.devuelve_victoria_sin_pausa" % nivel, str(_resultado))

func _tecla(codigo: int, abajo: bool) -> void:
	if bool(_pulsadas.get(codigo, false)) == abajo:
		return
	_pulsadas[codigo] = abajo
	var evento: InputEventKey = InputEventKey.new()
	evento.physical_keycode = codigo
	evento.keycode = codigo
	evento.pressed = abajo
	Input.parse_input_event(evento)

func _soltar() -> void:
	for codigo in _pulsadas.keys():
		_tecla(int(codigo), false)

func _toque(codigo: int) -> void:
	_tecla(codigo, true)
	await get_tree().process_frame
	await get_tree().physics_frame
	_tecla(codigo, false)
	await _real(0.08)

func _real(segundos: float) -> void:
	await get_tree().create_timer(segundos, true, false, true).timeout
extends Node

const Minijuego = preload("res://minijuegos/linea_tiempo/linea_tiempo.gd")
var _resultado: Dictionary = {}

func _crear(nivel: int) -> Control:
	var mj: Control = Minijuego.new()
	add_child(mj)
	mj.preparar({"dificultad": nivel}, {})
	mj.terminado.connect(func(r: Dictionary): _resultado = r)
	_resultado = {}
	mj.empezar()
	mj.set_process(false)
	return mj

func correr(pruebas: Node) -> void:
	for nivel in [1, 2, 3]:
		for acierta in [true, false]:
			var mj: Control = _crear(nivel)
			var anios: Array[int] = []
			for hito in mj.hitos:
				anios.append(int(hito["anio"]))
			pruebas.comprobar(anios == [1873, 1957, 1969, 1975, 1981, 1982, 2007, 2013, 2023], "linea.modelo.d%d.anios_de_fichas" % nivel)
			var ocultas: bool = true
			for placa in mj.placas:
				ocultas = ocultas and not bool(placa["revelada"])
			pruebas.comprobar(ocultas, "linea.modelo.d%d.fechas_ocultas" % nivel)
			mj.jugar_solo(acierta)
			for cuadro in 799:
				if not mj.activo:
					break
				mj._process(0.05)
			pruebas.comprobar(not mj.activo and bool(_resultado.get("superado", not acierta)) == acierta and mj.tiempo < 40.0, "linea.modelo.d%d.auto_%s_menos40" % [nivel, str(acierta)], str(_resultado))
			print("LINEA_MODELO nivel=%d acierta=%s tiempo=%.2f vidas=%d" % [nivel, str(acierta), mj.tiempo, mj.vidas])
			mj.free()
	var juego: Control = _crear(1)
	juego.fase = 1
	juego.jugadora = Vector2(140, 55)
	# Estar sobre una placa sin saltar no revela el anio.
	for i in 12:
		juego._tic(1.0 / 120.0)
	pruebas.comprobar(juego.siguiente == 0, "linea.modelo.caminar_no_activa")
	var evento: InputEventAction = InputEventAction.new()
	evento.action = "saltar"
	evento.pressed = true
	juego._input(evento)
	for i in 100:
		juego._tic(1.0 / 120.0)
	pruebas.comprobar(juego.siguiente == 1, "linea.modelo.aterrizar_revela")
	juego.free()
	for volando in [false, true]:
		juego = _crear(1)
		juego.fase = 1
		juego.salto = 0.4 if volando else 0.0
		juego.peligros.append({"pos": juego.jugadora, "vel": Vector2.ZERO, "coco": true})
		juego._tic(1.0 / 120.0)
		pruebas.comprobar(juego.vidas == (3 if volando else 2), "linea.modelo.salto_evade_%s" % str(volando))
		juego.free()
	juego = _crear(3)
	juego.fase = 1
	juego.reloj = juego.limite - 0.001
	juego._tic(0.01)
	for i in 150:
		juego._tic(0.01)
	pruebas.comprobar(not juego.activo and not bool(_resultado.get("superado", true)), "linea.modelo.tiempo_agotado")
	juego.free()
