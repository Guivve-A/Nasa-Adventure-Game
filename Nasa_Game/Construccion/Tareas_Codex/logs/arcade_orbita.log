# ------------------------------------------------------------------ dibujo en pixeles gordos

func _px(x: float, y: float, w: float, h: float, color: Color) -> void:
	draw_rect(Rect2((roundf(x) + float(_ox)) * ESCALA, (roundf(y) + float(_oy)) * ESCALA, w * ESCALA, h * ESCALA), color)


func _sprite(filas: Array, x: float, y: float, colores: Dictionary, espejo: bool = false) -> void:
	for j in filas.size():
		var fila: String = filas[j]
		var n := fila.length()
		var i := 0
		while i < n:
			var c := fila[i]
			if c == ".":
				i += 1
				continue
			var k := i
			while k + 1 < n and fila[k + 1] == c:
				k += 1
			var color: Color = colores.get(c, Estilo.CREMA)
			var col := (n - 1 - k) if espejo else i
			_px(x + float(col), y + float(j), float(k - i + 1), 1.0, color)
			i = k + 1


func _ancho_texto(s: String, esc: int = 1) -> int:
	var total := 0
	for i in s.length():
		var letra := s[i]
		var base: String = ACENTOS.get(letra, letra)
		var filas: Array = LETRAS.get(base, LETRAS["?"])
		var primera: String = filas[0]
		total += (primera.length() + 1) * esc
	return maxi(0, total - esc)


func _escribir(s: String, x: float, y: float, color: Color, esc: int = 1) -> void:
	var cx := roundf(x)
	for i in s.length():
		var letra := s[i]
		var base: String = ACENTOS.get(letra, letra)
		var filas: Array = LETRAS.get(base, LETRAS["?"])
		var primera: String = filas[0]
		var ancho := primera.length()
		for j in filas.size():
			var fila: String = filas[j]
			var a := 0
			while a < ancho:
				if fila[a] != "#":
					a += 1
					continue
				var b := a
				while b + 1 < ancho and fila[b + 1] == "#":
					b += 1
				_px(cx + float(a * esc), y + float(j * esc), float((b - a + 1) * esc), float(esc), color)
				a = b + 1
		if base != letra:
			if letra == "Ñ":
				_px(cx + float(esc), y - float(2 * esc), float(2 * esc), float(esc), color)
			else:
				_px(cx + float(esc), y - float(2 * esc), float(2 * esc), float(esc), color)
		cx += float((ancho + 1) * esc)


func _centrado(s: String, cx: float, y: float, color: Color, esc: int = 1) -> void:
	_escribir(s, cx - float(_ancho_texto(s, esc)) * 0.5, y, color, esc)


func _draw() -> void:
	_ox = 0
	_oy = 0
	draw_rect(Rect2(Vector2.ZERO, size), Estilo.NOCHE)
	if sacudida > 0.0:
		_ox = chispa.randi_range(-1, 1)
		_oy = chispa.randi_range(-1, 1)
	_dibujar_cielo()
	_dibujar_luna()
	_dibujar_nubes()
	for r in rayas:
		_px(r.x, r.y, r.z, 1.0, Color(Estilo.BRILLO, 0.75))
	_dibujar_barrio()
	_dibujar_visor()
	for p in particulas:
		var px: float = p["x"]
		var py: float = p["y"]
		var color: Color = p["color"]
		_px(px, py, 1.0, 1.0, color)
	_ox = 0
	_oy = 0
	_dibujar_marcador()
	_dibujar_leyenda()
	if fase <= 1:
		_dibujar_mision()
	elif cartel_t > 0.0 and cartel != "":
		var ancho := _ancho_texto(cartel, 2)
		_px(160.0 - float(ancho) * 0.5 - 4.0, 22.0, float(ancho) + 8.0, 16.0, Color(Estilo.TINTA, 0.9))
		_centrado(cartel, 160.0, 25.0, Estilo.DORADO if _gana or fase == 2 and cartel != "CORTE" else Estilo.CORAL, 2)
	if destello > 0.0:
		draw_rect(Rect2(Vector2.ZERO, size), Color(color_destello, 0.4 * destello / 0.5))


func _dibujar_cielo() -> void:
	var amanecer := clampf((reloj - (_tiempo_total() - 15.0)) / 15.0, 0.0, 1.0)
	var c0: Color = Estilo.NOCHE.lerp(Estilo.PETROLEO, 0.25 * amanecer)
	var c1: Color = Estilo.NOCHE.lerp(Estilo.PETROLEO, 0.16 + 0.3 * amanecer)
	var c2: Color = Estilo.NOCHE.lerp(Estilo.PETROLEO, 0.34 + 0.2 * amanecer).lerp(Estilo.CORAL, 0.28 * amanecer)
	var c3: Color = Estilo.NOCHE.lerp(Estilo.PETROLEO, 0.55).lerp(Estilo.NARANJA, 0.6 * amanecer)
	_px(0, 0, ANCHO, 61, c0)
	_px(0, 61, ANCHO, 34, c1)
	_px(0, 95, ANCHO, 34, c2)
	_px(0, 129, ANCHO, 51, c3)
	var n := 0
	while n < ANCHO:
		_px(n, 60, 2, 1, c1)
		_px(n + 2, 94, 2, 1, c2)
		_px(n, 128, 2, 1, c3)
		n += 4
	# estrellas: giran con el cielo, a la misma velocidad que la Luna
	var corrimiento := vel_cielo * reloj
	for i in estrellas.size():
		var e: Vector3 = estrellas[i]
		var x := fposmod(e.x + corrimiento, 340.0) - 10.0
		var guino := int(t_dibujo * 1.5 + float(i) * 0.7) % 6 == 0
		var color: Color = [Estilo.BRILLO, Estilo.CREMA, Estilo.PETROLEO.lightened(0.25), Estilo.PAPEL][int(e.z)]
		if guino or amanecer > 0.6:
			color = Estilo.PETROLEO.lightened(0.1)
		_px(x, e.y, 1, 1, color)
		if int(e.z) == 0 and not guino and amanecer < 0.5:
			_px(x - 1.0, e.y, 3, 1, Color(Estilo.BRILLO, 0.35))
			_px(x, e.y - 1.0, 1, 3, Color(Estilo.BRILLO, 0.35))
	# la senda de la Luna: puntos que tambien giran con el cielo
	for k in 34:
		var x := fposmod(float(k) * 10.0 + corrimiento, 340.0) - 10.0
		_px(x, _arco(x), 1, 1, Color(Estilo.PETROLEO.lightened(0.2), 0.8))


func _dibujar_luna() -> void:
	if fase < 2:
		return
	var cx := roundf(luna_x)
	var cy := roundf(_arco(luna_x))
	var r2 := (float(RADIO) + 0.5) * (float(RADIO) + 0.5)
	var corrida := 4.0 + 2.5 * float(pasada - 1)       # cada pasada, la Luna crece un poco
	for dy in range(-RADIO, RADIO + 1):
		var medio_ancho := int(sqrt(r2 - float(dy * dy)))
		_px(cx - float(medio_ancho), cy + float(dy), float(2 * medio_ancho + 1), 1, C_LUNA_SOMBRA)
		# parte iluminada: el borde de abajo, la «Luna sonriente» del ecuador
		var resto := r2 - (float(dy) + corrida) * (float(dy) + corrida)
		if resto <= 0.0:
			_px(cx - float(medio_ancho), cy + float(dy), float(2 * medio_ancho + 1), 1, Estilo.CREMA)
		else:
			var hueco := int(sqrt(resto))
			if hueco < medio_ancho:
				_px(cx - float(medio_ancho), cy + float(dy), float(medio_ancho - hueco), 1, Estilo.CREMA)
				_px(cx + float(hueco) + 1.0, cy + float(dy), float(medio_ancho - hueco), 1, Estilo.CREMA)
	_px(cx - 2.0, cy + 3.0, 2, 1, Estilo.PAPEL_SOMBRA)


func _mando_giro(objetivo: float) -> float:
	# pulsos de tecla: frena antes de llegar, porque la capsula conserva el giro
	var falta: float = (objetivo - angulo) - giro * 0.16
	return signf(falta) if absf(falta) > 1.5 else 0.0


func _carril_libre() -> float:
	var mejor: float = cap_x
	var costo_mejor: float = _costo_carril(cap_x)
	var c: float = X_MIN + 8.0
	while c <= X_MAX - 8.0:
		var costo: float = _costo_carril(c)
		if costo < costo_mejor - 0.01:
			costo_mejor = costo
			mejor = c
		c += 4.0
	return mejor


func _costo_carril(c: float) -> float:
	var costo: float = absf(c - cap_x) + absf(c - 160.0) * 0.05
	for b in bolsas:
		if not bool(b["viva"]):
			continue
		var r: float = b["r"]
		var by: float = Y_CAP + float(b["prof"]) - prof
		if by < Y_CAP - r - 6.0:
			continue
		var llegada: float = maxf(by - Y_CAP, 0.0) / maxf(velocidad, 1.0)
		var bx: float = float(b["x"]) + float(b["vx"]) * llegada
		var holgura: float = minf(absf(bx - c), absf(float(b["x"]) - c)) - (r + 11.0)
		if holgura < 0.0:
			costo += 300.0 + 6000.0 / (by - Y_CAP + r + 30.0) - holgura * 4.0
	return costo


# ------------------------------------------------------------------ efectos

func _destellar(color: Color, fuerza: float) -> void:
	_destello = fuerza
	_destello_color = color


func _estallar(x: float, y: float, cuantas: int, color: Color, fuerza: float) -> void:
	for i in cuantas:
		var a: float = _fx.randf_range(0.0, TAU)
		var v: float = _fx.randf_range(fuerza * 0.3, fuerza)
		_chispa(x, y, cos(a) * v, sin(a) * v, _fx.randf_range(0.35, 0.8), color)


func _chispa(x: float, y: float, vx: float, vy: float, vida: float, color: Color) -> void:
	if _chispas.size() < 110:
		_chispas.append([x, y, vx, vy, vida, vida, color])


func _tic_efectos(dt: float) -> void:
	_inmune = maxf(_inmune - dt, 0.0)
	_t_tela = maxf(_t_tela - dt, 0.0)
	_destello = maxf(_destello - dt * 1.6, 0.0)
	if _sacudida > 0.0:
		_sacudida = maxf(_sacudida - dt, 0.0)
		_desvio = Vector2(roundf(_fx.randf_range(-1.6, 1.6)), roundf(_fx.randf_range(-1.6, 1.6))) if _sacudida > 0.0 else Vector2.ZERO
	var cy: float = _y_capsula()
	if fase == REENTRADA:
		# estela: el aire caliente queda arriba, porque la capsula cae
		var lado: float = -6.0 if _fx.randf() < 0.5 else 6.0
		_chispa(cap_x + lado + _fx.randf_range(-1.0, 1.0), cy + 1.0, _fx.randf_range(-4.0, 4.0), -velocidad * 1.3, 0.35, Estilo.NARANJA if calor < 60.0 else Estilo.CORAL)
		if mando_abajo:
			_chispa(cap_x + _fx.randf_range(-5.0, 5.0), cy + 6.0, _fx.randf_range(-10.0, 10.0), -velocidad * 1.6, 0.3, Estilo.DORADO)
		if absf(angulo) > margen:
			var costado: float = signf(angulo)
			_chispa(cap_x - costado * 5.0, cy + 2.0, -costado * _fx.randf_range(10.0, 40.0), _fx.randf_range(-60.0, -20.0), 0.4, Estilo.CORAL)
	elif fase == PERDIDO and _tipo_perdida == "calor":
		_chispa(cap_x + _fx.randf_range(-6.0, 6.0), cy + _fx.randf_range(-6.0, 6.0), _fx.randf_range(-30.0, 30.0), _fx.randf_range(-60.0, -10.0), 0.5, Estilo.CORAL)
	elif fase == AMERIZADO and _fx.randf() < 0.3:
		_chispa(cap_x + _fx.randf_range(-9.0, 9.0), cy + 6.0, _fx.randf_range(-12.0, 12.0), _fx.randf_range(-26.0, -8.0), 0.5, Estilo.PAPEL)
	var i: int = _chispas.size() - 1
	while i >= 0:
		var c: Array = _chispas[i]
		c[4] = float(c[4]) - dt
		if float(c[4]) <= 0.0:
			_chispas.remove_at(i)
		else:
			c[0] = float(c[0]) + float(c[2]) * dt
			c[1] = float(c[1]) + float(c[3]) * dt
		i -= 1
	i = _carteles.size() - 1
	while i >= 0:
		var cartel: Array = _carteles[i]
		cartel[3] = float(cartel[3]) - dt
		cartel[1] = float(cartel[1]) - 14.0 * dt
		if float(cartel[3]) <= 0.0:
			_carteles.remove_at(i)
		i -= 1
	i = _rasgados.size() - 1
	while i >= 0:
		var tela: Array = _rasgados[i]
		tela[0] = float(tela[0]) + float(tela[2]) * dt
		tela[1] = float(tela[1]) + float(tela[3]) * dt
		if float(tela[1]) < -10.0:
			_rasgados.remove_at(i)
		i -= 1


# ------------------------------------------------------------------ geometria de la pantalla

func _camara() -> float:
	# la camara sigue a la capsula hasta que el mar queda a la vista
	if mar_prof > 0.0:
		return minf(prof, mar_prof - 78.0)
	return prof


func _y_capsula() -> float:
	return Y_CAP + prof - _camara() + _caida_extra


func _y_altimetro() -> float:
	if prof <= LARGO or franja_ini <= 0.0:
		return 26.0 + 90.0 * clampf(prof / LARGO, 0.0, 1.0)
	if abiertos > 0:
		return _alt_abrio + (162.0 - _alt_abrio) * clampf((prof - _prof_abrio) / (mar_prof - 6.0 - _prof_abrio), 0.0, 1.0)
	if prof < franja_ini:
		return 116.0 + 4.0 * (prof - LARGO) / (franja_ini - LARGO)
	return 120.0 + minf(12.0 * (prof - franja_ini) / (franja_fin - franja_ini), 30.0)


# ------------------------------------------------------------------ dibujo

func _draw() -> void:
	var escala: Vector2 = Vector2(PIXEL, PIXEL)
	draw_set_transform(Vector2.ZERO, 0.0, escala)
	var t1: float = clampf(prof / LARGO, 0.0, 1.0)
	var t2: float = clampf((prof - LARGO) / 240.0, 0.0, 1.0)
	draw_rect(Rect2(0, 0, ANCHO, ALTO), _c_espacio.lerp(_c_aire, t1).lerp(_c_cielo, t2))
	draw_set_transform(_desvio * PIXEL, 0.0, escala)
	_dibujar_fondo(t1, t2)
	_dibujar_mar()
	_dibujar_franja()
	_dibujar_bolsas()
	_dibujar_chispas()
	_dibujar_capsula()
	_dibujar_carteles()
	draw_set_transform(Vector2.ZERO, 0.0, escala)
	if _destello > 0.0:
		draw_rect(Rect2(0, HUD, CAMPO, ALTO - HUD), Color(_destello_color, minf(_destello, 0.5)))
	_dibujar_avisos()
	if fase == INTRO:
		_dibujar_mision()
	_dibujar_altimetro()
	_dibujar_marcador()


func _r(x: float, y: float, w: float, h: float, color: Color) -> void:
	draw_rect(Rect2(floorf(x), floorf(y), w, h), color)


func _sprite(mapa: Array, x: float, y: float, e: int = 1, tinte: Color = Color(0, 0, 0, 0)) -> void:
	var ox: float = floorf(x)
	var oy: float = floorf(y)
	for fy in mapa.size():
		var fila: String = mapa[fy]
		for fx in fila.length():
			var c: String = fila[fx]
			if c != ".":
				var color: Color = tinte
				if tinte.a <= 0.0:
					color = _pal[c]
				draw_rect(Rect2(ox + fx * e, oy + fy * e, e, e), color)


func _escribir(t: String, x: float, y: float, color: Color, e: int = 1) -> void:
	var cx: float = floorf(x)
	var oy: float = floorf(y)
	for i in t.length():
		var c: String = t[i]
		var base: String = c
		if ACENTOS.has(c):
			base = ACENTOS[c]
			if c == "Ñ":
				draw_rect(Rect2(cx, oy - 2 * e, 3 * e, e), color)
			else:
				draw_rect(Rect2(cx + e, oy - 2 * e, e, e), color)
		if _glifos.has(base):
			var filas: PackedStringArray = _glifos[base]
			for fy in 5:
				var fila: String = filas[fy]
				for fx in 3:
					if fila[fx] == "#":
						draw_rect(Rect2(cx + fx * e, oy + fy * e, e, e), color)
		cx += 4 * e


func _ancho(t: String, e: int = 1) -> float:
	return float(t.length() * 4 * e - e)


func _centrado(t: String, y: float, color: Color, e: int = 1) -> void:

