extends Node

# Lee posicion y deslizamiento; solo actua mediante teclas fisicas.
var pulsadas: Dictionary = {}
var final: Dictionary = {}
var devuelto: bool = false


func correr(pruebas: Node) -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	Juego.modo_prueba = false
	Juego.sin_guardar = true
	Juego.minijuegos_solos = false
	await _partida(pruebas, false)
	await _partida(pruebas, true)
	Juego.modo_prueba = true


func _lanzar(parametros: Dictionary) -> void:
	final = await Interfaz.abrir_minijuego("seguidor", parametros)
	devuelto = true


func _partida(pruebas: Node, ayuda: bool) -> void:
	final = {}
	devuelto = false
	var parametros: Dictionary = {"dificultad": 1}
	if ayuda:
		parametros["modo"] = "prealimentacion"
	_lanzar(parametros)
	var limite := 5.0
	while not Interfaz.anfitrion.visible and limite > 0.0:
		await _real(0.1)
		limite -= 0.1
	await _real(0.15)
	var m: Control = Interfaz.anfitrion.get("_minijuego")
	var nombre := "seguidor.manos.cielo" if ayuda else "seguidor.manos.normal"
	pruebas.comprobar(m != null and Interfaz.anfitrion.visible, nombre + ".abierto", str(parametros))
	if m == null:
		return
	pruebas.comprobar(int(m.get("_auto")) == 0 and int(m.get("_solo")) == 0, nombre + ".sin_piloto", "Entrada fisica")
	pruebas.comprobar(m.size == Vector2(1280, 720), nombre + ".pantalla_completa", str(m.size))
	await _toque(KEY_ENTER)
	limite = 110.0
	while is_instance_valid(m) and bool(m.get("activo")) and limite > 0.0:
		if int(m.get("fase")) == 2:
			if ayuda and not bool(m.get("cielo")):
				await _toque(KEY_E)
			var error: float = float(m.get("luna_x")) - float(m.get("visor_x"))
			var velocidad: float = float(m.get("visor_v"))
			var deriva: float = float(m.get("vel_cielo"))
			# Impulsos de una decima; anticipa el frenado mirando el deslizamiento.
			var sobra := velocidad - deriva
			var orden := 6.0 * error - 3.5 * sobra
			_tecla(KEY_D, orden > 8.0)
			_tecla(KEY_A, orden < -8.0)
			var base: float = deriva if bool(m.get("cielo")) else 0.0
			_tecla(KEY_SPACE, absf(sobra) > 20.0 and (velocidad - base) * sobra > 0.0 and absf(error) < 0.45 * absf(sobra) + 4.0)
		await _real(0.1)
		limite -= 0.1
	for codigo in pulsadas.keys():
		_tecla(int(codigo), false)
	await _real(0.3)
	var resultado: Dictionary = Interfaz.anfitrion.get("_resultado")
	pruebas.comprobar(bool(resultado.get("superado", false)), nombre + ".superado", str(resultado))
	print("MANOS ", nombre, " ", resultado)
	await _toque(KEY_ENTER)
	await _real(0.3)
	pruebas.comprobar(devuelto and bool(final.get("superado", false)), nombre + ".resultado_devuelto", str(final))
	pruebas.comprobar(not Interfaz.anfitrion.visible, nombre + ".anfitrion_cerrado", str(Interfaz.anfitrion.visible))
	pruebas.comprobar(not get_tree().paused, nombre + ".arbol_sin_pausa", str(get_tree().paused))
	if ayuda:
		var cuaderno: Array = Juego.estado.get("cuaderno", [])
		pruebas.comprobar(cuaderno.has("prealimentacion"), nombre + ".ficha_anotada", str(cuaderno))


func _tecla(codigo: int, abajo: bool) -> void:
	if bool(pulsadas.get(codigo, false)) == abajo:
		return
	pulsadas[codigo] = abajo
	var evento := InputEventKey.new()
	evento.physical_keycode = codigo
	evento.keycode = codigo
	evento.pressed = abajo
	Input.parse_input_event(evento)


func _toque(codigo: int) -> void:
	_tecla(codigo, true)
	await get_tree().process_frame
	await get_tree().physics_frame
	await get_tree().process_frame
	_tecla(codigo, false)
	await get_tree().process_frame


func _real(segundos: float) -> void:
	await get_tree().create_timer(segundos, true, false, true).timeout
		senal = minf(1.0, senal + PASO / (t_corte * 0.5))
		if int(video / 4.0) != tramo:
			sonar("tic")
			_chispas(72.0 + video * 1.5, 7.0, 4, Estilo.DORADO, 14.0)
		if video >= VIDEO_META:
			_acabar(true, "")
			return
	else:
		racha = 0.0
		var lado := 1 if e > 0.0 else -1
		if _ultimo_lado != 0 and lado != _ultimo_lado and _estancia < 1.0 and a_la_vista:
			rebotes += 1          # cruzo la Luna de lado a lado sin quedarse: se paso
		_ultimo_lado = lado
		_estancia = 0.0
		if a_la_vista and gracia <= 0.0:
			senal -= PASO / t_corte
			if e > 0.0:
				t_atras += PASO
			else:
				t_delante += PASO
			if senal <= 0.0:
				_cortar()


func _multiplicador() -> int:
	return 1 + mini(3, int(racha / 4.0))


func _soplar() -> void:
	match viento_fase:
		0:
			viento = 0.0
			if reloj >= viento_prox:
				viento_fase = 1
				viento_t = 0.0
				viento_dir = 1 if azar.randf() < 0.5 else -1
				viento_dur = azar.randf_range(1.2, 2.0)
				sonar("radio")
		1:
			viento_t += PASO
			if viento_t >= 0.8:
				viento_fase = 2
				viento_t = 0.0
				rachas_viento += 1
				sacudida = maxf(sacudida, 0.15)
		2:
			viento_t += PASO
			var k := viento_t / viento_dur
			var forma := minf(1.0, minf(k, 1.0 - k) * 5.0)
			var f: float = FUERZA[dificultad - 1]
			viento = float(viento_dir) * f * (1.0 + 0.12 * float(pasada - 1)) * forma
			if k >= 1.0:
				viento_fase = 0
				viento = 0.0
				var calma: Array = CALMA[dificultad - 1]
				var c0: float = calma[0]
				var c1: float = calma[1]
				viento_prox = reloj + azar.randf_range(c0, c1)


func _cortar() -> void:
	vidas -= 1
	cortes += 1
	senal = 1.0
	gracia = 2.5
	sacudida = 0.4
	destello = 0.5
	color_destello = Estilo.CORAL
	parpadeo_vida = 1.2
	sonar("error")
	_chispas(visor_x, _arco(visor_x), 14, Estilo.CORAL, 40.0)
	if vidas <= 0:
		_acabar(false, "cortes")
	else:
		_poner_cartel("CORTE", 1.0)


func _acabar(gana: bool, motivo: String) -> void:
	fase = 3
	t_fase = 0.0
	_gana = gana
	_motivo = motivo
	mando = 0.0
	freno = false
	viento = 0.0
	if gana:
		puntos += float(vidas) * 200.0 + maxf(0.0, _tiempo_total() - reloj) * 5.0
		_poner_cartel("VIDEO COMPLETO", T_FINAL)
		destello = 0.5
		color_destello = Estilo.BRILLO
		sonar("logro")
		for n in 5:
			_chispas(chispa.randf_range(40.0, 240.0), chispa.randf_range(30.0, 80.0), 12, [Estilo.DORADO, Estilo.CIAN, Estilo.CORAL][n % 3], 46.0)
	else:
		_poner_cartel("AMANECE" if motivo == "amanece" else "SIN SEÑAL", T_FINAL)


func _tiempo_total() -> float:
	return dur_pasada * float(n_pasadas)


func _cerrar() -> void:
	var grabado := int(video)
	if _gana:
		var frase := "Grabaste los 60 s: mides dónde está la Luna y corriges el motor. Empujar acelera; frenar calma."
		if modo_cielo and cielo:
			Juego.anotar("prealimentacion")
			frase = "El cielo gira unos 15° por hora: con ese dato en el motor, solo corregiste el viento."
		elif modo_cielo:
			frase = "Grabaste los 60 s a pulso. Con E, el motor copia el giro del cielo y solo queda corregir."
		terminar(true, roundf(puntos), frase)
		return
	var causa := "El motor se quedó atrás: el cielo no para de girar y hay que seguir empujando."
	if rebotes >= 3 or t_delante > t_atras:
		causa = "El motor se pasó de la Luna y osciló: empujaste más de lo que frenaste."
	elif modo_cielo and t_con_cielo < 3.0:
		causa = "Sin la velocidad del cielo (E), el motor no anticipa el giro y se queda atrás."
	if _motivo == "amanece":
		terminar(false, roundf(puntos), "Amaneció con %d de 60 s grabados. %s" % [grabado, causa])
	else:
		terminar(false, roundf(puntos), "%s Grabaste %d de 60 s." % [causa, grabado])


# ------------------------------------------------------------------ adornos (no cambian las reglas)

func _poner_cartel(mensaje: String, segundos: float) -> void:
	cartel = mensaje
	cartel_t = segundos


func _chispas(x: float, y: float, cuantas: int, color: Color, fuerza: float) -> void:
	for n in cuantas:
		if particulas.size() > 90:
			return
		var angulo := chispa.randf_range(0.0, TAU)
		var rapidez := chispa.randf_range(0.3, 1.0) * fuerza
		particulas.append({"x": x, "y": y, "vx": cos(angulo) * rapidez, "vy": sin(angulo) * rapidez - 8.0, "vida": chispa.randf_range(0.35, 0.8), "color": color})


func _nueva_nube(x: float) -> Dictionary:
	var ancho := chispa.randi_range(26, 44)
	var alto := chispa.randi_range(6, 9)
	var filas: Array[Vector2i] = []
	var joroba := chispa.randf_range(0.25, 0.55)
	for r in alto:
		var t := float(r) / float(alto - 1)
		var izq := int(float(ancho) * 0.30 * pow(1.0 - t, 1.6))
		var der := ancho - int(float(ancho) * 0.24 * pow(1.0 - t, 1.6))
		if r < 2:
			izq = int(float(ancho) * joroba)
			der = izq + int(float(ancho) * 0.28) + r * 3
		filas.append(Vector2i(izq, mini(der, ancho)))
	return {"x": x, "y": chispa.randf_range(40.0, 118.0), "v": chispa.randf_range(5.0, 11.0), "ancho": ancho, "filas": filas}


func _animar(delta: float) -> void:
	sacudida = maxf(0.0, sacudida - delta)
	destello = maxf(0.0, destello - delta)
	parpadeo_vida = maxf(0.0, parpadeo_vida - delta)
	cartel_t = maxf(0.0, cartel_t - delta)
	brillo_boton = maxf(0.0, brillo_boton - delta)
	if fase < 2:
		return
	for nube in nubes:
		var x: float = nube["x"]
		var v: float = nube["v"]
		var ancho: int = nube["ancho"]
		x += (-v + viento * 0.5) * delta
		if x < -float(ancho) - 6.0:
			x = float(ANCHO) + chispa.randf_range(4.0, 40.0)
			nube["y"] = chispa.randf_range(40.0, 118.0)
		elif x > float(ANCHO) + 46.0:
			x = -float(ancho) - 4.0
		nube["x"] = x
	var vivas: Array[Dictionary] = []
	for p in particulas:
		var vida: float = p["vida"]
		vida -= delta
		if vida <= 0.0:
			continue



