var modo_cielo := false         # existe el boton «velocidad del cielo» (parametros.modo == "prealimentacion")
var cielo := false              # el motor ya sigue solo la deriva del cielo
var fase := 0                   # 0 espera, 1 mision, 2 juego, 3 final
