func _simular(nivel: int, bien: bool, delta: float) -> Dictionary:
	var m: Control = Orbita.new()
	add_child(m)
	m.preparar({\"dificultad\": nivel}, Juego.info_minijuego(\"orbita\"))
	m.empezar()
	m.set_process(false)
	m.jugar_solo(bien)
	var salida: Dictionary = {}
