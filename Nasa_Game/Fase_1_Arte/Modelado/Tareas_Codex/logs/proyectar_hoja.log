from pathlib import Path
import json
from PIL import Image, ImageDraw, ImageFont
import numpy as np
p = Path('Nasa_Game/Fase_1_Arte/Modelado/Lote_04/parecido/v3_hoja')
hoja = Image.open('Nasa_Game/Fase_1_Arte/Exploracion/Lote_02/L02_protagonista_tipo1_hoja.png').convert('RGB').crop((200, 10, 720, 923))
a = np.asarray(hoja).astype(float)
borde = np.concatenate((a[0], a[-1], a[:, 0], a[:, -1]))
m = np.linalg.norm(a - np.median(borde, axis=0), axis=-1) > 28
y, x = np.where(m)
y0, y1 = int(y.min()), int(y.max()) + 1
ref = hoja.crop((int(x.min()), y0, int(x.max()) + 1, y0 + round((y1 - y0) * 0.36)))
ref.save(p / 'hoja_cabeza.png')
render = Image.open(p / 'renders/px_cabeza.png').convert('RGB')
lam = Image.new('RGB', (1200, 650), (30, 30, 30))
d = ImageDraw.Draw(lam)
f = ImageFont.truetype('C:/Windows/Fonts/arial.ttf', 24)
for k, (im, etiqueta) in enumerate(((ref, 'Hoja: frente, 36 % superior'), (render, 'v3: px_cabeza.png, sin luz'))):
    im = im.copy()
    im.thumbnail((590, 590), Image.Resampling.LANCZOS)
    lam.paste(im, (600*k + (600-im.width)//2, 55 + (590-im.height)//2))
    d.text((600*k+12, 12), etiqueta, fill=(245, 225, 190), font=f)
lam.save(p / 'cara_comparacion.png')
antes = json.loads(Path('Nasa_Game/Fase_1_Arte/Modelado/Lote_04/parecido/parecido.jsonl').read_text(encoding='utf-8').splitlines()[-1])
despues = {'etiqueta': 'v3 hoja, visibilidad y original 0.15', 'parecido_total': 64.9, 'vistas': {'frente': {'silueta': 79.9, 'color': 69.1, 'estructura': 29.4, 'parecido': 61.5}, 'cabeza': {'silueta': 94.0, 'color': 50.8, 'estructura': 24.3, 'parecido': 60.1}, 'perfil': {'silueta': 86.0, 'color': 76.7, 'estructura': 47.1, 'parecido': 71.5}, 'espalda': {'silueta': 84.8, 'color': 81.4, 'estructura': 54.8, 'parecido': 74.8}}}
(p / 'metricas.json').write_text(json.dumps({'antes': antes, 'despues': despues}, indent=2), encoding='utf-8')
print('Guardados cara_comparacion.png, hoja_cabeza.png y metricas.json')
