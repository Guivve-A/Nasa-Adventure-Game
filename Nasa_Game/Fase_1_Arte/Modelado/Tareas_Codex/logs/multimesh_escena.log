class_name Iluminacion
extends RefCounted

# Luz de la tarde (Biblia de arte, seccion 7): sol calido y bajo que llega desde el fondo a la derecha
# (contraluz, como en la vista aprobada), sombras azul petroleo y un poco de brillo para el cian.

static func montar(padre: Node3D) -> DirectionalLight3D:
	var sol := DirectionalLight3D.new()
	sol.name = "Sol"
	sol.light_color = Color("ffe1bf")
	sol.light_energy = 1.15
	sol.shadow_enabled = true
	sol.shadow_blur = 1.6
	sol.directional_shadow_mode = DirectionalLight3D.SHADOW_PARALLEL_2_SPLITS
	sol.directional_shadow_max_distance = 40.0
	padre.add_child(sol)
	# el sol viaja desde el fondo derecho hacia el frente izquierdo, a unos 38 grados de altura
	sol.look_at_from_position(Vector3.ZERO, Vector3(-0.62, -0.62, 0.48), Vector3.UP)

	var entorno := WorldEnvironment.new()
	var e := Environment.new()
	e.background_mode = Environment.BG_COLOR
	e.background_color = Color("2b3a33")
	e.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
	e.ambient_light_color = Color("6f8fa3")   # azul petroleo aclarado: la sombra fria
	e.ambient_light_energy = 0.62
	e.tonemap_mode = Environment.TONE_MAPPER_FILMIC
	e.tonemap_exposure = 0.95
	e.glow_enabled = true
	e.glow_intensity = 0.35
	e.glow_hdr_threshold = 1.2
	e.adjustment_enabled = true
	e.adjustment_saturation = 1.0
	entorno.environment = e
	padre.add_child(entorno)
	return sol
// Comun a los shaders de la escena: inclinacion hacia atras y luz celular calida con borde de luz.
// La camara de juego mira hacia -Z desde lo alto. Echar los objetos hacia atras (-Z) en proporcion a su
// altura hace que se lean erguidos, como en las ilustraciones aprobadas, sin tocar el suelo (y = 0).

uniform float inclinacion = 0.55;   // tan del angulo de inclinacion; 0 = sin inclinar
uniform float borde_luz = 0.45;     // intensidad del borde de luz (rim)
uniform float suavidad = 0.10;      // ancho de la transicion luz/sombra

void inclinar(inout vec3 v, inout vec3 n) {
	// VERTEX y NORMAL en coordenadas de mundo (render_mode world_vertex_coords)
	v.z -= inclinacion * v.y;
	// la normal bajo la cizalla z' = z - k y se transforma con la inversa transpuesta
	n = normalize(vec3(n.x, n.y + inclinacion * n.z, n.z));
}

float paso_celular(float ndl) {
	return smoothstep(0.0, suavidad, ndl);
}

float borde(vec3 normal, vec3 vista, vec3 luz) {
	float fresnel = pow(1.0 - clamp(dot(normal, vista), 0.0, 1.0), 3.0);
	// mas borde en los contornos que miran hacia el sol (contraluz de la tarde)
	float contraluz = clamp(dot(luz, -vista) * 0.5 + 0.5, 0.0, 1.0);
	return fresnel * contraluz * borde_luz;
}

