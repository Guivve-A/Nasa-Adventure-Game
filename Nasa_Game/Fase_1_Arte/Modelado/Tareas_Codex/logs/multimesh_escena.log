// Arroyo: turquesa con bandas de corriente, destellos y espuma donde el color de vertice lo marca (alfa).
shader_type spatial;
render_mode world_vertex_coords, specular_disabled, cull_disabled;

#include "res://shaders/comun.gdshaderinc"

uniform vec3 agua_honda : source_color = vec3(0.17, 0.45, 0.49);   // cian medio hacia azul petroleo
uniform vec3 agua_clara : source_color = vec3(0.21, 0.69, 0.70);   // #36B1B2 cian medio
uniform vec3 espuma : source_color = vec3(0.81, 0.97, 0.96);       // #CEF8F5 brillo
uniform vec2 corriente = vec2(0.25, 0.6);                            // direccion y rapidez del flujo
varying vec3 pos_mundo;

void vertex() {
	pos_mundo = VERTEX;
	inclinar(VERTEX, NORMAL);
}

float ondas(vec2 p) {
	return sin(p.x * 3.1 + sin(p.y * 1.7)) * 0.5 + sin(p.y * 4.3 - p.x * 1.3) * 0.5;
}

void fragment() {
	vec2 p = pos_mundo.xz * 1.6 - corriente * TIME;
	float o = ondas(p) * 0.5 + 0.5;
	vec3 c = mix(agua_honda, agua_clara, smoothstep(0.35, 0.85, o));
	float destello = smoothstep(0.975, 0.995, ondas(p * 1.9 + 3.0) * 0.5 + 0.5);
	float borde_espuma = COLOR.r;  // mascara del generador: blanco = espuma (orillas y cascadas)
	c = mix(c, espuma, clamp(destello * 0.5 + borde_espuma, 0.0, 1.0));
	ALBEDO = c;
	ROUGHNESS = 0.4;
	ALPHA = 0.88;
}

void light() {
	float paso = paso_celular(dot(NORMAL, LIGHT)) * ATTENUATION;
	DIFFUSE_LIGHT += LIGHT_COLOR * (0.6 + 0.4 * paso) / PI;
}
// Low-poly pintado: color de vertice con degradado por faceta, luz celular calida y borde de luz.
// La sombra fria (azul petroleo) la pone la luz ambiental del entorno.
shader_type spatial;
render_mode world_vertex_coords, specular_disabled;

#include "res://shaders/comun.gdshaderinc"

void vertex() {
	inclinar(VERTEX, NORMAL);
}

void fragment() {
	ALBEDO = COLOR.rgb;
	ROUGHNESS = 1.0;
}

void light() {
	// LIGHT_COLOR llega multiplicado por PI: se divide para igualar al Lambert estandar de Godot
	float paso = paso_celular(dot(NORMAL, LIGHT)) * ATTENUATION;
	DIFFUSE_LIGHT += LIGHT_COLOR * paso / PI;
	DIFFUSE_LIGHT += LIGHT_COLOR * borde(NORMAL, VIEW, LIGHT) * ATTENUATION / PI;
}
// Hojas, hierba y flores: doble cara, color de vertice, viento sutil y luz que envuelve (follaje).
shader_type spatial;
render_mode world_vertex_coords, specular_disabled, cull_disabled;

#include "res://shaders/comun.gdshaderinc"

uniform float viento = 0.035;        // amplitud del balanceo en metros por metro de altura
uniform float velocidad = 1.3;

void vertex() {
	// el balanceo crece con la altura del vertice y varia con la posicion (rafagas)
	float fase = VERTEX.x * 0.7 + VERTEX.z * 0.5;
	float rafaga = sin(TIME * velocidad + fase) * 0.6 + sin(TIME * velocidad * 2.3 + fase * 1.7) * 0.4;
	float altura = max(VERTEX.y, 0.0);
	VERTEX.x += rafaga * viento * altura;
	VERTEX.z += rafaga * viento * 0.5 * altura;
	inclinar(VERTEX, NORMAL);
}

void fragment() {
	ALBEDO = COLOR.rgb;
	ROUGHNESS = 1.0;
	// en la cara trasera la normal se invierte para que la hoja no quede negra
	if (!FRONT_FACING) {
		NORMAL = -NORMAL;
	}
}

void light() {
	// luz que envuelve: el follaje deja pasar algo de luz por detras
	float ndl = dot(NORMAL, LIGHT) * 0.75 + 0.25;
	float paso = paso_celular(ndl) * ATTENUATION;
	DIFFUSE_LIGHT += LIGHT_COLOR * paso / PI;
	DIFFUSE_LIGHT += LIGHT_COLOR * borde(NORMAL, VIEW, LIGHT) * ATTENUATION * 0.6 / PI;
}
// Mallas texturizadas (Tripo): textura pintada, facetas planas por triangulo, luz celular y borde de luz.
shader_type spatial;
render_mode world_vertex_coords, specular_disabled;

#include "res://shaders/comun.gdshaderinc"

uniform sampler2D textura : source_color, filter_linear_mipmap;
uniform bool facetas_planas = true;  // normal de cara a partir de derivadas: se ve cada triangulo
uniform float saturacion = 1.0;

void vertex() {
	inclinar(VERTEX, NORMAL);
}

void fragment() {
	vec3 c = texture(textura, UV).rgb;
	float gris = dot(c, vec3(0.299, 0.587, 0.114));
	ALBEDO = mix(vec3(gris), c, saturacion);
	ROUGHNESS = 1.0;
	if (facetas_planas) {
		NORMAL = normalize(cross(dFdy(VERTEX), dFdx(VERTEX)));
	}
}

void light() {
	float paso = paso_celular(dot(NORMAL, LIGHT)) * ATTENUATION;
	DIFFUSE_LIGHT += LIGHT_COLOR * paso / PI;
	DIFFUSE_LIGHT += LIGHT_COLOR * borde(NORMAL, VIEW, LIGHT) * ATTENUATION / PI;
}

