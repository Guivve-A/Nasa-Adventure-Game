diff --git a/capturas/multimesh/medir_original.gd b/capturas/multimesh/medir_original.gd
new file mode 100644
index 0000000000000000000000000000000000000000..e9869a5c39c71dc8d35a749f2a593c967f72ed86
--- /dev/null
+++ b/capturas/multimesh/medir_original.gd
@@ -0,0 +1,14 @@
+extends SceneTree
+
+# Ejecuta la fuente original con los mismos argumentos de medicion de la escena.
+func _initialize() -> void:
+	call_deferred("_montar")
+
+
+func _montar() -> void:
+	var programa := GDScript.new()
+	programa.source_code = FileAccess.get_file_as_string("res://capturas/multimesh/escena_antes.gd.txt")
+	if programa.reload() != OK:
+		quit(1)
+		return
+	root.add_child(programa.new())
diff --git a/capturas/multimesh/verificar.gd b/capturas/multimesh/verificar.gd
new file mode 100644
index 0000000000000000000000000000000000000000..e10d19d5212101c5b8baf13d837b3dfbfc3eb153
--- /dev/null
+++ b/capturas/multimesh/verificar.gd
@@ -0,0 +1,121 @@
+extends SceneTree
+
+# Prueba reproducible con tiempo de shader y pose del gato controlados.
+var escena: Node3D
+var version := "despues"
+var fallos := 0
+var follaje: Array[ShaderMaterial] = []
+
+
+func _initialize() -> void:
+	for arg in OS.get_cmdline_user_args():
+		if arg.begins_with("--prueba_version="):
+			version = arg.trim_prefix("--prueba_version=")
+	call_deferred("_ejecutar")
+
+
+func _exigir(condicion: bool, mensaje: String) -> void:
+	if not condicion:
+		fallos += 1
+		push_error("PRUEBA_FALLO " + mensaje)
+
+
+func _ejecutar() -> void:
+	var ruta := "res://capturas/multimesh/escena_antes.gd.txt" if version == "antes" else "res://escena.gd"
+	var programa := GDScript.new()
+	programa.source_code = FileAccess.get_file_as_string(ruta)
+	_exigir(programa.reload() == OK, "compilacion")
+	escena = programa.new()
+	root.add_child(escena)
+	escena.set_process(false)
+	for hijo in escena.get_children():
+		if hijo is CanvasLayer:
+			hijo.hide()
+	await process_frame
+	var gato: Node3D = escena.instancias["PER-09"]
+	var reproductor := gato.find_child("AnimationPlayer", true, false) as AnimationPlayer
+	_exigir(reproductor.is_playing() and reproductor.current_animation == "caminar", "gato animado")
+	reproductor.speed_scale = 0.0
+	reproductor.seek(0.25, true)
+	if version == "despues":
+		_verificar_lotes()
+	var base: Node3D = escena.instancias["roca_iguana"]
+	_exigir(is_equal_approx(escena.instancias["FAU-01"].position.y, Materiales.caja_mundo(base).end.y - 0.06), "apoyo iguana")
+	var shaders := {}
+	for material in Materiales.creados:
+		var original := material.shader
+		if not shaders.has(original):
+			var shader := Shader.new()
+			var codigo := original.code
+			if original.resource_path.ends_with("follaje.gdshader"):
+				codigo = codigo.replace("TIME", "tiempo_prueba")
+				codigo = codigo.replace("void vertex()", "uniform float tiempo_prueba = 0.25;\n\nvoid vertex()")
+			else:
+				codigo = codigo.replace("TIME", "float(0.25)")
+			shader.code = codigo
+			shaders[original] = shader
+		if original.resource_path.ends_with("follaje.gdshader"):
+			follaje.append(material)
+		material.shader = shaders[original]
+	for e in ["21", "12"]:
+		escena.encuadre = e
+		escena._colocar_camara()
+		Materiales.ajustar_parametro("inclinacion", 0.45)
+		for m in follaje:
+			m.set_shader_parameter("tiempo_prueba", 0.25)
+		await _capturar("%s_%s_fijo" % [version, e])
+		for m in follaje:
+			m.set_shader_parameter("tiempo_prueba", 1.25)
+		await _capturar("%s_%s_viento" % [version, e])
+		for m in follaje:
+			m.set_shader_parameter("tiempo_prueba", 0.25)
+		Materiales.ajustar_parametro("inclinacion", 0.0)
+		await _capturar("%s_%s_sin_inclinacion" % [version, e])
+	print("PRUEBA version=%s fallos=%d materiales_follaje=%d" % [version, fallos, follaje.size()])
+	quit(1 if fallos else 0)
+
+
+func _capturar(nombre: String) -> void:
+	for i in range(12):
+		await process_frame
+	await RenderingServer.frame_post_draw
+	escena._guardar(ProjectSettings.globalize_path("res://capturas/multimesh/%s.png" % nombre))
+
+
+func _verificar_lotes() -> void:
+	var grupos := {}
+	for r in escena.datos["recursos"]:
+		if not escena.instancias.has(r["id"]):
+			continue
+		var nodo: Node3D = escena.instancias[r["id"]]
+		if r.has("animacion") or r.has("variante"):
+			for mi in nodo.find_children("*", "MeshInstance3D", true, false):
+				_exigir(mi.visible, "excepcion " + r["id"])
+			continue
+		var clave := JSON.stringify([r["glb"], r.get("nodo", "")])
+		if not grupos.has(clave):
+			grupos[clave] = []
+		grupos[clave].append(nodo)
+	var transformaciones := 0
+	var lotes := 0
+	for grupo in grupos.values():
+		var primero: Node3D = grupo[0]
+		for mi in primero.find_children("*", "MeshInstance3D", true, false):
+			if grupo.size() == 1:
+				_exigir(mi.visible, "recurso unico " + primero.name)
+				continue
+			var lote := escena.get_node("Multimesh_%s_%s" % [primero.name, mi.name]) as MultiMeshInstance3D
+			_exigir(lote != null, "lote " + primero.name)
+			if lote == null:
+				continue
+			lotes += 1
+			_exigir(lote.multimesh.instance_count == grupo.size(), "cantidad " + lote.name)
+			_exigir(lote.cast_shadow == mi.cast_shadow, "sombras " + lote.name)
+			for s in mi.mesh.get_surface_count():
+				_exigir(lote.multimesh.mesh.surface_get_material(s) == mi.get_active_material(s), "material " + lote.name)
+			for i in grupo.size():
+				var original := grupo[i].get_node(primero.get_path_to(mi)) as MeshInstance3D
+				_exigir(not original.visible, "malla individual oculta")
+				_exigir((lote.global_transform * lote.multimesh.get_instance_transform(i)).is_equal_approx(original.global_transform), "transformacion " + grupo[i].name)
+				transformaciones += 1
+	print("PRUEBA_LOTES lotes=%d transformaciones=%d" % [lotes, transformaciones])
diff --git a/escena.gd b/escena.gd
index a18a23c5557087cbc9e1f531c490f1139a50f9e6..b2082822d0e468043d7a291c710e5461b6b15248
--- a/escena.gd
+++ b/escena.gd
@@ -132,6 +132,77 @@
 		if base != null:
 			var caja := Materiales.caja_mundo(base)
 			par[0].position.y = caja.end.y - 0.06
+	_agrupar_repetidos()
+
+
+func _agrupar_repetidos() -> void:
+	var grupos := {}
+	for r in datos["recursos"]:
+		if r.has("animacion") or r.has("variante") or not instancias.has(r["id"]):
+			continue
+		var clave := JSON.stringify([r["glb"], r.get("nodo", "")])
+		if not grupos.has(clave):
+			grupos[clave] = []
+		grupos[clave].append(instancias[r["id"]])
+	var recursos := 0
+	var lotes := 0
+	for grupo in grupos.values():
+		if grupo.size() < 2:
+			continue
+		recursos += grupo.size()
+		var primero: Node3D = grupo[0]
+		for hijo in primero.find_children("*", "MeshInstance3D", true, false):
+			var origen := hijo as MeshInstance3D
+			# Las variantes descartadas con queue_free aun existen durante este cuadro.
+			var rama: Node = origen
+			while rama != primero and not rama.is_queued_for_deletion():
+				rama = rama.get_parent()
+			if rama != primero or origen.mesh == null:
+				continue
+			_crear_multimesh(grupo, origen)
+			lotes += 1
+	print("MULTIMESH recursos=%d lotes=%d" % [recursos, lotes])
+
+
+func _crear_multimesh(grupo: Array, origen: MeshInstance3D) -> void:
+	# MultiMesh usa los materiales de la malla, no los overrides de MeshInstance3D.
+	# Se copia solo la malla y se comparten los ShaderMaterial ya registrados.
+	var malla := origen.mesh.duplicate() as Mesh
+	for superficie in malla.get_surface_count():
+		malla.surface_set_material(superficie, origen.get_active_material(superficie))
+	var multiples := MultiMesh.new()
+	multiples.transform_format = MultiMesh.TRANSFORM_3D
+	multiples.mesh = malla
+	multiples.instance_count = grupo.size()
+	var primero: Node3D = grupo[0]
+	var ruta := primero.get_path_to(origen)
+	var inversa := global_transform.affine_inverse()
+	var cizalla := maxf(inclinacion, float(datos["camara"].get("inclinacion_objetos", 0.45)))
+	var inclinar := Transform3D(Basis(Vector3.RIGHT, Vector3(0.0, 1.0, -cizalla), Vector3.BACK), Vector3.ZERO)
+	var caja := AABB()
+	for i in grupo.size():
+		var original := grupo[i].get_node(ruta) as MeshInstance3D
+		# Incluye pivotes, altura normalizada, escala, rotacion y apoyo ya resuelto.
+		multiples.set_instance_transform(i, inversa * original.global_transform)
+		# Cubre ambas posiciones de la tecla I y el viento del shader de follaje.
+		var limite := original.global_transform * malla.get_aabb()
+		limite = limite.merge(inclinar * limite)
+		var balanceo := Vector3(0.035, 0.0, 0.0175) * maxf(limite.end.y, 0.0)
+		limite.position -= balanceo
+		limite.size += balanceo * 2.0
+		limite = inversa * limite
+		caja = limite if i == 0 else caja.merge(limite)
+		# Se conservan los nodos y sus cajas para las referencias de instancias.
+		original.visible = false
+	multiples.custom_aabb = caja
+	var lote := MultiMeshInstance3D.new()
+	lote.name = "Multimesh_%s_%s" % [primero.name, origen.name]
+	lote.multimesh = multiples
+	lote.cast_shadow = origen.cast_shadow
+	lote.layers = origen.layers
+	lote.material_overlay = origen.material_overlay
+	lote.extra_cull_margin = origen.extra_cull_margin
+	add_child(lote)
 
 
 func _mostrar_antena() -> void:

exec
