        return b'glTF'+struct.pack('<II',2,20+len(data))+struct.pack('<II',len(data),0x4E4F534A)+data
    path=temp/'test.glb';path.write_bytes(glb(doc))
    durations,images=b['verificar_glb'](path,['reposo'],2,1)
    assert durations['reposo']['duracion_s']==1 and images==1
    for field in ('name','texture','triangles','duration'):
        bad=copy.deepcopy(doc)
        if field=='name': bad['animations'][0]['name']='otro'
        if field=='texture': bad['images']=[]
        if field=='triangles': bad['accessors'][0]['count']=6
        if field=='duration': bad['accessors'][1]['max']=[0]
        path.write_bytes(glb(bad))
        try:
            b['verificar_glb'](path,['reposo'],2,1)
            raise AssertionError('Debia rechazar '+field)
        except ValueError:
            pass
    print('OK validador GLB: estructura aceptada y cuatro corrupciones rechazadas')
assert b['lista']('a,b')==['a','b']
assert b['lista']('')==[]
try:
    b['lista']('a,')
    raise AssertionError('Debia rechazar lista vacia')
