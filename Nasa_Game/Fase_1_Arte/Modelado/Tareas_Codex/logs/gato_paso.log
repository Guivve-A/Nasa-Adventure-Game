+"""Mide la malla evaluada y los controles, sin modificar el blend."""
+import bpy
+import json
+import sys
+from pathlib import Path
+from mathutils import Vector
+
+out = Path(sys.argv[sys.argv.index('--') + 1])
+rig = bpy.data.objects['Orbita_Rigify']
+target = bpy.data.objects['Orbita_esqueleto']
+meshes = [o for o in bpy.data.objects if o.type == 'MESH' and o.name.endswith('_GLB')]
+measures = json.loads(bpy.context.scene['rig_gato_measures'])
+feet = {k: Vector(v) for k, v in measures['feet'].items()}
+groups = {k: [] for k in feet}
+for obj in meshes:
+    obj.hide_set(False)
+    for v in obj.data.vertices:
+        if v.co.z < .12 * measures['size_m'][2]:
+            k = min(feet, key=lambda k: (v.co - feet[k]).length_squared)
+            groups[k].append((obj.name, v.index))
+target.hide_set(False)
+for obj in (rig, target):
+    obj.animation_data.action = None
+    for track in obj.animation_data.nla_tracks:
+        track.mute = True
+    for pb in obj.pose.bones:
+        pb.matrix_basis.identity()
+bpy.context.view_layer.update()
+
+def minimums():
+    dg = bpy.context.evaluated_depsgraph_get()
+    vertices = {}
+    for obj in meshes:
+        ev = obj.evaluated_get(dg)
+        mesh = ev.to_mesh()
+        vertices[obj.name] = [ev.matrix_world @ v.co for v in mesh.vertices]
+        ev.to_mesh_clear()
+    return {k: min(vertices[obj][i].z for obj, i in indices) for k, indices in groups.items()}
+
+rest = minimums()
+rows = []
+controls = []
+for name, count in [('reposo', 60), ('caminar', 30)]:
+    action = bpy.data.actions[name]
+    target.animation_data.action = action
+    target.animation_data.action_slot = action.slots[0]
+    ctrl = bpy.data.actions['CTRL_' + name]
+    rig.animation_data.action = ctrl
+    rig.animation_data.action_slot = ctrl.slots[0]
+    for f in range(count * 4 + 1):
+        frame = 1 + f / 4
+        bpy.context.scene.frame_set(int(frame), subframe=frame % 1)
+        bpy.context.view_layer.update()
+        rows.append({'action': name, 'frame': frame, 'time': (frame - 1) / 30,
+                     'minimums_m': minimums()})
+        ev = rig.evaluated_get(bpy.context.evaluated_depsgraph_get())
+        controls.append({'action': name, 'frame': frame,
+                         'positions': {n: list(ev.pose.bones[n].matrix.translation)
+                                       for n in ['torso', 'head', 'hand_ik.L', 'hand_ik.R',
+                                                 'foot_ik.L', 'foot_ik.R']}})
+out.write_text(json.dumps({'rest_m': rest, 'vertices_per_foot': {k: len(v) for k, v in groups.items()},
+                           'samples': rows, 'controls': controls}, indent=2), encoding='utf-8')
+print('AUDITORIA', out, 'descanso', rest, flush=True)
+for name in ['reposo', 'caminar']:
+    subset = [r for r in rows if r['action'] == name]
+    print(name, {k: {'min': min(r['minimums_m'][k] for r in subset),
+                     'max': max(r['minimums_m'][k] for r in subset)} for k in feet}, flush=True)

