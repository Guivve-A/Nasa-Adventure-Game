+
+lines = ['# Orbita: paso legible y apoyo de las patas', '',
+    'Ejecucion: 12 de noviembre de 2026. Blender 5.3.0; Godot 4.7.2, Mobile/Vulkan, Intel HD 620.', '',
+    'Se modificaron `create_actions` y la validacion en [rig_gato.py](../../rig_gato.py). '
