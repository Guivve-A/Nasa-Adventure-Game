+"""Compone evidencia existente; no modifica recursos del proyecto."""
+from pathlib import Path
+import difflib
+import json
+import math
+import re
+from PIL import Image, ImageDraw, ImageFont
+
+root = Path(__file__).resolve().parents[2]
+out = Path(__file__).resolve().parent
+font = ImageFont.truetype('C:/Windows/Fonts/arial.ttf', 21)
+small = ImageFont.truetype('C:/Windows/Fonts/arial.ttf', 15)
+sheet = Image.new('RGB', (1200, 1060), '#23352e')
+draw = ImageDraw.Draw(sheet)
+for i in range(6):
+    shot = Image.open(out / f'caminar_{i}.png').convert('RGB')
+    crop = shot.crop((420, 125, 820, 625))
+    x, y = (i % 3)*400, (i // 3)*530
+    sheet.paste(crop, (x, y+30))
+    draw.text((x+12, y+4), f'{i}/6 s = {i/6:.6f} s', font=font, fill='white')
+sheet.save(out / 'caminar_mosaico.png')
+
+# Misma escala en las seis miniaturas; el gato ocupa unos 150 px de alto.
+mini = Image.new('RGB', (1200, 290), '#23352e')
+draw = ImageDraw.Draw(mini)
+for i in range(6):
+    shot = Image.open(out / f'caminar_{i}.png').convert('RGB')
+    crop = shot.crop((420, 125, 820, 625)).resize((140, 175), Image.Resampling.LANCZOS)
+    mini.paste(crop, (i*200+30, 38))
+    draw.text((i*200+18, 8), f'{i}/6 s', font=font, fill='white')
+draw.text((18, 242), 'Recortes de Godot reducidos a escala fija; gato de unos 150 px de alto.',
+          font=small, fill='white')
+mini.save(out / 'caminar_tamano_juego.png')
+
+before = json.loads((out / 'alturas_antes.json').read_text())
+after = json.loads((out / 'alturas_despues.json').read_text())
+geometry = json.loads((root / 'salidas/PER-09_rig.medidas.json').read_text())
+plants = json.loads((root / 'salidas/PER-09_rig.plantas.json').read_text())
+log = (out / 'ejecucion_completa.log').read_text(encoding='utf-16')
+summary = json.loads(next(s.split('=', 1)[1] for s in log.splitlines() if s.startswith('RESUMEN_RIG_GATO=')))
+
+def measure(stage):
+    text = (out / f'medida_final_{stage}.log').read_text(encoding='utf-16')
+    return next(s for s in text.splitlines() if s.startswith('MEDIDA '))
+
+def range_control(data, name, axis):
+    values = [r['positions'][name][axis] for r in data['controls'] if r['action'] == 'caminar']
+    return max(values)-min(values)
+
+def head_error(data):
+    rows = data['controls']
+    ref = rows[0]['positions']['head']
+    return max(math.dist(r['positions']['head'], ref) for r in rows)
+
+old = (out / 'rig_gato_antes.py').read_text(encoding='utf-8').splitlines(True)
