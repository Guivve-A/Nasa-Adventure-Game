+import bpy
+from mathutils import Matrix
+
+bpy.ops.wm.open_mainfile(filepath=__file__.replace('diagnosticar_gato.py', 'gato.blend'))
+rig = next(o for o in bpy.data.objects if o.get('rig_gato_role') == 'rig')
+print('BLENDER', bpy.app.version_string)
+for pb in rig.pose.bones:
+    if pb.keys():
+        print('PROPS', pb.name, {k: pb[k] for k in pb.keys() if k != '_RNA_UI'})
+names = ['torso', 'chest', 'head', 'neck', 'hand_ik.L', 'foot_ik.L']
+def dump(label):
+    bpy.context.view_layer.update()
+    ev = rig.evaluated_get(bpy.context.evaluated_depsgraph_get())
+    print('POSE', label)
+    for pb in ev.pose.bones:
+        if pb.name.startswith('DEF-') or pb.name in names:
+            b = pb.bone
+            print(pb.name, 'rest', tuple(round(v, 5) for v in b.head_local),
+                  'posed', tuple(round(v, 5) for v in pb.head),
+                  'len', round(b.length, 6), round((pb.tail-pb.head).length, 6),
+                  'scale', tuple(round(v, 4) for v in pb.matrix.to_scale()))
+dump('old_reposo_f1')
+rig.animation_data.action = None
+for pb in rig.pose.bones:
+    pb.matrix_basis = Matrix.Identity(4)
+dump('identity_basis')
+for n in names:
+    pb = rig.pose.bones.get(n)
+    if pb:
+        print('CONTROL', n, 'parent', pb.parent.name if pb.parent else None,
+              'constraints', [(c.name, c.type) for c in pb.constraints])
+
+target = next(o for o in bpy.data.objects if o.type == 'ARMATURE' and o.get('rig_gato_role') == 'export')
+track = next(t for t in target.animation_data.nla_tracks if t.name == 'reposo')
+target.animation_data.action = track.strips[0].action
+target.animation_data.action_slot = track.strips[0].action_slot
+bpy.context.scene.frame_set(1)
+bpy.context.view_layer.update()
+ev = target.evaluated_get(bpy.context.evaluated_depsgraph_get())
+for pb in ev.pose.bones:
+    print('BAKED', pb.name, 'head', tuple(round(v, 5) for v in pb.head),
+          'len', round((pb.tail-pb.head).length, 6),
+          'scale', tuple(round(v, 5) for v in pb.matrix.to_scale()),
+          'delta_rig', round((pb.head-rig.pose.bones[pb.name].head).length, 6))
+    print('REST_COMPARE', pb.name,
+          'rest_angle', round((pb.bone.matrix_local.inverted() @ rig.data.bones[pb.name].matrix_local).to_quaternion().angle, 6),
+          'deform_angle', round((pb.matrix @ pb.bone.matrix_local.inverted()).to_quaternion().angle, 6),
+          'rest_m', [list(r) for r in pb.bone.matrix_local] if pb.name == 'DEF-spine.006' else '',
+          'rig_m', [list(r) for r in rig.data.bones[pb.name].matrix_local] if pb.name == 'DEF-spine.006' else '')
+path = __file__.replace('diagnosticar_gato.py', 'PER-09_rig.glb')
+bpy.ops.import_scene.gltf(filepath=path)
+imported = bpy.context.object
+imported = next(o for o in bpy.context.selected_objects if o.type == 'ARMATURE')
+for act in bpy.data.actions:
+    if act.name.startswith('reposo') and act != track.strips[0].action:
+        imported.animation_data_create().action = act
+        imported.animation_data.action_slot = act.slots[0]
+bpy.context.scene.frame_set(1)
+bpy.context.view_layer.update()
+ev = imported.evaluated_get(bpy.context.evaluated_depsgraph_get())
+for pb in ev.pose.bones:
+    print('ROUNDTRIP', pb.name, 'head', tuple(round(v, 5) for v in pb.head),
+          'len', round((pb.tail-pb.head).length, 6),
+          'deform_angle', round((pb.matrix @ pb.bone.matrix_local.inverted()).to_quaternion().angle, 5))
+for obj in bpy.context.scene.objects:
+    if obj.type == 'MESH' and obj.parent and obj.parent.type == 'ARMATURE':
+        evmesh = obj.evaluated_get(bpy.context.evaluated_depsgraph_get())
+        pts = [evmesh.matrix_world @ v.co for v in evmesh.data.vertices]
+        print('BOUNDS', obj.name, [(min(p[i] for p in pts), max(p[i] for p in pts)) for i in range(3)])
+
+# Comparar las matrices de skin de los nodos animados con inverseBindMatrices,
+# sin depender del importador ni de las longitudes reconstruidas de los huesos.
+import sys, json, struct
+sys.path.insert(0, str(__import__('pathlib').Path(__file__).resolve().parents[1]))
+import rig_gato as mod
+with open(path, 'rb') as f:
+    f.read(12)
+    size, _ = struct.unpack('<II', f.read(8)); doc = json.loads(f.read(size))
+    size, _ = struct.unpack('<II', f.read(8)); binary = f.read(size)
+nodes = doc['nodes']
+parents = {c: i for i, n in enumerate(nodes) for c in n.get('children', [])}
+skin = doc['skins'][0]
+ibms = [Matrix([row[i:i+4] for i in range(0, 16, 4)]).transposed()
+        for row in mod.accessor_values(doc, binary, skin['inverseBindMatrices'])]
+for animation in doc['animations']:
+    local = {i: dict(n) for i, n in enumerate(nodes)}
+    for channel in animation['channels']:
+        s = animation['samplers'][channel['sampler']]
+        local[channel['target']['node']][channel['target']['path']] = mod.accessor_values(doc, binary, s['output'])[0]
+    def world(i):
+        n = local[i]
+        from mathutils import Vector, Quaternion
+        q = n.get('rotation', [0, 0, 0, 1])
+        m = Matrix.LocRotScale(Vector(n.get('translation', [0]*3)), Quaternion((q[3], *q[:3])), Vector(n.get('scale', [1]*3)))
+        return world(parents[i]) @ m if i in parents else m
+    for j, ibm in zip(skin['joints'], ibms):
+        deform = world(j) @ ibm
+        print('RAW_SKIN', animation['name'], nodes[j]['name'],
+              'angle', round(deform.to_quaternion().angle, 5),
+              'translation', tuple(round(v, 5) for v in deform.translation))

