+        center = (low+high)/2
+        camera.location = center + Vector((3*max(high-low), 0, 0))
+        camera.rotation_euler = (center-camera.location).to_track_quat('-Z', 'Y').to_euler()
+        camera_data.ortho_scale = 1.35*max(high.z-low.z, high.y-low.y)
