+    y_knots = [(original['spine.006'][1].y, head.y - .08*length),
+               (original['spine.006'][0].y, head.y),
+               (original['spine.004'][0].y, front_y - .01*length),
+               (original['spine.003'][0].y, (front_y+rear_y)*.5),
+               (original['spine'][0].y, rear_y + .025*length)]
