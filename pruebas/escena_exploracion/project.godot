; Prueba: escena de exploracion v1, la vista aprobada del sendero (ANC_VISTA_JUEGO) en 3D.
config_version=5

[application]

config/name="Escena de exploracion v1"
run/main_scene="res://escena.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=false

[rendering]

renderer/rendering_method="mobile"
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
